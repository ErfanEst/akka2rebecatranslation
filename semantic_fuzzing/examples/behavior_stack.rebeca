reactiveclass ModeActor(16) {
  knownrebecs {}
  statevars {
    int value;
    int fuzzBehaviorMode;
    int fuzzBehaviorDepth;
    int fuzzBehaviorSlot0;
    int fuzzBehaviorSlot1;
    int fuzzBehaviorSlot2;
    int fuzzBehaviorSlot3;
  }
  ModeActor() {
    value = 0;
    fuzzBehaviorMode = 0;
    fuzzBehaviorDepth = 0;
    fuzzBehaviorSlot0 = -1;
    fuzzBehaviorSlot1 = -1;
    fuzzBehaviorSlot2 = -1;
    fuzzBehaviorSlot3 = -1;
  }
  void popBehavior() {
    if (fuzzBehaviorDepth > 0) {
      fuzzBehaviorDepth = fuzzBehaviorDepth - 1;
      if (fuzzBehaviorDepth == 0) { fuzzBehaviorSlot0 = -1; }
      if (fuzzBehaviorDepth == 1) { fuzzBehaviorSlot1 = -1; }
      if (fuzzBehaviorDepth == 2) { fuzzBehaviorSlot2 = -1; }
      if (fuzzBehaviorDepth == 3) { fuzzBehaviorSlot3 = -1; }
    }
    fuzzBehaviorMode = 0;
    if (fuzzBehaviorDepth == 1) { fuzzBehaviorMode = fuzzBehaviorSlot0; }
    if (fuzzBehaviorDepth == 2) { fuzzBehaviorMode = fuzzBehaviorSlot1; }
    if (fuzzBehaviorDepth == 3) { fuzzBehaviorMode = fuzzBehaviorSlot2; }
    if (fuzzBehaviorDepth == 4) { fuzzBehaviorMode = fuzzBehaviorSlot3; }
  }
  void pushBehavior(int mode, boolean discard) {
    if (discard && fuzzBehaviorDepth > 0) { popBehavior(); }
    assertion(fuzzBehaviorDepth < 4);
    if (fuzzBehaviorDepth == 0) { fuzzBehaviorSlot0 = mode; }
    if (fuzzBehaviorDepth == 1) { fuzzBehaviorSlot1 = mode; }
    if (fuzzBehaviorDepth == 2) { fuzzBehaviorSlot2 = mode; }
    if (fuzzBehaviorDepth == 3) { fuzzBehaviorSlot3 = mode; }
    fuzzBehaviorDepth = fuzzBehaviorDepth + 1;
    fuzzBehaviorMode = mode;
  }
  msgsrv PushActive() { pushBehavior(1, false); }
  msgsrv PushPaused() { pushBehavior(2, false); }
  msgsrv ReplaceActive() { pushBehavior(1, true); }
  msgsrv Pop() { popBehavior(); }
  msgsrv Add(int amount) {
    if (fuzzBehaviorMode == 0) { value = value + amount; }
    if (fuzzBehaviorMode == 1) { value = value + amount * 2; }
  }
}
reactiveclass Client(16) {
  knownrebecs { ModeActor worker; }
  statevars {}
  Client() {}
  msgsrv Noop() {}
}
main {
  ModeActor worker():();
  Client client(worker):();
}
