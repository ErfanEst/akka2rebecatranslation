reactiveclass Ping(5) {
	knownrebecs {
		Pong pong;
	}
	statevars {
		int count;
		boolean active;
	}

	Ping() {
		count = 0;
		active = true;
		self.initial();
	}

	msgsrv initial() {
		// Ping started the game!
		pong.pingMessage();
	}

	msgsrv pongMessage() {
		if (!active) {
		} else {
			count = count + 1;
			// Ping received pong #count from sender
			if (count >= 10) {
				((Pong)sender).stopMessage();
				// Ping stopped
				active = false;
			} else {
				((Pong)sender).pingMessage();
			}
		}
	}
}

reactiveclass Pong(5) {
	knownrebecs {
		Ping ping;
	}
	statevars {
		boolean active;
	}

	Pong() {
		active = true;
	}

	msgsrv pingMessage() {
		if (!active) {
		} else {
			// Pong received ping from sender
			((Ping)sender).pongMessage();
		}
	}

	msgsrv stopMessage() {
		// Pong stopped
		active = false;
	}
}

main {
	Ping ping(pong):();
	Pong pong(ping):();
}