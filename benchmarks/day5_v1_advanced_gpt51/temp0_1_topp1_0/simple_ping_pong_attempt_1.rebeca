reactiveclass Ping(5) {
	knownrebecs { 
		Pong pong;
	}
	statevars {
		int count;
		boolean active;
	}

	Ping() {
		count = 0;
		active = true;
		self.initial();
	}

	msgsrv initial() {
		if (active) {
			pong.pingMessage();
		}
	}

	msgsrv pingMessage() {
		// not used in this translation; no behavior for incoming PingMessage in Ping
	}

	msgsrv pongMessage() {
		if (active) {
			count = count + 1;
			if (count >= 10) {
				((Pong)sender).stopMessage();
				active = false;
			} else {
				((Pong)sender).pingMessage();
			}
		}
	}

	msgsrv stopMessage() {
		active = false;
	}
}

reactiveclass Pong(5) {
	knownrebecs {
		Ping ping;
	}
	statevars {
		boolean active;
	}

	Pong() {
		active = true;
	}

	msgsrv pingMessage() {
		if (active) {
			((Ping)sender).pongMessage();
		}
	}

	msgsrv pongMessage() {
		// not used in this translation; no behavior for incoming PongMessage in Pong
	}

	msgsrv stopMessage() {
		active = false;
	}
}

main {
	Ping ping(pong):();
	Pong pong(ping):();
}