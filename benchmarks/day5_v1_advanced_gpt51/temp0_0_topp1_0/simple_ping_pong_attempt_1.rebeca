reactiveclass Ping(10) {
	knownrebecs {
		Pong pong;
	}

	statevars {
		int count;
		boolean active;
	}

	Ping() {
		count = 0;
		active = true;
		self.initial();
	}

	msgsrv initial() {
		if (active) {
			pong.pingMsg();
		}
	}

	msgsrv pongMsg() {
		if (!active) {
		} else {
			count = count + 1;
			if (count >= 10) {
				((Pong)sender).stopMsg();
				active = false;
			} else {
				((Pong)sender).pingMsg();
			}
		}
	}
}

reactiveclass Pong(10) {
	knownrebecs {
	}

	statevars {
		boolean active;
	}

	Pong() {
		active = true;
	}

	msgsrv pingMsg() {
		if (!active) {
		} else {
			((Ping)sender).pongMsg();
		}
	}

	msgsrv stopMsg() {
		active = false;
	}
}

main {
	Pong pong():();
	Ping ping(pong):();
}