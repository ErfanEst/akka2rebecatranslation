reactiveclass Ping(1) {
	knownrebecs {
		Pong pong;
	}
	statevars {
		int count;
	}
	
	Ping(Pong myPong) {
		pong = myPong;
		count = 0;
	}
	
	msgsrv startMessage {
		pong.pingMessage(self);
	}
	
	msgsrv pongMessage {
		count = count + 1;
		if (count >= 10) {
			pong.stopMessage();
		} else {
			pong.pingMessage(self);
		}
	}
}

reactiveclass Pong(1) {
	msgsrv pingMessage(Ping sender) {
		sender.pongMessage();
	}
	
	msgsrv stopMessage {
	}
}

main {
	Pong pong(): ();
	Ping ping(pong): ();
	
	ping.startMessage();
}