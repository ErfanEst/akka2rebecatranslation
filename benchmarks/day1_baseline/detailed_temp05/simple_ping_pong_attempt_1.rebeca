reactiveclass Ping(1) {
	knownrebecs {
		Pong pong;
	}
	statevars {
		int count = 0;
	}
	
	msgsrv startMessage {
		println("Ping started the game!");
		pong.pingMessage();
	}
	
	msgsrv pongMessage {
		count = count + 1;
		println("Ping received pong #" + count);
		if (count >= 10) {
			pong.stopMessage();
			println("Ping stopped");
			self.stop();
		} else {
			pong.pingMessage();
		}
	}
}

reactiveclass Pong(1) {
	msgsrv pingMessage(Ping sender) {
		println("Pong received ping");
		sender.pongMessage();
	}
	
	msgsrv stopMessage {
		println("Pong stopped");
		self.stop();
	}
}

main {
	Pong pong(1): ();
	Ping ping(1): (pong);
	
	ping.startMessage();
}