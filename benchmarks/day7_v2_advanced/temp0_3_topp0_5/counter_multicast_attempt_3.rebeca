reactiveclass Counter() {
	knownrebecs {
	}

	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv initial() {
		// no-op
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client(Counter counter) {
	knownrebecs {
		Counter counter;
	}

	statevars {
		int clientId;
	}

	Client(int id) {
		clientId = id;
	}

	msgsrv initial() {
		// simulate:
		// counter.tell(Increment, client1)
		// counter.tell(Increment, client2)
		// counter.tell(GetValue, client1)
		counter.Increment(this);
		counter.Increment(this);
		counter.GetValue(this);
	}

	msgsrv ValueResponse(int value) {
		// println equivalent omitted
	}
}

main {
	Counter counter():();
	Client client1(counter):(1);
	Client client2(counter):(2);
}