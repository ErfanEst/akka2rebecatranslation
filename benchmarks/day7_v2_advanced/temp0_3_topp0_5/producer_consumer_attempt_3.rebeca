reactiveclass Producer {
	knownrebecs {
		Consumer consumer;
	}
	statevars {
		// no internal state
	}

	Producer() {
		// no initialization needed
	}

	msgsrv initial() {
		// no automatic behavior
	}

	// corresponds to case Produce(item)
	msgsrv ProduceMsg(char item[]) {
		// println(s"Producer: sending $item")
		// print statement omitted in Rebeca model
		consumer.ItemMsg(item);
	}
}

reactiveclass Consumer {
	knownrebecs {
		// no known rebecs
	}
	statevars {
		int bufferSize;
	}

	Consumer() {
		bufferSize = 0;
	}

	msgsrv initial() {
		// no automatic behavior
	}

	// corresponds to case Item(data)
	msgsrv ItemMsg(char data[]) {
		// buffer.enqueue(data)
		bufferSize = bufferSize + 1;
		// println(s"Consumer: received $data, buffer size: ${buffer.size}")
		// print statement omitted
	}

	// corresponds to case Consume()
	msgsrv ConsumeMsg() {
		if (bufferSize > 0) {
			// val item = buffer.dequeue()
			bufferSize = bufferSize - 1;
			// println(s"Consumer: consumed $item")
			// print statement omitted
		} else {
			// println("Consumer: buffer empty")
			// print statement omitted
		}
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();

	// simulate:
	// producer ! Produce("item1")
	// producer ! Produce("item2")
	// consumer ! Consume()
	producer.ProduceMsg("item1");
	producer.ProduceMsg("item2");
	consumer.ConsumeMsg();
}