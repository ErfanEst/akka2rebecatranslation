reactiveclass Producer {
	knownrebecs {
		Consumer consumer;
	}
	statevars {
		// no internal state
	}

	Producer() {
		// no initialization needed
	}

	msgsrv initial() {
		// no automatic behavior
	}

	// corresponds to case Produce(item)
	msgsrv ProduceMsg(int item) {
		consumer.ItemMsg(item);
	}
}

reactiveclass Consumer {
	knownrebecs {
	}
	statevars {
		int bufferSize;
	}

	Consumer() {
		bufferSize = 0;
	}

	msgsrv initial() {
		// no automatic behavior
	}

	// corresponds to case Item(data)
	msgsrv ItemMsg(int data) {
		bufferSize = bufferSize + 1;
	}

	// corresponds to case Consume()
	msgsrv ConsumeMsg() {
		if (bufferSize > 0) {
			bufferSize = bufferSize - 1;
		} else {
			// buffer empty, do nothing
		}
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();

	producer.ProduceMsg(1);
	producer.ProduceMsg(2);
	consumer.ConsumeMsg();
}