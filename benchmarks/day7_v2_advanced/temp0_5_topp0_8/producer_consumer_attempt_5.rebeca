reactiveclass Producer(Consumer consumer) {
	statevars {
		// no additional state
	}

	Producer() {
		// constructor body can be empty
	}

	msgsrv initial() {
		// no automatic behavior
	}

	// corresponds to case Produce(item)
	msgsrv Produce(int item) {
		// println("Producer: sending " + item);
		consumer.Item(item);
	}
}

reactiveclass Consumer() {
	statevars {
		int bufferSize;
		int buffer[10]; // fixed-size buffer to simulate Queue
	}

	Consumer() {
		bufferSize = 0;
	}

	msgsrv initial() {
		// no automatic behavior
	}

	// corresponds to case Item(data)
	msgsrv Item(int data) {
		if (bufferSize < 10) {
			buffer[bufferSize] = data;
			bufferSize = bufferSize + 1;
			// println("Consumer: received " + data + ", buffer size: " + bufferSize);
		} else {
			// buffer overflow in this abstraction; ignore or overwrite
		}
	}

	// corresponds to case Consume()
	msgsrv Consume() {
		if (bufferSize > 0) {
			int item;
			item = buffer[0];
			// shift remaining items
			int i;
			i = 0;
			while (i < bufferSize - 1) {
				buffer[i] = buffer[i + 1];
				i = i + 1;
			}
			bufferSize = bufferSize - 1;
			// println("Consumer: consumed " + item);
		} else {
			// println("Consumer: buffer empty");
		}
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):(consumer);

	producer.Produce(1);
	producer.Produce(2);
	consumer.Consume();
}