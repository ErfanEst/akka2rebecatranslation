timedreactiveclass Producer {
	knownrebecs {
		Consumer consumer;
	}
	statevars {
		// no additional state
	}

	Producer() {
		// constructor body can be empty
	}

	msgsrv initial() {
		// no automatic behavior
	}

	// corresponds to case Produce(item)
	msgsrv Produce(string item) {
		// println("Producer: sending " + item);
		consumer.Item(item);
	}
}

timedreactiveclass Consumer {
	knownrebecs {
		// no known rebecs
	}
	statevars {
		int bufferSize;
		string buffer[10]; // fixed-size buffer to simulate Queue
	}

	Consumer() {
		bufferSize = 0;
	}

	msgsrv initial() {
		// no automatic behavior
	}

	// corresponds to case Item(data)
	msgsrv Item(string data) {
		if (bufferSize < 10) {
			buffer[bufferSize] = data;
			bufferSize = bufferSize + 1;
			// println("Consumer: received " + data + ", buffer size: " + bufferSize);
		} else {
			// buffer overflow in this abstraction; ignore or overwrite
		}
	}

	// corresponds to case Consume()
	msgsrv Consume() {
		if (bufferSize > 0) {
			string item;
			item = buffer[0];
			// shift remaining items
			int i;
			i = 0;
			while (i < bufferSize - 1) {
				buffer[i] = buffer[i + 1];
				i = i + 1;
			}
			bufferSize = bufferSize - 1;
			// println("Consumer: consumed " + item);
		} else {
			// println("Consumer: buffer empty");
		}
	}
}

main {
	Producer producer(consumer):();
	Consumer consumer():();

	// initial message flow as in main
	producer.Produce("item1");
	producer.Produce("item2");
	consumer.Consume();
}