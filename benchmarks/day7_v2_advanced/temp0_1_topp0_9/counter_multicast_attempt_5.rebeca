reactiveclass Counter(counterClient1, counterClient2) {
	knownrebecs {
		Client counterClient1;
		Client counterClient2;
	}

	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv initial() {
		// no-op
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		counterClient1.log("Counter incremented to " + count);
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		counterClient1.log("Counter decremented to " + count);
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client(counter) {
	knownrebecs {
		Counter counter;
	}

	statevars {
		int clientId;
	}

	Client() {
		// no-op
	}

	msgsrv initial() {
		// no-op
	}

	msgsrv setId(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		log("Client " + clientId + " received value: " + value);
	}
}

main {
	Client counterClient1(counter):();
	Client counterClient2(counter):();
	Counter counter(counterClient1, counterClient2):();

	counterClient1.setId(1);
	counterClient2.setId(2);

	counter.Increment(counterClient1);
	counter.Increment(counterClient2);
	counter.GetValue(counterClient1);
}