reactiveclass Producer {
	knownrebecs {
		Consumer consumer;
	}
	statevars {
		// no additional state
	}

	Producer() {
		// initial behavior if needed
	}

	msgsrv initial() {
		// no automatic behavior on start
	}

	// Corresponds to case Produce(item)
	msgsrv produce(int item) {
		consumer.item(item);
	}
}

reactiveclass Consumer {
	knownrebecs {
		// no known rebecs
	}
	statevars {
		int bufferSize;
	}

	Consumer() {
		bufferSize = 0;
	}

	msgsrv initial() {
		// no automatic behavior on start
	}

	// Corresponds to case Item(data)
	msgsrv item(int data) {
		bufferSize = bufferSize + 1;
	}

	// Corresponds to case Consume()
	msgsrv consume() {
		if (bufferSize > 0) {
			bufferSize = bufferSize - 1;
		} else {
			// buffer empty
		}
	}
}

main {
	Consumer consumer();
	Producer producer(consumer):();

	producer.produce(1);
	producer.produce(2);
	consumer.consume();
}