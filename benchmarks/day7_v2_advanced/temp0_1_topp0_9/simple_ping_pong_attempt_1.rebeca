timedreactiveclass Ping {
	knownrebecs {
		Pong pong;
	}

	statevars {
		int count;
	}

	Ping() {
		count = 0;
	}

	msgsrv initial() {
		// Start the game automatically similar to ping ! StartMessage
		startMessage();
	}

	msgsrv startMessage() {
		// println("Ping started the game!")
		pong.pingMessage();
	}

	msgsrv pongMessage() {
		count = count + 1;
		// println("Ping received pong #" + count)
		if (count >= 10) {
			pong.stopMessage();
			// println("Ping stopped")
			// context.stop(self) is modeled by not sending further messages
		} else {
			pong.pingMessage();
		}
	}
}

timedreactiveclass Pong {
	knownrebecs {
		Ping ping;
	}

	Pong() {
	}

	msgsrv initial() {
		// no-op
	}

	msgsrv pingMessage() {
		// println("Pong received ping")
		ping.pongMessage();
	}

	msgsrv stopMessage() {
		// println("Pong stopped")
		// context.stop(self) is modeled by not sending further messages
	}
}

main {
	Ping ping(pong):();
	Pong pong(ping):();
}