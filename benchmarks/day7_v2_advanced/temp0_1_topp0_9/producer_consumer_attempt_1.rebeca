reactiveclass Producer {
		knownrebecs {
			Consumer consumer;
		}
		statevars {
			// no additional state
		}

		Producer() {
			// initial behavior if needed
		}

		msgsrv initial() {
			// no automatic behavior on start
		}

		// Corresponds to case Produce(item)
		msgsrv produce(string item) {
			// println(s"Producer: sending $item")
			// System.out.println can be modeled with comments or abstractly
			// System.out.println("Producer: sending " + item);
			consumer.item(item);
		}
	}

	// Reactive class for Consumer
	reactiveclass Consumer {
		knownrebecs {
			// no known rebecs needed
		}
		statevars {
			int bufferSize;
		}

		Consumer() {
			bufferSize = 0;
		}

		msgsrv initial() {
			// no automatic behavior on start
		}

		// Corresponds to case Item(data)
		msgsrv item(string data) {
			// buffer.enqueue(data)
			bufferSize = bufferSize + 1;
			// println(s"Consumer: received $data, buffer size: ${buffer.size}")
			// System.out.println("Consumer: received " + data + ", buffer size: " + bufferSize);
		}

		// Corresponds to case Consume()
		msgsrv consume() {
			if (bufferSize > 0) {
				bufferSize = bufferSize - 1;
				// val item = buffer.dequeue()
				// println(s"Consumer: consumed $item")
				// We don't keep actual item values, only size abstraction.
				// System.out.println("Consumer: consumed one item");
			} else {
				// println("Consumer: buffer empty")
				// System.out.println("Consumer: buffer empty");
			}
		}
	}

	main {
		// Instantiate rebecs
		Consumer consumer();
		Producer producer(consumer);

		// Simulate:
		// producer ! Produce("item1")
		// producer ! Produce("item2")
		// consumer ! Consume()
		producer.produce("item1");
		producer.produce("item2");
		consumer.consume();
	}
}