reactiveclass Counter {
	knownrebecs {
		Client client1;
		Client client2;
	}
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs {
		Counter counter;
	}
	statevars {
		int clientId;
	}

	msgsrv initial(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// println modeled as comment
		// Client clientId received value: value
	}

	msgsrv Start() {
		counter.Increment(this);
		counter.Increment(this);
		counter.GetValue(this);
	}
}

main {
	// knownrebecs binding lists must match the order and number in reactiveclass

	// First create dummy declarations to satisfy bindings
	Client client1(counter): (1);
	Client client2(counter): (2);
	Counter counter(client1, client2): ();

	// Start the scenario
	client1.Start();
}