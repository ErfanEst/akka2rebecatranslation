reactiveclass Ping {
	knownrebec Pong pong;

	statevars {
		int count;
	}

	Ping(Pong pong) {
		self.pong = pong;
		count = 0;
	}

	msgsrv initial() {
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		if (count >= 10) {
			pong.StopMessage();
			self.finish();
		} else {
			pong.PingMessage();
		}
	}
}

reactiveclass Pong {
	statevars {
	}

	Pong() {
	}

	msgsrv PingMessage() {
		sender.PongMessage();
	}

	msgsrv StopMessage() {
		self.finish();
	}
}

main {
	Pong pong():();
	Ping ping(pong):(pong);
}