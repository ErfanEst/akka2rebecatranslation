reactiveclass Producer {
	knownrebec Consumer consumer;

	Producer(Consumer consumer) {
		self.consumer = consumer;
	}

	msgrpc Produce(string item) {
		// println("Producer: sending " + item);
		consumer.Item(item);
	}
}

reactiveclass Consumer {
	statevars {
		int head;
		int tail;
		int count;
		string buffer[10];
	}

	Consumer() {
		head = 0;
		tail = 0;
		count = 0;
	}

	msgrpc Item(string data) {
		// enqueue
		if (count < 10) {
			buffer[tail] = data;
			tail = (tail + 1) % 10;
			count = count + 1;
		}
		// println("Consumer: received " + data + ", buffer size: " + count);
	}

	msgrpc Consume() {
		if (count > 0) {
			string item;
			item = buffer[head];
			head = (head + 1) % 10;
			count = count - 1;
			// println("Consumer: consumed " + item);
		} else {
			// println("Consumer: buffer empty");
		}
	}
}

main {
	Producer producer(consumer):();
	Consumer consumer():();

	// Initial messages corresponding to main
	producer.Produce("item1");
	producer.Produce("item2");
	consumer.Consume();
}

}