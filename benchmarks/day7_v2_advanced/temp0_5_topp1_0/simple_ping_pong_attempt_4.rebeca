reactiveclass Ping {
	knownrebecs {
		Pong pong;
	}

	statevars {
		int count;
	}

	Ping() {
		count = 0;
	}

	msgsrv initial() {
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		if (count >= 10) {
			pong.StopMessage();
			self.finish();
		} else {
			pong.PingMessage();
		}
	}
}

reactiveclass Pong {

	Pong() {
	}

	msgsrv PingMessage() {
		sender.PongMessage();
	}

	msgsrv StopMessage() {
		self.finish();
	}
}

main {
	Pong pong():();
	Ping ping(pong):(pong);
}