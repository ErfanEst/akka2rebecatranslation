// Environment reactiveclass to emulate println
	reactiveclass Env {
	knownrebecs { }
	statevars { }

	msgsrv printInt(int x) {
		// modeling print as a side effect, no operation needed
	}
	}

	// Messages: Increment, Decrement, GetValue, ValueResponse
	reactiveclass Counter {
	knownrebecs {
		Env env;
		Client client1;
		Client client2;
	}
	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv initial() {
		// no initial actions
	}

	msgsrv Increment(int senderId) {
		count = count + 1;
		env.printInt(count);
		if (senderId == 1) {
			client1.ValueResponse(count);
		} else {
			client2.ValueResponse(count);
		}
	}

	msgsrv Decrement(int senderId) {
		count = count - 1;
		env.printInt(count);
		if (senderId == 1) {
			client1.ValueResponse(count);
		} else {
			client2.ValueResponse(count);
		}
	}

	msgsrv GetValue(int senderId) {
		if (senderId == 1) {
			client1.ValueResponse(count);
		} else {
			client2.ValueResponse(count);
		}
	}
	}

	reactiveclass Client {
	knownrebecs {
		Env env;
		Counter counter;
	}
	statevars {
		int clientId;
	}

	Client(int id) {
		clientId = id;
	}

	msgsrv initial() {
		// no initial actions here
	}

	msgsrv ValueResponse(int value) {
		env.printInt(value);
	}
	}

	main {
		Env env();
		Counter counter(env, client1, client2);
		Client client1(env, counter)(1);
		Client client2(env, counter)(2);

		// Emulate:
		// counter.tell(Increment, client1)
		// counter.tell(Increment, client2)
		// counter.tell(GetValue, client1)
		counter.Increment(1);
		counter.Increment(2);
		counter.GetValue(1);
	}
}