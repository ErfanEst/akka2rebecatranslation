reactiveclass Producer(Consumer consumer) {
	knownrebec Consumer consumer;

	msgsrv initial() {
		// No automatic behavior; messages are sent from main
	}

	msgsrv Produce(string item) {
		consumer.Item(item);
	}
}

reactiveclass Consumer() {
	statevars {
		int bufferSize;
		string buffer[10];
		int head;
		int tail;
	}

	msgsrv initial() {
		bufferSize = 0;
		head = 0;
		tail = 0;
	}

	msgsrv Item(string data) {
		if (bufferSize < 10) {
			buffer[tail] = data;
			tail = (tail + 1) % 10;
			bufferSize = bufferSize + 1;
		} else {
			// Buffer overflow in this bounded model; ignore or handle as needed
		}
	}

	msgsrv Consume() {
		if (bufferSize > 0) {
			string item;
			item = buffer[head];
			head = (head + 1) % 10;
			bufferSize = bufferSize - 1;
		} else {
			// Buffer empty
		}
	}
}

main {
	Consumer consumer();
	Producer producer(consumer);

	producer.Produce("item1");
	producer.Produce("item2");
	consumer.Consume();
}