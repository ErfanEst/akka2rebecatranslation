timedreactiveclass Producer {
	knownrebec Consumer consumer;

	Producer(Consumer consumer) {
		self.consumer = consumer;
	}

	msgsrv initial() {
		// No automatic behavior; messages are sent from main
	}

	msgsrv Produce(string item) {
		// println("Producer: sending " + item);
		consumer.Item(item);
	}
}

timedreactiveclass Consumer {
	statevars {
		int bufferSize;
		string buffer[10];
		int head;
		int tail;
	}

	Consumer() {
		bufferSize = 0;
		head = 0;
		tail = 0;
	}

	msgsrv initial() {
		// No automatic behavior; messages are sent from main
	}

	msgsrv Item(string data) {
		if (bufferSize < 10) {
			buffer[tail] = data;
			tail = (tail + 1) % 10;
			bufferSize = bufferSize + 1;
			// println("Consumer: received " + data + ", buffer size: " + bufferSize);
		} else {
			// Buffer overflow in this bounded model; ignore or handle as needed
		}
	}

	msgsrv Consume() {
		if (bufferSize > 0) {
			string item;
			item = buffer[head];
			head = (head + 1) % 10;
			bufferSize = bufferSize - 1;
			// println("Consumer: consumed " + item);
		} else {
			// println("Consumer: buffer empty");
		}
	}
}

main {
	Consumer consumer();
	Producer producer(consumer);

	// Simulate the initial messages sent in the Akka main
	producer.Produce("item1") after(0);
	producer.Produce("item2") after(0);
	consumer.Consume() after(0);
}