reactiveclass Counter {
    knownrebec Client client1;
    knownrebec Client client2;

    statevars {
        int count;
    }

    Counter() {
        count = 0;
    }

    msgsrv initial() {
        // Simulate:
        // counter.tell(Increment, client1)
        // counter.tell(Increment, client2)
        // counter.tell(GetValue, client1)
        this.Increment(client1);
        this.Increment(client2);
        this.GetValue(client1);
    }

    msgsrv Increment(Client sender) {
        count = count + 1;
        // println(s"Counter incremented to $count")
        sender.ValueResponse(count);
    }

    msgsrv Decrement(Client sender) {
        count = count - 1;
        // println(s"Counter decremented to $count")
        sender.ValueResponse(count);
    }

    msgsrv GetValue(Client sender) {
        sender.ValueResponse(count);
    }
}

reactiveclass Client {
    statevars {
        int clientId;
    }

    Client(int id) {
        clientId = id;
    }

    msgsrv initial() {
        // no initial behavior
    }

    msgsrv ValueResponse(int value) {
        // println(s"Client $clientId received value: $value")
    }
}

main {
    Client client1(1):();
    Client client2(2):();
    Counter counter(client1, client2):();

    // bindings
    client1:();
    client2:();
    counter(client1, client2):();
}