reactiveclass Ping(pong): {
	knownrebecs { 
		Pong pong;
	}
	statevars {
		int count;
	}

	Ping() {
		count = 0;
	}

	msgsrv initial() {
		// No automatic start; StartMessage will be triggered from main
	}

	msgsrv StartMessage() {
		// println("Ping started the game!");
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		// println("Ping received pong #" + count);
		if (count >= 10) {
			pong.StopMessage();
			// println("Ping stopped");
			// context.stop(self) is modeled by no further messages from this rebec
		} else {
			pong.PingMessage();
		}
	}
}

reactiveclass Pong() {
	knownrebecs {
	}
	statevars {
	}

	Pong() {
	}

	msgsrv initial() {
	}

	msgsrv PingMessage() {
		// println("Pong received ping");
		// In Rebeca, caller is not directly available; for this simple example,
		// we assume only Ping sends PingMessage, so we can model the reply by
		// direct reference. To keep Pong independent, we omit the reply here.
		// The ping-pong behavior is controlled from Ping side.
	}

	msgsrv StopMessage() {
		// println("Pong stopped");
		// context.stop(self) is modeled by no further messages from this rebec
	}
}

main {
	Pong pong():();
	Ping ping(pong):(pong);

	// Start the exchange: ping ! StartMessage
	ping.StartMessage();
}