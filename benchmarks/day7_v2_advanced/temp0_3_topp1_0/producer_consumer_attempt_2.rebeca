reactiveclass Producer {
    knownrebec Consumer consumer;

    Producer(Consumer consumer) {
        self.consumer = consumer;
    }

    msgsrv initial() {
        // corresponds to:
        // producer ! Produce("item1")
        // producer ! Produce("item2")
        Produce("item1");
        Produce("item2");
    }

    msgsrv Produce(string item) {
        // println(s"Producer: sending $item")
        consumer.Item(item);
    }
}

reactiveclass Consumer {
    statevars {
        int maxSize;
        string buffer[10];
        int size;
    }

    Consumer() {
        maxSize = 10;
        size = 0;
    }

    msgsrv initial() {
        // corresponds to: consumer ! Consume()
        Consume();
    }

    msgsrv Item(string data) {
        // buffer.enqueue(data)
        if (size < maxSize) {
            buffer[size] = data;
            size = size + 1;
        }
        // println(s"Consumer: received $data, buffer size: ${buffer.size}")
    }

    msgsrv Consume() {
        if (size > 0) {
            string item;
            int i;

            // dequeue: take first element
            item = buffer[0];

            // shift remaining elements
            i = 0;
            while (i < size - 1) {
                buffer[i] = buffer[i + 1];
                i = i + 1;
            }

            size = size - 1;
            // println(s"Consumer: consumed $item")
        } else {
            // println("Consumer: buffer empty")
        }
    }
}

main {
    Consumer consumer();
    Producer producer(consumer);
}