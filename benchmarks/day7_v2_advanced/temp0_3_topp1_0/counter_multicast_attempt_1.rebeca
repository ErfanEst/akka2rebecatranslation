reactiveclass Counter {
		knownrebec Client client1;
		knownrebec Client client2;

		statevars {
			int count;
		}

		Counter() {
			count = 0;
		}

		msgsrv initial() {
			// No automatic behavior; in Akka, messages are sent from main
		}

		// Increment message
		msgsrv Increment(Client sender) {
			count = count + 1;
			// println simulation: no direct output, only state update
			sender.ValueResponse(count);
		}

		// Decrement message
		msgsrv Decrement(Client sender) {
			count = count - 1;
			sender.ValueResponse(count);
		}

		// GetValue message
		msgsrv GetValue(Client sender) {
			sender.ValueResponse(count);
		}
	}

	// Reactive class for Client (Akka Client actor)
	reactiveclass Client {
		knownrebec Counter counter;

		statevars {
			int clientId;
		}

		Client(int id) {
			clientId = id;
		}

		msgsrv initial() {
			// No automatic behavior; messages are triggered from main
		}

		// Handle ValueResponse(value)
		msgsrv ValueResponse(int value) {
			// println simulation: no direct output, only state update or ignore
			// Example: could store last value if needed
			// int lastValue = value; // not required by original code semantics
		}
	}

	main {
		Counter counter(counterClient1, counterClient2);
		Client counterClient1(counter);
		Client counterClient2(counter);

		// Emulate the Akka main:
		// counter.tell(Increment, client1)
		// counter.tell(Increment, client2)
		// counter.tell(GetValue, client1)

		// In Rebeca, we must explicitly pass the sender as a parameter.
		counter.Increment(counterClient1);
		counter.Increment(counterClient2);
		counter.GetValue(counterClient1);
	}
}