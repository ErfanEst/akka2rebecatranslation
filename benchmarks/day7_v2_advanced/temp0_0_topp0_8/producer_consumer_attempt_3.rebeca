reactiveclass Producer(Consumer consumer) {
	knownrebec Consumer consumer;

	Producer() {
		self.start();
	}

	msgsrv start() {
		self.Produce("item1");
		self.Produce("item2");
	}

	msgsrv Produce(string item) {
		consumer.Item(item);
	}
}

reactiveclass Consumer() {
	statevars {
		int bufferSize;
	}

	Consumer() {
		bufferSize = 0;
		self.start();
	}

	msgsrv start() {
		self.Consume();
	}

	msgsrv Item(string data) {
		bufferSize = bufferSize + 1;
	}

	msgsrv Consume() {
		if (bufferSize > 0) {
			bufferSize = bufferSize - 1;
		} else {
			// buffer empty
		}
	}
}

main {
	Consumer consumer();
	Producer producer(consumer);
}