timedreactiveclass Ping {
    knownrebec Pong pong;

    statevars {
        int count;
    }

    Ping() {
        count = 0;
    }

    msgsrv initial() {
        // StartMessage behavior
        // println("Ping started the game!");
        pong.PingMessage();
    }

    msgsrv PongMessage() {
        count = count + 1;
        // println("Ping received pong #" + count);
        if (count >= 10) {
            pong.StopMessage();
            // println("Ping stopped");
            // context.stop(self) is modeled by not sending further messages
        } else {
            pong.PingMessage();
        }
    }
}

timedreactiveclass Pong {
    knownrebec Ping ping;

    Pong() {
    }

    msgsrv initial() {
        // No automatic behavior on start; Ping starts the game in its initial()
    }

    msgsrv PingMessage() {
        // println("Pong received ping");
        ping.PongMessage();
    }

    msgsrv StopMessage() {
        // println("Pong stopped");
        // context.stop(self) is modeled by not sending further messages
    }
}

timedmain {
    Ping ping(pong):();
    Pong pong(ping):();
}