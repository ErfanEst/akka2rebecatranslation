reactiveclass Ping {
		knownrebecs { 
			Pong pong;
		}
		statevars {
			int count;
			boolean active;
		}

		Ping(Pong pong) {
			self.count = 0;
			self.active = true;
		}

		msgsrv initial() {
			// In Akka, StartMessage is sent from main; here we trigger it in initial.
			self.startMessage();
		}

		msgsrv startMessage() {
			// println("Ping started the game!")
			if (active) {
				pong.pingMessage();
			}
		}

		msgsrv pongMessage() {
			if (active) {
				count = count + 1;
				// println("Ping received pong #" + count)
				if (count >= 10) {
					// sender() ! StopMessage; here sender is pong
					pong.stopMessage();
					// println("Ping stopped")
					active = false; // model context.stop(self)
				} else {
					// sender() ! PingMessage; here sender is pong
					pong.pingMessage();
				}
			}
		}
	}

	// Reactive class corresponding to Pong actor
	reactiveclass Pong {
		knownrebecs {
			Ping ping;
		}
		statevars {
			boolean active;
		}

		Pong(Ping ping) {
			active = true;
		}

		msgsrv initial() {
			// No automatic start; Ping starts the game
		}

		msgsrv pingMessage() {
			if (active) {
				// println("Pong received ping")
				// sender() ! PongMessage; here sender is ping
				ping.pongMessage();
			}
		}

		msgsrv stopMessage() {
			// println("Pong stopped")
			active = false; // model context.stop(self)
		}
	}

	main {
		Ping ping(pong):();
		Pong pong(ping):();
	}
}