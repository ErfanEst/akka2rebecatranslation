reactiveclass Counter {
    knownrebecs {
        Client client1;
        Client client2;
    }
    statevars {
        int count;
    }

    Counter() {
        count = 0;
    }

    msgsrv initial() {
        // Simulate the three initial tells from the main:
        // counter.tell(Increment, client1)
        this.Increment(client1);
        // counter.tell(Increment, client2)
        this.Increment(client2);
        // counter.tell(GetValue, client1)
        this.GetValue(client1);
    }

    msgsrv Increment(Client senderRef) {
        count = count + 1;
        // println: "Counter incremented to count"
        senderRef.ValueResponse(count);
    }

    msgsrv Decrement(Client senderRef) {
        count = count - 1;
        // println: "Counter decremented to count"
        senderRef.ValueResponse(count);
    }

    msgsrv GetValue(Client senderRef) {
        senderRef.ValueResponse(count);
    }
}

reactiveclass Client {
    knownrebecs {
        Counter counter;
    }
    statevars {
        int clientId;
    }

    Client(int id) {
        clientId = id;
    }

    msgsrv initial() {
        // No initial behavior; interactions are triggered from Counter.initial
    }

    msgsrv ValueResponse(int value) {
        // println: "Client clientId received value: value"
    }
}

main {
    Counter counter(counterClient1, counterClient2):();
    Client counterClient1(counter):(1);
    Client counterClient2(counter):(2);
}