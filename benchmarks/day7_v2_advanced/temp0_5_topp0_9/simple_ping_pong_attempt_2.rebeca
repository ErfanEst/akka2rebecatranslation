reactiveclass Ping {
		knownrebecs { 
			Pong pong;
		}
		statevars {
			int count;
			boolean active;
		}

		Ping() {
			count = 0;
			active = true;
		}

		msgsrv initial() {
			startMessage();
		}

		msgsrv startMessage() {
			if (active) {
				pong.pingMessage();
			}
		}

		msgsrv pongMessage() {
			if (active) {
				count = count + 1;
				if (count >= 10) {
					pong.stopMessage();
					active = false;
				} else {
					pong.pingMessage();
				}
			}
		}
	}

	reactiveclass Pong {
		knownrebecs {
			Ping ping;
		}
		statevars {
			boolean active;
		}

		Pong() {
			active = true;
		}

		msgsrv initial() {
			// no automatic start; Ping starts the game
		}

		msgsrv pingMessage() {
			if (active) {
				ping.pongMessage();
			}
		}

		msgsrv stopMessage() {
			active = false;
		}
	}

	main {
		Ping ping(pong):();
		Pong pong(ping):();
	}
}