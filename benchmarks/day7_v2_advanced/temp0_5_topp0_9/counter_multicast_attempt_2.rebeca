timedreactiveclass Counter {
	knownrebecs {
		Client client1;
		Client client2;
	}
	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv initial() {
		self.Increment(client1);
		self.Increment(client2);
		self.GetValue(client1);
	}

	msgsrv Increment(Client senderRef) {
		count = count + 1;
		senderRef.ValueResponse(count);
	}

	msgsrv Decrement(Client senderRef) {
		count = count - 1;
		senderRef.ValueResponse(count);
	}

	msgsrv GetValue(Client senderRef) {
		senderRef.ValueResponse(count);
	}
}

timedreactiveclass Client {
	knownrebecs {
		Counter counter;
	}
	statevars {
		int clientId;
	}

	Client() {
		clientId = 0;
	}

	msgsrv initial() {
		// no initial behavior
	}

	msgsrv ValueResponse(int value) {
		// handle received value
	}
}

main {
	Counter counter(counterClient1, counterClient2):();
	Client counterClient1(counter):();
	Client counterClient2(counter):();
}