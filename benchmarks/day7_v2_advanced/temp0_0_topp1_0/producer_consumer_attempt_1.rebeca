timedreactiveclass Producer {
	knownrebecs {
		Consumer consumer;
	}

	statevars {
		// no additional state
	}

	Producer() {
		// constructor
	}

	msgsrv initial() {
		// no automatic behavior; messages will be sent from main
	}

	msgsrv Produce(string item) {
		// println("Producer: sending " + item);
		consumer.Item(item);
	}
}

timedreactiveclass Consumer {
	knownrebecs {
	}

	statevars {
		int bufferSize;
	}

	Consumer() {
		bufferSize = 0;
	}

	msgsrv initial() {
		// no automatic behavior
	}

	msgsrv Item(string data) {
		bufferSize = bufferSize + 1;
		// println("Consumer: received " + data + ", buffer size: " + bufferSize);
	}

	msgsrv Consume() {
		if (bufferSize > 0) {
			bufferSize = bufferSize - 1;
			// println("Consumer: consumed one item");
		} else {
			// println("Consumer: buffer empty");
		}
	}
}

timedreactiveclass Starter {
	knownrebecs {
		Producer producer;
		Consumer consumer;
	}

	statevars {
	}

	Starter() {
	}

	msgsrv initial() {
		producer.Produce("item1");
		producer.Produce("item2");
		consumer.Consume();
	}
}

main {
	Producer producer(consumer):();
	Consumer consumer():();
	Starter starter(producer, consumer):();
}