reactiveclass Ping {
    knownrebecs {
        Pong pong;
    }

    statevars {
        int count;
    }

    Ping() {
        count = 0;
    }

    msgsrv initial() {
        // In Akka, StartMessage is sent from main to ping.
        // Here we start automatically by calling startGame.
        self.startGame();
    }

    msgsrv startGame() {
        // println("Ping started the game!")
        pong.pingMessage();
    }

    msgsrv pingMessage() {
        // Not used in this model; defined for completeness if needed.
    }

    msgsrv pongMessage() {
        count = count + 1;
        // println("Ping received pong #" + count)
        if (count >= 10) {
            pong.stopMessage();
            // println("Ping stopped")
            // context.stop(self) -> no direct equivalent; just stop sending
        } else {
            pong.pingMessage();
        }
    }

    msgsrv stopMessage() {
        // Not expected to be called on Ping in this example.
    }
}

reactiveclass Pong {
    knownrebecs {
        Ping ping;
    }

    statevars {
    }

    Pong() {
    }

    msgsrv initial() {
        // nothing
    }

    msgsrv pingMessage() {
        // println("Pong received ping")
        ping.pongMessage();
    }

    msgsrv pongMessage() {
        // Not used directly on Pong; defined for completeness.
    }

    msgsrv stopMessage() {
        // println("Pong stopped")
        // context.stop(self) -> no direct equivalent; just stop responding
    }
}

main {
    Ping ping(pong):();
    Pong pong(ping):();
}