reactiveclass Producer {
	knownrebecs {
		Consumer consumer;
	}

	statevars {
		// no additional state
	}

	Producer() {
		// constructor
	}

	msgsrv initial() {
		// no automatic behavior; messages will be sent from main
	}

	msgsrv Produce(byte item[]) {
		consumer.Item(item);
	}
}

reactiveclass Consumer {
	knownrebecs {
	}

	statevars {
		int bufferSize;
	}

	Consumer() {
		bufferSize = 0;
	}

	msgsrv initial() {
		// no automatic behavior
	}

	msgsrv Item(byte data[]) {
		bufferSize = bufferSize + 1;
	}

	msgsrv Consume() {
		if (bufferSize > 0) {
			bufferSize = bufferSize - 1;
		} else {
			// buffer empty
		}
	}
}

reactiveclass Starter {
	knownrebecs {
		Producer producer;
		Consumer consumer;
	}

	statevars {
	}

	Starter() {
	}

	msgsrv initial() {
		byte item1[5];
		byte item2[5];

		// representing "item1"
		item1[0] = 105; // 'i'
		item1[1] = 116; // 't'
		item1[2] = 101; // 'e'
		item1[3] = 109; // 'm'
		item1[4] = 49;  // '1'

		// representing "item2"
		item2[0] = 105; // 'i'
		item2[1] = 116; // 't'
		item2[2] = 101; // 'e'
		item2[3] = 109; // 'm'
		item2[4] = 50;  // '2'

		producer.Produce(item1);
		producer.Produce(item2);
		consumer.Consume();
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();
	Starter starter(producer, consumer):();
}