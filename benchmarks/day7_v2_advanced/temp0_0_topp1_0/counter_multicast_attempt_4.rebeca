reactiveclass Environment {
	msgrv Environment() {
	}

	msgrv initial() {
	}

	msgrv print(int msg) {
		// Use integer as placeholder; in Afra/RMC this can be traced
	}
}

reactiveclass Client {
	knownrebec Environment env;
	knownrebec Counter counter;
	int clientId;

	msgrv Client(Environment e, Counter c, int id) {
		env = e;
		counter = c;
		clientId = id;
	}

	msgrv initial() {
		// no-op; interactions are initiated from main
	}

	msgrv ValueResponse(int value) {
		// Encoded print: we just pass the value itself
		env.print(value);
	}
}

reactiveclass Counter {
	knownrebec Environment env;
	int count;

	msgrv Counter(Environment e) {
		env = e;
		count = 0;
	}

	msgrv initial() {
		// no-op
	}

	msgrv Increment(Client sender) {
		count = count + 1;
		env.print(count);
		sender.ValueResponse(count);
	}

	msgrv Decrement(Client sender) {
		count = count - 1;
		env.print(count);
		sender.ValueResponse(count);
	}

	msgrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

main {
	Environment env():();
	Counter counter(env):(initial);
	Client client1(env, counter, 1):(initial);
	Client client2(env, counter, 2):(initial);

	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}