reactiveclass Ping {
	knownrebecs {
		Pong pong;
	}

	statevars {
		int count;
	}

	Ping() {
		count = 0;
	}

	msgsrv initial() {
		self.startGame();
	}

	msgsrv startGame() {
		pong.pingMessage();
	}

	msgsrv pingMessage() {
		// Not used in this model; defined for completeness if needed.
	}

	msgsrv pongMessage() {
		count = count + 1;
		if (count >= 10) {
			pong.stopMessage();
		} else {
			pong.pingMessage();
		}
	}

	msgsrv stopMessage() {
		// Not expected to be called on Ping in this example.
	}
}

reactiveclass Pong {
	knownrebecs {
		Ping ping;
	}

	statevars {
	}

	Pong() {
	}

	msgsrv initial() {
		// nothing
	}

	msgsrv pingMessage() {
		ping.pongMessage();
	}

	msgsrv pongMessage() {
		// Not used directly on Pong; defined for completeness.
	}

	msgsrv stopMessage() {
		// Pong stops responding
	}
}

main {
	Ping ping(pong):();
	Pong pong(ping):();
}