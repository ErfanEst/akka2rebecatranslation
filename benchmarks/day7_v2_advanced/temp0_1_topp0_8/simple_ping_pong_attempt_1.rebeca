timedreactiveclass Ping {
	knownrebec Pong pong;

	statevars {
		int count;
	}

	Ping() {
		count = 0;
	}

	msgsrv StartMessage() {
		// println("Ping started the game!");
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		// println("Ping received pong #" + count);
		if (count >= 10) {
			pong.StopMessage();
			// println("Ping stopped");
			// context.stop(self) is modeled by no further actions
		} else {
			pong.PingMessage();
		}
	}
}

timedreactiveclass Pong {
	knownrebec Ping ping;

	Pong() {
	}

	msgsrv PingMessage() {
		// println("Pong received ping");
		ping.PongMessage();
	}

	msgsrv StopMessage() {
		// println("Pong stopped");
		// context.stop(self) is modeled by no further actions
	}
}

main {
	Ping ping(pong):();
	Pong pong(ping):();

	// Start the exchange from "ping"
	ping.StartMessage();
}