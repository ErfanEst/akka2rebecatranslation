timedreactiveclass Ping {
	knownrebec Pong pong;

	statevars {
		int count;
	}

	Ping() {
		count = 0;
	}

	msgsrv StartMessage() {
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		if (count >= 10) {
			pong.StopMessage();
		} else {
			pong.PingMessage();
		}
	}
}

timedreactiveclass Pong {
	knownrebec Ping ping;

	Pong() {
	}

	msgsrv PingMessage() {
		ping.PongMessage();
	}

	msgsrv StopMessage() {
	}
}

timedmain {
	Ping ping(pong):();
	Pong pong(ping):();

	ping.StartMessage();
}