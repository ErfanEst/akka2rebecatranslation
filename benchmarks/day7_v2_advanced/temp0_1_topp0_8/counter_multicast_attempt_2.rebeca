reactiveclass Counter {
    knownrebec Client client1;
    knownrebec Client client2;

    statevars {
        int count;
    }

    Counter() {
        count = 0;
    }

    msgsrv initial() {
        // No initial behavior; messages are sent from main
    }

    msgsrv Increment(int senderId) {
        count = count + 1;
        // println("Counter incremented to " + count);
        if (senderId == 1) {
            client1.ValueResponse(count);
        } else {
            client2.ValueResponse(count);
        }
    }

    msgsrv Decrement(int senderId) {
        count = count - 1;
        // println("Counter decremented to " + count);
        if (senderId == 1) {
            client1.ValueResponse(count);
        } else {
            client2.ValueResponse(count);
        }
    }

    msgsrv GetValue(int senderId) {
        if (senderId == 1) {
            client1.ValueResponse(count);
        } else {
            client2.ValueResponse(count);
        }
    }
}

reactiveclass Client {
    knownrebec Counter counter;

    statevars {
        int clientId;
    }

    Client(int id) {
        clientId = id;
    }

    msgsrv initial() {
        // No automatic behavior; messages are initiated from main
    }

    msgsrv ValueResponse(int value) {
        // println("Client " + clientId + " received value: " + value);
    }
}

main {
    Client counterClient1(counter): (1);
    Client counterClient2(counter): (2);
    Counter counter(counterClient1, counterClient2):();

    counter.Increment(1);
    counter.Increment(2);
    counter.GetValue(1);
}