timedreactiveclass Producer {
	knownrebecs {
		Consumer consumer;
	}
	statevars {
		// no internal state
	}

	Producer() {
		// constructor
	}

	msgsrv initial() {
		// no automatic behavior on start
	}

	// corresponds to case Produce(item)
	msgsrv ProduceMsg(char item[]) {
		// println(s"Producer: sending $item")
		consumer.ItemMsg(item);
	}
}

timedreactiveclass Consumer {
	knownrebecs {
		// no known rebecs
	}
	statevars {
		char buffer[10][20]; // simple bounded buffer: up to 10 items, each up to length 20
		int head;
		int tail;
		int size;
	}

	Consumer() {
		head = 0;
		tail = 0;
		size = 0;
	}

	msgsrv initial() {
		// no automatic behavior on start
	}

	// corresponds to case Item(data)
	msgsrv ItemMsg(char data[]) {
		// buffer.enqueue(data)
		if (size < 10) {
			int i;
			i = 0;
			while (i < 20) {
				buffer[tail][i] = data[i];
				i = i + 1;
			}
			tail = (tail + 1) % 10;
			size = size + 1;
			// println(s"Consumer: received $data, buffer size: ${buffer.size}")
		} else {
			// buffer overflow not present in original; ignore extra items
		}
	}

	// corresponds to case Consume()
	msgsrv ConsumeMsg() {
		if (size > 0) {
			// val item = buffer.dequeue()
			char item[20];
			int i;
			i = 0;
			while (i < 20) {
				item[i] = buffer[head][i];
				i = i + 1;
			}
			head = (head + 1) % 10;
			size = size - 1;
			// println(s"Consumer: consumed $item")
		} else {
			// println("Consumer: buffer empty")
		}
	}
}

main {
	// declare rebecs and knownrebecs bindings
	Consumer consumer();
	Producer producer(consumer);

	// emulate:
	// producer ! Produce("item1")
	// producer ! Produce("item2")
	// consumer ! Consume()
	producer.ProduceMsg("item1") after(0);
	producer.ProduceMsg("item2") after(0);
	consumer.ConsumeMsg() after(0);
}