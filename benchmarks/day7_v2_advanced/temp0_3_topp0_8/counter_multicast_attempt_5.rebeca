reactiveclass Counter (Client client1, Client client2) {
	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv initial() {
		// No automatic behavior on start; messages come from environment (Main).
	}

	msgsrv Increment(Client senderRef) {
		count = count + 1;
		senderRef.ValueResponse(count);
	}

	msgsrv Decrement(Client senderRef) {
		count = count - 1;
		senderRef.ValueResponse(count);
	}

	msgsrv GetValue(Client senderRef) {
		senderRef.ValueResponse(count);
	}
}

reactiveclass Client (Counter counter) {
	statevars {
		int clientId;
	}

	Client() {
		clientId = 0;
	}

	msgsrv initial() {
		// No automatic behavior; messages are initiated from Main.
	}

	msgsrv ValueResponse(int value) {
		// println("Client " + clientId + " received value: " + value);
	}
}

main {
	// Declaration of rebecs
	Counter counter(client1, client2):();
	Client client1(counter):();
	Client client2(counter):();

	// Simulation of message passing
	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}