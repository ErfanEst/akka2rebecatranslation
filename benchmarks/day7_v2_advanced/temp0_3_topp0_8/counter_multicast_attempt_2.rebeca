reactiveclass Counter {
	knownrebec Client client1;
	knownrebec Client client2;

	statevars {
		int count;
	}

	Counter(Client c1, Client c2) {
		client1 = c1;
		client2 = c2;
		count = 0;
	}

	msgsrv initial() {
		// No automatic behavior on start; messages come from environment (Main).
	}

	msgsrv Increment(Client senderRef) {
		count = count + 1;
		// println("Counter incremented to " + count);
		senderRef.ValueResponse(count);
	}

	msgsrv Decrement(Client senderRef) {
		count = count - 1;
		// println("Counter decremented to " + count);
		senderRef.ValueResponse(count);
	}

	msgsrv GetValue(Client senderRef) {
		senderRef.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebec Counter counter;

	statevars {
		int clientId;
	}

	Client(Counter c, int id) {
		counter = c;
		clientId = id;
	}

	msgsrv initial() {
		// No automatic behavior; messages are initiated from Main.
	}

	msgsrv ValueResponse(int value) {
		// println("Client " + clientId + " received value: " + value);
	}
}

main {
	Client client1(counter):(counter, 1);
	Client client2(counter):(counter, 2);
	Counter counter(client1, client2):(client1, client2);

	// Simulate:
	// counter.tell(Increment, client1)
	// counter.tell(Increment, client2)
	// counter.tell(GetValue, client1)

	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}