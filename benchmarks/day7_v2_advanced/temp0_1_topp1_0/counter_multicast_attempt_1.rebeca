timedreactiveclass Counter {
    knownrebec Client client1;
    knownrebec Client client2;

    statevars {
        int count;
    }

    Counter() {
        count = 0;
    }

    msgsrv initial() {
        // In Akka, messages are sent by specific clients as sender()
        // We simulate:
        // counter.tell(Increment, client1)
        // counter.tell(Increment, client2)
        // counter.tell(GetValue, client1)
        Increment(client1);
        Increment(client2);
        GetValue(client1);
    }

    msgsrv Increment(Client sender) {
        count = count + 1;
        // println simulated as comment: Counter incremented to count
        ValueResponse(sender, count);
    }

    msgsrv Decrement(Client sender) {
        count = count - 1;
        // println simulated as comment: Counter decremented to count
        ValueResponse(sender, count);
    }

    msgsrv GetValue(Client sender) {
        ValueResponse(sender, count);
    }

    msgsrv ValueResponse(Client sender, int value) {
        // This msgsrv is unused; added only for type completeness if needed
    }
}

timedreactiveclass Client {
    knownrebec Counter counter;

    statevars {
        int clientId;
    }

    Client(int id) {
        clientId = id;
    }

    msgsrv initial() {
        // No autonomous behavior; all communication initiated from Counter.initial
    }

    msgsrv ValueResponse(int value) {
        // println simulated as comment: "Client " clientId " received value: " value
    }
}

main {
    Counter counter(counterClient1, counterClient2);
    Client counterClient1(counter, 1);
    Client counterClient2(counter, 2);
}