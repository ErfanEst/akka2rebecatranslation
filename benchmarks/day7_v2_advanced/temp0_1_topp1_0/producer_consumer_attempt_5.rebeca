reactiveclass Producer (Consumer consumer) {
	knownrebecs {
		Consumer consumer;
	}
	statevars {
		// no internal state
	}

	Producer() {
	}

	msgsrv initial() {
		// no automatic behavior
	}

	msgsrv ProduceMsg(char item[20]) {
		consumer.ItemMsg(item);
	}
}

reactiveclass Consumer {
	knownrebecs {
	}
	statevars {
		int bufferSize;
		char buffer[10][20];
	}

	Consumer() {
		bufferSize = 0;
	}

	msgsrv initial() {
		// no automatic behavior
	}

	msgsrv ItemMsg(char data[20]) {
		if (bufferSize < 10) {
			int i;
			i = 0;
			while (i < 20) {
				buffer[bufferSize][i] = data[i];
				i = i + 1;
			}
			bufferSize = bufferSize + 1;
		}
	}

	msgsrv ConsumeMsg() {
		if (bufferSize > 0) {
			int i;
			int j;
			char item[20];

			i = 0;
			while (i < 20) {
				item[i] = buffer[0][i];
				i = i + 1;
			}

			j = 0;
			while (j < bufferSize - 1) {
				i = 0;
				while (i < 20) {
					buffer[j][i] = buffer[j + 1][i];
					i = i + 1;
				}
				j = j + 1;
			}
			bufferSize = bufferSize - 1;
		}
	}
}

main {
	Consumer c():();
	Producer p(c):(c);

	p.ProduceMsg("item1");
	p.ProduceMsg("item2");
	c.ConsumeMsg();
}