timedreactiveclass Counter {
    knownrebec Client client1;
    knownrebec Client client2;

    statevars {
        int count;
    }

    Counter() {
        count = 0;
    }

    msgsrv initial() {
        // Simulate:
        // counter.tell(Increment, client1)
        // counter.tell(Increment, client2)
        // counter.tell(GetValue, client1)
        this.Increment(client1);
        this.Increment(client2);
        this.GetValue(client1);
    }

    msgsrv Increment(Client sender) {
        count = count + 1;
        // println("Counter incremented to " + count);
        sender.ValueResponse(count);
    }

    msgsrv Decrement(Client sender) {
        count = count - 1;
        // println("Counter decremented to " + count);
        sender.ValueResponse(count);
    }

    msgsrv GetValue(Client sender) {
        sender.ValueResponse(count);
    }
}

timedreactiveclass Client {
    knownrebec Counter counter;

    statevars {
        int clientId;
    }

    Client(int id) {
        clientId = id;
    }

    msgsrv initial() {
        // No initial behavior; interactions are started from Counter.initial
    }

    msgsrv ValueResponse(int value) {
        // println("Client " + clientId + " received value: " + value);
    }
}

timedmain {
    Counter counter(counterClient1, counterClient2):();
    Client counterClient1(counter):(1);
    Client counterClient2(counter):(2);
}