reactiveclass Ping(pong: Pong) {
    knownrebecs { Pong pong; }
    statevars { int count; }

    Ping() {
        count = 0;
    }

    msgsrv startMessage() {
        println("Ping started the game!");
        pong.pingMessage();
    }

    msgsrv pongMessage() {
        count = count + 1;
        println("Ping received pong #" + count);
        if (count >= 10) {
            pong.stopMessage();
            println("Ping stopped");
            self.stop();
        } else {
            pong.pingMessage();
        }
    }

    msgsrv stopMessage() {
        // not used in Ping, defined for completeness
    }
}

reactiveclass Pong {
    knownrebecs { }
    statevars { }

    Pong() {
    }

    msgsrv pingMessage() {
        println("Pong received ping");
        sender.pongMessage();
    }

    msgsrv stopMessage() {
        println("Pong stopped");
        self.stop();
    }

    msgsrv startMessage() {
        // not used in Pong, defined for completeness
    }
}

main {
    Pong pong();
    Ping ping(pong): ( );
    ping.startMessage();
}