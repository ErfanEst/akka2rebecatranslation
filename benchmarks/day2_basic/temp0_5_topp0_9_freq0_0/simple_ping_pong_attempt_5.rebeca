reactiveclass Ping {
	knownrebecs {
		Pong pong;
	}
	statevars {
		int count;
	}

	Ping(Pong pong) {
		self.pong = pong;
		count = 0;
	}

	msgsrv StartMessage() {
		// Ping started the game!
		PingMessage();
	}

	msgsrv PingMessage() {
		// Not used in Ping
	}

	msgsrv PongMessage() {
		count = count + 1;
		// Ping received pong #count from pong
		if (count >= 10) {
			pong.StopMessage();
			// Ping stopped
			self.stop();
		} else {
			pong.PingMessage();
		}
	}

	msgsrv StopMessage() {
		// Not used in Ping
	}
}

reactiveclass Pong {
	knownrebecs {
	}
	statevars {
	}

	Pong() {
	}

	msgsrv StartMessage() {
		// Not used in Pong
	}

	msgsrv PingMessage() {
		// Pong received ping from ping
		self.PongMessage();
	}

	msgsrv PongMessage() {
		// Not used in Pong
	}

	msgsrv StopMessage() {
		// Pong stopped
		self.stop();
	}
}

main {
	Pong pong():();
	Ping ping(pong):(pong);

	ping.StartMessage();
}