reactiveclass Ping(pongKnown) {
	knownrebecs {
		Pong pongKnown;
	}
	statevars {
		int count;
	}
	msgsrv initial() {
		count = 0;
		startMessage();
	}
	msgsrv startMessage() {
		pongKnown.pingMessage();
	}
	msgsrv pongMessage() {
		count = count + 1;
		if (count >= 10) {
			pongKnown.stopMessage();
			self.stop();
		} else {
			pongKnown.pingMessage();
		}
	}
	msgsrv stop() {
		// no-op
	}
}

reactiveclass Pong() {
	knownrebecs {
		// no known rebecs
	}
	statevars {
		// no state variables
	}
	msgsrv initial() {
	}
	msgsrv pingMessage() {
		sender.pongMessage();
	}
	msgsrv stopMessage() {
		self.stop();
	}
	msgsrv stop() {
		// no-op
	}
}

main {
	Pong pong() : ();
	Ping ping(pong) : (pong);
}