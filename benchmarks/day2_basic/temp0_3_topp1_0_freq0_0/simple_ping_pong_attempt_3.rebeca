reactiveclass Ping {
	knownrebecs {
		Pong pong;
	}
	statevars {
		int count;
	}

	Ping(Pong pong) {
		self.pong = pong;
		count = 0;
	}

	msgsrv startMessage() {
		pong.pingMessage();
	}

	msgsrv pongMessage() {
		count = count + 1;
		if (count >= 10) {
			pong.stopMessage();
			self.stop();
		} else {
			pong.pingMessage();
		}
	}

	msgsrv stop() {
		// simulate context.stop(self) - empty in Rebeca
	}
}

reactiveclass Pong {
	knownrebecs {
		Ping ping;
	}

	Pong(Ping ping) {
		self.ping = ping;
	}

	msgsrv pingMessage() {
		ping.pongMessage();
	}

	msgsrv stopMessage() {
		self.stop();
	}

	msgsrv stop() {
		// simulate context.stop(self) - empty in Rebeca
	}
}

main {
	Ping ping(pong):();
	Pong pong(ping):();

	ping.startMessage();
}