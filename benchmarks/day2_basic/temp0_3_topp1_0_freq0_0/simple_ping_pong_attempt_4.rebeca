reactiveclass Ping {
	knownrebecs {
		Pong pong;
	}
	statevars {
		int count;
	}

	Msgserv startMessage() {
		pong.pingMessage();
	}

	Msgserv pongMessage() {
		count = count + 1;
		if (count >= 10) {
			pong.stopMessage();
			self.stop();
		} else {
			pong.pingMessage();
		}
	}

	Msgserv stop() {
		// simulate context.stop(self) - empty in Rebeca
	}
}

reactiveclass Pong {
	knownrebecs {
		Ping ping;
	}

	Msgserv pingMessage() {
		ping.pongMessage();
	}

	Msgserv stopMessage() {
		self.stop();
	}

	Msgserv stop() {
		// simulate context.stop(self) - empty in Rebeca
	}
}

main {
	Pong pong():();
	Ping ping(pong):();

	ping.startMessage();
}