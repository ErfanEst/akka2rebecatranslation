reactiveclass Ping {
	knownrebecs {
		Pong pong;
	}

	statevars {
		int count;
	}

	Ping(Pong p) {
		pong = p;
		count = 0;
	}

	msgsrv StartMessage() {
		print("Ping started the game!");
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		print("Ping received pong #");
		print(count);
		if (count >= 10) {
			pong.StopMessage();
			print("Ping stopped");
			self.stop();
		} else {
			pong.PingMessage();
		}
	}
}

reactiveclass Pong {
	knownrebecs {
	}

	statevars {
	}

	Pong() {
	}

	msgsrv PingMessage() {
		print("Pong received ping");
		sender.PongMessage();
	}

	msgsrv StopMessage() {
		print("Pong stopped");
		self.stop();
	}
}

main {
	Pong pong():();
	Ping ping(pong):();

	ping.StartMessage();
}