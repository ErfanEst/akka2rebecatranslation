reactiveclass Ping(5) {
	knownrebecs {
		Pong pong;
	}

	statevars {
		int count;
	}

	Ping() {
		count = 0;
		self.initial();
	}

	msgsrv initial() {
		pong.pingMessage();
	}

	msgsrv pongMessage() {
		count = count + 1;
		if (count >= 10) {
			((Pong)sender).stopMessage();
		} else {
			((Pong)sender).pingMessage();
		}
	}
}

reactiveclass Pong(5) {
	knownrebecs {
	}

	statevars {
	}

	Pong() {
	}

	msgsrv pingMessage() {
		((Ping)sender).pongMessage();
	}

	msgsrv stopMessage() {
		// no further behavior; actor would stop in Akka
	}
}

main {
	Pong pong():();
	Ping ping(pong):();
}