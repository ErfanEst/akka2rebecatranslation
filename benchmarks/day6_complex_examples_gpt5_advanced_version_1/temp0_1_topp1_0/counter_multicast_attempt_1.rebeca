reactiveclass CounterMulticast_Counter(5) {
	statevars {
		int count;
	}

	msgsrv initial() {
		// no initialization behavior specified
	}

	msgsrv Increment() {
		count = count + 1;
		// println removed
		((CounterMulticast_Client)sender).ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		// println removed
		((CounterMulticast_Client)sender).ValueResponse(count);
	}

	msgsrv GetValue() {
		((CounterMulticast_Client)sender).ValueResponse(count);
	}
}

reactiveclass CounterMulticast_Client(5) {
	knownrebecs {
		CounterMulticast_Counter counter;
	}

	statevars {
		int clientId;
	}

	msgsrv initial(int _clientId) {
		clientId = _clientId;
		// no initial requests from client in original main
	}

	msgsrv ValueResponse(int value) {
		// println removed
	}
}

main {
	CounterMulticast_Counter counter() :();
	CounterMulticast_Client client1(counter) :(1);
	CounterMulticast_Client client2(counter) :(2);

	// Simulating:
	// counter.tell(Increment, client1)
	// counter.tell(Increment, client2)
	// counter.tell(GetValue, client1)
	counter.Increment() from(client1);
	counter.Increment() from(client2);
	counter.GetValue() from(client1);
}