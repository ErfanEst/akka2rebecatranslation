reactiveclass CounterMulticastSystem(5) {
	knownrebecs {
		Counter counter;
		Client client1;
		Client client2;
	}

	statevars {
	}

	CounterMulticastSystem() {
		self.initial();
	}

	msgsrv initial() {
		// Simulate:
		// counter.tell(Increment, client1)
		counter.increment_client1();

		// counter.tell(Increment, client2)
		counter.increment_client2();

		// counter.tell(GetValue, client1)
		counter.getValue_client1();
	}
}

reactiveclass Counter(5) {
	knownrebecs {
		Client client1;
		Client client2;
	}

	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	// Separate msgsrv per logical sender (client1 / client2)
	msgsrv increment_client1() {
		count = count + 1;
		client1.valueResponse(count);
	}

	msgsrv increment_client2() {
		count = count + 1;
		client2.valueResponse(count);
	}

	msgsrv decrement_client1() {
		count = count - 1;
		client1.valueResponse(count);
	}

	msgsrv decrement_client2() {
		count = count - 1;
		client2.valueResponse(count);
	}

	msgsrv getValue_client1() {
		client1.valueResponse(count);
	}

	msgsrv getValue_client2() {
		client2.valueResponse(count);
	}
}

reactiveclass Client(5) {
	knownrebecs {
		Counter counter;
	}

	statevars {
		int clientId;
	}

	Client(int clientIdArg) {
		clientId = clientIdArg;
	}

	msgsrv valueResponse(int value) {
		// Original println removed; could store value if needed
	}
}

main {
	Counter counter(client1, client2):();
	Client client1(counter):(1);
	Client client2(counter):(2);
	CounterMulticastSystem system(counter, client1, client2):();
}