reactiveclass CounterMulticast_Counter(5) {
	statevars {
		int count;
	}

	knownrebecs { }

	CounterMulticast_Counter() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		((CounterMulticast_Client)sender).ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		((CounterMulticast_Client)sender).ValueResponse(count);
	}

	msgsrv GetValue() {
		((CounterMulticast_Client)sender).ValueResponse(count);
	}
}

reactiveclass CounterMulticast_Client(5) {
	statevars {
		int clientId;
		CounterMulticast_Counter counter;
	}

	knownrebecs {
		CounterMulticast_Counter c;
	}

	CounterMulticast_Client(CounterMulticast_Counter c, int id) {
		counter = c;
		clientId = id;
	}

	msgsrv initial() {
	}

	msgsrv ValueResponse(int value) {
	}
}

main {
	CounterMulticast_Counter counter():();
	CounterMulticast_Client client1(counter):(1);
	CounterMulticast_Client client2(counter):(2);

	client1.Increment() to(counter);
	client2.Increment() to(counter);
	client1.GetValue() to(counter);
}