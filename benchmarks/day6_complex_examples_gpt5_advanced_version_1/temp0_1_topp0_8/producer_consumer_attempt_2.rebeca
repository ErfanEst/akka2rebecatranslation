reactiveclass ProducerConsumerSystem(10) {
}

reactiveclass Producer(10) {
	knownrebecs { 
		Consumer consumer;
	}
	statevars {
		// no data state variables needed
	}

	Producer() {
		self.initial();
	}

	msgsrv initial() {
		self.produce_item1();
		self.produce_item2();
	}

	msgsrv produce_item1() {
		consumer.item(1);
	}

	msgsrv produce_item2() {
		consumer.item(2);
	}
}

reactiveclass Consumer(10) {
	knownrebecs {
		// no known rebecs
	}
	statevars {
		int buffer[10];
		int head;
		int tail;
		int size;
	}

	Consumer() {
		head = 0;
		tail = 0;
		size = 0;
	}

	msgsrv item(int data) {
		if (size < 10) {
			buffer[tail] = data;
			tail = (tail + 1) % 10;
			size = size + 1;
		} else {
			// buffer full, item is dropped
		}
	}

	msgsrv consume() {
		if (size > 0) {
			int item;
			item = buffer[head];
			head = (head + 1) % 10;
			size = size - 1;
			// item consumed, no output
		} else {
			// buffer empty, no output
		}
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();
	ProducerConsumerSystem system():();
	consumer.consume();
}