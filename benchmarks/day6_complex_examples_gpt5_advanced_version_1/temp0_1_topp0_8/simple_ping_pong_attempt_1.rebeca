reactiveclass Ping(10) {
	knownrebecs {
		Pong pong;
	}
	statevars {
		int count;
		boolean active;
	}

	Ping() {
		count = 0;
		active = true;
		self.start();
	}

	msgsrv start() {
		if (active) {
			pong.pingMessage();
		}
	}

	msgsrv pongMessage() {
		if (active) {
			count = count + 1;
			if (count >= 10) {
				((Pong)sender).stopMessage();
				active = false;
			} else {
				((Pong)sender).pingMessage();
			}
		}
	}
}

reactiveclass Pong(10) {
	knownrebecs {
		Ping ping;
	}
	statevars {
		boolean active;
	}

	Pong() {
		active = true;
	}

	msgsrv pingMessage() {
		if (active) {
			((Ping)sender).pongMessage();
		}
	}

	msgsrv stopMessage() {
		if (active) {
			active = false;
		}
	}
}

main {
	Ping ping(pong):();
	Pong pong(ping):();
}