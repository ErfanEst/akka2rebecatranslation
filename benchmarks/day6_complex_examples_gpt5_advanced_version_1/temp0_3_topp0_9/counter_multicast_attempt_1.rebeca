reactiveclass CounterMulticast_Counter(10) {
	statevars {
		int count;
	}

	// no knownrebecs

	CounterMulticast_Counter() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		((CounterMulticast_Client)sender).ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		((CounterMulticast_Client)sender).ValueResponse(count);
	}

	msgsrv GetValue() {
		((CounterMulticast_Client)sender).ValueResponse(count);
	}
}

reactiveclass CounterMulticast_Client(10) {
	knownrebecs {
		CounterMulticast_Counter counter;
	}
	statevars {
		int clientId;
		int lastValue;
	}

	CounterMulticast_Client(int id) {
		clientId = id;
		lastValue = 0;
		self.initial();
	}

	msgsrv initial() {
		if (clientId == 1) {
			counter.Increment();
		} else {
			if (clientId == 2) {
				counter.Increment();
			}
		}
	}

	msgsrv ValueResponse(int value) {
		lastValue = value;
	}
}

main {
	CounterMulticast_Counter counter():();
	CounterMulticast_Client client1(counter):(1);
	CounterMulticast_Client client2(counter):(2);

	counter.GetValue() after(1);
}