reactiveclass Producer(5) {
	knownrebecs {
		Consumer consumer;
	}
	statevars {
	}
	Producer() {
		self.initial();
	}
	msgsrv initial() {
		char item1[6];
		char item2[6];

		item1[0] = 'i';
		item1[1] = 't';
		item1[2] = 'e';
		item1[3] = 'm';
		item1[4] = '1';
		item1[5] = '\0';

		item2[0] = 'i';
		item2[1] = 't';
		item2[2] = 'e';
		item2[3] = 'm';
		item2[4] = '2';
		item2[5] = '\0';

		self.produce(item1);
		self.produce(item2);
		consumer.consume();
	}
	msgsrv produce(char item[6]) {
		consumer.item(item);
	}
}

reactiveclass Consumer(5) {
	knownrebecs {
	}
	statevars {
		int head;
		int tail;
		int size;
		char buffer[10][6];
	}
	Consumer() {
		head = 0;
		tail = 0;
		size = 0;
	}
	msgsrv item(char data[6]) {
		int i;
		if (size < 10) {
			i = 0;
			while (i < 6) {
				buffer[tail][i] = data[i];
				i = i + 1;
			}
			tail = (tail + 1) % 10;
			size = size + 1;
		} else {
			// buffer full, item is dropped
		}
	}
	msgsrv consume() {
		if (size > 0) {
			int i;
			char item[6];
			i = 0;
			while (i < 6) {
				item[i] = buffer[head][i];
				i = i + 1;
			}
			head = (head + 1) % 10;
			size = size - 1;
		} else {
			// buffer empty
		}
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();
}