reactiveclass Producer(10) {
	knownrebecs {
		Consumer consumer;
	}
	statevars {
		// no state variables
	}

	Producer() {
		self.initial();
	}

	msgsrv initial() {
		// no automatic behavior on start
	}

	msgsrv ProduceMsg(int itemId) {
		// itemId represents different items; no strings in Rebeca core
		consumer.ItemMsg(itemId);
	}
}

reactiveclass Consumer(10) {
	knownrebecs {
		// no known rebecs
	}
	statevars {
		int buffer[10];
		int head;
		int tail;
		int size;
	}

	Consumer() {
		head = 0;
		tail = 0;
		size = 0;
		self.initial();
	}

	msgsrv initial() {
		// simulate: producer ! Produce("item1"); producer ! Produce("item2"); consumer ! Consume()
		// item1 -> 1, item2 -> 2
		// we assume there is exactly one producer known in main that will call these
		// Since main cannot send, we model the initial scenario directly here:
		buffer[0] = 1;
		tail = (tail + 1) % 10;
		size = size + 1;

		buffer[tail] = 2;
		tail = (tail + 1) % 10;
		size = size + 1;

		self.ConsumeMsg();
	}

	msgsrv ItemMsg(int data) {
		if (size < 10) {
			buffer[tail] = data;
			tail = (tail + 1) % 10;
			size = size + 1;
		} else {
			// buffer overflow ignored
		}
	}

	msgsrv ConsumeMsg() {
		if (size > 0) {
			int item;
			item = buffer[head];
			head = (head + 1) % 10;
			size = size - 1;
			// consumed item stored in 'item'
		} else {
			// buffer empty, nothing to consume
		}
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();
}