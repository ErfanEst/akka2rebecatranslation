reactiveclass PingPing(bufferSize) {
}

reactiveclass Ping(bufferSize) {
	knownrebecs { 
		Pong pong;
	}
	statevars {
		int count;
		boolean active;
	}

	Ping(Pong pongRef) {
		pong = pongRef;
		count = 0;
		active = true;
		self.initial();
	}

	msgsrv initial() {
		if (active) {
			pong.pingMessage();
		}
	}

	msgsrv startMessage() {
		// Not used in this translation; start is done in constructor via initial
	}

	msgsrv pongMessage() {
		if (!active) {
		} else {
			count = count + 1;
			if (count >= 10) {
				((Pong)sender).stopMessage();
				active = false;
			} else {
				((Pong)sender).pingMessage();
			}
		}
	}
}

reactiveclass Pong(bufferSize) {
	statevars {
		boolean active;
	}

	Pong() {
		active = true;
	}

	msgsrv pingMessage() {
		if (active) {
			((Ping)sender).pongMessage();
		}
	}

	msgsrv stopMessage() {
		active = false;
	}
}

main {
	Pong pong():();
	Ping ping(pong):();
	PingPing dummy():();
}