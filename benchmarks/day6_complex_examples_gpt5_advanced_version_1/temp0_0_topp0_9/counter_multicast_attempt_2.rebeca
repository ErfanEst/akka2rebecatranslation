reactiveclass CounterMulticast_Counter(10) {
	statevars {
		int count;
	}

	knownrebecs {
		CounterMulticast_Client client1;
		CounterMulticast_Client client2;
	}

	CounterMulticast_Counter() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		((CounterMulticast_Client)sender).ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		((CounterMulticast_Client)sender).ValueResponse(count);
	}

	msgsrv GetValue() {
		((CounterMulticast_Client)sender).ValueResponse(count);
	}
}

reactiveclass CounterMulticast_Client(10) {
	statevars {
		int clientId;
	}

	knownrebecs {
		CounterMulticast_Counter counter;
	}

	CounterMulticast_Client(int clientId) {
		clientId = clientId;
	}

	msgsrv initial() {
		counter.Increment() with (this);
		counter.Increment() with (this);
		counter.GetValue() with (this);
	}

	msgsrv ValueResponse(int value) {
		// original Akka: println("Client " + clientId + " received value: " + value);
	}
}

main {
	CounterMulticast_Counter counter(client1, client2):();
	CounterMulticast_Client client1(counter):(1);
	CounterMulticast_Client client2(counter):(2);
}