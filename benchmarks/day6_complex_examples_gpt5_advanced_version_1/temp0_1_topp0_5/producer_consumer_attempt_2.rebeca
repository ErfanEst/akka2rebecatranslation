reactiveclass Producer(10) {
	knownrebecs {
		Consumer consumer;
	}

	statevars {
	}

	Producer() {
		self.initial();
	}

	msgsrv initial() {
		// No automatic behavior on start
	}

	msgsrv ProduceMsg(int itemId) {
		consumer.ItemMsg(itemId);
	}
}

reactiveclass Consumer(10) {
	knownrebecs {
	}

	statevars {
		int buffer[10];
		int head;
		int tail;
		int size;
	}

	Consumer() {
		head = 0;
		tail = 0;
		size = 0;
	}

	msgsrv ItemMsg(int dataId) {
		if (size < 10) {
			buffer[tail] = dataId;
			tail = (tail + 1) % 10;
			size = size + 1;
		} else {
			// buffer full, item is dropped
		}
	}

	msgsrv ConsumeMsg() {
		if (size > 0) {
			int itemId;
			itemId = buffer[head];
			head = (head + 1) % 10;
			size = size - 1;
			// consumed itemId
		} else {
			// buffer empty
		}
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();

	producer.ProduceMsg(1);
	producer.ProduceMsg(2);
	consumer.ConsumeMsg();
}