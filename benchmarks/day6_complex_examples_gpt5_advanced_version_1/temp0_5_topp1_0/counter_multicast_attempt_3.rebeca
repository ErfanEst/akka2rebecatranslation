reactiveclass CounterClientSystem(10) {
	knownrebecs {
	}
	statevars {
	}

	CounterClientSystem() {
	}
}

reactiveclass CounterClient(10) {
	knownrebecs { 
		Counter counter;
	}
	statevars {
		int clientId;
		int lastReceivedValue;
	}

	CounterClient(int clientIdArg) {
		clientId = clientIdArg;
	}

	msgsrv initial() {
		// No initial behavior
	}

	msgsrv valueResponse(int value) {
		lastReceivedValue = value;
	}
}

reactiveclass Counter(10) {
	knownrebecs {
		CounterClient client1;
		CounterClient client2;
	}
	statevars {
		int count;
		int lastSentValueClient1;
		int lastSentValueClient2;
	}

	Counter() {
		count = 0;
	}

	msgsrv initial() {
		self.increment(1) after(1);
		self.increment(2) after(2);
		self.getValue(1) after(3);
		self.getValue(2) after(3);
	}

	msgsrv increment(int clientId) {
		count = count + 1;
		if (clientId == 1) {
			lastSentValueClient1 = count;
			client1.valueResponse(count);
		} else {
			lastSentValueClient2 = count;
			client2.valueResponse(count);
		}
	}

	msgsrv decrement(int clientId) {
		count = count - 1;
		if (clientId == 1) {
			lastSentValueClient1 = count;
			client1.valueResponse(count);
		} else {
			lastSentValueClient2 = count;
			client2.valueResponse(count);
		}
	}

	msgsrv getValue(int clientId) {
		int current = count;
		if (clientId == 1) {
			lastSentValueClient1 = current;
			client1.valueResponse(current);
		} else {
			lastSentValueClient2 = current;
			client2.valueResponse(current);
		}
	}
}

main {
	CounterClientSystem system() :();

	CounterClient client1(counter) :(1);
	CounterClient client2(counter) :(2);
	Counter counter(client1, client2) :();

	counter.initial();
	client1.initial();
	client2.initial();
}