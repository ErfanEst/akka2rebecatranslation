reactiveclass CounterClientSystem(10) {
	knownrebecs {
	}
	statevars {
	}

	CounterClientSystem() {
	}
}

reactiveclass CounterClient(10) {
	knownrebecs { 
		Counter counter;
	}
	statevars {
		int clientId;
		int lastReceivedValue;
	}

	CounterClient(int clientIdArg) {
		clientId = clientIdArg;
	}

	msgsrv initial() {
	}

	msgsrv valueResponse(int value) {
		lastReceivedValue = value;
	}
}

reactiveclass Counter(10) {
	knownrebecs {
	}
	statevars {
		int count;
		int lastSentValueClient1;
		int lastSentValueClient2;
	}

	Counter() {
		count = 0;
	}

	msgsrv initial() {
		self.increment() after(1);
		self.increment() after(2);
		self.getValue() after(3);
	}

	msgsrv increment() {
		count = count + 1;
		if (((CounterClient)sender).clientId == 1) {
			lastSentValueClient1 = count;
		} else {
			lastSentValueClient2 = count;
		}
		((CounterClient)sender).valueResponse(count);
	}

	msgsrv decrement() {
		count = count - 1;
		if (((CounterClient)sender).clientId == 1) {
			lastSentValueClient1 = count;
		} else {
			lastSentValueClient2 = count;
		}
		((CounterClient)sender).valueResponse(count);
	}

	msgsrv getValue() {
		int current = count;
		if (((CounterClient)sender).clientId == 1) {
			lastSentValueClient1 = current;
		} else {
			lastSentValueClient2 = current;
		}
		((CounterClient)sender).valueResponse(current);
	}
}

main {
	Counter counter() :();
	CounterClient client1(counter) :(1);
	CounterClient client2(counter) :(2);

	counter.initial();
	client1.initial();
	client2.initial();
}