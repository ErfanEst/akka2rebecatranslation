reactiveclass Producer(5) {
	knownrebecs {
		Consumer consumer;
	}

	statevars {
		// no data state variables
	}

	Producer() {
		self.initial();
	}

	msgsrv initial() {
		String s1;
		String s2;
		s1 = "item1";
		s2 = "item2";
		self.produce(s1);
		self.produce(s2);
		consumer.consume();
	}

	msgsrv produce(String item) {
		consumer.item(item);
	}
}

reactiveclass Consumer(5) {
	knownrebecs {
		// no known rebecs
	}

	statevars {
		int bufferSize;
		String buffer[10];
		int head;
		int tail;
	}

	Consumer() {
		bufferSize = 0;
		head = 0;
		tail = 0;
	}

	msgsrv item(String data) {
		if (bufferSize < 10) {
			buffer[tail] = data;
			tail = (tail + 1) % 10;
			bufferSize = bufferSize + 1;
		} else {
			// buffer full, item dropped
		}
	}

	msgsrv consume() {
		if (bufferSize > 0) {
			String item;
			item = buffer[head];
			head = (head + 1) % 10;
			bufferSize = bufferSize - 1;
		} else {
			// buffer empty
		}
	}
}

main {
	Consumer consumer() : ();
	Producer producer(consumer) : ();
}