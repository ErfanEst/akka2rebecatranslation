reactiveclass CounterClientSystem {
}

reactiveclass CounterClient(bufferSize) {
	knownrebecs { 
		Counter counter;
	}
	statevars {
		int clientId;
		int lastReceivedValue;
	}

	CounterClient(int clientIdArg) {
		clientId = clientIdArg;
	}

	msgsrv valueResponse(int value) {
		lastReceivedValue = value;
	}
}

reactiveclass Counter(bufferSize) {
	knownrebecs {
	}
	statevars {
		int count;
		int lastSentValueClient1;
		int lastSentValueClient2;
	}

	Counter() {
		count = 0;
	}

	msgsrv increment() {
		count = count + 1;
		if (((CounterClient)sender).clientId == 1) {
			lastSentValueClient1 = count;
		} else {
			lastSentValueClient2 = count;
		}
		((CounterClient)sender).valueResponse(count);
	}

	msgsrv decrement() {
		count = count - 1;
		if (((CounterClient)sender).clientId == 1) {
			lastSentValueClient1 = count;
		} else {
			lastSentValueClient2 = count;
		}
		((CounterClient)sender).valueResponse(count);
	}

	msgsrv getValue() {
		int current = count;
		if (((CounterClient)sender).clientId == 1) {
			lastSentValueClient1 = current;
		} else {
			lastSentValueClient2 = current;
		}
		((CounterClient)sender).valueResponse(current);
	}
}

main {
	Counter counter() :();
	CounterClient client1(counter) :(1);
	CounterClient client2(counter) :(2);

	// Simulate:
	// counter.tell(Increment, client1)
	// counter.tell(Increment, client2)
	// counter.tell(GetValue, client1)
	counter.increment() after(1);
	counter.increment() after(2);
	counter.getValue() after(3);
}