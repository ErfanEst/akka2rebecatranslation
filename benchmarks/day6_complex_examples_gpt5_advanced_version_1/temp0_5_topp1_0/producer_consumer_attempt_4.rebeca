reactiveclass Producer(5) {
	knownrebecs {
		Consumer consumer;
	}

	statevars {
		// no data state variables
	}

	Producer() {
		self.initial();
	}

	msgsrv initial() {
		byte s1[6];
		byte s2[6];

		s1[0] = 'i'; s1[1] = 't'; s1[2] = 'e'; s1[3] = 'm'; s1[4] = '1'; s1[5] = '\0';
		s2[0] = 'i'; s2[1] = 't'; s2[2] = 'e'; s2[3] = 'm'; s2[4] = '2'; s2[5] = '\0';

		self.produce(s1);
		self.produce(s2);
		consumer.consume();
	}

	msgsrv produce(byte item[ ]) {
		consumer.item(item);
	}
}

reactiveclass Consumer(5) {
	knownrebecs {
		// no known rebecs
	}

	statevars {
		int bufferSize;
		byte buffer[10][6];
		int head;
		int tail;
	}

	Consumer() {
		bufferSize = 0;
		head = 0;
		tail = 0;
	}

	msgsrv item(byte data[ ]) {
		if (bufferSize < 10) {
			int i;
			i = 0;
			while (i < 6) {
				buffer[tail][i] = data[i];
				i = i + 1;
			}
			tail = (tail + 1) % 10;
			bufferSize = bufferSize + 1;
		} else {
			skip;
		}
	}

	msgsrv consume() {
		if (bufferSize > 0) {
			byte item[6];
			int i;
			i = 0;
			while (i < 6) {
				item[i] = buffer[head][i];
				i = i + 1;
			}
			head = (head + 1) % 10;
			bufferSize = bufferSize - 1;
		} else {
			skip;
		}
	}
}

main {
	Consumer consumer() :();
	Producer producer(consumer) :();
}