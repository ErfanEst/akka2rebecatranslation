reactiveclass Producer(5) {
	knownrebecs {
		Consumer consumer;
	}

	statevars {
		// no data state variables
	}

	// constructor with knownrebecs only
	Producer() {
		self.initial();
	}

	msgsrv initial() {
		// send initial produce messages as in main
		self.produce("item1");
		self.produce("item2");
		consumer.consume();
	}

	msgsrv produce(char item[20]) {
		// Producer: sending item
		consumer.item(item);
	}
}

reactiveclass Consumer(5) {
	knownrebecs {
		// no known rebecs
	}

	statevars {
		int bufferSize;
		char buffer[10][20]; // simple fixed-size buffer of up to 10 items
	}

	Consumer() {
		bufferSize = 0;
	}

	msgsrv item(char data[20]) {
		// enqueue data if there is space
		if (bufferSize < 10) {
			int i;
			i = 0;
			while (i < 20) {
				buffer[bufferSize][i] = data[i];
				i = i + 1;
			}
			bufferSize = bufferSize + 1;
			// Consumer: received data, buffer size updated
		} else {
			// buffer full, item dropped
		}
	}

	msgsrv consume() {
		if (bufferSize > 0) {
			// dequeue first item by shifting
			int i;
			int j;
			i = 0;
			while (i < bufferSize - 1) {
				j = 0;
				while (j < 20) {
					buffer[i][j] = buffer[i + 1][j];
					j = j + 1;
				}
				i = i + 1;
			}
			bufferSize = bufferSize - 1;
			// Consumer: consumed one item
		} else {
			// Consumer: buffer empty
		}
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();
}