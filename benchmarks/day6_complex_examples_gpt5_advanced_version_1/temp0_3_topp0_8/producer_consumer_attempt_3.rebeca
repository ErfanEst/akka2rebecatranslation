reactiveclass ProducerConsumerSystem(1) {
	knownrebecs {
		Producer producer;
		Consumer consumer;
	}
	statevars {
	}
	ProducerConsumerSystem() {
		self.initial();
	}
	msgsrv initial() {
		producer.produceMsg(1);
		producer.produceMsg(2);
		consumer.consumeMsg();
	}
}

reactiveclass Producer(1) {
	knownrebecs { 
		Consumer consumer;
	}
	statevars {
	}
	Producer() {
	}
	msgsrv initial() {
	}
	msgsrv produceMsg(int itemId) {
		consumer.itemMsg(itemId);
	}
}

reactiveclass Consumer(1) {
	knownrebecs {
	}
	statevars {
		int buffer[10];
		int head;
		int tail;
		int size;
	}
	Consumer() {
		head = 0;
		tail = 0;
		size = 0;
	}
	msgsrv initial() {
	}
	msgsrv itemMsg(int dataId) {
		if (size < 10) {
			buffer[tail] = dataId;
			tail = (tail + 1) % 10;
			size = size + 1;
		} else {
		}
	}
	msgsrv consumeMsg() {
		if (size > 0) {
			int itemId;
			itemId = buffer[head];
			head = (head + 1) % 10;
			size = size - 1;
		} else {
		}
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();
	ProducerConsumerSystem system(producer, consumer):();
}