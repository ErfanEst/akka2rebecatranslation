reactiveclass ProducerConsumerSystem(1) {
}

reactiveclass Producer(1) {
	knownrebecs { 
		Consumer consumer;
	}
	statevars {
	}
	Producer() {
	}
	msgsrv initial() {
		// No automatic behavior
	}
	msgsrv ProduceMsg(int itemId) {
		// In place of sending a String item, we use an integer identifier
		consumer.ItemMsg(itemId);
	}
}

reactiveclass Consumer(1) {
	knownrebecs {
	}
	statevars {
		int buffer[10];
		int head;
		int tail;
		int size;
	}
	Consumer() {
		head = 0;
		tail = 0;
		size = 0;
	}
	msgsrv initial() {
		// No automatic behavior
	}
	msgsrv ItemMsg(int dataId) {
		// enqueue dataId into circular buffer if not full
		if (size < 10) {
			buffer[tail] = dataId;
			tail = (tail + 1) % 10;
			size = size + 1;
		} else {
			// buffer full, drop item (no-op)
		}
	}
	msgsrv ConsumeMsg() {
		if (size > 0) {
			int itemId;
			itemId = buffer[head];
			head = (head + 1) % 10;
			size = size - 1;
			// consumed itemId (no I/O)
		} else {
			// buffer empty (no I/O)
		}
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();
	ProducerConsumerSystem system():();

	producer.ProduceMsg(1);
	producer.ProduceMsg(2);
	consumer.ConsumeMsg();
}