reactiveclass Producer(5) {
	knownrebecs {
		Consumer consumer;
	}
	statevars {
		// no data state variables needed
		char item1[10];
		char item2[10];
	}

	Producer() {
		// initialize items as character arrays
		item1[0] = 'i'; item1[1] = 't'; item1[2] = 'e'; item1[3] = 'm'; item1[4] = '1';
		item2[0] = 'i'; item2[1] = 't'; item2[2] = 'e'; item2[3] = 'm'; item2[4] = '2';
		self.initial();
	}

	msgsrv initial() {
		self.produceMsg(item1);
		self.produceMsg(item2);
		consumer.consumeMsg();
	}

	msgsrv produceMsg(char item[10]) {
		consumer.itemMsg(item);
	}
}

reactiveclass Consumer(5) {
	knownrebecs {
		// no known rebecs
	}
	statevars {
		char buffer[10][10];
		int head;
		int tail;
		int size;
	}

	Consumer() {
		head = 0;
		tail = 0;
		size = 0;
	}

	msgsrv itemMsg(char data[10]) {
		if (size < 10) {
			int i;
			i = 0;
			while (i < 10) {
				buffer[tail][i] = data[i];
				i = i + 1;
			}
			tail = (tail + 1) % 10;
			size = size + 1;
		} else {
			// buffer full, item dropped (no-op)
		}
	}

	msgsrv consumeMsg() {
		if (size > 0) {
			char item[10];
			int i;
			i = 0;
			while (i < 10) {
				item[i] = buffer[head][i];
				i = i + 1;
			}
			head = (head + 1) % 10;
			size = size - 1;
			// item consumed (no-op)
		} else {
			// buffer empty (no-op)
		}
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();
}