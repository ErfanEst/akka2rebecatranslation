reactiveclass Producer(5) {
	knownrebecs {
		Consumer consumer;
	}
	statevars {
		// items stored as 1D arrays; we conceptually use first 5 chars
		char item1[10];
		char item2[10];
	}

	Producer() {
		item1[0] = 'i'; item1[1] = 't'; item1[2] = 'e'; item1[3] = 'm'; item1[4] = '1';
		item2[0] = 'i'; item2[1] = 't'; item2[2] = 'e'; item2[3] = 'm'; item2[4] = '2';
		self.initial();
	}

	msgsrv initial() {
		self.produceMsg(1);
		self.produceMsg(2);
		consumer.consumeMsg();
	}

	// use an index to choose which item to send, since Rebeca does not allow
	// array-typed parameters in msgsrv signatures
	msgsrv produceMsg(int which) {
		int i;
		char tmp[10];
		i = 0;
		while (i < 10) {
			if (which == 1) {
				tmp[i] = item1[i];
			} else {
				tmp[i] = item2[i];
			}
			i = i + 1;
		}
		consumer.itemMsg();
	}
}

reactiveclass Consumer(5) {
	knownrebecs {
		// no known rebecs
	}
	statevars {
		// flatten 2D buffer[10][10] into 1D buffer[100]
		char buffer[100];
		int head;
		int tail;
		int size;
		char lastItem[10];
	}

	Consumer() {
		head = 0;
		tail = 0;
		size = 0;
	}

	msgsrv itemMsg() {
		if (size < 10) {
			int i;
			int base;
			i = 0;
			base = tail * 10;
			while (i < 10) {
				buffer[base + i] = lastItem[i];
				i = i + 1;
			}
			tail = (tail + 1) % 10;
			size = size + 1;
		} else {
			// buffer full, item dropped (no-op)
		}
	}

	msgsrv consumeMsg() {
		if (size > 0) {
			char item[10];
			int i;
			int base;
			i = 0;
			base = head * 10;
			while (i < 10) {
				item[i] = buffer[base + i];
				i = i + 1;
			}
			head = (head + 1) % 10;
			size = size - 1;
			// item consumed (no-op)
		} else {
			// buffer empty (no-op)
		}
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();
}