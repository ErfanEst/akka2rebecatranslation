reactiveclass Producer(5) {
	knownrebecs {
		Consumer consumer;
	}
	statevars {
		// no data state variables needed
	}

	Producer() {
		self.initial();
	}

	msgsrv initial() {
		// send initial produce messages as in main
		self.produceMsg("item1");
		self.produceMsg("item2");
		consumer.consumeMsg();
	}

	msgsrv produceMsg(char[10] item) {
		// Producer: sending item (omitted print)
		consumer.itemMsg(item);
	}
}

reactiveclass Consumer(5) {
	knownrebecs {
		// no known rebecs
	}
	statevars {
		char[10] buffer[10];
		int head;
		int tail;
		int size;
	}

	Consumer() {
		head = 0;
		tail = 0;
		size = 0;
	}

	msgsrv itemMsg(char[10] data) {
		if (size < 10) {
			buffer[tail] = data;
			tail = (tail + 1) % 10;
			size = size + 1;
			// Consumer: received data, buffer size: size (omitted print)
		} else {
			// buffer full, item dropped (no-op)
		}
	}

	msgsrv consumeMsg() {
		if (size > 0) {
			char[10] item;
			item = buffer[head];
			head = (head + 1) % 10;
			size = size - 1;
			// Consumer: consumed item (omitted print)
		} else {
			// Consumer: buffer empty (omitted print)
		}
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();
}