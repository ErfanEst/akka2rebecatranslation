reactiveclass Producer(5) {
	knownrebecs {
		Consumer consumer;
	}

	statevars {
	}

	Producer() {
		self.initial();
	}

	msgsrv initial() {
		// No initialization needed
	}

	msgsrv ProduceMsg(int itemId) {
		// itemId represents different items (e.g., 1 for "item1", 2 for "item2")
		consumer.itemMsg(itemId);
	}
}

reactiveclass Consumer(5) {
	knownrebecs {
	}

	statevars {
		int buffer[10];
		int head;
		int tail;
		int size;
	}

	Consumer() {
		head = 0;
		tail = 0;
		size = 0;
	}

	msgsrv itemMsg(int dataId) {
		if (size < 10) {
			buffer[tail] = dataId;
			tail = (tail + 1) % 10;
			size = size + 1;
		} else {
			// buffer full, item dropped
		}
	}

	msgsrv consumeMsg() {
		if (size > 0) {
			int itemId;
			itemId = buffer[head];
			head = (head + 1) % 10;
			size = size - 1;
			// itemId consumed
		} else {
			// buffer empty
		}
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();

	producer.ProduceMsg(1);
	producer.ProduceMsg(2);
	consumer.consumeMsg();
}