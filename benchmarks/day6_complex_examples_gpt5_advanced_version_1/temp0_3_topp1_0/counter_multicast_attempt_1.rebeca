reactiveclass CounterMulticastCounterMulticast_Counter(5) {
    knownrebecs { }
    statevars {
        int count;
    }

    CounterMulticastCounterMulticast_Counter() {
        count = 0;
        self.initial();
    }

    msgsrv initial() {
        // no initial behavior
    }

    msgsrv Increment() {
        count = count + 1;
        // sender() ! ValueResponse(count)
        (CounterMulticastCounterMulticast_Client)sender.ValueResponse(count);
    }

    msgsrv Decrement() {
        count = count - 1;
        // sender() ! ValueResponse(count)
        (CounterMulticastCounterMulticast_Client)sender.ValueResponse(count);
    }

    msgsrv GetValue() {
        // sender() ! ValueResponse(count)
        (CounterMulticastCounterMulticast_Client)sender.ValueResponse(count);
    }
}

reactiveclass CounterMulticastCounterMulticast_Client(5) {
    knownrebecs {
        CounterMulticastCounterMulticast_Counter counter;
    }
    statevars {
        int clientId;
        int lastValue;
    }

    CounterMulticastCounterMulticast_Client(int clientIdArg) {
        clientId = clientIdArg;
        lastValue = 0;
        self.initial();
    }

    msgsrv initial() {
        // no initial behavior
    }

    msgsrv ValueResponse(int value) {
        lastValue = value;
        // originally: println(s"Client $clientId received value: $value")
    }
}

main {
    CounterMulticastCounterMulticast_Counter counter():();
    CounterMulticastCounterMulticast_Client client1(counter):(1);
    CounterMulticastCounterMulticast_Client client2(counter):(2);

    // counter.tell(Increment, client1)
    counter.Increment() with (client1);
    // counter.tell(Increment, client2)
    counter.Increment() with (client2);
    // counter.tell(GetValue, client1)
    counter.GetValue() with (client1);
}