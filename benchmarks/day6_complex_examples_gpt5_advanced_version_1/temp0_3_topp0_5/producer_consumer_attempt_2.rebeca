reactiveclass Producer(10) {
	knownrebecs {
		Consumer consumer;
	}

	statevars {
		// no data state variables
	}

	Producer() {
		self.initial();
	}

	msgsrv initial() {
		// no automatic behavior on start
	}

	msgsrv ProduceMsg(int itemId) {
		consumer.ItemMsg(itemId);
	}
}

reactiveclass Consumer(10) {
	knownrebecs {
		// no known rebecs
	}

	statevars {
		int buffer[10];
		int head;
		int tail;
		int size;
	}

	Consumer() {
		head = 0;
		tail = 0;
		size = 0;
	}

	msgsrv ItemMsg(int data) {
		if (size < 10) {
			buffer[tail] = data;
			tail = (tail + 1) % 10;
			size = size + 1;
		} else {
			// buffer full, item is dropped
		}
	}

	msgsrv ConsumeMsg() {
		if (size > 0) {
			int item;
			item = buffer[head];
			head = (head + 1) % 10;
			size = size - 1;
			// item consumed, no output
		} else {
			// buffer empty, nothing to consume
		}
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();

	producer.ProduceMsg(1);
	producer.ProduceMsg(2);
	consumer.ConsumeMsg();
}