reactiveclass CounterMulticastSystem(10) {
	knownrebecs {
		Counter counter;
		Client client1;
		Client client2;
	}

	statevars {
	}

	// Entry point to start the scenario
	msgsrv initial() {
		// counter.tell(Increment, client1)
		counter.increment();
		// counter.tell(Increment, client2)
		counter.increment();
		// counter.tell(GetValue, client1)
		counter.getValue();
	}
}

reactiveclass Counter(10) {
	knownrebecs {
	}

	statevars {
		int count;
		int lastValueSent;
	}

	// Constructor
	Counter() {
		count = 0;
		lastValueSent = 0;
	}

	msgsrv increment() {
		count = count + 1;
		lastValueSent = count;
		// sender() ! ValueResponse(count)
		((Client)sender).valueResponse(lastValueSent);
	}

	msgsrv decrement() {
		count = count - 1;
		lastValueSent = count;
		// sender() ! ValueResponse(count)
		((Client)sender).valueResponse(lastValueSent);
	}

	msgsrv getValue() {
		lastValueSent = count;
		// sender() ! ValueResponse(count)
		((Client)sender).valueResponse(lastValueSent);
	}
}

reactiveclass Client(10) {
	knownrebecs {
		Counter counter;
	}

	statevars {
		int clientId;
		int lastReceivedValue;
	}

	// Constructor with clientId as data parameter
	Client(int id) {
		clientId = id;
		lastReceivedValue = 0;
	}

	msgsrv valueResponse(int value) {
		lastReceivedValue = value;
		// original println removed; state updated instead
	}
}

main {
	Counter counter() :();
	Client client1(counter) :(1);
	Client client2(counter) :(2);
	CounterMulticastSystem system(counter, client1, client2) :();
}