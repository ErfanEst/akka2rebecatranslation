reactiveclass Producer(10) {
	knownrebecs {
		Consumer consumer;
	}
	statevars {
		// no data state variables
	}

	Producer() {
		self.initial();
	}

	msgsrv initial() {
		// no automatic behavior
	}

	msgsrv produceMsg(int itemId) {
		consumer.itemMsg(itemId);
	}
}

reactiveclass Consumer(10) {
	knownrebecs {
		// no known rebecs
	}
	statevars {
		int buffer[10];
		int head;
		int tail;
		int size;
	}

	Consumer() {
		head = 0;
		tail = 0;
		size = 0;
		self.initial();
	}

	msgsrv initial() {
		// no automatic behavior
	}

	msgsrv itemMsg(int dataId) {
		if (size < 10) {
			buffer[tail] = dataId;
			tail = (tail + 1) % 10;
			size = size + 1;
		} else {
			{}
		}
	}

	msgsrv consumeMsg() {
		if (size > 0) {
			int itemId;
			itemId = buffer[head];
			head = (head + 1) % 10;
			size = size - 1;
		} else {
			{}
		}
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();

	producer.produceMsg(1);
	producer.produceMsg(2);
	consumer.consumeMsg();
}