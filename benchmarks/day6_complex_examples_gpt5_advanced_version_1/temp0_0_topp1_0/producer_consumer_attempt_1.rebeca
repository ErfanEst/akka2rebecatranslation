reactiveclass Producer(10) {
	knownrebecs {
		Consumer consumer;
	}

	statevars {
		// no data state variables needed
	}

	Producer() {
		// initialization if needed
	}

	msgsrv initial() {
		// no automatic behavior on start
	}

	msgsrv ProduceMsg(int itemId) {
		// itemId encodes the item; strings are not supported directly
		consumer.ItemMsg(itemId);
	}
}

reactiveclass Consumer(10) {
	knownrebecs {
		// no known rebecs
	}

	statevars {
		int buffer[10];
		int head;
		int tail;
		int size;
	}

	Consumer() {
		head = 0;
		tail = 0;
		size = 0;
	}

	msgsrv initial() {
		// no automatic behavior on start
	}

	msgsrv ItemMsg(int dataId) {
		if (size < 10) {
			buffer[tail] = dataId;
			tail = (tail + 1) % 10;
			size = size + 1;
		} else {
			// buffer overflow in this abstract model: item is dropped
		}
	}

	msgsrv ConsumeMsg() {
		if (size > 0) {
			int item;
			item = buffer[head];
			head = (head + 1) % 10;
			size = size - 1;
			// item consumed; no further actions in this abstract model
		} else {
			// buffer empty; nothing to consume
		}
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();

	// simulate:
	// producer ! Produce("item1")
	// producer ! Produce("item2")
	// consumer ! Consume()
	producer.ProduceMsg(1);
	producer.ProduceMsg(2);
	consumer.ConsumeMsg();
}