reactiveclass CounterMulticast_Counter(5) {
	statevars {
		int count;
	}

	CounterMulticast_Counter() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		((Client)sender).ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		((Client)sender).ValueResponse(count);
	}

	msgsrv GetValue() {
		((Client)sender).ValueResponse(count);
	}
}

reactiveclass Client(5) {
	knownrebecs {
		CounterMulticast_Counter counter;
	}

	statevars {
		int clientId;
		int lastValue;
	}

	Client(int cId) {
		clientId = cId;
		lastValue = 0;
	}

	msgsrv ValueResponse(int value) {
		lastValue = value;
	}
}

main {
	CounterMulticast_Counter counter():();
	Client client1(counter):(1);
	Client client2(counter):(2);

	counter.Increment() after(0) sender client1;
	counter.Increment() after(0) sender client2;
	counter.GetValue() after(0) sender client1;
}