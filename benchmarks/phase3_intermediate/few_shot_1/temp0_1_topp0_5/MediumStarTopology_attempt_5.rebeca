reactiveclass Client(5) {
	knownrebecs { Hub hub; }
	statevars { }

	msgsrv initial() { }

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}
}

reactiveclass Hub(5) {
	knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; }
	statevars { }

	msgsrv initial() { }

	msgsrv Register1() { }
	msgsrv Register2() { }
	msgsrv Register3() { }
	msgsrv Register4() { }
	msgsrv Register5() { }

	msgsrv Ping() {
		c1.Pong();
	}
}

main {
	Hub hub(c1, c2, c3, c4, c5):();
	Client c1(hub):();
	Client c2(hub):();
	Client c3(hub):();
	Client c4(hub):();
	Client c5(hub):();

	c1.start();
	c2.start();
	c3.start();
	c4.start();
	c5.start();
}