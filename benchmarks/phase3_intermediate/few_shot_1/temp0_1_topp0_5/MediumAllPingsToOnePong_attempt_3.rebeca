reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}
	statevars {
		int id;
	}

	msgsrv initial(int _id) {
		id = _id;
		self.start();
	}

	msgsrv start() {
		pong.ping(id);
	}

	msgsrv pingBack(int msgId) {
		pong.ping(id);
	}
}

reactiveclass PongActor {
	knownrebecs {
		PingActor ping1;
		PingActor ping2;
		PingActor ping3;
		PingActor ping4;
		PingActor ping5;
		PingActor ping6;
		PingActor ping7;
		PingActor ping8;
		PingActor ping9;
		PingActor ping10;
	}
	statevars {
	}

	msgsrv initial() {
	}

	msgsrv ping(int id) {
		if (id == 1) {
			ping1.pingBack(1);
		} else if (id == 2) {
			ping2.pingBack(2);
		} else if (id == 3) {
			ping3.pingBack(3);
		} else if (id == 4) {
			ping4.pingBack(4);
		} else if (id == 5) {
			ping5.pingBack(5);
		} else if (id == 6) {
			ping6.pingBack(6);
		} else if (id == 7) {
			ping7.pingBack(7);
		} else if (id == 8) {
			ping8.pingBack(8);
		} else if (id == 9) {
			ping9.pingBack(9);
		} else if (id == 10) {
			ping10.pingBack(10);
		}
	}
}

main {
	PongActor pong(ping1, ping2, ping3, ping4, ping5, ping6, ping7, ping8, ping9, ping10):();
	PingActor ping1(pong):(1);
	PingActor ping2(pong):(2);
	PingActor ping3(pong):(3);
	PingActor ping4(pong):(4);
	PingActor ping5(pong):(5);
	PingActor ping6(pong):(6);
	PingActor ping7(pong):(7);
	PingActor ping8(pong):(8);
	PingActor ping9(pong):(9);
	PingActor ping10(pong):(10);
}