reactiveclass Client(5) {
	knownrebecs { Hub hub; }
	statevars { }

	msgsrv initial() {
		hub.register(self);
		self.start();
	}

	msgsrv start() {
		hub.ping(self);
	}

	msgsrv pong() {
		hub.ping(self);
	}
}

reactiveclass Hub(5) {
	knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; }
	statevars {
		boolean registered1;
		boolean registered2;
		boolean registered3;
		boolean registered4;
		boolean registered5;
	}

	msgsrv initial() {
		registered1 = false;
		registered2 = false;
		registered3 = false;
		registered4 = false;
		registered5 = false;
	}

	msgsrv register(Client ref) {
		if (ref == c1) {
			registered1 = true;
		} else {
			if (ref == c2) {
				registered2 = true;
			} else {
				if (ref == c3) {
					registered3 = true;
				} else {
					if (ref == c4) {
						registered4 = true;
					} else {
						if (ref == c5) {
							registered5 = true;
						}
					}
				}
			}
		}
	}

	msgsrv ping(Client senderRef) {
		senderRef.pong();
	}
}

main {
	Hub hub(c1, c2, c3, c4, c5):();
	Client c1(hub):();
	Client c2(hub):();
	Client c3(hub):();
	Client c4(hub):();
	Client c5(hub):();
}