reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}
	statevars {
		int id;
	}

	msgsrv initial() {
		// id will be set via a separate initId message
	}

	msgsrv initId(int initId) {
		id = initId;
		pong.pingMsg(id);
	}

	msgsrv start() {
		pong.pingMsg(id);
	}

	msgsrv strMsg() {
		pong.pingMsg(id);
	}
}

reactiveclass PongActor {
	knownrebecs { }

	statevars { }

	msgsrv initial() { }

	msgsrv pingMsg(int pid) {
		self.pongForPing(pid);
	}

	msgsrv pongForPing(int pid) { }
}

main {
	PongActor pong():();
	PingActor ping1(pong):();
	PingActor ping2(pong):();
	PingActor ping3(pong):();
	PingActor ping4(pong):();
	PingActor ping5(pong):();
	PingActor ping6(pong):();
	PingActor ping7(pong):();
	PingActor ping8(pong):();
	PingActor ping9(pong):();
	PingActor ping10(pong):();

	// Initialize ids after creation
	ping1.initId(1);
	ping2.initId(2);
	ping3.initId(3);
	ping4.initId(4);
	ping5.initId(5);
	ping6.initId(6);
	ping7.initId(7);
	ping8.initId(8);
	ping9.initId(9);
	ping10.initId(10);
}