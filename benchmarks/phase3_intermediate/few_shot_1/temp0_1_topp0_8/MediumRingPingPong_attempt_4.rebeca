reactiveclass RingActor(5) {
	knownrebecs {
		RingActor next;
	}
	statevars {
		boolean isNextSet;
	}

	msgsrv initial() {
		isNextSet = true;
	}

	msgsrv ping() {
		if (isNextSet) {
			next.ping();
		}
	}
}

main {
	RingActor a1(a2):();
	RingActor a2(a3):();
	RingActor a3(a4):();
	RingActor a4(a5):();
	RingActor a5(a1):();

	a1:initial();
	a2:initial();
	a3:initial();
	a4:initial();
	a5:initial();

	a1:ping();
}