reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}
	statevars {
		int id;
	}

	msgsrv initial(int _id) {
		id = _id;
		pong.pingMsg(id);
	}

	msgsrv pingMsg(int _id) {
		pong.pingMsg(id);
	}

	msgsrv pongResponse(int _id) {
		// PingActor ignores pong responses
	}
}

reactiveclass PongActor {
	knownrebecs {
		PingActor ping1;
		PingActor ping2;
		PingActor ping3;
		PingActor ping4;
		PingActor ping5;
		PingActor ping6;
		PingActor ping7;
		PingActor ping8;
		PingActor ping9;
		PingActor ping10;
	}
	statevars {
	}

	msgsrv initial() {
	}

	msgsrv pingMsg(int id) {
		if (id == 1) {
			ping1.pongResponse(id);
		} else if (id == 2) {
			ping2.pongResponse(id);
		} else if (id == 3) {
			ping3.pongResponse(id);
		} else if (id == 4) {
			ping4.pongResponse(id);
		} else if (id == 5) {
			ping5.pongResponse(id);
		} else if (id == 6) {
			ping6.pongResponse(id);
		} else if (id == 7) {
			ping7.pongResponse(id);
		} else if (id == 8) {
			ping8.pongResponse(id);
		} else if (id == 9) {
			ping9.pongResponse(id);
		} else if (id == 10) {
			ping10.pongResponse(id);
		}
	}
}

main {
	PongActor pong(ping1, ping2, ping3, ping4, ping5, ping6, ping7, ping8, ping9, ping10):();

	PingActor ping1(pong):(1);
	PingActor ping2(pong):(2);
	PingActor ping3(pong):(3);
	PingActor ping4(pong):(4);
	PingActor ping5(pong):(5);
	PingActor ping6(pong):(6);
	PingActor ping7(pong):(7);
	PingActor ping8(pong):(8);
	PingActor ping9(pong):(9);
	PingActor ping10(pong):(10);
}