reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}
	statevars {
		int id;
	}

	msgsrv initial(int initId) {
		id = initId;
		pong.ping(id);
	}

	msgsrv pingBack(string msg) {
		pong.ping(id);
	}
}

reactiveclass PongActor {
	knownrebecs {
