reactiveclass PingActor(5) {
	knownrebecs {
		PongActor pong;
	}
	statevars {
		int id;
	}

	msgsrv initial() {
		// id will be set by a separate initialization message
	}

	msgsrv initId(int _id) {
		id = _id;
		self.start();
	}

	msgsrv start() {
		pong.ping(id);
	}

	msgsrv otherMsg() {
		pong.ping(id);
	}
}

