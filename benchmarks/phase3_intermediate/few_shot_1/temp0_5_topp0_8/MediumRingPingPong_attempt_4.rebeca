reactiveclass RingActor(5) {
	knownrebecs {
		RingActor next;
	}
	statevars {
		boolean isNextSet;
	}

	msgsrv initial() {
		isNextSet = true;
	}

	msgsrv setNext(RingActor ref) {
		// next is a knownrebec (constant reference), so we cannot assign to it here.
		// This msgsrv is kept only to match the Akka interface; it does nothing.
		isNextSet = true;
	}

	msgsrv ping() {
		if (isNextSet) {
			next.ping();
		}
	}
}

main {
	RingActor a1(a2):();
	RingActor a2(a3):();
	RingActor a3(a4):();
	RingActor a4(a5):();
	RingActor a5(a1):();

	a1.initial() after(0);
	a2.initial() after(0);
	a3.initial() after(0);
	a4.initial() after(0);
	a5.initial() after(0);

	a1.ping() after(0);
}