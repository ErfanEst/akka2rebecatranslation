reactiveclass PingActor(5) {
	knownrebecs { PongActor pong; }
	statevars { int id; }

	msgsrv initial(int _id) {
		id = _id;
		pong.ping(id);
	}

	msgsrv ping(int _id) {
		pong.ping(id);
	}

	msgsrv start() {
		pong.ping(id);
	}
}

reactiveclass PongActor(5) {
	knownrebecs { }
	statevars { }

	msgsrv initial() { }

	msgsrv ping(int pid) {
		// Represent "doing nothing" with an empty body
	}
}

main {
	PongActor pong():();
	PingActor ping1(pong):(<int>1);
	PingActor ping2(pong):(<int>2);
	PingActor ping3(pong):(<int>3);
	PingActor ping4(pong):(<int>4);
	PingActor ping5(pong):(<int>5);
	PingActor ping6(pong):(<int>6);
	PingActor ping7(pong):(<int>7);
	PingActor ping8(pong):(<int>8);
	PingActor ping9(pong):(<int>9);
	PingActor ping10(pong):(<int>10);
}