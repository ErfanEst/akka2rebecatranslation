reactiveclass PingActor(5) {
	knownrebecs { PongActor pong; }
	statevars { int id; }

	msgsrv initial(int _id) {
		id = _id;
		pong.ping(id);
	}

	msgsrv ping(int _id) {
		pong.ping(id);
	}

	msgsrv start() {
		pong.ping(id);
	}
}

reactiveclass PongActor(5) {
	knownrebecs { }
	statevars { }

	msgsrv initial() { }

	msgsrv ping(int pid) {
		// In Akka: sender() ! s"pong-for-$msg"
		// Here we only model that a pong is conceptually generated.
		// To keep the structure, we do not send it anywhere specific.
		// If needed, this could be extended with explicit ping references.
		skip;
	}
}

main {
	PongActor pong():();
	PingActor ping1(pong):(1);
	PingActor ping2(pong):(2);
	PingActor ping3(pong):(3);
	PingActor ping4(pong):(4);
	PingActor ping5(pong):(5);
	PingActor ping6(pong):(6);
	PingActor ping7(pong):(7);
	PingActor ping8(pong):(8);
	PingActor ping9(pong):(9);
	PingActor ping10(pong):(10);
}