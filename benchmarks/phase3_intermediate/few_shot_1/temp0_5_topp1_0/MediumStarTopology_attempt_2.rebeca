reactiveclass Client(5) { 
  knownrebecs { Hub hub; } 
  statevars { } 

  msgsrv initial() { 
    hub.Ping(self); 
  } 

  msgsrv Pong() { 
    hub.Ping(self); 
  } 
} 

reactiveclass Hub(5) { 
  knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; } 
  statevars { } 

  msgsrv initial() { 
  } 

  msgsrv Ping(Client senderRef) { 
    senderRef.Pong(); 
  } 
} 

main { 
  Client c1(hub):(); 
  Client c2(hub):(); 
  Client c3(hub):(); 
  Client c4(hub):(); 
  Client c5(hub):(); 
  Hub hub(c1, c2, c3, c4, c5):(); 
}