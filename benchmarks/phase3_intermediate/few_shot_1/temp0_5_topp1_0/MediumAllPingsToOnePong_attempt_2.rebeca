reactiveclass PingActor(5) {
	knownrebecs {
		PongActor pong;
	}
	statevars {
		int id;
	}

	msgsrv initial() {
		// default id; can be set via explicit initialization message
		id = 0;
	}

	msgsrv setId(int _id) {
		id = _id;
		pong.pingFromPing(id);
	}

	msgsrv anyString() {
		pong.pingFromPing(id);
	}
}

reactiveclass PongActor(5) {
	knownrebecs {
	}
	statevars {
	}

	msgsrv initial() {
	}

	msgsrv pingFromPing(int pingId) {
	}
}

main {
	PongActor pong():();

	PingActor ping1(pong):();
	PingActor ping2(pong):();
	PingActor ping3(pong):();
	PingActor ping4(pong):();
	PingActor ping5(pong):();
	PingActor ping6(pong):();
	PingActor ping7(pong):();
	PingActor ping8(pong):();
	PingActor ping9(pong):();
	PingActor ping10(pong):();

	ping1.setId(1);
	ping2.setId(2);
	ping3.setId(3);
	ping4.setId(4);
	ping5.setId(5);
	ping6.setId(6);
	ping7.setId(7);
	ping8.setId(8);
	ping9.setId(9);
	ping10.setId(10);
}