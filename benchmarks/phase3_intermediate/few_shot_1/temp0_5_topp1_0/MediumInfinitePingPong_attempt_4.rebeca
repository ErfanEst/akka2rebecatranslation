reactiveclass PingActor(5) {
	knownrebecs {
		PongActor pong;
	}
	statevars {
	}

	msgsrv initial() {
		// Start will be sent from main
	}

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor(5) {
	knownrebecs {
		PingActor pingRef;
	}
	statevars {
	}

	msgsrv initial() {
	}

	msgsrv Ping() {
		pingRef.Pong();
	}
}

main {
	PongActor pong(ping):();
	PingActor ping(pong):();

	ping.initial();
	pong.initial();

	ping.Start();
}