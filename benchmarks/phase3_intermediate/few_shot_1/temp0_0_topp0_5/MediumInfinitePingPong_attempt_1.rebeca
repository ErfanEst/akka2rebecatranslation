reactiveclass PingActor(5) {
	knownrebecs {
		PongActor pong;
	}
	statevars {
	}

	msgsrv initial() {
		// No automatic start; Start will be sent from main
	}

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor(5) {
	knownrebecs {
	}
	statevars {
	}

	msgsrv initial() {
	}

	msgsrv Ping() {
		// sender() in Akka is always PingActor in this model
		// We model it by having PingActor call this, so we respond directly
		// to the known PingActor instance in main via its knownrebec link.
		// Here, we assume a single PingActor; main will wire it.
		// The actual call is done via knownrebec in main, not via sender().
	}
}

reactiveclass PongActorWithPing(5) {
	knownrebecs {
		PingActor ping;
	}
	statevars {
	}

	msgsrv initial() {
	}

	msgsrv Ping() {
		ping.Pong();
	}
}

main {
	PingActor ping(pong):();
	PongActorWithPing pong(ping):();

	ping.Start();
}