reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}
	statevars {
		int id;
	}

	msgsrv initial() {
		// default id; will be overridden by explicit init messages
		id = 0;
	}

	msgsrv setup(int _id) {
		id = _id;
		self.start();
	}

	msgsrv start() {
		pong.ping(id);
	}

	msgsrv pingedFromEnv() {
		pong.ping(id);
	}
}

reactiveclass PongActor {
	knownrebecs {
	}
	statevars {
	}

	msgsrv initial() {
	}

	msgsrv ping(int id) {
		// replying to ping; sender not explicitly modeled
	}
}

main {
	PongActor pong():();

	PingActor ping1(pong):();
	PingActor ping2(pong):();
	PingActor ping3(pong):();
	PingActor ping4(pong):();
	PingActor ping5(pong):();
	PingActor ping6(pong):();
	PingActor ping7(pong):();
	PingActor ping8(pong):();
	PingActor ping9(pong):();
	PingActor ping10(pong):();

	// explicit initialization of ids
	ping1.setup(1);
	ping2.setup(2);
	ping3.setup(3);
	ping4.setup(4);
	ping5.setup(5);
	ping6.setup(6);
	ping7.setup(7);
	ping8.setup(8);
	ping9.setup(9);
	ping10.setup(10);
}