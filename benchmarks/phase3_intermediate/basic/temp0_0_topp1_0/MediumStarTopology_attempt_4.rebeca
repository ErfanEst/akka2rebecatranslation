reactiveclass Client(hubKnown) {
	knownrebecs { 
		Hub hub; 
	}

	Client(Hub hubKnown) {
		hub = hubKnown;
	}

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}
}

reactiveclass Hub(c1Known, c2Known, c3Known, c4Known, c5Known) {
	knownrebecs { 
		Client c1; 
		Client c2; 
		Client c3; 
		Client c4; 
		Client c5; 
	}

	statevars {
		boolean c1Registered;
		boolean c2Registered;
		boolean c3Registered;
		boolean c4Registered;
		boolean c5Registered;
	}

	Hub(Client c1Known, Client c2Known, Client c3Known, Client c4Known, Client c5Known) {
		c1 = c1Known;
		c2 = c2Known;
		c3 = c3Known;
		c4 = c4Known;
		c5 = c5Known;

		c1Registered = false;
		c2Registered = false;
		c3Registered = false;
		c4Registered = false;
		c5Registered = false;
	}

	msgsrv Register(Client ref) {
		if (ref == c1) {
			c1Registered = true;
		} else if (ref == c2) {
			c2Registered = true;
		} else if (ref == c3) {
			c3Registered = true;
		} else if (ref == c4) {
			c4Registered = true;
		} else if (ref == c5) {
			c5Registered = true;
		}
	}

	msgsrv Ping() {
		sender.Pong();
	}
}

main {
	Client c1(hub):();
	Client c2(hub):();
	Client c3(hub):();
	Client c4(hub):();
	Client c5(hub):();
	Hub hub(c1, c2, c3, c4, c5):();

	hub.Register(c1);
	hub.Register(c2);
	hub.Register(c3);
	hub.Register(c4);
	hub.Register(c5);

	c1.start();
	c2.start();
	c3.start();
	c4.start();
	c5.start();
}