reactiveclass Client {
	knownrebecs { 
		Hub hub; 
	}

	Client() {
	}

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}
}

reactiveclass Hub {
	knownrebecs { 
		Client c1; 
		Client c2; 
		Client c3; 
		Client c4; 
		Client c5; 
	}

	statevars {
		boolean c1Registered;
		boolean c2Registered;
		boolean c3Registered;
		boolean c4Registered;
		boolean c5Registered;
	}

	Hub() {
		c1Registered = false;
		c2Registered = false;
		c3Registered = false;
		c4Registered = false;
		c5Registered = false;
	}

	msgsrv Register(Client ref) {
		if (ref == c1) {
			c1Registered = true;
		} else if (ref == c2) {
			c2Registered = true;
		} else if (ref == c3) {
			c3Registered = true;
		} else if (ref == c4) {
			c4Registered = true;
		} else if (ref == c5) {
			c5Registered = true;
		}
	}

	msgsrv Ping() {
		sender.Pong();
	}
}

main {
	Hub hub():();
	Client c1(hub):();
	Client c2(hub):();
	Client c3(hub):();
	Client c4(hub):();
	Client c5(hub):();

	hub.Register(c1);
	hub.Register(c2);
	hub.Register(c3);
	hub.Register(c4);
	hub.Register(c5);

	c1.start();
	c2.start();
	c3.start();
	c4.start();
	c5.start();
}