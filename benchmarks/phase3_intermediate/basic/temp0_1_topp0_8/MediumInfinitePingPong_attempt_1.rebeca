reactiveclass PingActor {
    knownrebecs { PongActor pong; }

    msgsrv Start() {
        pong.Ping();
    }

    msgsrv Pong() {
        pong.Ping();
    }
}

reactiveclass PongActor {
    msgsrv Ping() {
        self.getSender().Pong();
    }
}

main {
    PongActor pong();
    PingActor ping(pong);

    ping.Start();
}