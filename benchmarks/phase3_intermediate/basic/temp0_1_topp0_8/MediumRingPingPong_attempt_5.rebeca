reactiveclass RingActor {
	knownrebecs { 
		RingActor next;
	}

	statevars { 
	}

	constructor(RingActor n) {
		next = n;
	}

	msgsrv Ping() {
		next.Ping();
	}

	msgsrv setNext(RingActor ref) {
		next = ref;
	}
}

main {
	RingActor a1(a2):();
	RingActor a2(a3):();
	RingActor a3(a4):();
	RingActor a4(a5):();
	RingActor a5(a1):();

	a1.Ping();
}