reactiveclass PingActor(pong: PongActor, id: int) {
    knownrebecs { PongActor pong; }

    msgsrv initial() {
        // equivalent of receiving "start"
        ping();
    }

    msgsrv ping() {
        // send "ping-id" to pong
        pong.ping(id);
    }

    msgsrv pongResponse(int pid) {
        // handle pong response if needed (no-op here)
    }
}

reactiveclass PongActor {
    knownrebecs { }

    msgsrv initial() {
        // no initialization needed
    }

    msgsrv ping(int pid) {
        // send back "pong-for-ping-id"
        // we only keep the id as data
        sender.pongResponse(pid);
    }
}

main {
    PongActor pong();
    PingActor ping1(pong, 1);
    PingActor ping2(pong, 2);
    PingActor ping3(pong, 3);
    PingActor ping4(pong, 4);
    PingActor ping5(pong, 5);
    PingActor ping6(pong, 6);
    PingActor ping7(pong, 7);
    PingActor ping8(pong, 8);
    PingActor ping9(pong, 9);
    PingActor ping10(pong, 10);
}