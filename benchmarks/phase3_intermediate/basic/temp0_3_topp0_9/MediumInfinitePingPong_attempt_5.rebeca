reactiveclass PingActor(pongActorType) {
	knownrebecs { 
		pongActorType pong; 
	}
	msgsrv Start() { 
		pong.Ping(); 
	}
	msgsrv Pong() { 
		pong.Ping(); 
	}
}

reactiveclass PongActor(pingActorType) {
	knownrebecs { 
		pingActorType ping;
	}
	msgsrv Ping() { 
		ping.Pong(); 
	}
}

main {
	PingActor ping(PongActor):();
	PongActor pong(PingActor):();
}