reactiveclass PingActor {
	knownrebecs { 
		PongActor pong; 
	}
	statevars {
		int id;
	}

	PingActor(PongActor pong, int id) {
		self.pong = pong;
		self.id = id;
	}

	msgsrv initial() {
		ping();
	}

	msgsrv ping() {
		pong.ping(id);
	}

	msgsrv pongResponse(int pid) {
		// no-op
	}
}

reactiveclass PongActor {
	knownrebecs { }

	PongActor() {
	}

	msgsrv initial() {
		// no initialization needed
	}

	msgsrv ping(int pid) {
		sender.pongResponse(pid);
	}
}

main {
	PongActor pong():();
	PingActor ping1(pong):(1);
	PingActor ping2(pong):(2);
	PingActor ping3(pong):(3);
	PingActor ping4(pong):(4);
	PingActor ping5(pong):(5);
	PingActor ping6(pong):(6);
	PingActor ping7(pong):(7);
	PingActor ping8(pong):(8);
	PingActor ping9(pong):(9);
	PingActor ping10(pong):(10);
}