reactiveclass RingActor {
    knownrebecs {
        RingActor next;
    }

    msgsrv Ping() {
        next.Ping();
    }

    msgsrv setNext(RingActor ref) {
        next = ref;
    }

    RingActor() {
        // no initialization
    }
}

main {
    RingActor a1(a2);
    RingActor a2(a3);
    RingActor a3(a4);
    RingActor a4(a5);
    RingActor a5(a1);

    a1.setNext(a2);
    a2.setNext(a3);
    a3.setNext(a4);
    a4.setNext(a5);
    a5.setNext(a1);

    a1.Ping();
}