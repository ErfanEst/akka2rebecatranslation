reactiveclass Client {
	knownrebecs {
		Hub hub;
	}

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}
}

reactiveclass Hub {
	knownrebecs {
		Client c1;
		Client c2;
		Client c3;
		Client c4;
		Client c5;
	}

	statevars {
		int dummy;
	}

	msgsrv Register(Client ref) {
		// no-op
	}

	msgsrv Ping() {
		sender.Pong();
	}
}

main {
	Client c1(h);
	Client c2(h);
	Client c3(h);
	Client c4(h);
	Client c5(h);
	Hub h(c1, c2, c3, c4, c5);

	h.Register(c1);
	h.Register(c2);
	h.Register(c3);
	h.Register(c4);
	h.Register(c5);

	c1.start();
	c2.start();
	c3.start();
	c4.start();
	c5.start();
}