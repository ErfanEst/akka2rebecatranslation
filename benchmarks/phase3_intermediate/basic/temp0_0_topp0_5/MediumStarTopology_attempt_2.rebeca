reactiveclass Client {
	knownrebecs { Hub hub; }

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}

	msgsrv initial() {
		// no-op
	}
}

reactiveclass Hub {
	knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; }

	msgsrv Ping() {
		c1.Pong();
		c2.Pong();
		c3.Pong();
		c4.Pong();
		c5.Pong();
	}

	msgsrv initial() {
		// no-op
	}
}

main {
	Client c1(hub):();
	Client c2(hub):();
	Client c3(hub):();
	Client c4(hub):();
	Client c5(hub):();
	Hub hub(c1, c2, c3, c4, c5):();

	c1.start();
	c2.start();
	c3.start();
	c4.start();
	c5.start();
}