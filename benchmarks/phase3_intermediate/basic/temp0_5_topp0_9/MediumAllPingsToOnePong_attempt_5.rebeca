reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}
	statevars {
		byte id;
	}

	PingActor(PongActor pong) {
		self.pong = pong;
	}

	msgsrv init(byte id) {
		self.id = id;
	}

	msgsrv start() {
		ping();
	}

	msgsrv ping() {
		pong.ping(id);
	}
}

reactiveclass PongActor {
	knownrebecs {
	}

	PongActor() {
	}

	msgsrv ping(byte id) {
		sender.pong(id);
	}

	msgsrv pong(byte id) {
		// pong-for-ping-id
	}
}

main {
	PongActor pong();

	PingActor ping1(pong);
	PingActor ping2(pong);
	PingActor ping3(pong);
	PingActor ping4(pong);
	PingActor ping5(pong);
	PingActor ping6(pong);
	PingActor ping7(pong);
	PingActor ping8(pong);
	PingActor ping9(pong);
	PingActor ping10(pong);

	ping1.init(1);
	ping2.init(2);
	ping3.init(3);
	ping4.init(4);
	ping5.init(5);
	ping6.init(6);
	ping7.init(7);
	ping8.init(8);
	ping9.init(9);
	ping10.init(10);

	ping1.start();
	ping2.start();
	ping3.start();
	ping4.start();
	ping5.start();
	ping6.start();
	ping7.start();
	ping8.start();
	ping9.start();
	ping10.start();
}