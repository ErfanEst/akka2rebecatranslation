reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}
	statevars {
		byte id;
	}

	PingActor() {
	}

	msgsrv init(PongActor pong, byte id) {
		self.pong = pong;
		self.id = id;
	}

	msgsrv start() {
		ping();
	}

	msgsrv ping() {
		pong.ping(id);
	}
}

reactiveclass PongActor {
	knownrebecs {
	}

	PongActor() {
	}

	msgsrv ping(byte id) {
		sender.pong(id);
	}

	msgsrv pong(byte id) {
		// pong-for-ping-id
	}
}

main {
	PongActor pong();

	PingActor ping1(pong);
	PingActor ping2(pong);
	PingActor ping3(pong);
	PingActor ping4(pong);
	PingActor ping5(pong);
	PingActor ping6(pong);
	PingActor ping7(pong);
	PingActor ping8(pong);
	PingActor ping9(pong);
	PingActor ping10(pong);

	ping1.init(pong, 1): {};
	ping2.init(pong, 2): {};
	ping3.init(pong, 3): {};
	ping4.init(pong, 4): {};
	ping5.init(pong, 5): {};
	ping6.init(pong, 6): {};
	ping7.init(pong, 7): {};
	ping8.init(pong, 8): {};
	ping9.init(pong, 9): {};
	ping10.init(pong, 10): {};

	ping1.start(): {};
	ping2.start(): {};
	ping3.start(): {};
	ping4.start(): {};
	ping5.start(): {};
	ping6.start(): {};
	ping7.start(): {};
	ping8.start(): {};
	ping9.start(): {};
	ping10.start(): {};
}