reactiveclass Client(hub): 
    knownrebecs { 
        Hub hub; 
    } 

    msgsrv initial() { 
        start(); 
    } 

    msgsrv start() { 
        hub.Ping(); 
    } 

    msgsrv Pong() { 
        hub.Ping(); 
    } 
} 

reactiveclass Hub(c1, c2, c3, c4, c5) { 
    knownrebecs { 
        Client c1; 
        Client c2; 
        Client c3; 
        Client c4; 
        Client c5; 
    } 

    msgsrv initial() { 
        Register(c1); 
        Register(c2); 
        Register(c3); 
        Register(c4); 
        Register(c5); 

        c1.start(); 
        c2.start(); 
        c3.start(); 
        c4.start(); 
        c5.start(); 
    } 

    msgsrv Register(Client ref) { 
    } 

    msgsrv Ping() { 
        sender.Pong(); 
    } 
} 

main { 
    Client c1(hub):(); 
    Client c2(hub):(); 
    Client c3(hub):(); 
    Client c4(hub):(); 
    Client c5(hub):(); 
    Hub hub(c1, c2, c3, c4, c5):(); 
}