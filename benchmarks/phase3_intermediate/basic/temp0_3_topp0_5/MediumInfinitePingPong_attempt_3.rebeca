reactiveclass PingActor {
	knownrebecs { 
		PongActor pong;
	}

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor {
	knownrebecs {
		PingActor ping;
	}

	msgsrv Ping() {
		ping.Pong();
	}
}

main {
	PongActor pong(ping):();
	PingActor ping(pong):();
}