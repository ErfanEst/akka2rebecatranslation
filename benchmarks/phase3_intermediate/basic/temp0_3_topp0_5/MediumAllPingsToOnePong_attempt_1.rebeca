reactiveclass PingActor(pongId: int, id: int) {
    knownrebecs {
        PongActor pong: pongId;
    }

    msgsrv start() {
        ping();
    }

    msgsrv ping() {
        pong.ping(id);
    }
}

reactiveclass PongActor {
    knownrebecs {
    }

    msgsrv ping(int id) {
        self.pongForPing(id);
    }

    msgsrv pongForPing(int id) {
        // In Akka, pong replies to the sender.
        // Here we only model the behavior; no direct sender reference exists.
        // This can be extended if a mapping from id to PingActor is maintained.
    }
}

main {
    PongActor pong();

    PingActor p1(pong, 1);
    PingActor p2(pong, 2);
    PingActor p3(pong, 3);
    PingActor p4(pong, 4);
    PingActor p5(pong, 5);
    PingActor p6(pong, 6);
    PingActor p7(pong, 7);
    PingActor p8(pong, 8);
    PingActor p9(pong, 9);
    PingActor p10(pong, 10);

    p1.start();
    p2.start();
    p3.start();
    p4.start();
    p5.start();
    p6.start();
    p7.start();
    p8.start();
    p9.start();
    p10.start();
}