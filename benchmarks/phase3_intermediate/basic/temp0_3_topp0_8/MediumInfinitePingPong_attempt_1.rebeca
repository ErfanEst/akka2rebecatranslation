reactiveclass PingActor(pongActor) {
    knownrebecs {
        PongActor pongActor;
    }
    msgsrv Start() {
        pongActor.Ping();
    }
    msgsrv Pong() {
        pongActor.Ping();
    }
}

reactiveclass PongActor {
    knownrebecs { }
    msgsrv Ping() {
        sender.Pong();
    }
}

main {
    PongActor pongActor();
    PingActor pingActor(pongActor): (Start);
}