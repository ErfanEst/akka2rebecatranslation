reactiveclass Client {
    knownrebecs { Hub hub; }

    msgsrv initial() {
        start();
    }

    msgsrv start() {
        hub.Ping();
    }

    msgsrv Pong() {
        hub.Ping();
    }
}

reactiveclass Hub {
    knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; }

    msgsrv initial() {
        // Registration happens via environment in main
    }

    msgsrv Register(Client ref) {
        // In Rebeca, dynamic lists are not supported as in Akka;
        // registration is modeled in main by wiring known rebecs.
        // This msgsrv is kept for structural similarity but does nothing.
    }

    msgsrv Ping() {
        sender.Pong();
    }
}

main {
    Hub hub(c1, c2, c3, c4, c5);
    Client c1(hub);
    Client c2(hub);
    Client c3(hub);
    Client c4(hub);
    Client c5(hub);

    // Start all clients (equivalent to sending "start")
    c1.start();
    c2.start();
    c3.start();
    c4.start();
    c5.start();
}