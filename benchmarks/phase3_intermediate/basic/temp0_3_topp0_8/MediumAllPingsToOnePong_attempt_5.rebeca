reactiveclass PingActor {
	knownrebecs { 
		PongActor pongRef;
	}
	statevars { 
		int id; 
	}

	PingActor(PongActor pong, int pingId) {
		pongRef = pong;
		id = pingId;
		self.start();
	}

	msgsrv start() {
		pongRef.ping(id);
	}

	msgsrv pongResponse(int id, int pongId) {
		pongRef.ping(id);
	}
}

reactiveclass PongActor {
	knownrebecs { }

	PongActor() {
	}

	msgsrv ping(int id) {
		self.pongForPing(id);
	}

	msgsrv pongForPing(int id) {
		// response handling can be added here
	}
}

main {
	PongActor pong();

	PingActor ping1(pong, 1);
	PingActor ping2(pong, 2);
	PingActor ping3(pong, 3);
	PingActor ping4(pong, 4);
	PingActor ping5(pong, 5);
	PingActor ping6(pong, 6);
	PingActor ping7(pong, 7);
	PingActor ping8(pong, 8);
	PingActor ping9(pong, 9);
	PingActor ping10(pong, 10);
}