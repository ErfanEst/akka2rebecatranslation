reactiveclass PingActor(1) {
    knownrebecs { PongActor pong; }

    msgsrv Start() {
        pong.Ping();
    }

    msgsrv Pong() {
        pong.Ping();
    }
}

reactiveclass PongActor(1) {
    msgsrv Ping() {
        sender.Pong();
    }
}

main {
    PingActor ping(pong):();
    PongActor pong():();

    ping.Start();
}