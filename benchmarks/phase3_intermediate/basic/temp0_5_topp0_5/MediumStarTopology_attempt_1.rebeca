reactiveclass Client {
    knownrebecs { Hub hub; }

    msgsrv start() {
        hub.Ping();
    }

    msgsrv Pong() {
        hub.Ping();
    }

    msgsrv initial() {
        // no-op
    }
}

reactiveclass Hub {
    knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; }

    msgsrv Ping() {
        // In Akka, sender() is dynamic; in Rebeca we must choose explicitly.
        // Here we just respond to all known clients to approximate the behavior.
        c1.Pong();
        c2.Pong();
        c3.Pong();
        c4.Pong();
        c5.Pong();
    }

    msgsrv initial() {
        // no-op
    }
}

main {
    Hub hub(c1, c2, c3, c4, c5);
    Client c1(hub);
    Client c2(hub);
    Client c3(hub);
    Client c4(hub);
    Client c5(hub);

    c1.start();
    c2.start();
    c3.start();
    c4.start();
    c5.start();
}