reactiveclass PingActor {
	knownrebecs { 
		PongActor pong;
	}

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}

	PingActor(PongActor pong) {
		this.pong = pong;
	}
}

reactiveclass PongActor {
	knownrebecs { }

	msgsrv Ping() {
		sender.Pong();
	}

	PongActor() { }
}

main {
	PongActor pong();
	PingActor ping(pong);
	ping.Start();
}