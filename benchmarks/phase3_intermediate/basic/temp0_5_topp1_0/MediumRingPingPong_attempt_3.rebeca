reactiveclass RingActor {
	knownrebecs { 
		RingActor a2;
	}

	statevars {
		RingActor next;
	}

	msgsrv setNext(RingActor ref) {
		next = ref;
	}

	msgsrv ping() {
		next.ping();
	}

	RingActor() {
		// no initial behavior
	}
}

main {
	// declare rebec references
	RingActor a1(a2):();
	RingActor a2(a3):();
	RingActor a3(a4):();
	RingActor a4(a5):();
	RingActor a5(a1):();

	// initialize next pointers via messages
	a1.setNext(a2);
	a2.setNext(a3);
	a3.setNext(a4);
	a4.setNext(a5);
	a5.setNext(a1);

	// start the ping
	a1.ping();
}