reactiveclass Client {
	knownrebecs {
		Hub hub;
	}
	msgsrv initial(Hub h) {
		hub = h;
		start();
	}
	msgsrv start() {
		hub.Ping();
	}
	msgsrv Pong() {
		hub.Ping();
	}
}

reactiveclass Hub {
	knownrebecs {
		Client c1;
		Client c2;
		Client c3;
		Client c4;
		Client c5;
	}
	statevars {
		int registeredCount;
	}
	msgsrv initial(Client r1, Client r2, Client r3, Client r4, Client r5) {
		c1 = r1;
		c2 = r2;
		c3 = r3;
		c4 = r4;
		c5 = r5;
		registeredCount = 0;
		Register(c1);
		Register(c2);
		Register(c3);
		Register(c4);
		Register(c5);
	}
	msgsrv Register(Client ref) {
		registeredCount = registeredCount + 1;
		ref.start();
	}
	msgsrv Ping() {
		sender.Pong();
	}
}

main {
	Client c1(): (hub);
	Client c2(): (hub);
	Client c3(): (hub);
	Client c4(): (hub);
	Client c5(): (hub);
	Hub hub(): (c1, c2, c3, c4, c5);
}