reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}

	statevars {
		int id;
	}

	PingActor(PongActor pongArg) {
		pong = pongArg;
	}

	msgsrv start(int pongIdArg) {
		id = pongIdArg;
		pong.ping(id);
	}

	msgsrv pongResponse(int id, int pongId) {
		pong.ping(id);
	}
}

reactiveclass PongActor {
	knownrebecs {
	}

	statevars {
	}

	PongActor() {
	}

	msgsrv ping(int id) {
		self.pong(id);
	}

	msgsrv pong(int id) {
		// no-op
	}
}

main {
	PongActor pong();
	PingActor p1(pong);
	PingActor p2(pong);
	PingActor p3(pong);
	PingActor p4(pong);
	PingActor p5(pong);
	PingActor p6(pong);
	PingActor p7(pong);
	PingActor p8(pong);
	PingActor p9(pong);
	PingActor p10(pong);

	p1.start(1);
	p2.start(2);
	p3.start(3);
	p4.start(4);
	p5.start(5);
	p6.start(6);
	p7.start(7);
	p8.start(8);
	p9.start(9);
	p10.start(10);
}