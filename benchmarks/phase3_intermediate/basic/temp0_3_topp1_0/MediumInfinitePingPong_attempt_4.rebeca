reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}

	msgsrv initial() {
		// no initialization needed
	}
}

reactiveclass PongActor {
	knownrebecs {
		PingActor sender;
	}

	msgsrv Ping() {
		sender.Pong();
	}

	msgsrv initial() {
		// no initialization needed
	}
}

main {
	PingActor ping(pong):();
	PongActor pong(ping):();

	ping.Start();
}