reactiveclass PingActor(pongArg) {
	knownrebecs {
		PongActor pong;
	}
	statevars {
		int id;
	}

	PingActor(PongActor pongArg) {
		pong = pongArg;
		id = 0;
	}

	msgsrv initial(int i) {
		id = i;
		self.start();
	}

	msgsrv start() {
		pong.ping(id);
	}

	msgsrv pongFor(int pingId) {
		pong.ping(pingId);
	}
}

reactiveclass PongActor(p1Arg, p2Arg, p3Arg, p4Arg, p5Arg, p6Arg, p7Arg, p8Arg, p9Arg, p10Arg) {
	knownrebecs {
		PingActor ping1;
		PingActor ping2;
		PingActor ping3;
		PingActor ping4;
		PingActor ping5;
		PingActor ping6;
		PingActor ping7;
		PingActor ping8;
		PingActor ping9;
		PingActor ping10;
	}
	statevars {
	}

	PongActor(PingActor p1Arg, PingActor p2Arg, PingActor p3Arg, PingActor p4Arg,
	          PingActor p5Arg, PingActor p6Arg, PingActor p7Arg, PingActor p8Arg,
	          PingActor p9Arg, PingActor p10Arg) {
		ping1 = p1Arg;
		ping2 = p2Arg;
		ping3 = p3Arg;
		ping4 = p4Arg;
		ping5 = p5Arg;
		ping6 = p6Arg;
		ping7 = p7Arg;
		ping8 = p8Arg;
		ping9 = p9Arg;
		ping10 = p10Arg;
	}

	msgsrv ping(int id) {
		if (id == 1) {
			ping1.pongFor(id);
		} else if (id == 2) {
			ping2.pongFor(id);
		} else if (id == 3) {
			ping3.pongFor(id);
		} else if (id == 4) {
			ping4.pongFor(id);
		} else if (id == 5) {
			ping5.pongFor(id);
		} else if (id == 6) {
			ping6.pongFor(id);
		} else if (id == 7) {
			ping7.pongFor(id);
		} else if (id == 8) {
			ping8.pongFor(id);
		} else if (id == 9) {
			ping9.pongFor(id);
		} else if (id == 10) {
			ping10.pongFor(id);
		}
	}
}

main {
	PongActor pong(p1, p2, p3, p4, p5, p6, p7, p8, p9, p10):();
	PingActor p1(pong):(1);
	PingActor p2(pong):(2);
	PingActor p3(pong):(3);
	PingActor p4(pong):(4);
	PingActor p5(pong):(5);
	PingActor p6(pong):(6);
	PingActor p7(pong):(7);
	PingActor p8(pong):(8);
	PingActor p9(pong):(9);
	PingActor p10(pong):(10);
}