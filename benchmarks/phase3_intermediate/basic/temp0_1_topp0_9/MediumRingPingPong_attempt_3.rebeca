reactiveclass RingActor {
	knownrebecs {
		RingActor next;
	}

	msgsrv setNext(RingActor ref) {
		next = ref;
	}

	msgsrv ping() {
		next.ping();
	}

	RingActor() {
		// empty constructor
	}
}

main {
	knownrebecs {
		RingActor a1:();
		RingActor a2:();
		RingActor a3:();
		RingActor a4:();
		RingActor a5:();
	}

	main {
		a1.setNext(a2);
		a2.setNext(a3);
		a3.setNext(a4);
		a4.setNext(a5);
		a5.setNext(a1);

		a1.ping();
	}
}