reactiveclass PingActor {
    knownrebecs {
        PongActor pong;
    }

    msgsrv Start() {
        pong.Ping();
    }

    msgsrv Pong() {
        pong.Ping();
    }

    msgsrv initial() {
        // no-op
    }
}

reactiveclass PongActor {
    knownrebecs { }

    msgsrv Ping() {
        sender().Pong();
    }

    msgsrv initial() {
        // no-op
    }
}

main {
    PongActor pong();
    PingActor ping(pong);

    ping.Start();
}