reactiveclass RingActor {
    knownrebecs {
        RingActor next;
    }

    msgsrv Ping() {
        next.Ping();
    }

    msgsrv setNext(RingActor r) {
        next = r;
    }

    RingActor() {
        // constructor body can be empty
    }
}

main {
    RingActor a1(a2):();
    RingActor a2(a3):();
    RingActor a3(a4):();
    RingActor a4(a5):();
    RingActor a5(a1):();

    a1.Ping();
}