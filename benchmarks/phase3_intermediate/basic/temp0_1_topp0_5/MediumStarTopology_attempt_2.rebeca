reactiveclass Client(hub): {
	knownrebecs { Hub hub; }

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}

	msgsrv initial() {
		// no-op
	}
}

reactiveclass Hub(c1, c2, c3, c4, c5): {
	knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; }

	msgsrv Ping() {
		// generic Ping, no reply (cannot know sender)
	}

	msgsrv PingFromC1() {
		c1.Pong();
	}

	msgsrv PingFromC2() {
		c2.Pong();
	}

	msgsrv PingFromC3() {
		c3.Pong();
	}

	msgsrv PingFromC4() {
		c4.Pong();
	}

	msgsrv PingFromC5() {
		c5.Pong();
	}

	msgsrv initial() {
		// no-op
	}
}

main {
	Client c1(h);
	Client c2(h);
	Client c3(h);
	Client c4(h);
	Client c5(h);
	Hub h(c1, c2, c3, c4, c5);

	c1.start();
	c2.start();
	c3.start();
	c4.start();
	c5.start();
}