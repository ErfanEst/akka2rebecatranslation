reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}

	statevars {
		byte myId;
	}

	PingActor() {
	}

	msgsrv initial(PongActor p, byte id) {
		pong = p;
		myId = id;
		self.start();
	}

	msgsrv start() {
		ping();
	}

	msgsrv ping() {
		pong.pingFromPing(myId);
	}
}

reactiveclass PongActor {
	knownrebecs {
	}

	statevars {
	}

	PongActor() {
	}

	msgsrv pingFromPing(byte id) {
		self.pong(id);
	}

	msgsrv pong(byte id) {
		// corresponds to: sender() ! s"pong-for-ping-$id"
	}
}

main {
	PongActor pong():();
	PingActor ping1(pong, 1):();
	PingActor ping2(pong, 2):();
	PingActor ping3(pong, 3):();
	PingActor ping4(pong, 4):();
	PingActor ping5(pong, 5):();
	PingActor ping6(pong, 6):();
	PingActor ping7(pong, 7):();
	PingActor ping8(pong, 8):();
	PingActor ping9(pong, 9):();
	PingActor ping10(pong, 10):();

	pong.initial();
	ping1.initial(pong, 1);
	ping2.initial(pong, 2);
	ping3.initial(pong, 3);
	ping4.initial(pong, 4);
	ping5.initial(pong, 5);
	ping6.initial(pong, 6);
	ping7.initial(pong, 7);
	ping8.initial(pong, 8);
	ping9.initial(pong, 9);
	ping10.initial(pong, 10);
}