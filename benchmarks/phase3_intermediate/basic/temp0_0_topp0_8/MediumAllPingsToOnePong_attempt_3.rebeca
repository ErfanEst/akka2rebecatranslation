reactiveclass PingActor(pong: PongActor, _id: byte) {
	knownrebecs {
		PongActor pong;
	}

	statevars {
		byte myId;
	}

	PingActor(PongActor p, byte id) {
		pong = p;
		myId = id;
	}

	msgsrv start() {
		ping();
	}

	msgsrv ping() {
		pong.pingFromPing(myId);
	}
}

reactiveclass PongActor() {
	knownrebecs {
	}

	statevars {
	}

	PongActor() {
	}

	msgsrv pingFromPing(byte id) {
		self.pong(id);
	}

	msgsrv pong(byte id) {
		// corresponds to: sender() ! s"pong-for-ping-$id"
		// no-op or logging can be added if needed
	}
}

main {
	PongActor pong():();
	PingActor ping1(pong, 1):(pong, 1);
	PingActor ping2(pong, 2):(pong, 2);
	PingActor ping3(pong, 3):(pong, 3);
	PingActor ping4(pong, 4):(pong, 4);
	PingActor ping5(pong, 5):(pong, 5);
	PingActor ping6(pong, 6):(pong, 6);
	PingActor ping7(pong, 7):(pong, 7);
	PingActor ping8(pong, 8):(pong, 8);
	PingActor ping9(pong, 9):(pong, 9);
	PingActor ping10(pong, 10):(pong, 10);
}