reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}

	statevars {
		byte myId;
	}

	PingActor() {
	}

	msgsrv initial(byte id) {
		myId = id;
		self.start();
	}

	msgsrv start() {
		ping();
	}

	msgsrv ping() {
		pong.pingFromPing(myId);
	}
}

reactiveclass PongActor {
	knownrebecs {
	}

	statevars {
	}

	PongActor() {
	}

	msgsrv initial() {
	}

	msgsrv pingFromPing(byte id) {
		self.pong(id);
	}

	msgsrv pong(byte id) {
		// corresponds to: sender() ! s"pong-for-ping-$id"
	}
}

main {
	PongActor pong():();
	PingActor ping1(pong):();
	PingActor ping2(pong):();
	PingActor ping3(pong):();
	PingActor ping4(pong):();
	PingActor ping5(pong):();
	PingActor ping6(pong):();
	PingActor ping7(pong):();
	PingActor ping8(pong):();
	PingActor ping9(pong):();
	PingActor ping10(pong):();

	pong.initial();
	ping1.initial(1);
	ping2.initial(2);
	ping3.initial(3);
	ping4.initial(4);
	ping5.initial(5);
	ping6.initial(6);
	ping7.initial(7);
	ping8.initial(8);
	ping9.initial(9);
	ping10.initial(10);
}