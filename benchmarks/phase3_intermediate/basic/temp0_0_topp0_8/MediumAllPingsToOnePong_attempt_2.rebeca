reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}

	statevars {
		byte myId;
	}

	PingActor(PongActor p, byte _id) {
		pong = p;
		myId = _id;
	}

	msgsrv start() {
		ping();
	}

	msgsrv ping() {
		pong.pingFromPing(myId);
	}
}

reactiveclass PongActor {
	knownrebecs {
	}

	statevars {
	}

	PongActor() {
	}

	msgsrv pingFromPing(byte id) {
		self.pong(id);
	}

	msgsrv pong(byte id) {
		// corresponds to: sender() ! s"pong-for-ping-$id"
		// no-op or logging can be added if needed
	}
}

main {
	PongActor pong():();
	PingActor ping1(pong):(pong, 1);
	PingActor ping2(pong):(pong, 2);
	PingActor ping3(pong):(pong, 3);
	PingActor ping4(pong):(pong, 4);
	PingActor ping5(pong):(pong, 5);
	PingActor ping6(pong):(pong, 6);
	PingActor ping7(pong):(pong, 7);
	PingActor ping8(pong):(pong, 8);
	PingActor ping9(pong):(pong, 9);
	PingActor ping10(pong):(pong, 10);
}