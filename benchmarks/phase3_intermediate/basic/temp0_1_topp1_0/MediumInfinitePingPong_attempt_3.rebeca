reactiveclass PingActor {
	knownrebecs { PongActor pong; }

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}

	constructor(PongActor pongRef) {
		pong = pongRef;
	}
}

reactiveclass PongActor {
	knownrebecs { }

	msgsrv Ping() {
		sender.Pong();
	}

	constructor() {
	}
}

main {
	PongActor pong():();
	PingActor ping(pong):();

	ping.Start();
}