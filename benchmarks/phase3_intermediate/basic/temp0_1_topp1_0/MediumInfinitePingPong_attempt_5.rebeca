reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}

	PingActor(PongActor pongRef) {
		pong = pongRef;
	}
}

reactiveclass PongActor {
	knownrebecs {
		PingActor ping;
	}

	msgsrv Ping() {
		ping.Pong();
	}

	PongActor(PingActor pingRef) {
		ping = pingRef;
	}
}

main {
	PingActor ping(pong):();
	PongActor pong(ping):();

	ping.Start();
}