reactiveclass Client(5) {
  knownrebecs { Hub hub; } 
  statevars { }

  msgsrv initial() { 
    hub.Ping(); 
  }

  msgsrv Pong() { 
    hub.Ping(); 
  }
}

reactiveclass Hub(10) {
  knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; } 
  statevars { }

  msgsrv initial() { 
    c1.Register(); 
    c2.Register(); 
    c3.Register(); 
    c4.Register(); 
    c5.Register(); 
  }

  msgsrv Register() { 
    // registration logic implicit via knownrebecs
  }

  msgsrv Ping() { 
    sender.Pong(); 
  }
}

main {
  Hub hub(c1, c2, c3, c4, c5):();
  Client c1(hub):();
  Client c2(hub):();
  Client c3(hub):();
  Client c4(hub):();
  Client c5(hub):();
}