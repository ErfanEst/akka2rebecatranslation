reactiveclass Client(5) {
	knownrebecs { Hub hub; }
	statevars { }

	Client() { }

	msgsrv initial() { hub.Register(self); self.start(); }

	msgsrv start() { hub.Ping(); }

	msgsrv Pong() { hub.Ping(); }
}

reactiveclass Hub(10) {
	knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; }
	statevars { int clientCount; }

	Hub() {
		clientCount = 0;
	}

	msgsrv Register(Client ref) {
		if (clientCount < 5) {
			if (clientCount == 0) { c1 = ref; }
			else if (clientCount == 1) { c2 = ref; }
			else if (clientCount == 2) { c3 = ref; }
			else if (clientCount == 3) { c4 = ref; }
			else if (clientCount == 4) { c5 = ref; }
			clientCount = clientCount + 1;
		}
	}

	msgsrv Ping() {
		// Rebeca has no sender(), so we use a fixed client (e.g., c1) to respond
		c1.Pong();
	}
}

main {
	Client c1(hub):();
	Client c2(hub):();
	Client c3(hub):();
	Client c4(hub):();
	Client c5(hub):();
	Hub hub(c1, c2, c3, c4, c5):();
}