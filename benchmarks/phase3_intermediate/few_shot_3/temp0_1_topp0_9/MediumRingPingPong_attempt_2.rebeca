reactiveclass RingActor(5) {
	knownrebecs { RingActor next; }
	statevars { boolean initialized; RingActor tempNext; }

	RingActor(RingActor n) {
		initialized = false;
		tempNext = n;
		self.SetNext();
	}

	msgsrv SetNext() {
		next = tempNext;
		initialized = true;
	}

	msgsrv Ping() {
		if (initialized) {
			next.Ping();
		}
	}
}

main {
	RingActor a1(a2):();
	RingActor a2(a3):();
	RingActor a3(a4):();
	RingActor a4(a5):();
	RingActor a5(a1):();

	a1.Ping():();
}