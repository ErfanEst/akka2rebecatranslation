reactiveclass Client(5) {
  knownrebecs { Hub hub; }
  statevars { }

  Client() { }

  msgsrv initial() { }

  msgsrv start() {
    hub.Ping();
  }

  msgsrv Pong() {
    hub.Ping();
  }
}

reactiveclass Hub(5) {
  knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; }
  statevars { int[5] clients; int clientCount; }

  Hub() {
    clientCount = 0;
  }

  msgsrv initial() { }

  msgsrv Register1() {
    if (clientCount < 5) {
      clients[clientCount] = 1;
      clientCount = clientCount + 1;
    }
  }

  msgsrv Register2() {
    if (clientCount < 5) {
      clients[clientCount] = 2;
      clientCount = clientCount + 1;
    }
  }

  msgsrv Register3() {
    if (clientCount < 5) {
      clients[clientCount] = 3;
      clientCount = clientCount + 1;
    }
  }

  msgsrv Register4() {
    if (clientCount < 5) {
      clients[clientCount] = 4;
      clientCount = clientCount + 1;
    }
  }

  msgsrv Register5() {
    if (clientCount < 5) {
      clients[clientCount] = 5;
      clientCount = clientCount + 1;
    }
  }

  msgsrv PingFrom1() {
    c1.Pong();
  }

  msgsrv PingFrom2() {
    c2.Pong();
  }

  msgsrv PingFrom3() {
    c3.Pong();
  }

  msgsrv PingFrom4() {
    c4.Pong();
  }

  msgsrv PingFrom5() {
    c5.Pong();
  }
}

main {
  Hub hub(c1, c2, c3, c4, c5):();
  Client c1(hub):();
  Client c2(hub):();
  Client c3(hub):();
  Client c4(hub):();
  Client c5(hub):();

  hub.Register1();
  hub.Register2();
  hub.Register3();
  hub.Register4();
  hub.Register5();

  c1.start();
  c2.start();
  c3.start();
  c4.start();
  c5.start();
}