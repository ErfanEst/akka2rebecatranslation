reactiveclass Client(5) {
	knownrebecs { Hub hub; } 
	statevars { }

	Client() { }

	msgsrv initial() { hub.Ping(); }

	msgsrv Pong() { hub.Ping(); }
}

reactiveclass Hub(10) {
	knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; }
	statevars { }

	Hub() { }

	msgsrv Register1() { }
	msgsrv Register2() { }
	msgsrv Register3() { }
	msgsrv Register4() { }
	msgsrv Register5() { }

	msgsrv Ping() { c1.Pong(); }
}

main {
	Client c1(h):();
	Client c2(h):();
	Client c3(h):();
	Client c4(h):();
	Client c5(h):();
	Hub h(c1, c2, c3, c4, c5):();
}