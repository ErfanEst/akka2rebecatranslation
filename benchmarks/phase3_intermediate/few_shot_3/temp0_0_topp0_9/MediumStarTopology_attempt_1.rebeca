reactiveclass Client(5) {
  knownrebecs { Hub hub; }
  statevars { }

  Client() {
    self.start();
  }

  msgsrv start() {
    hub.Ping();
  }

  msgsrv Pong() {
    hub.Ping();
  }
}

reactiveclass Hub(5) {
  knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; }
  statevars { }

  Hub() {
    self.Register(c1);
    self.Register(c2);
    self.Register(c3);
    self.Register(c4);
    self.Register(c5);
  }

  msgsrv Register(Client ref) {
    // no-op, registration ignored in this simplified model
  }

  msgsrv Ping() {
    sender.Pong();
  }
}

main {
  Hub h(c1, c2, c3, c4, c5):();
  Client c1(h):();
  Client c2(h):();
  Client c3(h):();
  Client c4(h):();
  Client c5(h):();
}