reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}

	statevars {
	}

	msgsrv initial(PongActor pongActor) {
		pong = pongActor;
	}

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor {
	knownrebecs {
	}

	statevars {
	}

	msgsrv initial() {
	}

	msgsrv Ping() {
		self.Pong();
	}

	msgsrv Pong() {
	}
}

main {
	PongActor pong():();
	PingActor ping(pong):(pong);

	ping.Start();
}