reactiveclass Client {
	knownrebecs { 
		Hub hub;
	}
	statevars { 
	}

	Client(Hub h) {
		hub = h;
	}

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}
}

reactiveclass Hub {
	knownrebecs { 
		Client c1;
		Client c2;
		Client c3;
		Client c4;
		Client c5;
	}
	statevars { 
		Client clients[5];
		int count;
	}

	Hub(Client rc1, Client rc2, Client rc3, Client rc4, Client rc5) {
		c1 = rc1;
		c2 = rc2;
		c3 = rc3;
		c4 = rc4;
		c5 = rc5;
		count = 0;
	}

	msgsrv Register(Client ref) {
		if (count < 5) {
			clients[count] = ref;
			count = count + 1;
		}
	}

	msgsrv Ping() {
		sender.Pong();
	}
}

main {
	Client c1(hub);
	Client c2(hub);
	Client c3(hub);
	Client c4(hub);
	Client c5(hub);
	Hub hub(c1, c2, c3, c4, c5);

	hub.Register(c1);
	c1.start();

	hub.Register(c2);
	c2.start();

	hub.Register(c3);
	c3.start();

	hub.Register(c4);
	c4.start();

	hub.Register(c5);
	c5.start();
}