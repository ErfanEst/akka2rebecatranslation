reactiveclass PingActor {
	knownrebecs { 
		PongActor pong;
	}
	statevars {
		int id;
	}

	PingActor(int _id) {
		id = _id;
	}

	msgsrv start() {
		pong.ping(id);
	}

	msgsrv pingBack(string msg) {
		pong.ping(id);
	}
}

reactiveclass PongActor {
	knownrebecs {
	}
	statevars {
	}

	PongActor() {
	}

	msgsrv ping(int id) {
		self.pongForPing(id);
	}

	msgsrv pongForPing(int id) {
		// sender() ! s"pong-for-$msg" is not directly representable in Rebeca
		// as dynamic sender reference; here it's modeled as self-call placeholder
	}
}

main {
	PongActor pong();
	PingActor p1(pong):();
	PingActor p2(pong):();
	PingActor p3(pong):();
	PingActor p4(pong):();
	PingActor p5(pong):();
	PingActor p6(pong):();
	PingActor p7(pong):();
	PingActor p8(pong):();
	PingActor p9(pong):();
	PingActor p10(pong):();

	p1.start();
	p2.start();
	p3.start();
	p4.start();
	p5.start();
	p6.start();
	p7.start();
	p8.start();
	p9.start();
	p10.start();
}