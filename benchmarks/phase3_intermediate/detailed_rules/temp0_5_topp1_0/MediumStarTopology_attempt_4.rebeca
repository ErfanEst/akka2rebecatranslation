reactiveclass Client {
	knownrebecs {
		Hub hub;
	}
	statevars {
	}

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}

	msgsrv initial() {
	}
}

reactiveclass Hub {
	knownrebecs {
		Client c1;
		Client c2;
		Client c3;
		Client c4;
		Client c5;
	}
	statevars {
		Client clients[5];
		int clientCount;
	}

	msgsrv initial() {
		clientCount = 0;
		clients[0] = c1;
		clients[1] = c2;
		clients[2] = c3;
		clients[3] = c4;
		clients[4] = c5;
	}

	msgsrv Register(Client ref) {
		if (clientCount < 5) {
			clients[clientCount] = ref;
			clientCount = clientCount + 1;
		}
	}

	msgsrv Ping() {
		sender.Pong();
	}
}

main {
	Hub hub(c1, c2, c3, c4, c5):();
	Client c1(hub):();
	Client c2(hub):();
	Client c3(hub):();
	Client c4(hub):();
	Client c5(hub):();

	c1.Register(c1);
	c2.Register(c2);
	c3.Register(c3);
	c4.Register(c4);
	c5.Register(c5);

	c1.start();
	c2.start();
	c3.start();
	c4.start();
	c5.start();
}