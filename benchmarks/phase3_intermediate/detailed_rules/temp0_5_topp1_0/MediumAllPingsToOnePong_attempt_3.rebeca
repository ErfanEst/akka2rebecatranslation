reactiveclass PingActor {
	knownrebecs { 
		PongActor pong;
	}
	statevars {
		int id;
	}

	PingActor(PongActor _pong, int _id) {
		pong = _pong;
		id = _id;
	}

	msgsrv start() {
		pong.ping(id);
	}

	msgsrv pingBack(char msg) {
		pong.ping(id);
	}
}

