reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}

	statevars {
		int id;
	}

	PingActor(PongActor _pong, int _id) {
		pong = _pong;
		id = _id;
	}

	msgsrv start() {
		pong.ping(id);
	}

	msgsrv pongForPing(char msg[]) {
		pong.ping(id);
	}
}

reactiveclass PongActor {
	knownrebecs {
		PingActor ping1;
		PingActor ping2;
		PingActor ping3;
		PingActor ping4;
		PingActor ping5;
		PingActor ping6;
		PingActor ping7;
		PingActor ping8;
		PingActor ping9;
		PingActor ping10;
	}

	PongActor(PingActor _ping1, PingActor _ping2, PingActor _ping3, PingActor _ping4, PingActor _ping5, PingActor _ping6, PingActor _ping7, PingActor _ping8, PingActor _ping9, PingActor _ping10) {
		ping1 = _ping1;
		ping2 = _ping2;
		ping3 = _ping3;
		ping4 = _ping4;
		ping5 = _ping5;
		ping6 = _ping6;
		ping7 = _ping7;
		ping8 = _ping8;
		ping9 = _ping9;
		ping10 = _ping10;
	}

	msgsrv ping(int id) {
		if (id == 1) {
			ping1.pongForPing("pong-for-ping-1");
		} else if (id == 2) {
			ping2.pongForPing("pong-for-ping-2");
		} else if (id == 3) {
			ping3.pongForPing("pong-for-ping-3");
		} else if (id == 4) {
			ping4.pongForPing("pong-for-ping-4");
		} else if (id == 5) {
			ping5.pongForPing("pong-for-ping-5");
		} else if (id == 6) {
			ping6.pongForPing("pong-for-ping-6");
		} else if (id == 7) {
			ping7.pongForPing("pong-for-ping-7");
		} else if (id == 8) {
			ping8.pongForPing("pong-for-ping-8");
		} else if (id == 9) {
			ping9.pongForPing("pong-for-ping-9");
		} else if (id == 10) {
			ping10.pongForPing("pong-for-ping-10");
		}
	}
}

main {
	PingActor ping1(pong, 1):();
	PingActor ping2(pong, 2):();
	PingActor ping3(pong, 3):();
	PingActor ping4(pong, 4):();
	PingActor ping5(pong, 5):();
	PingActor ping6(pong, 6):();
	PingActor ping7(pong, 7):();
	PingActor ping8(pong, 8):();
	PingActor ping9(pong, 9):();
	PingActor ping10(pong, 10):();
	PongActor pong(ping1, ping2, ping3, ping4, ping5, ping6, ping7, ping8, ping9, ping10):();

	ping1.start();
	ping2.start();
	ping3.start();
	ping4.start();
	ping5.start();
	ping6.start();
	ping7.start();
	ping8.start();
	ping9.start();
	ping10.start();
}