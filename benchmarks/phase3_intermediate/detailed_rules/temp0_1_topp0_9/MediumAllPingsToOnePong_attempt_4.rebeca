reactiveclass PingActor {
	knownrebecs { 
		PongActor pong;
	}
	statevars {
		byte id;
	}

	PingActor() {
	}

	msgsrv start(byte _id) {
		id = _id;
		pong.ping(id);
	}

	msgsrv pongForPing() {
		pong.ping(id);
	}
}

reactiveclass PongActor {
	knownrebecs {
		PingActor ping1;
		PingActor ping2;
		PingActor ping3;
		PingActor ping4;
		PingActor ping5;
		PingActor ping6;
		PingActor ping7;
		PingActor ping8;
		PingActor ping9;
		PingActor ping10;
	}
	PongActor() {
	}

	msgsrv ping(byte id) {
		if (id == 1) {
			ping1.pongForPing();
		} else if (id == 2) {
			ping2.pongForPing();
		} else if (id == 3) {
			ping3.pongForPing();
		} else if (id == 4) {
			ping4.pongForPing();
		} else if (id == 5) {
			ping5.pongForPing();
		} else if (id == 6) {
			ping6.pongForPing();
		} else if (id == 7) {
			ping7.pongForPing();
		} else if (id == 8) {
			ping8.pongForPing();
		} else if (id == 9) {
			ping9.pongForPing();
		} else if (id == 10) {
			ping10.pongForPing();
		}
	}
}

main {
	PingActor ping1(pong):();
	PingActor ping2(pong):();
	PingActor ping3(pong):();
	PingActor ping4(pong):();
	PingActor ping5(pong):();
	PingActor ping6(pong):();
	PingActor ping7(pong):();
	PingActor ping8(pong):();
	PingActor ping9(pong):();
	PingActor ping10(pong):();
	PongActor pong(ping1, ping2, ping3, ping4, ping5, ping6, ping7, ping8, ping9, ping10):();

	ping1.start(1);
	ping2.start(2);
	ping3.start(3);
	ping4.start(4);
	ping5.start(5);
	ping6.start(6);
	ping7.start(7);
	ping8.start(8);
	ping9.start(9);
	ping10.start(10);
}