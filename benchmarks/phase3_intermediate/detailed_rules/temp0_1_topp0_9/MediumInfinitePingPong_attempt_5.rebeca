reactiveclass PingActor {
	knownrebecs { 
		PongActor pong;
	}
	statevars { 
	}

	PingActor() {
	}

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor {
	knownrebecs {
		PingActor ping;
	}

	statevars {
	}

	PongActor() {
	}

	msgsrv Ping() {
		ping.Pong();
	}
}

main {
	PingActor ping(pong):();
	PongActor pong(ping):();
	ping.Start():();
}