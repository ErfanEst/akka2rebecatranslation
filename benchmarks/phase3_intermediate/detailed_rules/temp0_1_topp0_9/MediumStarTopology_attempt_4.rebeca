reactiveclass Client(hub) {
	knownrebecs { 
		Hub hub;
	}
	statevars {
	}

	Client() {
	}

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}
}

reactiveclass Hub(c1, c2, c3, c4, c5) {
	knownrebecs {
		Client c1;
		Client c2;
		Client c3;
		Client c4;
		Client c5;
	}
	statevars {
		boolean r1;
		boolean r2;
		boolean r3;
		boolean r4;
		boolean r5;
	}

	Hub() {
		r1 = false;
		r2 = false;
		r3 = false;
		r4 = false;
		r5 = false;
	}

	msgsrv Register1() {
		r1 = true;
		c1.start();
	}

	msgsrv Register2() {
		r2 = true;
		c2.start();
	}

	msgsrv Register3() {
		r3 = true;
		c3.start();
	}

	msgsrv Register4() {
		r4 = true;
		c4.start();
	}

	msgsrv Register5() {
		r5 = true;
		c5.start();
	}

	msgsrv Ping() {
		self.PongToSender();
	}

	msgsrv PongToSender() {
		// no-op
	}

	msgsrv PongFromClient1() {
		c1.Pong();
	}

	msgsrv PongFromClient2() {
		c2.Pong();
	}

	msgsrv PongFromClient3() {
		c3.Pong();
	}

	msgsrv PongFromClient4() {
		c4.Pong();
	}

	msgsrv PongFromClient5() {
		c5.Pong();
	}
}

main {
	Hub hub(c1, c2, c3, c4, c5): ();
	Client c1(hub): ();
	Client c2(hub): ();
	Client c3(hub): ();
	Client c4(hub): ();
	Client c5(hub): ();

	hub.Register1();
	hub.Register2();
	hub.Register3();
	hub.Register4();
	hub.Register5();
}