reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}

	statevars {
	}

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor {
	knownrebecs {
		PingActor ping;
	}

	statevars {
	}

	msgsrv Ping() {
		ping.Pong();
	}
}

main {
	PingActor ping();
	PongActor pong(ping);

	ping.Start();
}