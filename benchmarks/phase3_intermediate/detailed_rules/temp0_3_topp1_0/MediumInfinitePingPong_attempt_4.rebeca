reactiveclass PingActor(pongActor : PongActor) {
	knownrebecs {
		PongActor pong;
	}
	statevars {
	}

	constructor(PongActor pongActor) {
		pong = pongActor;
	}

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor {
	knownrebecs {
	}
	statevars {
	}

	msgsrv Ping() {
		sender.Pong();
	}
}

main {
	PongActor pong();
	PingActor ping(pong): (pong);

	ping.Start();
}