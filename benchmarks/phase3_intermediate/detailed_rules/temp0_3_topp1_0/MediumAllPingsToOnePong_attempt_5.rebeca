reactiveclass PongActor {
	knownrebecs {
	}
	statevars {
	}

	PongActor() {
	}

	msgsrv ping(byte id) {
		sender.pongResponse(id);
	}
}

reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}
	statevars {
		byte id;
	}

	PingActor(byte myId, PongActor p) {
		id = myId;
		pong = p;
	}

	msgsrv start() {
		pong.ping(id);
	}

	msgsrv pongResponse(byte respId) {
		pong.ping(id);
	}
}

main {
	PongActor pong() : ();

	PingActor ping1(pong) : (1, pong);
	PingActor ping2(pong) : (2, pong);
	PingActor ping3(pong) : (3, pong);
	PingActor ping4(pong) : (4, pong);
	PingActor ping5(pong) : (5, pong);
	PingActor ping6(pong) : (6, pong);
	PingActor ping7(pong) : (7, pong);
	PingActor ping8(pong) : (8, pong);
	PingActor ping9(pong) : (9, pong);
	PingActor ping10(pong) : (10, pong);

	ping1.start() : ();
	ping2.start() : ();
	ping3.start() : ();
	ping4.start() : ();
	ping5.start() : ();
	ping6.start() : ();
	ping7.start() : ();
	ping8.start() : ();
	ping9.start() : ();
	ping10.start() : ();
}