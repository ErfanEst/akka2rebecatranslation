reactiveclass PingActor {
	knownrebecs { 
		PongActor pong;
	}

	statevars {
	}

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor {
	knownrebecs { 
	}

	statevars {
	}

	msgsrv Ping() {
		self.Pong();
	}
}

main {
	PongActor pong();
	PingActor ping(pong): Start();
}