reactiveclass RingActor(byte dummy) {
	knownrebecs {
	}

	statevars {
		boolean isNextSet;
		RingActor next;
	}

	msgsrv initial() {
		isNextSet = false;
	}

	msgsrv setNext(RingActor ref) {
		if (!isNextSet) {
			next = ref;
			isNextSet = true;
		}
	}

	msgsrv ping() {
		next.ping();
	}
}

main {
	RingActor a1(0):();
	RingActor a2(0):();
	RingActor a3(0):();
	RingActor a4(0):();
	RingActor a5(0):();

	a1.setNext(a2):();
	a2.setNext(a3):();
	a3.setNext(a4):();
	a4.setNext(a5):();
	a5.setNext(a1):();

	a1.ping():();
}