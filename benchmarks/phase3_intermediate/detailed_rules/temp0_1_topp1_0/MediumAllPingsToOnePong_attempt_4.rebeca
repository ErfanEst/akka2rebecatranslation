reactiveclass PingActor(pong): knownrebecs {
	PongActor pong;
} statevars {
	byte id;
} 

reactiveclass PongActor() {
	knownrebecs {
	}
	statevars {
	}

	PongActor() {
	}

	msgsrv ping(byte id) {
		self.pongFor(id);
	}

	msgsrv pongFor(byte id) {
	}
}

reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}
	statevars {
		byte id;
	}

	PingActor(PongActor p, byte i) {
		pong = p;
		id = i;
	}

	msgsrv start() {
		pong.ping(id);
	}

	msgsrv msg(byte m) {
		pong.ping(id);
	}
}

main {
	PongActor pong() : ();

	PingActor ping1(pong) : (pong, 1);
	PingActor ping2(pong) : (pong, 2);
	PingActor ping3(pong) : (pong, 3);
	PingActor ping4(pong) : (pong, 4);
	PingActor ping5(pong) : (pong, 5);
	PingActor ping6(pong) : (pong, 6);
	PingActor ping7(pong) : (pong, 7);
	PingActor ping8(pong) : (pong, 8);
	PingActor ping9(pong) : (pong, 9);
	PingActor ping10(pong) : (pong, 10);

	pong.start():();
	ping1.start():();
	ping2.start():();
	ping3.start():();
	ping4.start():();
	ping5.start():();
	ping6.start():();
	ping7.start():();
	ping8.start():();
	ping9.start():();
	ping10.start():();
}