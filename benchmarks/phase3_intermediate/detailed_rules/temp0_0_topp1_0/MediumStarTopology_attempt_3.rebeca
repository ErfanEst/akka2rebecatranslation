reactiveclass Client {
	knownrebecs {
		Hub hub;
	}

	statevars {
	}

	msgrv start() {
		hub.Ping();
	}

	msgrv Pong() {
		hub.Ping();
	}
}

reactiveclass Hub {
	knownrebecs {
		Client c1;
		Client c2;
		Client c3;
		Client c4;
		Client c5;
	}

	statevars {
		boolean r1;
		boolean r2;
		boolean r3;
		boolean r4;
		boolean r5;
	}

	msgrv initial() {
		r1 = false;
		r2 = false;
		r3 = false;
		r4 = false;
		r5 = false;

		self.Register1();
		self.Register2();
		self.Register3();
		self.Register4();
		self.Register5();

		c1.start();
		c2.start();
		c3.start();
		c4.start();
		c5.start();
	}

	msgrv Register1() {
		r1 = true;
	}

	msgrv Register2() {
		r2 = true;
	}

	msgrv Register3() {
		r3 = true;
	}

	msgrv Register4() {
		r4 = true;
	}

	msgrv Register5() {
		r5 = true;
	}

	msgrv Ping() {
		if (r1) c1.Pong();
		if (r2) c2.Pong();
		if (r3) c3.Pong();
		if (r4) c4.Pong();
		if (r5) c5.Pong();
	}
}

main {
	Client c1(hub):();
	Client c2(hub):();
	Client c3(hub):();
	Client c4(hub):();
	Client c5(hub):();
	Hub hub(c1, c2, c3, c4, c5):();
}