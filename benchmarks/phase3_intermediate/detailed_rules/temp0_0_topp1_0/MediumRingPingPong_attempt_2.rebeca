reactiveclass RingActor {
	knownrebecs { 
		RingActor next;
	}

	statevars {
		RingActor nextLocal;
	}

	msgrv SetNext(RingActor ref) {
		nextLocal = ref;
	}

	msgrv Ping() {
		nextLocal.Ping();
	}
}

main {
	RingActor a1(a2): (a2);
	RingActor a2(a3): (a3);
	RingActor a3(a4): (a4);
	RingActor a4(a5): (a5);
	RingActor a5(a1): (a1);

	a1.Ping();
}