reactiveclass Client(HubInterface h) {
	knownrebecs {
		HubInterface hub;
	}

	statevars {
	}

	Client(HubInterface h) {
		hub = h;
	}

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}
}

reactiveclass Hub(CInterface rc1, CInterface rc2, CInterface rc3, CInterface rc4, CInterface rc5) {
	knownrebecs {
		CInterface c1;
		CInterface c2;
		CInterface c3;
		CInterface c4;
		CInterface c5;
	}

	statevars {
		boolean r1;
		boolean r2;
		boolean r3;
		boolean r4;
		boolean r5;
	}

	Hub(CInterface rc1, CInterface rc2, CInterface rc3, CInterface rc4, CInterface rc5) {
		c1 = rc1;
		c2 = rc2;
		c3 = rc3;
		c4 = rc4;
		c5 = rc5;
		self.initial();
	}

	msgsrv initial() {
		r1 = false;
		r2 = false;
		r3 = false;
		r4 = false;
		r5 = false;

		self.Register1();
		self.Register2();
		self.Register3();
		self.Register4();
		self.Register5();

		c1.start();
		c2.start();
		c3.start();
		c4.start();
		c5.start();
	}

	msgsrv Register1() {
		r1 = true;
	}

	msgsrv Register2() {
		r2 = true;
	}

	msgsrv Register3() {
		r3 = true;
	}

	msgsrv Register4() {
		r4 = true;
	}

	msgsrv Register5() {
		r5 = true;
	}

	msgsrv Ping() {
		if (r1) c1.Pong();
		if (r2) c2.Pong();
		if (r3) c3.Pong();
		if (r4) c4.Pong();
		if (r5) c5.Pong();
	}
}

main {
	Hub hub(c1, c2, c3, c4, c5):();
	Client c1(hub):();
	Client c2(hub):();
	Client c3(hub):();
	Client c4(hub):();
	Client c5(hub):();
}