reactiveclass Client {
	knownrebecs { 
		Hub hub;
	}
	statevars { 
	}

	Client() {
	}

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}
}

reactiveclass Hub {
	knownrebecs { 
		Client c1;
		Client c2;
		Client c3;
		Client c4;
		Client c5;
	}
	statevars {
		int registeredCount;
	}

	Hub() {
		registeredCount = 0;
	}

	msgsrv Register(Client ref) {
		registeredCount = registeredCount + 1;
	}

	msgsrv Ping() {
		sender.Pong();
	}
}

main {
	Hub hub(c1, c2, c3, c4, c5):();
	Client c1(hub):();
	Client c2(hub):();
	Client c3(hub):();
	Client c4(hub):();
	Client c5(hub):();

	hub.Register(c1):();
	c1.start():();

	hub.Register(c2):();
	c2.start():();

	hub.Register(c3):();
	c3.start():();

	hub.Register(c4):();
	c4.start():();

	hub.Register(c5):();
	c5.start():();
}