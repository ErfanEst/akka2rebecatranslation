reactiveclass PingActor(pongActor pong) {
	statevars {
	}

	msgsrv initial() {
		self.Start();
	}

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor {
	statevars {
	}

	msgsrv initial() {
	}

	msgsrv Ping() {
		self.Pong();
	}

	msgsrv Pong() {
		// no-op, to match the message type
	}
}

main {
	PongActor pong();
	PingActor ping(pong);
}