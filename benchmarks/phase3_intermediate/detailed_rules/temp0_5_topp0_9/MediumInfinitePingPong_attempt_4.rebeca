reactiveclass PingActor {
	knownrebecs { 
		PongActor pong;
	}

	statevars {
	}

	msgsrv initial() {
		self.Start();
	}

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor {
	knownrebecs {
	}

	statevars {
	}

	msgsrv initial() {
	}

	msgsrv Ping() {
		self.Pong();
	}

	msgsrv Pong() {
		// no-op, to match the message type
	}
}

main {
	PongActor pong();
	PingActor ping(pong);
}