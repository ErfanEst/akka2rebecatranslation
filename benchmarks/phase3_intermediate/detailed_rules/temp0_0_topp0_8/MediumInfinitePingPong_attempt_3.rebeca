reactiveclass PingActor() {
	knownrebecs {
		PongActor pong;
	}

	statevars {
	}

	msgsrv initial() {
	}

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor(PingActor ping) {
	knownrebecs {
		PingActor ping;
	}

	statevars {
	}

	msgsrv initial() {
	}

	msgsrv Ping() {
		ping.Pong();
	}
}

main {
	PingActor ping(): ();
	PongActor pong(ping): ();
}