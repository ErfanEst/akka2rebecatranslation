reactiveclass Client {
	knownrebecs { 
		Hub hub;
	}
	statevars { 
	}

	Client(Hub h) {
		hub = h;
	}

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}
}

reactiveclass Hub {
	knownrebecs {
		Client c1;
		Client c2;
		Client c3;
		Client c4;
		Client c5;
	}
	statevars {
		boolean r1;
		boolean r2;
		boolean r3;
		boolean r4;
		boolean r5;
	}

	Hub(Client c1, Client c2, Client c3, Client c4, Client c5) {
		this.c1 = c1;
		this.c2 = c2;
		this.c3 = c3;
		this.c4 = c4;
		this.c5 = c5;

		r1 = false;
		r2 = false;
		r3 = false;
		r4 = false;
		r5 = false;
	}

	msgsrv Register1() {
		r1 = true;
	}

	msgsrv Register2() {
		r2 = true;
	}

	msgsrv Register3() {
		r3 = true;
	}

	msgsrv Register4() {
		r4 = true;
	}

	msgsrv Register5() {
		r5 = true;
	}

	msgsrv Ping() {
		// Rebeca does not support sender; explicitly choose a client
		c1.Pong();
	}
}

main {
	Client c1(hub):();
	Client c2(hub):();
	Client c3(hub):();
	Client c4(hub):();
	Client c5(hub):();
	Hub hub(c1, c2, c3, c4, c5):();

	hub.Register1();
	hub.Register2();
	hub.Register3();
	hub.Register4();
	hub.Register5();

	c1.start();
	c2.start();
	c3.start();
	c4.start();
	c5.start();
}