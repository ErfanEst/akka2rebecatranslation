reactiveclass Client(hubType) {
	knownrebecs { 
		hubType hub;
	}
	statevars { 
	}

	Client() {
	}

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}
}

reactiveclass Hub(clientType) {
	knownrebecs {
		clientType c1;
		clientType c2;
		clientType c3;
		clientType c4;
		clientType c5;
	}
	statevars {
		boolean r1;
		boolean r2;
		boolean r3;
		boolean r4;
		boolean r5;
	}

	Hub() {
		r1 = false;
		r2 = false;
		r3 = false;
		r4 = false;
		r5 = false;
	}

	msgsrv Register1() {
		r1 = true;
	}

	msgsrv Register2() {
		r2 = true;
	}

	msgsrv Register3() {
		r3 = true;
	}

	msgsrv Register4() {
		r4 = true;
	}

	msgsrv Register5() {
		r5 = true;
	}

	msgsrv Ping() {
		c1.Pong();
	}
}

main {
	Client<Hub> c1(hub):();
	Client<Hub> c2(hub):();
	Client<Hub> c3(hub):();
	Client<Hub> c4(hub):();
	Client<Hub> c5(hub):();
	Hub<Client> hub(c1, c2, c3, c4, c5):();

	hub.Register1():();
	hub.Register2():();
	hub.Register3():();
	hub.Register4():();
	hub.Register5():();

	c1.start():();
	c2.start():();
	c3.start():();
	c4.start():();
	c5.start():();
}