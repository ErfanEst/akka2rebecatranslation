reactiveclass RingActor {
	knownrebecs {
		RingActor next;
	}

	statevars {
	}

	RingActor(RingActor n) {
		next = n;
		self.initial();
	}

	msgsrv initial() {
		// nothing
	}

	msgsrv Ping() {
		next.Ping();
	}
}

main {
	RingActor a1(a2):();
	RingActor a2(a3):();
	RingActor a3(a4):();
	RingActor a4(a5):();
	RingActor a5(a1):();

	a1.Ping();
}