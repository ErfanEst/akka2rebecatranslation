reactiveclass PongActor {
	knownrebecs {
		PingActor ping1;
		PingActor ping2;
		PingActor ping3;
		PingActor ping4;
		PingActor ping5;
		PingActor ping6;
		PingActor ping7;
		PingActor ping8;
		PingActor ping9;
		PingActor ping10;
	}

	statevars {
		int dummy;
	}

	PongActor() {
		dummy = 0;
	}

	msgsrv ping(int id) {
		if (id == 1) {
			ping1.pong(id);
		} else {
			if (id == 2) {
				ping2.pong(id);
			} else {
				if (id == 3) {
					ping3.pong(id);
				} else {
					if (id == 4) {
						ping4.pong(id);
					} else {
						if (id == 5) {
							ping5.pong(id);
						} else {
							if (id == 6) {
								ping6.pong(id);
							} else {
								if (id == 7) {
									ping7.pong(id);
								} else {
									if (id == 8) {
										ping8.pong(id);
									} else {
										if (id == 9) {
											ping9.pong(id);
										} else {
											if (id == 10) {
												ping10.pong(id);
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}

	statevars {
		int id;
	}

	PingActor(PongActor _pong, int _id) {
		pong = _pong;
		id = _id;
		self.start();
	}

	msgsrv start() {
		pong.ping(id);
	}

	msgsrv pong(int fromId) {
		pong.ping(id);
	}
}

main {
	PongActor pong():();
	PingActor ping1(pong):(pong, 1);
	PingActor ping2(pong):(pong, 2);
	PingActor ping3(pong):(pong, 3);
	PingActor ping4(pong):(pong, 4);
	PingActor ping5(pong):(pong, 5);
	PingActor ping6(pong):(pong, 6);
	PingActor ping7(pong):(pong, 7);
	PingActor ping8(pong):(pong, 8);
	PingActor ping9(pong):(pong, 9);
	PingActor ping10(pong):(pong, 10);
}