reactiveclass PingActor() {
	knownrebecs {
		PongActor pong;
	}
	statevars {
	}

	msgsrv initial() {
		self.start();
	}

	msgsrv start() {
		pong.ping();
	}

	msgsrv pong() {
		pong.ping();
	}
}

reactiveclass PongActor() {
	knownrebecs {
		PingActor ping;
	}
	statevars {
	}

	msgsrv initial() {
	}

	msgsrv ping() {
		sender.pong();
	}
}

main {
	PingActor ping(pong):();
	PongActor pong(ping):();
}