reactiveclass PingActor(pong: PongActor) {
	statevars {
	}

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor(ping: PingActor) {
	statevars {
	}

	msgsrv Ping() {
		sender.Pong();
	}
}

main {
	PingActor ping(pong):();
	PongActor pong(ping):();

	ping.Start();
}