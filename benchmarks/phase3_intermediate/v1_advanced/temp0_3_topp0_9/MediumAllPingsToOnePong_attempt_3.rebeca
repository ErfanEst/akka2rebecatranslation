reactiveclass PongActor {
	knownrebecs { }

	PongActor() {
	}

	msgsrv initial() {
	}

	msgsrv handleString() {
		sender.handlePong();
	}

	msgsrv handlePing() {
		sender.handlePong();
	}

	msgsrv handleStart() {
		sender.handlePong();
	}
}

reactiveclass PingActor {
	knownrebecs { PongActor pong; }
	statevars { int id; }

	PingActor(PongActor pongRef, int myId) {
		pong = pongRef;
		id = myId;
	}

	msgsrv initial() {
	}

	msgsrv handleStart() {
		pong.handlePing();
	}

	msgsrv handlePong() {
		pong.handlePing();
	}

	msgsrv handleString() {
		pong.handlePing();
	}
}

main {
	PongActor pong():();

	PingActor ping1(pong):(1);
	PingActor ping2(pong):(2);
	PingActor ping3(pong):(3);
	PingActor ping4(pong):(4);
	PingActor ping5(pong):(5);
	PingActor ping6(pong):(6);
	PingActor ping7(pong):(7);
	PingActor ping8(pong):(8);
	PingActor ping9(pong):(9);
	PingActor ping10(pong):(10);

	ping1.handleStart():();
	ping2.handleStart():();
	ping3.handleStart():();
	ping4.handleStart():();
	ping5.handleStart():();
	ping6.handleStart():();
	ping7.handleStart():();
	ping8.handleStart():();
	ping9.handleStart():();
	ping10.handleStart():();
}