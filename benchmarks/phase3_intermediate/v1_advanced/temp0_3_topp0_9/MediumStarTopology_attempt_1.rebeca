import Environment;

	reactiveclass Hub {
		statevars {
			Client clients[5];
			int clientCount;
		}

		msgsrv initial() {
			clientCount = 0;
		}

		msgsrv register(Client ref) {
			clients[clientCount] = ref;
			clientCount = clientCount + 1;
		}

		msgsrv ping() {
			sender.pong();
		}
	}

	reactiveclass Client {
		knownrebecs {
			Hub hub;
		}

		msgsrv initial() {
			hub.ping();
		}

		msgsrv pong() {
			hub.ping();
		}
	}

	main {
		Hub hub();
		Client c1(hub);
		Client c2(hub);
		Client c3(hub);
		Client c4(hub);
		Client c5(hub);

		hub.register(c1);
		hub.register(c2);
		hub.register(c3);
		hub.register(c4);
		hub.register(c5);
	}
}