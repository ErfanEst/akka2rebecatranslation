timedreactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}
	statevars {
	}

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

timedreactiveclass PongActor {
	knownrebecs {
	}
	statevars {
	}

	msgsrv Ping() {
		sender.Pong();
	}
}

main {
	PongActor pong():();
	PingActor ping(pong):();

	ping.Start();
}