reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}
	statevars {
	}

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor {
	knownrebecs {
		PingActor ping;
	}
	statevars {
	}

	msgsrv Ping() {
		sender.Pong();
	}
}

main {
	PongActor pong(ping):();
	PingActor ping(pong):();

	ping.Start();
}