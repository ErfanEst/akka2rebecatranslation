reactiveclass PingActor {
    knownrebecs {
        PongActor pong;
    }

    msgsrv Start() {
        pong.Ping();
    }

    msgsrv Pong() {
        pong.Ping();
    }
}

reactiveclass PongActor {
    knownrebecs { }

    msgsrv Ping() {
        sender.Pong();
    }
}

main {
    PingActor ping(pong):();
    PongActor pong():();

    ping.Start();
}

}