reactiveclass PongActor {
	knownrebecs { }
	statevars { }

	msgsrv initial() { }

	msgsrv ping(int msg) {
		sender.pong(msg);
	}
}

reactiveclass PingActor {
	knownrebecs { PongActor pong; }
	statevars { int id; }

	msgsrv initial(int _id, PongActor _pong) {
		id = _id;
		pong = _pong;
		pong.ping(id);
	}

	msgsrv pong(int msg) {
		pong.ping(id);
	}
}

main {
	PongActor pong():();
	PingActor ping1(pong):(1, pong);
	PingActor ping2(pong):(2, pong);
	PingActor ping3(pong):(3, pong);
	PingActor ping4(pong):(4, pong);
	PingActor ping5(pong):(5, pong);
	PingActor ping6(pong):(6, pong);
	PingActor ping7(pong):(7, pong);
	PingActor ping8(pong):(8, pong);
	PingActor ping9(pong):(9, pong);
	PingActor ping10(pong):(10, pong);
}