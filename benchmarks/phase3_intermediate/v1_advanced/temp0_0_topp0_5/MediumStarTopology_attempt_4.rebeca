reactiveclass Client {
	knownrebecs { Hub hub; }
	statevars { }

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}
}

reactiveclass Hub {
	knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; }
	statevars { }

	msgsrv initial() {
		self.Register(c1);
		self.Register(c2);
		self.Register(c3);
		self.Register(c4);
		self.Register(c5);

		c1.start();
		c2.start();
		c3.start();
		c4.start();
		c5.start();
	}

	msgsrv Register(Client ref) {
		/* registration logic omitted; list not modeled explicitly */
	}

	msgsrv Ping() {
		sender.Pong();
	}
}

main {
	Client c1(hub):();
	Client c2(hub):();
	Client c3(hub):();
	Client c4(hub):();
	Client c5(hub):();
	Hub hub(c1, c2, c3, c4, c5):();
}