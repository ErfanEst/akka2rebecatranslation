reactiveclass PingActor {
	knownrebecs { PongActor pong; }
	statevars {
	}

	PingActor(PongActor pong) {
		this.pong = pong;
	}

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor {
	knownrebecs { }
	statevars {
	}

	PongActor() {
	}

	msgsrv Ping() {
		sender.Pong();
	}
}

main {
	PongActor pong():();
	PingActor ping(pong):(pong);

	ping.Start();
}