reactiveclass PongActor(mysystem) {
	knownrebecs { PingActor ping[10]; }
	statevars { }

	msgsrv pingMsg(int senderId) {
		pongReply(senderId);
	}

	msgsrv pongReply(int senderId) {
		ping[senderId].pongMsg();
	}
}

reactiveclass PingActor(PongActor pong) {
	knownrebecs { PongActor pong; }
	statevars { int id; }

	constructor(int myId) {
		id = myId;
	}

	msgsrv start() {
		ping();
	}

	msgsrv ping() {
		pong.pingMsg(id);
	}

	msgsrv pongMsg() {
		ping();
	}
}

main {
	PongActor pong(ping):();
	PingActor ping0(pong):(0);
	PingActor ping1(pong):(1);
	PingActor ping2(pong):(2);
	PingActor ping3(pong):(3);
	PingActor ping4(pong):(4);
	PingActor ping5(pong):(5);
	PingActor ping6(pong):(6);
	PingActor ping7(pong):(7);
	PingActor ping8(pong):(8);
	PingActor ping9(pong):(9);

	ping0.start();
	ping1.start();
	ping2.start();
	ping3.start();
	ping4.start();
	ping5.start();
	ping6.start();
	ping7.start();
	ping8.start();
	ping9.start();
}