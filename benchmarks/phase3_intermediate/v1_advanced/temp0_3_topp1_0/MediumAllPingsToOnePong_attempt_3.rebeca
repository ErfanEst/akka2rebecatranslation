$timedreactiveclass PongActor {
	knownrebecs { PingActor PingActor[10]; }
	statevars { }

	msgsrv pingMsg(int senderId) {
		pongReply(senderId);
	}

	msgsrv pongReply(int senderId) {
		PingActor[senderId].pongMsg();
	}
}

$timedreactiveclass PingActor {
	knownrebecs { PongActor pong; }
	statevars { int id; }

	constructor(int myId) {
		id = myId;
	}

	msgsrv start() {
		ping();
	}

	msgsrv ping() {
		pong.pingMsg(id);
	}

	msgsrv pongMsg() {
		ping();
	}
}

main {
	PongActor pong(PingActor[10]):();
	PingActor ping0(pong):(0);
	PingActor ping1(pong):(1);
	PingActor ping2(pong):(2);
	PingActor ping3(pong):(3);
	PingActor ping4(pong):(4);
	PingActor ping5(pong):(5);
	PingActor ping6(pong):(6);
	PingActor ping7(pong):(7);
	PingActor ping8(pong):(8);
	PingActor ping9(pong):(9);

	ping0.start() after(0);
	ping1.start() after(0);
	ping2.start() after(0);
	ping3.start() after(0);
	ping4.start() after(0);
	ping5.start() after(0);
	ping6.start() after(0);
	ping7.start() after(0);
	ping8.start() after(0);
	ping9.start() after(0);
}