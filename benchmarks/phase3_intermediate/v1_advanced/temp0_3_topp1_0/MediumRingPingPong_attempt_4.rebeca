reactiveclass RingActor {
	knownrebecs {
		RingActor next;
	}
	statevars {
	}

	// constructor
	RingActor() {
	}

	msgsrv setNext(RingActor ref) {
		next = ref;
	}

	msgsrv ping() {
		next.ping();
	}
}

main {
	// declare known rebecs for each instance (ring structure)
	RingActor a1(a2):();
	RingActor a2(a3):();
	RingActor a3(a4):();
	RingActor a4(a5):();
	RingActor a5(a1):();

	a1.ping();
}