reactiveclass Client : TimedRebeca {
	knownrebecs {
		Hub hub;
	}
	statevars {
	}

	msgsrv initial() {
		start();
	}

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}
}

reactiveclass Hub : TimedRebeca {
	knownrebecs {
	}
	statevars {
		Client clients[5];
		int clientCount;
	}

	msgsrv initial() {
		clientCount = 0;
	}

	msgsrv Register(Client ref) {
		if (clientCount < 5) {
			clients[clientCount] = ref;
			clientCount = clientCount + 1;
		}
	}

	msgsrv Ping() {
		sender.Pong();
	}
}

main {
	Hub hub():();
	Client c1(hub):();
	Client c2(hub):();
	Client c3(hub):();
	Client c4(hub):();
	Client c5(hub):();

	hub.Register(c1);
	hub.Register(c2);
	hub.Register(c3);
	hub.Register(c4);
	hub.Register(c5);
}