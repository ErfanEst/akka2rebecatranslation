reactiveclass PingActor {
	knownrebecs { PongActor pong; }
	statevars { int id; }

	PingActor(PongActor pongRef, int myId) {
		pong = pongRef;
		id = myId;
	}

	msgsrv start() {
		pong.ping(id);
	}

	msgsrv pong_reply(int pingId) {
		// no-op
	}
}

reactiveclass PongActor {
	knownrebecs {
		PingActor ping1;
		PingActor ping2;
		PingActor ping3;
		PingActor ping4;
		PingActor ping5;
		PingActor ping6;
		PingActor ping7;
		PingActor ping8;
		PingActor ping9;
		PingActor ping10;
	}

	PongActor(
		PingActor p1,
		PingActor p2,
		PingActor p3,
		PingActor p4,
		PingActor p5,
		PingActor p6,
		PingActor p7,
		PingActor p8,
		PingActor p9,
		PingActor p10
	) {
		ping1 = p1;
		ping2 = p2;
		ping3 = p3;
		ping4 = p4;
		ping5 = p5;
		ping6 = p6;
		ping7 = p7;
		ping8 = p8;
		ping9 = p9;
		ping10 = p10;
	}

	msgsrv ping(int pingId) {
		if (pingId == 1) {
			ping1.pong_reply(pingId);
		} else if (pingId == 2) {
			ping2.pong_reply(pingId);
		} else if (pingId == 3) {
			ping3.pong_reply(pingId);
		} else if (pingId == 4) {
			ping4.pong_reply(pingId);
		} else if (pingId == 5) {
			ping5.pong_reply(pingId);
		} else if (pingId == 6) {
			ping6.pong_reply(pingId);
		} else if (pingId == 7) {
			ping7.pong_reply(pingId);
		} else if (pingId == 8) {
			ping8.pong_reply(pingId);
		} else if (pingId == 9) {
			ping9.pong_reply(pingId);
		} else if (pingId == 10) {
			ping10.pong_reply(pingId);
		}
	}
}

main {
	PongActor pong(ping1, ping2, ping3, ping4, ping5, ping6, ping7, ping8, ping9, ping10):();
	PingActor ping1(pong, 1):();
	PingActor ping2(pong, 2):();
	PingActor ping3(pong, 3):();
	PingActor ping4(pong, 4):();
	PingActor ping5(pong, 5):();
	PingActor ping6(pong, 6):();
	PingActor ping7(pong, 7):();
	PingActor ping8(pong, 8):();
	PingActor ping9(pong, 9):();
	PingActor ping10(pong, 10):();

	{
		ping1.start();
		ping2.start();
		ping3.start();
		ping4.start();
		ping5.start();
		ping6.start();
		ping7.start();
		ping8.start();
		ping9.start();
		ping10.start();
	}
}