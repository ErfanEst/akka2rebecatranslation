reactiveclass RingActor {
	knownrebecs { 
		RingActor next;
	}

	statevars {
		// no additional state variables
	}

	msgsrv SetNext(RingActor ref) {
		next = ref;
	}

	msgsrv Ping() {
		next.Ping();
	}

	msgsrv initial() {
		// nothing
	}
}

main {
	RingActor a1(a2):();
	RingActor a2(a3):();
	RingActor a3(a4):();
	RingActor a4(a5):();
	RingActor a5(a1):();

	a1.Ping();
}