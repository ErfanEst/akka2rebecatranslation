reactiveclass PongActor {
	knownrebecs {
	}

	statevars {
	}

	constructor() {
		self.initial();
	}

	msgsrv initial() {
	}

	msgsrv handleString(int msgId, int senderId) {
		sender.handlePong(msgId, senderId);
	}
}

reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}

	statevars {
		int id;
	}

	constructor(PongActor pongRef, int _id) {
		pong = pongRef;
		id = _id;
		self.initial();
	}

	msgsrv initial() {
		self.start();
	}

	msgsrv start() {
		pong.handleString(id, id);
	}

	msgsrv handlePong(int msgId, int senderId) {
	}
}

main {
	PongActor pong():();

	PingActor ping1(pong):(1);
	PingActor ping2(pong):(2);
	PingActor ping3(pong):(3);
	PingActor ping4(pong):(4);
	PingActor ping5(pong):(5);
	PingActor ping6(pong):(6);
	PingActor ping7(pong):(7);
	PingActor ping8(pong):(8);
	PingActor ping9(pong):(9);
	PingActor ping10(pong):(10);
}