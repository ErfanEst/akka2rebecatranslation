reactiveclass PingActor(pong: PongActor) {
	statevars { }

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}

	msgsrv initial() {
		self.Start();
	}
}

reactiveclass PongActor() {
	statevars { }

	msgsrv Ping() {
		sender.Pong();
	}

	msgsrv initial() {
	}
}

main {
	PongActor pong():();
	PingActor ping(pong):();
}