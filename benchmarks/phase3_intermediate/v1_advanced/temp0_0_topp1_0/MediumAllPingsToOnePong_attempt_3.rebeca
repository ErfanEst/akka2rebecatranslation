reactiveclass PongActor() {
	knownrebecs { }

	msgsrv initial() {
	}

	msgsrv ping(int msg) {
		int reply;
		reply = msg;
		sender.pong(reply);
	}

	msgsrv pong(int msg) {
	}
}

reactiveclass PingActor(PongActor pong, int id) {
	knownrebecs { PongActor pong; }

	statevars {
		int id;
	}

	msgsrv initial() {
		int msg;
		msg = id;
		pong.ping(msg);
	}

	msgsrv ping(int msg) {
		int newMsg;
		newMsg = id;
		pong.ping(newMsg);
	}

	msgsrv pong(int msg) {
	}
}

main {
	PongActor pong():();
	PingActor p1(pong, 1):();
	PingActor p2(pong, 2):();
	PingActor p3(pong, 3):();
	PingActor p4(pong, 4):();
	PingActor p5(pong, 5):();
	PingActor p6(pong, 6):();
	PingActor p7(pong, 7):();
	PingActor p8(pong, 8):();
	PingActor p9(pong, 9):();
	PingActor p10(pong, 10):();
}