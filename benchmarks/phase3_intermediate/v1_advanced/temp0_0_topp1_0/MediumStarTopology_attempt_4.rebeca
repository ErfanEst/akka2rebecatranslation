reactiveclass Client {
	knownrebecs { 
		Hub hub; 
	}
	statevars {
		// no state
	}

	msgsrv initial() {
		start();
	}

	msgsrv start() {
		hub.ping();
	}

	msgsrv pong() {
		hub.ping();
	}
}

reactiveclass Hub {
	knownrebecs {
		Client c1;
		Client c2;
		Client c3;
		Client c4;
		Client c5;
	}
	statevars {
		int nClients;
	}

	msgsrv initial() {
		nClients = 5;
		c1.start();
		c2.start();
		c3.start();
		c4.start();
		c5.start();
	}

	msgsrv register(Client ref) {
		nClients = nClients;
	}

	msgsrv ping() {
		sender.pong();
	}
}

main {
	Client c1();
	Client c2();
	Client c3();
	Client c4();
	Client c5();
	Hub h(c1, c2, c3, c4, c5);
}