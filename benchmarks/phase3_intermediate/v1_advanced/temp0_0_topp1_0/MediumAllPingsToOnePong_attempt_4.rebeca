reactiveclass PongActor {
	knownrebecs { }

	statevars {
	}

	msgsrv initial() {
	}

	msgsrv ping(int msg) {
		int reply;
		reply = msg;
		sender.pong(reply);
	}

	msgsrv pong(int msg) {
	}
}

reactiveclass PingActor {
	knownrebecs { PongActor pong; }

	statevars {
		int id;
	}

	msgsrv initial(int initId, PongActor p) {
		int msg;
		id = initId;
		pong = p;
		msg = id;
		pong.ping(msg);
	}

	msgsrv ping(int msg) {
		int newMsg;
		newMsg = id;
		pong.ping(newMsg);
	}

	msgsrv pong(int msg) {
	}
}

main {
	PongActor pong():();
	PingActor p1(pong, 1):(1, pong);
	PingActor p2(pong, 2):(2, pong);
	PingActor p3(pong, 3):(3, pong);
	PingActor p4(pong, 4):(4, pong);
	PingActor p5(pong, 5):(5, pong);
	PingActor p6(pong, 6):(6, pong);
	PingActor p7(pong, 7):(7, pong);
	PingActor p8(pong, 8):(8, pong);
	PingActor p9(pong, 9):(9, pong);
	PingActor p10(pong, 10):(10, pong);
}