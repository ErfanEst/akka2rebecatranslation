timedreactiveclass PongActor {
    knownrebecs { }

    msgsrv initial() {
        // no initialization behavior
    }

    msgsrv ping(string msg) {
        // respond back to sender with a pong message
        string reply;
        reply = "pong-for-";
        reply = reply + msg;
        sender.pong(reply);
    }

    msgsrv pong(string msg) {
        // PongActor does not use this, but must exist to match calls
    }
}

timedreactiveclass PingActor {
    knownrebecs { PongActor pong; }

    statevars {
        int id;
    }

    PingActor(PongActor pong, int id) {
        this.pong = pong;
        this.id = id;
    }

    msgsrv initial() {
        string base;
        string msg;
        base = "ping-";
        msg = base + id;
        pong.ping(msg);
    }

    msgsrv ping(string msg) {
        string base;
        string newMsg;
        base = "ping-";
        newMsg = base + id;
        pong.ping(newMsg);
    }

    msgsrv pong(string msg) {
        // handle pong reply (no behavior needed)
    }
}

timedsystem AllPingsToOnePongApp {
    PongActor pong;
    PingActor p1;
    PingActor p2;
    PingActor p3;
    PingActor p4;
    PingActor p5;
    PingActor p6;
    PingActor p7;
    PingActor p8;
    PingActor p9;
    PingActor p10;

    main {
        pong : PongActor();
        p1 : PingActor(pong, 1);
        p2 : PingActor(pong, 2);
        p3 : PingActor(pong, 3);
        p4 : PingActor(pong, 4);
        p5 : PingActor(pong, 5);
        p6 : PingActor(pong, 6);
        p7 : PingActor(pong, 7);
        p8 : PingActor(pong, 8);
        p9 : PingActor(pong, 9);
        p10 : PingActor(pong, 10);
    }
}