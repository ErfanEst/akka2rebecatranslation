reactiveclass Client {
	knownrebecs {
		Hub hub;
	}

	statevars {
	}

	Client() {
	}

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}
}

reactiveclass Hub {
	knownrebecs {
		Client c1;
		Client c2;
		Client c3;
		Client c4;
		Client c5;
	}

	statevars {
		Client clients[5];
		int clientCount;
	}

	Hub() {
		clientCount = 0;
	}

	msgsrv Register(Client ref) {
		if (clientCount < 5) {
			clients[clientCount] = ref;
			clientCount = clientCount + 1;
		}
	}

	msgsrv Ping() {
		sender.Pong();
	}
}

main {
	Hub hub(c1, c2, c3, c4, c5);
	Client c1(hub);
	Client c2(hub);
	Client c3(hub);
	Client c4(hub);
	Client c5(hub);

	hub.Register(c1):();
	hub.Register(c2):();
	hub.Register(c3):();
	hub.Register(c4):();
	hub.Register(c5):();

	c1.start():();
	c2.start():();
	c3.start():();
	c4.start():();
	c5.start():();
}