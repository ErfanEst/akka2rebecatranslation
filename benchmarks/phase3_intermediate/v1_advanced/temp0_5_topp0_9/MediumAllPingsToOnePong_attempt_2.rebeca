reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}
	statevars {
		byte id;
	}

	PingActor(PongActor pong) {
		self.pong = pong;
	}

	msgsrv setId(byte idArg) {
		id = idArg;
	}

	msgsrv start() {
		pong.ping(id);
	}

	msgsrv pongResponse(byte dummy) {
		// no-op
	}
}

reactiveclass PongActor {
	knownrebecs {
	}
	statevars {
	}

	PongActor() {
	}

	msgsrv ping(byte id) {
		sender.pongResponse(id);
	}
}

main {
	PongActor pong();

	PingActor p1(pong): (p1.setId(1), p1.start());
	PingActor p2(pong): (p2.setId(2), p2.start());
	PingActor p3(pong): (p3.setId(3), p3.start());
	PingActor p4(pong): (p4.setId(4), p4.start());
	PingActor p5(pong): (p5.setId(5), p5.start());
	PingActor p6(pong): (p6.setId(6), p6.start());
	PingActor p7(pong): (p7.setId(7), p7.start());
	PingActor p8(pong): (p8.setId(8), p8.start());
	PingActor p9(pong): (p9.setId(9), p9.start());
	PingActor p10(pong): (p10.setId(10), p10.start());
}