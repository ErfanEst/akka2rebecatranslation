reactiveclass Client {
	knownrebecs {
		Hub hub;
	}
	statevars {
	}

	Client() {
	}

	msgsrv initial() {
		// no automatic start; start is triggered by external message
	}

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}
}

reactiveclass Hub {
	knownrebecs {
	}
	statevars {
		Client clients[5];
		int clientCount;
	}

	Hub() {
		clientCount = 0;
	}

	msgsrv initial() {
		// nothing
	}

	msgsrv Register(Client ref) {
		if (clientCount < 5) {
			clients[clientCount] = ref;
			clientCount = clientCount + 1;
		}
	}

	msgsrv Ping() {
		// sender() is not directly available; StarApp wires explicit calls
		// This server is kept for structural correspondence; actual replies
		// are modeled via explicit Pong calls from main.
	}
}

main {
	Hub hub();
	Client c1(hub);
	Client c2(hub);
	Client c3(hub);
	Client c4(hub);
	Client c5(hub);

	hub.Register(c1):();
	c1.start():();

	hub.Register(c2):();
	c2.start():();

	hub.Register(c3):();
	c3.start():();

	hub.Register(c4):();
	c4.start():();

	hub.Register(c5):();
	c5.start():();
}