reactiveclass Client(hubKnown) {
	knownrebecs {
		Hub hubKnown;
	}
	statevars {
	}

	Client() {
	}

	msgsrv initial() {
		// no automatic start; start is triggered by explicit message in main
	}

	msgsrv start() {
		hubKnown.Ping();
	}

	msgsrv Pong() {
		hubKnown.Ping();
	}
}

reactiveclass Hub {
	knownrebecs {
	}
	statevars {
		Client clients[5];
		int clientCount;
	}

	Hub() {
		clientCount = 0;
	}

	msgsrv initial() {
		// nothing
	}

	msgsrv Register(Client ref) {
		if (clientCount < 5) {
			clients[clientCount] = ref;
			clientCount = clientCount + 1;
		}
	}

	msgsrv Ping() {
		// kept for structural correspondence
	}
}

main {
	Hub hub():();
	Client c1(hub):();
	Client c2(hub):();
	Client c3(hub):();
	Client c4(hub):();
	Client c5(hub):();

	hub.Register(c1):();
	c1.start():();

	hub.Register(c2):();
	c2.start():();

	hub.Register(c3):();
	c3.start():();

	hub.Register(c4):();
	c4.start():();

	hub.Register(c5):();
	c5.start():();
}