reactiveclass PingActor(pong: PongActor) {
	statevars { }

	msgsrv initial() {
		self.start();
	}

	msgsrv start() {
		pong.ping();
	}

	msgsrv pong() {
		pong.ping();
	}
}

reactiveclass PongActor {
	statevars { }

	msgsrv initial() { }

	msgsrv ping() {
		sender.pong();
	}
}

main {
	PongActor pong();
	PingActor ping(pong):();
}