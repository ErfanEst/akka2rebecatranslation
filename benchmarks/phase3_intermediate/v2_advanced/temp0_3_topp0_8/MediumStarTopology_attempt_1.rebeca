reactiveclass Client(50) {
    knownrebecs {
        Hub hub;
    }
    statevars {
        // no state
    }

    msgsrv initial() {
        // initial transition, do nothing
    }

    msgsrv start() {
        hub.Ping();
    }

    msgsrv Pong() {
        hub.Ping();
    }
}

reactiveclass Hub(50) {
    knownrebecs {
        // no known rebecs
    }
    statevars {
        Client clients[5];
        int clientCount;
    }

    msgsrv initial() {
        clientCount = 0;
    }

    msgsrv Register(Client ref) {
        if (clientCount < 5) {
            clients[clientCount] = ref;
            clientCount = clientCount + 1;
        }
    }

    msgsrv Ping() {
        // sender is implicitly the rebec that sent Ping
        // In Rebeca, we must explicitly pass references, so we assume
        // Ping is always sent by a Client and reply to all registered clients
        // To approximate Akka's sender() ! Pong, we broadcast to all clients
        int i;
        i = 0;
        while (i < clientCount) {
            clients[i].Pong();
            i = i + 1;
        }
    }
}

main {
    Hub hub();
    Client c1(hub);
    Client c2(hub);
    Client c3(hub);
    Client c4(hub);
    Client c5(hub);

    hub.Register(c1);
    hub.Register(c2);
    hub.Register(c3);
    hub.Register(c4);
    hub.Register(c5);

    c1.start();
    c2.start();
    c3.start();
    c4.start();
    c5.start();
}

}