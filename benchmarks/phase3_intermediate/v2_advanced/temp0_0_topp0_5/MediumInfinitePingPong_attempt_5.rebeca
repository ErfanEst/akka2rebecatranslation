reactiveclass PingActor(pong: PongActor) {
	knownrebecs {
		PongActor pong;
	}

	statevars {
	}

	msgsrv initial() {
		self.Start();
	}

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor {
	knownrebecs {
	}

	statevars {
	}

	msgsrv initial() {
	}

	msgsrv Ping() {
		sender.Pong();
	}
}

main {
	PongActor pong():();
	PingActor ping(pong):();
}