reactiveclass PongActor() {
	knownrebecs {
	}

	statevars {
	}

	msgsrv initial() {
		// no initialization needed
	}

	msgsrv Ping() {
		self.Pong();
	}

	msgsrv Pong() {
		sender.Pong();
	}
}

reactiveclass PingActor(PongActor pong) {
	knownrebecs {
		PongActor pong;
	}

	statevars {
	}

	msgsrv initial() {
		Start();
	}

	msgsrv Start() {
		Ping();
	}

	msgsrv Pong() {
		Ping();
	}

	msgsrv Ping() {
		pong.Ping();
	}
}

main {
	PongActor pong():();
	PingActor ping(pong):();
}