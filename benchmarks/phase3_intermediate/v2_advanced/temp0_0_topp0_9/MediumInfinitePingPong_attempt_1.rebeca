reactiveclass PingActor {
	statevars {
		PongActor pong;
	}

	knownrebecs { PongActor pong; }

	msgsrv initial() {
		Start();
	}

	msgsrv Start() {
		Ping();
	}

	msgsrv Pong() {
		Ping();
	}

	msgsrv Ping() {
		pong.Ping();
	}
}

reactiveclass PongActor {
	knownrebecs { }

	msgsrv initial() {
		// no initialization needed
	}

	msgsrv Ping() {
		self.Pong();
	}

	msgsrv Pong() {
		sender.Pong();
	}
}

main {
	PongActor pong();
	PingActor ping(pong);
}