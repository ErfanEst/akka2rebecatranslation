reactiveclass Client(hub): {
	knownrebecs { 
		Hub hub;
	}

	Client() {
	}

	msghandler start() {
		hub.Ping();
	}

	msghandler Pong() {
		hub.Ping();
	}
}

reactiveclass Hub() {
	statevars {
		Client clients[5];
		int clientCount;
	}

	knownrebecs { }

	Hub() {
		clientCount = 0;
	}

	msghandler Register(Client ref) {
		if (clientCount < 5) {
			clients[clientCount] = ref;
			clientCount = clientCount + 1;
		}
	}

	msghandler Ping() {
		sender.Pong();
	}
}

main {
	Hub hub():();
	Client c1(hub):();
	Client c2(hub):();
	Client c3(hub):();
	Client c4(hub):();
	Client c5(hub):();

	hub.Register(c1);
	c1.start();

	hub.Register(c2);
	c2.start();

	hub.Register(c3);
	c3.start();

	hub.Register(c4);
	c4.start();

	hub.Register(c5);
	c5.start();
}