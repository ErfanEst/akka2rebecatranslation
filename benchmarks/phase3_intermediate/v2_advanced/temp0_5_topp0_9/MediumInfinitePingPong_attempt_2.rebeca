reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}

	statevars {
	}

	msgsrv initial() {
		self.start();
	}

	msgsrv start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor {
	knownrebecs {
		PingActor ping;
	}

	statevars {
	}

	msgsrv initial() {
		// no initialization needed
	}

	msgsrv Ping() {
		ping.Pong();
	}
}

main {
	PongActor pong(ping):();
	PingActor ping(pong):();
}