timed reactiveclass PingActor {
	statevars {
		int id;
		PongActor pong;
	}

	PingActor(int _id, PongActor _pong) {
		id = _id;
		pong = _pong;
	}

	msgsrv start() {
		pong.ping(id);
	}

	msgsrv trigger() {
		pong.ping(id);
	}
}

timed reactiveclass PongActor {
	statevars {
	}

	PongActor() {
	}

	msgsrv ping(int id) {
		self.reply(id);
	}

	msgsrv reply(int id) {
		// models sending "pong-for-ping-id" back to sender
	}
}

main {
	PongActor pong();
	PingActor ping1(1, pong);
	PingActor ping2(2, pong);
	PingActor ping3(3, pong);
	PingActor ping4(4, pong);
	PingActor ping5(5, pong);
	PingActor ping6(6, pong);
	PingActor ping7(7, pong);
	PingActor ping8(8, pong);
	PingActor ping9(9, pong);
	PingActor ping10(10, pong);

	ping1.start();
	ping2.start();
	ping3.start();
	ping4.start();
	ping5.start();
	ping6.start();
	ping7.start();
	ping8.start();
	ping9.start();
	ping10.start();
}