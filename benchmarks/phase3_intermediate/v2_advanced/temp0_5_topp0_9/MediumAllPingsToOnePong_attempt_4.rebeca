reactiveclass PongActor {
	knownrebecs {
	}
	statevars {
	}

	PongActor() {
	}

	msgsrv initial() {
	}

	msgsrv ping(byte id) {
		self.reply(id);
	}

	msgsrv reply(byte id) {
		// models sending "pong-for-ping-id" back to sender
	}
}

reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}
	statevars {
		byte id;
	}

	PingActor(PongActor pong) {
		self.pong = pong;
	}

	msgsrv initial(byte _id) {
		id = _id;
		pong.ping(id);
	}

	msgsrv trigger() {
		pong.ping(id);
	}
}

main {
	PongActor pong();

	PingActor ping1(pong): (1);
	PingActor ping2(pong): (2);
	PingActor ping3(pong): (3);
	PingActor ping4(pong): (4);
	PingActor ping5(pong): (5);
	PingActor ping6(pong): (6);
	PingActor ping7(pong): (7);
	PingActor ping8(pong): (8);
	PingActor ping9(pong): (9);
	PingActor ping10(pong): (10);
}