reactiveclass Client(hubID) {
	knownrebecs {
		Hub hub;
	}
	statevars {
		int id;
	}
	Client(int _id) {
		id = _id;
	}

	msgsrv initial() {
		// no automatic start; main will send start()
	}

	msgsrv start() {
		hub.ping();
	}

	msgsrv pong() {
		hub.ping();
	}
}

reactiveclass Hub {
	knownrebecs {
	}
	statevars {
		Client clients[5];
		int clientCount;
	}

	Hub() {
		clientCount = 0;
	}

	msgsrv initial() {
		// nothing
	}

	msgsrv register(Client c) {
		if (clientCount < 5) {
			clients[clientCount] = c;
			clientCount = clientCount + 1;
		}
	}

	msgsrv ping() {
		sender.pong();
	}
}

main {
	Hub hub();
	Client c1(hub): (1);
	Client c2(hub): (2);
	Client c3(hub): (3);
	Client c4(hub): (4);
	Client c5(hub): (5);

	{
		hub.register(c1);
		hub.register(c2);
		hub.register(c3);
		hub.register(c4);
		hub.register(c5);

		c1.start();
		c2.start();
		c3.start();
		c4.start();
		c5.start();
	}
}