reactiveclass Client {
	knownrebecs {
		Hub hub;
	}

	statevars {
	}

	Client() {
	}

	msgsrv initial() {
		hub.PingFrom(self);
	}

	msgsrv Pong() {
		hub.PingFrom(self);
	}
}

reactiveclass Hub {
	knownrebecs {
		Client c1;
		Client c2;
		Client c3;
		Client c4;
		Client c5;
	}

	statevars {
		Client clients[5];
		int clientCount;
	}

	Hub() {
		clientCount = 0;
	}

	msgsrv initial() {
	}

	msgsrv Register(Client ref) {
		if (clientCount < 5) {
			clients[clientCount] = ref;
			clientCount = clientCount + 1;
		}
	}

	msgsrv PingFrom(Client c) {
		c.Pong();
	}
}

main {
	Client c1():();
	Client c2():();
	Client c3():();
	Client c4():();
	Client c5():();
	Hub hub(c1, c2, c3, c4, c5):();

	hub.Register(c1);
	hub.Register(c2);
	hub.Register(c3);
	hub.Register(c4);
	hub.Register(c5);
}