reactiveclass Client {
	statevars {
		Hub hub;
	}

	Client(Hub h) {
		hub = h;
	}

	msgsrv initial() {
		// no automatic start; main will send start()
	}

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}
}

reactiveclass Hub {
	statevars {
		Client clients[5];
		int clientCount;
	}

	Hub() {
		clientCount = 0;
	}

	msgsrv initial() {
		// nothing
	}

	msgsrv Register(Client ref) {
		if (clientCount < 5) {
			clients[clientCount] = ref;
			clientCount = clientCount + 1;
		}
	}

	msgsrv Ping() {
		// sender() is not directly available; in this model,
		// we assume only registered clients send Ping,
		// and we do not need to distinguish which one.
		// To preserve semantics of replying to sender,
		// we model Ping as carrying the client reference.
	}

	// Corrected version with explicit sender:
	msgsrv PingFrom(Client c) {
		c.Pong();
	}
}

main {
	Hub hub();
	Client c1(hub);
	Client c2(hub);
	Client c3(hub);
	Client c4(hub);
	Client c5(hub);

	hub.Register(c1);
	hub.Register(c2);
	hub.Register(c3);
	hub.Register(c4);
	hub.Register(c5);

	c1.start();
	c2.start();
	c3.start();
	c4.start();
	c5.start();
}

}