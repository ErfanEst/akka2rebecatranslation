reactiveclass RingActor (RingActor next) {
	knownrebecs { 
		RingActor next;
	}
	statevars { 
	}

	msgsrv initial() {
		// no initialization needed
	}

	msgsrv ping() {
		next.ping();
	}
}

main {
	RingActor a1(a2):();
	RingActor a2(a3):();
	RingActor a3(a4):();
	RingActor a4(a5):();
	RingActor a5(a1):();

	a1.initial();
	a2.initial();
	a3.initial();
	a4.initial();
	a5.initial();

	a1.ping();
}