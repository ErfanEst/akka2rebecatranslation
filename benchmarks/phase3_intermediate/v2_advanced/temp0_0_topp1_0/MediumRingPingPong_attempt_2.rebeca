reactiveclass RingActor {
	knownrebecs { }
	statevars {
		RingActor next;
	}

	msgsrv initial() { }

	msgsrv SetNext(RingActor ref) {
		next = ref;
	}

	msgsrv Ping() {
		next.Ping();
	}
}

main {
	RingActor a1(a1_1):();
	RingActor a2(a2_1):();
	RingActor a3(a3_1):();
	RingActor a4(a4_1):();
	RingActor a5(a5_1):();

	a1_1.SetNext(a2_1);
	a2_1.SetNext(a3_1);
	a3_1.SetNext(a4_1);
	a4_1.SetNext(a5_1);
	a5_1.SetNext(a1_1);

	a1_1.Ping();
}