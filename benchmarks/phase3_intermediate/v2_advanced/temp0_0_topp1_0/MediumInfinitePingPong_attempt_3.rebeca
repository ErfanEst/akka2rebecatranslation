reactiveclass PingActor(pong: PongActor) {
	knownrebecs {
		PongActor pong;
	}

	msgsrv initial() {
		self.start();
	}

	msgsrv start() {
		pong.ping();
	}

	msgsrv pong() {
		pong.ping();
	}
}

reactiveclass PongActor(ping: PingActor) {
	knownrebecs {
		PingActor ping;
	}

	msgsrv initial() {
		// no initialization needed
	}

	msgsrv ping() {
		ping.pong();
	}
}

main {
	PingActor ping(pong):();
	PongActor pong(ping):();
}