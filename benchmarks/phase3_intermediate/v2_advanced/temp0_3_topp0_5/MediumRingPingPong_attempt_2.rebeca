reactiveclass RingActor() {
	knownrebecs { 
		RingActor next;
	}

	statevars {
		boolean initialized;
	}

	// constructor
	RingActor() {
		initialized = false;
	}

	msgsrv setNext(RingActor ref) {
		next = ref;
		initialized = true;
	}

	msgsrv ping() {
		next.ping();
	}
}

main {
	// declare rebecs and their known rebecs
	RingActor a1(a2):();
	RingActor a2(a3):();
	RingActor a3(a4):();
	RingActor a4(a5):();
	RingActor a5(a1):();

	// initial messages
	a1.ping();
}