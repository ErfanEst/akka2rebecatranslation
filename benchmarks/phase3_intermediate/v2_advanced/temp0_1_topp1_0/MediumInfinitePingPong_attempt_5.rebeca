reactiveclass PingActor(pong: PongActor) {
	knownrebecs {
		PongActor pong;
	}

	statevars {
	}

	msgsrv initial() {
		start();
	}

	msgsrv start() {
		pong.ping();
	}

	msgsrv pong() {
		pong.ping();
	}
}

reactiveclass PongActor {
	knownrebecs {
	}

	statevars {
	}

	msgsrv initial() {
	}

	msgsrv ping() {
		sender.pong();
	}
}

main {
	PongActor pong1():();
	PingActor ping1(pong1):(pong);
}