reactiveclass Client(1) {
	statevars {
	}

	knownrebecs {
		Hub hubRef;
	}

	msgsrv initial() {
		// automatic start: send first Ping via hub
		hubRef.Ping();
	}

	msgsrv Pong() {
		hubRef.Ping();
	}
}

reactiveclass Hub(6) {
	statevars {
		Client clients[5];
		int clientCount;
	}

	knownrebecs {
	}

	msgsrv initial() {
		clientCount = 0;
	}

	msgsrv Register(Client ref) {
		clients[clientCount] = ref;
		clientCount = clientCount + 1;
	}

	msgsrv Ping() {
		sender.Pong();
	}
}

main {
	Hub hub():();

	Client c1(hub):();
	Client c2(hub):();
	Client c3(hub):();
	Client c4(hub):();
	Client c5(hub):();

	hub.Register(c1):();
	hub.Register(c2):();
	hub.Register(c3):();
	hub.Register(c4):();
	hub.Register(c5):();
}