reactiveclass PingActor {
	statevars {
		PongActor pong;
	}

	knownrebecs { PongActor pong; }

	msgsrv initial() {
		start();
	}

	msgsrv start() {
		pong.ping();
	}

	msgsrv pong() {
		pong.ping();
	}
}

reactiveclass PongActor {
	statevars {
	}

	knownrebecs { }

	msgsrv initial() {
	}

	msgsrv ping() {
		sender.pong();
	}
}

main {
	PongActor pong();
	PingActor ping(pong):();
}