reactiveclass PingActor {
	statevars {
		PongActor pong;
	}

	knownrebecs { PongActor pong; }

	msgsrv initial() {
		// no automatic start here; Start is sent from main
	}

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor {
	statevars {
	}

	knownrebecs { }

	msgsrv initial() {
	}

	msgsrv Ping() {
		sender.Pong();
	}
}

main {
	PongActor pong();
	PingActor ping(pong);

	ping.Start();
}