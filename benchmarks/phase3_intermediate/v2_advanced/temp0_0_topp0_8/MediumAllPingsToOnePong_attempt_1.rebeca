timed reactiveclass PingActor {
    knownrebecs {
        PongActor pong;
    }
    statevars {
        int id;
    }

    PingActor(PongActor pongRef, int myId) {
        pong = pongRef;
        id = myId;
    }

    msgsrv start() {
        ping();
    }

    msgsrv ping() {
        pong.pong(id);
    }
}

timed reactiveclass PongActor {
    knownrebecs {
    }
    statevars {
    }

    PongActor() {
    }

    msgsrv pong(int id) {
        // reply back to the sender ping actor
        selfRef.sender.pongResponse(id);
    }

    msgsrv pongResponse(int id) {
        // this message server is a placeholder for responses
        // In Akka, the sender receives "pong-for-ping-id"
        // Here we just model the reception without side effects
        // to keep the structure compilable and analyzable.
    }
}

timed main {
    PongActor pong();
    PingActor ping1(pong, 1);
    PingActor ping2(pong, 2);
    PingActor ping3(pong, 3);
    PingActor ping4(pong, 4);
    PingActor ping5(pong, 5);
    PingActor ping6(pong, 6);
    PingActor ping7(pong, 7);
    PingActor ping8(pong, 8);
    PingActor ping9(pong, 9);
    PingActor ping10(pong, 10);

    {
        ping1.start();
        ping2.start();
        ping3.start();
        ping4.start();
        ping5.start();
        ping6.start();
        ping7.start();
        ping8.start();
        ping9.start();
        ping10.start();
    }
}