reactiveclass Client {
		knownrebecs { Hub hub; }
		statevars { }

		msgsrv initial() {
			// do nothing
		}

		msgsrv start() {
			hub.Ping();
		}

		msgsrv Pong() {
			hub.Ping();
		}
	}

	reactiveclass Hub {
		knownrebecs { }
		statevars {
			Client clients[5];
			int clientCount;
		}

		msgsrv initial() {
			clientCount = 0;
		}

		msgsrv Register(Client ref) {
			if (clientCount < 5) {
				clients[clientCount] = ref;
				clientCount = clientCount + 1;
			}
		}

		msgsrv Ping() {
			// In Akka: sender() ! Pong
			// Here we broadcast Pong to all registered clients
			int i;
			i = 0;
			while (i < clientCount) {
				clients[i].Pong();
				i = i + 1;
			}
		}
	}

	main {
		Hub hub();
		Client c1(hub);
		Client c2(hub);
		Client c3(hub);
		Client c4(hub);
		Client c5(hub);

		hub.Register(c1);
		c1.start();

		hub.Register(c2);
		c2.start();

		hub.Register(c3);
		c3.start();

		hub.Register(c4);
		c4.start();

		hub.Register(c5);
		c5.start();
	}
}