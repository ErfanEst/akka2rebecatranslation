timedreactiveclass PingActor(pongId: int, id: int) {
	statevars {
		int pong;
		int myId;
	}

	knownrebecs {
		PongActor pongRef;
	}

	msgsrv initial() {
		pong = pongId;
		myId = id;
	}

	msgsrv start() {
		ping();
	}

	msgsrv ping() {
		pongRef.pingFromPing(myId) after(0);
	}
}

timedreactiveclass PongActor {
	statevars {
	}

	knownrebecs {
	}

	msgsrv initial() {
	}

	msgsrv pingFromPing(int pingId) {
		pongForPing(pingId) after(0);
	}

	msgsrv pongForPing(int pingId) {
		// models sending "pong-for-ping-<id>" back to sender
		// no explicit sender reference in Rebeca, so this is a placeholder
	}
}

main {
	PongActor pong();

	PingActor ping1(pong, 1);
	PingActor ping2(pong, 2);
	PingActor ping3(pong, 3);
	PingActor ping4(pong, 4);
	PingActor ping5(pong, 5);
	PingActor ping6(pong, 6);
	PingActor ping7(pong, 7);
	PingActor ping8(pong, 8);
	PingActor ping9(pong, 9);
	PingActor ping10(pong, 10);

	ping1.start();
	ping2.start();
	ping3.start();
	ping4.start();
	ping5.start();
	ping6.start();
	ping7.start();
	ping8.start();
	ping9.start();
	ping10.start();
}