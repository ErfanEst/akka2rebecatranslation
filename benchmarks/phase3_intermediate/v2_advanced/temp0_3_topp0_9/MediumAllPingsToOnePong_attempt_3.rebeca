reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}
	statevars {
		int id;
	}

	PingActor() {
		// id is set in constructor in main via knownrebecs/initial messages if needed
	}

	msgsrv start() {
		pingMsg();
	}

	msgsrv setId(int _id) {
		id = _id;
	}

	msgsrv pingMsg() {
		pong.ping(id);
	}

	msgsrv pongResponse(int id, int msgId) {
		// no further behavior
	}
}

reactiveclass PongActor {
	knownrebecs {
		PingActor ping1;
		PingActor ping2;
		PingActor ping3;
		PingActor ping4;
		PingActor ping5;
		PingActor ping6;
		PingActor ping7;
		PingActor ping8;
		PingActor ping9;
		PingActor ping10;
	}
	statevars {
		int nextMsgId;
	}

	PongActor() {
		nextMsgId = 0;
	}

	msgsrv ping(int id) {
		int myMsgId;
		myMsgId = nextMsgId;
		nextMsgId = nextMsgId + 1;
		sendPong(id, myMsgId);
	}

	msgsrv sendPong(int id, int msgId) {
		if (id == 1) {
			ping1.pongResponse(id, msgId);
		} else if (id == 2) {
			ping2.pongResponse(id, msgId);
		} else if (id == 3) {
			ping3.pongResponse(id, msgId);
		} else if (id == 4) {
			ping4.pongResponse(id, msgId);
		} else if (id == 5) {
			ping5.pongResponse(id, msgId);
		} else if (id == 6) {
			ping6.pongResponse(id, msgId);
		} else if (id == 7) {
			ping7.pongResponse(id, msgId);
		} else if (id == 8) {
			ping8.pongResponse(id, msgId);
		} else if (id == 9) {
			ping9.pongResponse(id, msgId);
		} else if (id == 10) {
			ping10.pongResponse(id, msgId);
		}
	}
}

main {
	PingActor ping1(pong);
	PingActor ping2(pong);
	PingActor ping3(pong);
	PingActor ping4(pong);
	PingActor ping5(pong);
	PingActor ping6(pong);
	PingActor ping7(pong);
	PingActor ping8(pong);
	PingActor ping9(pong);
	PingActor ping10(pong);
	PongActor pong(ping1, ping2, ping3, ping4, ping5, ping6, ping7, ping8, ping9, ping10);

	ping1.setId(1);
	ping2.setId(2);
	ping3.setId(3);
	ping4.setId(4);
	ping5.setId(5);
	ping6.setId(6);
	ping7.setId(7);
	ping8.setId(8);
	ping9.setId(9);
	ping10.setId(10);

	ping1.start();
	ping2.start();
	ping3.start();
	ping4.start();
	ping5.start();
	ping6.start();
	ping7.start();
	ping8.start();
	ping9.start();
	ping10.start();
}