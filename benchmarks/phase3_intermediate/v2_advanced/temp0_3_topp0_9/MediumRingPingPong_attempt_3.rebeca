reactiveclass RingActor(a) {
	knownrebecs {
		RingActor next;
	}
	statevars {
	}

	msgsrv initial() {
		// no initialization needed
	}

	msgsrv ping() {
		next.ping();
	}
}

main {
	// Declaration of rebecs with their known rebecs
	RingActor a1(a2):();
	RingActor a2(a3):();
	RingActor a3(a4):();
	RingActor a4(a5):();
	RingActor a5(a1):();

	// Startup message
	a1.ping();
}