reactiveclass PingActor(2) {
  knownrebecs {
    PongActor pong;
  }
  statevars {
    int id;
  }

  PingActor(PongActor _pong, int _id) {
    pong = _pong;
    id = _id;
  }

  msgsrv initial() {
  }

  msgsrv start() {
    pong.ping(id);
  }

  msgsrv handleMsg() {
    pong.ping(id);
  }
}

reactiveclass PongActor(10) {
  knownrebecs {
    PingActor p1;
    PingActor p2;
    PingActor p3;
    PingActor p4;
    PingActor p5;
    PingActor p6;
    PingActor p7;
    PingActor p8;
    PingActor p9;
    PingActor p10;
  }
  statevars {
  }

  PongActor(PingActor _p1, PingActor _p2, PingActor _p3, PingActor _p4, PingActor _p5,
            PingActor _p6, PingActor _p7, PingActor _p8, PingActor _p9, PingActor _p10) {
    p1 = _p1;
    p2 = _p2;
    p3 = _p3;
    p4 = _p4;
    p5 = _p5;
    p6 = _p6;
    p7 = _p7;
    p8 = _p8;
    p9 = _p9;
    p10 = _p10;
  }

  msgsrv initial() {
  }

  msgsrv ping(int id) {
    if (id == 1) {
      p1.handleMsg();
    } else if (id == 2) {
      p2.handleMsg();
    } else if (id == 3) {
      p3.handleMsg();
    } else if (id == 4) {
      p4.handleMsg();
    } else if (id == 5) {
      p5.handleMsg();
    } else if (id == 6) {
      p6.handleMsg();
    } else if (id == 7) {
      p7.handleMsg();
    } else if (id == 8) {
      p8.handleMsg();
    } else if (id == 9) {
      p9.handleMsg();
    } else {
      p10.handleMsg();
    }
  }
}

main {
  PongActor pong():();

  PingActor p1(pong):(pong, 1);
  PingActor p2(pong):(pong, 2);
  PingActor p3(pong):(pong, 3);
  PingActor p4(pong):(pong, 4);
  PingActor p5(pong):(pong, 5);
  PingActor p6(pong):(pong, 6);
  PingActor p7(pong):(pong, 7);
  PingActor p8(pong):(pong, 8);
  PingActor p9(pong):(pong, 9);
  PingActor p10(pong):(pong, 10);

  pong(p1, p2, p3, p4, p5, p6, p7, p8, p9, p10):();

  p1.start();
  p2.start();
  p3.start();
  p4.start();
  p5.start();
  p6.start();
  p7.start();
  p8.start();
  p9.start();
  p10.start();
}