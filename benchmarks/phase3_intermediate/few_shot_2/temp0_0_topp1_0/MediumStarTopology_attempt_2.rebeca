reactiveclass Client(5) {
  knownrebecs { Hub hub; }
  statevars { }

  msgsrv initial() { }

  msgsrv start() {
    hub.Ping(self);
  }

  msgsrv Pong() {
    hub.Ping(self);
  }
}

reactiveclass Hub(10) {
  knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; }
  statevars { int clientsCount; Client clients[5]; }

  msgsrv initial() {
    clientsCount = 0;
    self.Register(c1);
    self.Register(c2);
    self.Register(c3);
    self.Register(c4);
    self.Register(c5);
    c1.start();
    c2.start();
    c3.start();
    c4.start();
    c5.start();
  }

  msgsrv Register(Client ref) {
    if (clientsCount < 5) {
      clients[clientsCount] = ref;
      clientsCount = clientsCount + 1;
    }
  }

  msgsrv Ping(Client senderRef) {
    senderRef.Pong();
  }
}

main {
  Hub h(c1, c2, c3, c4, c5):();
  Client c1(h):();
  Client c2(h):();
  Client c3(h):();
  Client c4(h):();
  Client c5(h):();
}