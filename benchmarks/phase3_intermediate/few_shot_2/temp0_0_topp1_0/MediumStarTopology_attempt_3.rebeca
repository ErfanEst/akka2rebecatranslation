reactiveclass Client(5) {
  knownrebecs { Hub hub; }
  statevars { }

  msgsrv initial() { }

  msgsrv start() {
    hub.Ping();
  }

  msgsrv Pong() {
    hub.Ping();
  }
}

reactiveclass Hub(10) {
  knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; }
  statevars { int clientsCount; Client clients[5]; }

  msgsrv initial() {
    clientsCount = 0;
    self.Register1();
    self.Register2();
    self.Register3();
    self.Register4();
    self.Register5();
    c1.start();
    c2.start();
    c3.start();
    c4.start();
    c5.start();
  }

  msgsrv Register1() {
    if (clientsCount < 5) {
      clients[clientsCount] = c1;
      clientsCount = clientsCount + 1;
    }
  }

  msgsrv Register2() {
    if (clientsCount < 5) {
      clients[clientsCount] = c2;
      clientsCount = clientsCount + 1;
    }
  }

  msgsrv Register3() {
    if (clientsCount < 5) {
      clients[clientsCount] = c3;
      clientsCount = clientsCount + 1;
    }
  }

  msgsrv Register4() {
    if (clientsCount < 5) {
      clients[clientsCount] = c4;
      clientsCount = clientsCount + 1;
    }
  }

  msgsrv Register5() {
    if (clientsCount < 5) {
      clients[clientsCount] = c5;
      clientsCount = clientsCount + 1;
    }
  }

  msgsrv Ping() {
    // no-op or any internal behavior; original just replied immediately
  }
}

main {
  Client c1(h):();
  Client c2(h):();
  Client c3(h):();
  Client c4(h):();
  Client c5(h):();
  Hub h(c1, c2, c3, c4, c5):();
}