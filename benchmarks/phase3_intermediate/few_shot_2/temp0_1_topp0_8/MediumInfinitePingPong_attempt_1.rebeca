reactiveclass PingActor(5) {
  knownrebecs { PongActor pong; }
  statevars { }

  PingActor() { }

  msgsrv initial() { }

  msgsrv Start() {
    pong.Ping();
  }

  msgsrv Pong() {
    pong.Ping();
  }
}

reactiveclass PongActor(5) {
  knownrebecs { }
  statevars { }

  PongActor() { }

  msgsrv initial() { }

  msgsrv Ping() {
    sender.Pong();
  }
}

main {
  PingActor ping(pong):();
  PongActor pong():();

  ping.Start();
}