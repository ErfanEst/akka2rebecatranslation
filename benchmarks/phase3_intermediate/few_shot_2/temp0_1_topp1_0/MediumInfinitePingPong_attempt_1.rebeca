reactiveclass PingActor(5) {
  knownrebecs { PongActor pong; } 
  statevars { } 

  msgsrv initial() { 
    // no-op
  } 

  msgsrv Start() { 
    pong.Ping(); 
  } 

  msgsrv Pong() { 
    pong.Ping(); 
  } 
} 

reactiveclass PongActor(5) {
  knownrebecs { PingActor ping; } 
  statevars { } 

  msgsrv initial() { 
    // no-op
  } 

  msgsrv Ping() { 
    ping.Pong(); 
  } 
} 

main { 
  PingActor ping(pong):(); 
  PongActor pong(ping):(); 
}