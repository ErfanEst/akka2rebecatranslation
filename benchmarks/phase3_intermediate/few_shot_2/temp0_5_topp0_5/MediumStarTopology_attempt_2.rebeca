reactiveclass Client(5) {
	knownrebecs { Hub hub; }
	statevars { }

	msgsrv initial() { }

	msgsrv start() {
		hub.ping();
	}

	msgsrv pong() {
		hub.ping();
	}
}

reactiveclass Hub(10) {
	knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; }
	statevars { }

	msgsrv initial() { }

	msgsrv register() {
		// Registration logic omitted due to static knownrebecs
	}

	msgsrv ping() {
		// sender.pong();  // 'sender' is not supported in Rebeca; direct callback not possible
	}
}

main {
	Hub h(c1, c2, c3, c4, c5):();
	Client c1(h):();
	Client c2(h):();
	Client c3(h):();
	Client c4(h):();
	Client c5(h):();

	c1.start();
	c2.start();
	c3.start();
	c4.start();
	c5.start();
}