reactiveclass Client(5) {
	knownrebecs { Hub hub; }
	statevars { }

	msgsrv initial() { }

	msgsrv start() {
		hub.Ping(self);
	}

	msgsrv Pong() {
		hub.Ping(self);
	}
}

reactiveclass Hub(10) {
	knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; }
	statevars { int clientsCount; }

	msgsrv initial() {
		clientsCount = 0;
	}

	msgsrv Register(Client ref) {
		clientsCount = clientsCount + 1;
	}

	msgsrv Ping(Client ref) {
		ref.Pong();
	}
}

main {
	Client c1(hub):();
	Client c2(hub):();
	Client c3(hub):();
	Client c4(hub):();
	Client c5(hub):();
	Hub hub(c1, c2, c3, c4, c5):();

	hub.Register(c1);
	hub.Register(c2);
	hub.Register(c3);
	hub.Register(c4);
	hub.Register(c5);

	c1.start();
	c2.start();
	c3.start();
	c4.start();
	c5.start();
}