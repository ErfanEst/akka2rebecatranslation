reactiveclass Client(5) {
	knownrebecs { Hub hub; }
	statevars { }

	msgsrv initial() {
		hub.ping();
	}

	msgsrv pong() {
		hub.ping();
	}
}

reactiveclass Hub(10) {
	knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; }
	statevars { }

	msgsrv initial() {
		// registration and start
		self.register(c1);
		self.register(c2);
		self.register(c3);
		self.register(c4);
		self.register(c5);

		c1.initial();
		c2.initial();
		c3.initial();
		c4.initial();
		c5.initial();
	}

	msgsrv register(Client ref) {
		// in this simplified model, registration has no stored state
	}

	msgsrv ping() {
		sender.pong();
	}
}

main {
	Hub hub(c1, c2, c3, c4, c5):();
	Client c1(hub):();
	Client c2(hub):();
	Client c3(hub):();
	Client c4(hub):();
	Client c5(hub):();
}