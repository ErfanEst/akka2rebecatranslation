reactiveclass PingActor(3) {
  knownrebecs { PongActor pong; }
  statevars { int id; }

  PingActor(int _id) {
    id = _id;
  }

  msgsrv initial() {
  }

  msgsrv start() {
    pong.ping(id);
  }

  msgsrv onString() {
    pong.ping(id);
  }
}

reactiveclass PongActor(3) {
  knownrebecs { PingActor ping1; PingActor ping2; PingActor ping3; PingActor ping4; PingActor ping5; PingActor ping6; PingActor ping7; PingActor ping8; PingActor ping9; PingActor ping10; }

  PongActor() {
  }

  msgsrv ping(int fromId) {
    if (fromId == 1) {
      ping1.onString();
    } else if (fromId == 2) {
      ping2.onString();
    } else if (fromId == 3) {
      ping3.onString();
    } else if (fromId == 4) {
      ping4.onString();
    } else if (fromId == 5) {
      ping5.onString();
    } else if (fromId == 6) {
      ping6.onString();
    } else if (fromId == 7) {
      ping7.onString();
    } else if (fromId == 8) {
      ping8.onString();
    } else if (fromId == 9) {
      ping9.onString();
    } else if (fromId == 10) {
      ping10.onString();
    }
  }
}

main {
  PingActor ping1(pong): (1);
  PingActor ping2(pong): (2);
  PingActor ping3(pong): (3);
  PingActor ping4(pong): (4);
  PingActor ping5(pong): (5);
  PingActor ping6(pong): (6);
  PingActor ping7(pong): (7);
  PingActor ping8(pong): (8);
  PingActor ping9(pong): (9);
  PingActor ping10(pong): (10);
  PongActor pong(ping1, ping2, ping3, ping4, ping5, ping6, ping7, ping8, ping9, ping10):();

  ping1.start();
  ping2.start();
  ping3.start();
  ping4.start();
  ping5.start();
  ping6.start();
  ping7.start();
  ping8.start();
  ping9.start();
  ping10.start();
}