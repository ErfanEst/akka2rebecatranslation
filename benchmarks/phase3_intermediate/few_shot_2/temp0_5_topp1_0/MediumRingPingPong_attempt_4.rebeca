reactiveclass RingActor(5) {
	knownrebecs {
		RingActor next;
	}

	statevars {
		boolean initialized;
	}

	RingActor() {
		initialized = false;
	}

	msgsrv initial() {
		// no-op
	}

	msgsrv setNext() {
		initialized = true;
	}

	msgsrv ping() {
		if (initialized) {
			next.ping();
		}
	}
}

main {
	RingActor a1(a2):();
	RingActor a2(a3):();
	RingActor a3(a4):();
	RingActor a4(a5):();
	RingActor a5(a1):();

	a1.setNext();
	a2.setNext();
	a3.setNext();
	a4.setNext();
	a5.setNext();

	a1.ping();
}