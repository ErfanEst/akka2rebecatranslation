reactiveclass Client(2) {
	knownrebecs { Hub hub; } 
	statevars { } 

	msgsrv initial() { 
		hub.Ping(); 
	} 

	msgsrv Pong() { 
		hub.Ping(); 
	} 
} 

reactiveclass Hub(7) {
	knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; Client sender; } 
	statevars { 
		Client clients[5]; 
		int clientCount; 
	} 

	msgsrv initial() { 
		clientCount = 0; 
		self.Register(c1); 
		self.Register(c2); 
		self.Register(c3); 
		self.Register(c4); 
		self.Register(c5); 
		c1.initial(); 
		c2.initial(); 
		c3.initial(); 
		c4.initial(); 
		c5.initial(); 
	} 

	msgsrv Register(Client ref) { 
		if (clientCount < 5) { 
			clients[clientCount] = ref; 
			clientCount = clientCount + 1; 
		} 
	} 

	msgsrv Ping(Client snd) { 
		snd.Pong(); 
	} 
} 

main { 
	Client c1(hub):(); 
	Client c2(hub):(); 
	Client c3(hub):(); 
	Client c4(hub):(); 
	Client c5(hub):(); 
	Hub hub(c1, c2, c3, c4, c5, c1):(); 
}