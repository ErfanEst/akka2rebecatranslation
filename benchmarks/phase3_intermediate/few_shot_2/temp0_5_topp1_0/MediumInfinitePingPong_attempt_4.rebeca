reactiveclass PingActor(3) {
  knownrebecs { 
    PongActor pong; 
  } 
  statevars { 
  } 

  PingActor(PongActor p) { 
    pong = p;
  } 

  msgsrv initial() { 
  } 

  msgsrv Start() { 
    pong.Ping(); 
  } 

  msgsrv Pong() { 
    pong.Ping(); 
  } 
} 

