reactiveclass RingActor(5) {
	knownrebecs {
		RingActor next;
	}

	statevars {
		boolean initialized;
	}

	msgsrv initial() {
		initialized = false;
	}

	msgsrv setNext(RingActor ref) {
		next = ref;
		initialized = true;
	}

	msgsrv ping() {
		if (initialized) {
			next.ping();
		}
	}
}

main {
	RingActor a1(a2):();
	RingActor a2(a3):();
	RingActor a3(a4):();
	RingActor a4(a5):();
	RingActor a5(a1):();

	a1.ping();
}