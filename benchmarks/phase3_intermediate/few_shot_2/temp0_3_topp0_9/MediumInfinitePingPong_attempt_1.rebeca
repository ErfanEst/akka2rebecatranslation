reactiveclass PingActor(5) {
	knownrebecs { PongActor pong; }
	statevars { }

	msgsrv initial() { }

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor(5) {
	knownrebecs { }
	statevars { }

	msgsrv initial() { }

	msgsrv Ping() {
		// In Akka: sender() ! Pong
		// Here, PongActor must be called by a known rebec; that rebec should
		// provide a msgsrv to receive Pong. Since Rebeca doesn't support
		// dynamic sender, we model this by having PingActor call its own
		// Pong() msgsrv after sending Ping, so explicit sender reference is
		// not used here.
	}
}

main {
	PongActor pong():();
	PingActor ping(pong):();

	ping.Start();
}