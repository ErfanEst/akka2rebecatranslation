reactiveclass PingActor(5) {
	knownrebecs {
		PongActor pong;
	}
	statevars {
		int id;
	}

	PingActor(int _id) {
		id = _id;
	}

	msgsrv initial() {
		// no automatic start
	}

	msgsrv start() {
		pong.ping(id);
	}

	msgsrv msg(int dummy) {
		pong.ping(id);
	}

	msgsrv pong() {
		// response handler
	}
}

reactiveclass PongActor(5) {
	knownrebecs {
		PingActor p1;
		PingActor p2;
		PingActor p3;
		PingActor p4;
		PingActor p5;
		PingActor p6;
		PingActor p7;
		PingActor p8;
		PingActor p9;
		PingActor p10;
	}

	statevars {
	}

	PongActor() {
	}

	msgsrv initial() {
	}

	msgsrv ping(int id) {
		if (id == 1) {
			p1.pong();
		} else if (id == 2) {
			p2.pong();
		} else if (id == 3) {
			p3.pong();
		} else if (id == 4) {
			p4.pong();
		} else if (id == 5) {
			p5.pong();
		} else if (id == 6) {
			p6.pong();
		} else if (id == 7) {
			p7.pong();
		} else if (id == 8) {
			p8.pong();
		} else if (id == 9) {
			p9.pong();
		} else if (id == 10) {
			p10.pong();
		}
	}
}

reactiveclass DummyPing(5) {
	knownrebecs {
	}

	statevars {
	}

	DummyPing() {
	}

	msgsrv initial() {
	}
}

main {
	PingActor ping1(pong): (1);
	PingActor ping2(pong): (2);
	PingActor ping3(pong): (3);
	PingActor ping4(pong): (4);
	PingActor ping5(pong): (5);
	PingActor ping6(pong): (6);
	PingActor ping7(pong): (7);
	PingActor ping8(pong): (8);
	PingActor ping9(pong): (9);
	PingActor ping10(pong): (10);

	PongActor pong(ping1, ping2, ping3, ping4, ping5, ping6, ping7, ping8, ping9, ping10): ();

	DummyPing dummy(): ();

	main {
		ping1.start();
		ping2.start();
		ping3.start();
		ping4.start();
		ping5.start();
		ping6.start();
		ping7.start();
		ping8.start();
		ping9.start();
		ping10.start();
	}
}