reactiveclass Client(5) {
    knownrebecs { Hub hub; }
    statevars { }

    Client() { }

    msgsrv initial() { }

    msgsrv start() {
        hub.Ping(self);
    }

    msgsrv Pong() {
        hub.Ping(self);
    }
}

reactiveclass Hub(5) {
    knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; }
    statevars { int clientsCount; }

    Hub() {
        clientsCount = 0;
    }

    msgsrv initial() { }

    msgsrv Register(Client ref) {
        clientsCount = clientsCount + 1;
    }

    msgsrv Ping(Client senderRef) {
        senderRef.Pong();
    }
}

main {
    Hub hub(c1, c2, c3, c4, c5):();
    Client c1(hub):();
    Client c2(hub):();
    Client c3(hub):();
    Client c4(hub):();
    Client c5(hub):();

    hub.Register(c1);
    c1.start();

    hub.Register(c2);
    c2.start();

    hub.Register(c3);
    c3.start();

    hub.Register(c4);
    c4.start();

    hub.Register(c5);
    c5.start();
}