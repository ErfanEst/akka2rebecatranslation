reactiveclass PingActor(5) {
	knownrebecs { PongActor pong; }
	statevars { }

	msgsrv initial() { }

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor(5) {
	knownrebecs { }
	statevars { }

	msgsrv initial() { }

	msgsrv Ping() {
		// Intentionally left empty to model sender() ! Pong from Akka
	}
}

main {
	PongActor pong() : ();
	PingActor ping(pong) : ();
	mainRebec starter(ping) : ();
}

reactiveclass mainRebec(5) {
	knownrebecs { PingActor ping; }
	statevars { }

	msgsrv initial() {
		ping.Start();
	}
}