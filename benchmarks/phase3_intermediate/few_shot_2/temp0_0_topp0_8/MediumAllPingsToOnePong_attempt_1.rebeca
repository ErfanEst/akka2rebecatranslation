reactiveclass PingActor(5) {
	knownrebecs { PongActor pong; }
	statevars { int id; }

	PingActor(int _id) {
		id = _id;
	}

	msgsrv initial() {
		self.start();
	}

	msgsrv start() {
		pong.ping(id);
	}

	msgsrv receiveString() {
		pong.ping(id);
	}
}

reactiveclass PongActor(5) {
	knownrebecs { PingActor ping1; PingActor ping2; PingActor ping3; PingActor ping4; PingActor ping5; PingActor ping6; PingActor ping7; PingActor ping8; PingActor ping9; PingActor ping10; }

	statevars { }

	PongActor() {
	}

	msgsrv initial() {
	}

	msgsrv ping(int id) {
		if (id == 1) {
			ping1.pong();
		} else if (id == 2) {
			ping2.pong();
		} else if (id == 3) {
			ping3.pong();
		} else if (id == 4) {
			ping4.pong();
		} else if (id == 5) {
			ping5.pong();
		} else if (id == 6) {
			ping6.pong();
		} else if (id == 7) {
			ping7.pong();
		} else if (id == 8) {
			ping8.pong();
		} else if (id == 9) {
			ping9.pong();
		} else if (id == 10) {
			ping10.pong();
		}
	}
}

main {
	PongActor pong(ping1, ping2, ping3, ping4, ping5, ping6, ping7, ping8, ping9, ping10):();
	PingActor ping1(pong): (1);
	PingActor ping2(pong): (2);
	PingActor ping3(pong): (3);
	PingActor ping4(pong): (4);
	PingActor ping5(pong): (5);
	PingActor ping6(pong): (6);
	PingActor ping7(pong): (7);
	PingActor ping8(pong): (8);
	PingActor ping9(pong): (9);
	PingActor ping10(pong): (10);
}