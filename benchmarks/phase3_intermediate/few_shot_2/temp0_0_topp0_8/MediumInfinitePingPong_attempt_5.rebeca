reactiveclass PingActor(5) {
	knownrebecs { PongActor pong; }
	statevars { }

	PingActor() {
		self.initial();
	}

	msgsrv initial() { }

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor(5) {
	knownrebecs { PingActor ping; }
	statevars { }

	PongActor() {
		self.initial();
	}

	msgsrv initial() { }

	msgsrv Ping() {
		ping.Pong();
	}
}

main {
	PingActor ping(PongActor pong): (pong);
	PongActor pong(PingActor ping): (ping);

	ping.Start();
}