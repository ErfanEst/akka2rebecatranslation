reactiveclass Client(5) {
    knownrebecs { Hub hub; }
    statevars { }

    msgsrv initial() { }

    msgsrv start() {
        hub.ping(self);
    }

    msgsrv pong() {
        hub.ping(self);
    }
}

reactiveclass Hub(10) {
    knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; }
    statevars {
        int clientCount;
        Client clients[5];
    }

    msgsrv initial() {
        clientCount = 0;
    }

    msgsrv register(Client ref) {
        if (clientCount < 5) {
            clients[clientCount] = ref;
            clientCount = clientCount + 1;
        }
    }

    msgsrv ping(Client senderRef) {
        senderRef.pong();
    }
}

main {
    Client c1(hub):();
    Client c2(hub):();
    Client c3(hub):();
    Client c4(hub):();
    Client c5(hub):();
    Hub hub(c1, c2, c3, c4, c5):();

    hub.register(c1);
    c1.start();

    hub.register(c2);
    c2.start();

    hub.register(c3);
    c3.start();

    hub.register(c4);
    c4.start();

    hub.register(c5);
    c5.start();
}