reactiveclass PingActor(5) {
	knownrebecs { PongActor pong; }
	statevars { }

	PingActor(PongActor p) {
		pong = p;
	}

	msgsrv initial() { }

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor(5) {
	knownrebecs { PingActor ping; }
	statevars { }

	PongActor(PingActor p) {
		ping = p;
	}

	msgsrv initial() { }

	msgsrv Ping() {
		ping.Pong();
	}
}

main {
	PingActor ping(PongActor):();
	PongActor pong(PingActor):(ping);

	ping.Start();
}