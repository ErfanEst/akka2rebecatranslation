reactiveclass PingActor(5) {
	knownrebecs { PongActor pong; }
	statevars { }

	msgsrv initial() { }

	msgsrv Start() {
		ping.Ping();
	}

	msgsrv Pong() {
		ping.Ping();
	}
}

reactiveclass PongActor(5) {
	knownrebecs { PingActor ping; }
	statevars { }

	msgsrv initial() { }

	msgsrv Ping() {
		ping.Pong();
	}
}

main {
	PongActor pong():();
	PingActor ping(pong):();

	ping.Start():();
}