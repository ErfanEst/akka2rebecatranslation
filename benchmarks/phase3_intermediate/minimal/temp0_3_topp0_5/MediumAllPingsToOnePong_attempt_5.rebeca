reactiveclass PingActor(pong: PongActor, i: byte) {
	knownrebecs { 
		PongActor pong;
	}
	statevars {
		byte id;
	}

	PingActor(PongActor p, byte i) {
		pong = p;
		id = i;
	}

	msgsrv initial() {
		start();
	}

	msgsrv start() {
		ping();
	}

	msgsrv ping() {
		pong.ping(id);
	}

	msgsrv pongResponse(byte i) {
		// handle pong if needed
	}
}

reactiveclass PongActor() {
	knownrebecs { }

	PongActor() {
	}

	msgsrv initial() { }

	msgsrv ping(byte i) {
		self.pongForPing(i);
	}

	msgsrv pongForPing(byte i) {
		// response handling
	}
}

main {
	PongActor pong():();

	PingActor p1(pong, 1):(pong, 1);
	PingActor p2(pong, 2):(pong, 2);
	PingActor p3(pong, 3):(pong, 3);
	PingActor p4(pong, 4):(pong, 4);
	PingActor p5(pong, 5):(pong, 5);
	PingActor p6(pong, 6):(pong, 6);
	PingActor p7(pong, 7):(pong, 7);
	PingActor p8(pong, 8):(pong, 8);
	PingActor p9(pong, 9):(pong, 9);
	PingActor p10(pong, 10):(pong, 10);
}