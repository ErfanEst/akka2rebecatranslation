reactiveclass PingActor(pong: PongActor, id: int) {
    knownrebecs { PongActor pong; }

    msgsrv initial() {
        // equivalent to sending "start" after creation
        start();
    }

    msgsrv start() {
        ping();
    }

    msgsrv ping() {
        pong.ping(id);
    }

    msgsrv pongResponse(int id) {
        // handle pong if needed
    }
}

reactiveclass PongActor {
    knownrebecs { }

    msgsrv initial() { }

    msgsrv ping(int id) {
        self.pongForPing(id);
    }

    msgsrv pongForPing(int id) {
        // in Akka: sender() ! s"pong-for-$msg"
        // In Rebeca we need explicit reference; simplified here
    }
}

main {
    PongActor pong();

    PingActor p1(pong, 1);
    PingActor p2(pong, 2);
    PingActor p3(pong, 3);
    PingActor p4(pong, 4);
    PingActor p5(pong, 5);
    PingActor p6(pong, 6);
    PingActor p7(pong, 7);
    PingActor p8(pong, 8);
    PingActor p9(pong, 9);
    PingActor p10(pong, 10);
}