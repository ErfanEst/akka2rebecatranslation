reactiveclass PingActor(pongId: int, id: int) {
    knownrebecs {
        PongActor pong[pongId];
    }

    msgsrv initial() {
        // no automatic start; environment should call start()
    }

    msgsrv start() {
        ping();
    }

    msgsrv ping() {
        pong.pingMsg(id);
    }

    msgsrv pongResponse(int pongId, int pingId) {
        // handle pong response if needed
    }
}

reactiveclass PongActor {
    knownrebecs {
        PingActor pings[10];
    }

    msgsrv initial() {
        // initialization if needed
    }

    msgsrv pingMsg(int pingId) {
        pings[pingId - 1].pongResponse(0, pingId);
    }
}

main {
    PongActor pong(pings: pings);

    PingActor pings[10](pongId: 0, id: 1);
    PingActor pings[10](pongId: 0, id: 2);
    PingActor pings[10](pongId: 0, id: 3);
    PingActor pings[10](pongId: 0, id: 4);
    PingActor pings[10](pongId: 0, id: 5);
    PingActor pings[10](pongId: 0, id: 6);
    PingActor pings[10](pongId: 0, id: 7);
    PingActor pings[10](pongId: 0, id: 8);
    PingActor pings[10](pongId: 0, id: 9);
    PingActor pings[10](pongId: 0, id: 10);

    // start all ping actors
    pings[0].start();
    pings[1].start();
    pings[2].start();
    pings[3].start();
    pings[4].start();
    pings[5].start();
    pings[6].start();
    pings[7].start();
    pings[8].start();
    pings[9].start();
}