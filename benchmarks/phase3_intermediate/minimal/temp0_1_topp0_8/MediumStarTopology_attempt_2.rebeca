reactiveclass Client {
	knownrebecs { 
		Hub hub;
	}

	Client(Hub h) {
		hub = h;
	}

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}
}

reactiveclass Hub {
	knownrebecs { 
		Client c1; 
		Client c2; 
		Client c3; 
		Client c4; 
		Client c5; 
	}

	Hub() {
	}

	msgsrv Ping() {
		sender.Pong();
	}
}

main {
	Hub hub():();
	Client c1(hub):();
	Client c2(hub):();
	Client c3(hub):();
	Client c4(hub):();
	Client c5(hub):();

	c1.start();
	c2.start();
	c3.start();
	c4.start();
	c5.start();
}