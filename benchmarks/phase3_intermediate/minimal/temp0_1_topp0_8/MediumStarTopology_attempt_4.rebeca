reactiveclass Client(hubKnown : Hub) {
	knownrebecs { 
		Hub hub;
	}

	Client(Hub h) {
		hub = h;
	}

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}
}

reactiveclass Hub(c1Known : Client, c2Known : Client, c3Known : Client, c4Known : Client, c5Known : Client) {
	knownrebecs { 
		Client c1; 
		Client c2; 
		Client c3; 
		Client c4; 
		Client c5; 
	}

	Hub(Client c1Ref, Client c2Ref, Client c3Ref, Client c4Ref, Client c5Ref) {
		c1 = c1Ref;
		c2 = c2Ref;
		c3 = c3Ref;
		c4 = c4Ref;
		c5 = c5Ref;
	}

	msgsrv Ping() {
		sender.Pong();
	}
}

main {
	Hub hub(c1, c2, c3, c4, c5):();
	Client c1(hub):();
	Client c2(hub):();
	Client c3(hub):();
	Client c4(hub):();
	Client c5(hub):();

	c1.start();
	c2.start();
	c3.start();
	c4.start();
	c5.start();
}