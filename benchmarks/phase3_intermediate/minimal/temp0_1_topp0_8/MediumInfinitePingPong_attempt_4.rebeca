reactiveclass PingActor {
	statevars {
		PongActor pong;
	}

	knownrebecs {
		PongActor pong;
	}

	msgsrv initial() {
		// no-op
	}

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor {
	statevars {
	}

	knownrebecs {
	}

	msgsrv initial() {
		// no-op
	}

	msgsrv Ping() {
		sender.Pong();
	}
}

main {
	PongActor pong();
	PingActor ping(pong): (pong);

	ping.Start();
}