reactiveclass RingActor {
    knownrebecs { RingActor next; }

    msgsrv setNext(RingActor ref) {
        next = ref;
    }

    msgsrv ping() {
        next.ping();
    }

    RingActor() {
        // no initialization
    }
}

main {
    RingActor a1(a2);
    RingActor a2(a3);
    RingActor a3(a4);
    RingActor a4(a5);
    RingActor a5(a1);

    a1.ping();
}