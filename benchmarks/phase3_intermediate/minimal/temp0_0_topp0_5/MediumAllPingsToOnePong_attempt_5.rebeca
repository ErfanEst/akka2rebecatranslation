reactiveclass PingActor {
	knownrebecs { PongActor pong; }
	statevars { byte id; }

	PingActor(PongActor _pong, byte _id) {
		pong = _pong;
		id = _id;
		self.start();
	}

	msgsrv start() {
		pong.ping(id);
	}

	msgsrv pongResponse(byte pongId, byte pingId) {
		pong.ping(id);
	}
}

reactiveclass PongActor {
	knownrebecs { }

	PongActor() {
	}

	msgsrv ping(byte pingId) {
		self.pongForPing(pingId);
	}

	msgsrv pongForPing(byte pingId) {
		// response modeled via knownrebecs in PingActor
	}
}

main {
	PongActor pong();

	PingActor ping1(pong, 1:byte);
	PingActor ping2(pong, 2:byte);
	PingActor ping3(pong, 3:byte);
	PingActor ping4(pong, 4:byte);
	PingActor ping5(pong, 5:byte);
	PingActor ping6(pong, 6:byte);
	PingActor ping7(pong, 7:byte);
	PingActor ping8(pong, 8:byte);
	PingActor ping9(pong, 9:byte);
	PingActor ping10(pong, 10:byte);
}