reactiveclass PingActor {
    knownrebecs { PongActor pong; }
    statevars { int id; }

    PingActor(int _id) {
        id = _id;
        self.start();
    }

    msgsrv start() {
        pong.ping(id);
    }

    msgsrv pongResponse(int pongId, int pingId) {
        pong.ping(id);
    }
}

reactiveclass PongActor {
    knownrebecs { }

    PongActor() {
    }

    msgsrv ping(int pingId) {
        self.pongForPing(pingId);
    }

    msgsrv pongForPing(int pingId) {
        // In Akka: sender() ! s"pong-for-$msg"
        // Here we model response by directly calling back the corresponding PingActor
        // This will be wired in the main block via knownrebecs
    }
}

main {
    PongActor pong();

    PingActor ping1(pong, 1);
    PingActor ping2(pong, 2);
    PingActor ping3(pong, 3);
    PingActor ping4(pong, 4);
    PingActor ping5(pong, 5);
    PingActor ping6(pong, 6);
    PingActor ping7(pong, 7);
    PingActor ping8(pong, 8);
    PingActor ping9(pong, 9);
    PingActor ping10(pong, 10);
}