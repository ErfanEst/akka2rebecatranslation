reactiveclass PingActor(pongId: int, id: int) {
	knownrebecs { PongActor pong[pongId]; }

	msgsrv initial() {
		start();
	}

	msgsrv start() {
		pong.ping(id);
	}

	msgsrv reply(string msg) {
		pong.ping(id);
	}
}

reactiveclass PongActor {
	msgsrv initial() {
	}

	msgsrv ping(int id) {
		self.reply(id);
	}

	msgsrv reply(int id) {
		// In Akka: sender() ! s"pong-for-ping-$id"
		// Here we only model the behavior structurally
	}
}

main {
	PongActor pong();
	PingActor p1(pong, 1);
	PingActor p2(pong, 2);
	PingActor p3(pong, 3);
	PingActor p4(pong, 4);
	PingActor p5(pong, 5);
	PingActor p6(pong, 6);
	PingActor p7(pong, 7);
	PingActor p8(pong, 8);
	PingActor p9(pong, 9);
	PingActor p10(pong, 10);
}