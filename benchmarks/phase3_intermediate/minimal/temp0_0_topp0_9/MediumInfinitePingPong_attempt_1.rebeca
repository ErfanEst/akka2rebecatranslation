reactiveclass PingActor(pong: PongActor) {
    knownrebecs { 
        PongActor pong;
    }

    msgsrv Start() {
        pong.Ping();
    }

    msgsrv Pong() {
        pong.Ping();
    }

    msgsrv initial() {
        // no-op
    }
}

reactiveclass PongActor {
    knownrebecs {
        // none
    }

    msgsrv Ping() {
        sender.Pong();
    }

    msgsrv initial() {
        // no-op
    }
}

main {
    PingActor ping(pong):();
    PongActor pong:();
    
    ping.Start();
}