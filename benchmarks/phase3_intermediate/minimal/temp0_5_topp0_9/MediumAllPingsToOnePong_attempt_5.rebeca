reactiveclass PingActor(pongServer) {
	knownrebecs {
		PongActor pongServer;
	}
	statevars {
		int id;
	}

	PingActor() {
	}

	msgsrv initial(int _id) {
		id = _id;
		self.start();
	}

	msgsrv start() {
		self.ping();
	}

	msgsrv ping() {
		pongServer.pong(id);
	}

	msgsrv pongResponse(int msg) {
		self.ping();
	}
}

reactiveclass PongActor(p1, p2, p3, p4, p5, p6, p7, p8, p9, p10) {
	knownrebecs {
		PingActor p1;
		PingActor p2;
		PingActor p3;
		PingActor p4;
		PingActor p5;
		PingActor p6;
		PingActor p7;
		PingActor p8;
		PingActor p9;
		PingActor p10;
	}

	PongActor() {
	}

	msgsrv initial() { }

	msgsrv pong(int senderId) {
		if (senderId == 1) {
			p1.pongResponse(senderId);
		} else if (senderId == 2) {
			p2.pongResponse(senderId);
		} else if (senderId == 3) {
			p3.pongResponse(senderId);
		} else if (senderId == 4) {
			p4.pongResponse(senderId);
		} else if (senderId == 5) {
			p5.pongResponse(senderId);
		} else if (senderId == 6) {
			p6.pongResponse(senderId);
		} else if (senderId == 7) {
			p7.pongResponse(senderId);
		} else if (senderId == 8) {
			p8.pongResponse(senderId);
		} else if (senderId == 9) {
			p9.pongResponse(senderId);
		} else if (senderId == 10) {
			p10.pongResponse(senderId);
		}
	}
}

main {
	PingActor ping1(pong): (1);
	PingActor ping2(pong): (2);
	PingActor ping3(pong): (3);
	PingActor ping4(pong): (4);
	PingActor ping5(pong): (5);
	PingActor ping6(pong): (6);
	PingActor ping7(pong): (7);
	PingActor ping8(pong): (8);
	PingActor ping9(pong): (9);
	PingActor ping10(pong): (10);

	PongActor pong(ping1, ping2, ping3, ping4, ping5, ping6, ping7, ping8, ping9, ping10): ();
}