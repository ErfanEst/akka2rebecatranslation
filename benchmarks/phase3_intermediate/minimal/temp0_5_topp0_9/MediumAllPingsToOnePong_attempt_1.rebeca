reactiveclass PingActor(pong: PongActor, id: int) {
    knownrebecs { PongActor pong; }

    msgsrv initial() {
        // In Akka, each PingActor receives "start" from main and sends first ping
        start();
    }

    msgsrv start() {
        ping();
    }

    msgsrv ping() {
        // Equivalent to: pong ! s"ping-$id"
        pong.pong("ping-" + id);
    }

    msgsrv pongResponse(string msg) {
        // In Akka: upon any String message, send ping again
        ping();
    }
}

reactiveclass PongActor {
    knownrebecs { }

    msgsrv initial() { }

    msgsrv pong(string msg, PingActor senderRef) {
        // In Akka: sender() ! s"pong-for-$msg"
        senderRef.pongResponse("pong-for-" + msg);
    }
}

main {
    PongActor pong();
    PingActor ping1(pong, 1);
    PingActor ping2(pong, 2);
    PingActor ping3(pong, 3);
    PingActor ping4(pong, 4);
    PingActor ping5(pong, 5);
    PingActor ping6(pong, 6);
    PingActor ping7(pong, 7);
    PingActor ping8(pong, 8);
    PingActor ping9(pong, 9);
    PingActor ping10(pong, 10);
}