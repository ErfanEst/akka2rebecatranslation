reactiveclass PingActor {
	knownrebecs {
		PongActor pongRef;
	}
	statevars {
	}
	msgsrv Start() {
		pongRef.Ping();
	}
	msgsrv Pong() {
		pongRef.Ping();
	}
}

reactiveclass PongActor {
	knownrebecs {
		PingActor pingRef;
	}
	statevars {
	}
	msgsrv Ping() {
		pingRef.Pong();
	}
}

main {
	PongActor pong(ping):();
	PingActor ping(pong):();
	ping.Start();
}