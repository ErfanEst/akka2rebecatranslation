reactiveclass Client {
    knownrebecs {
        Hub hub;
    }

    msgsrv start() {
        hub.Ping();
    }

    msgsrv Pong() {
        hub.Ping();
    }

    msgsrv initial() {
        // no-op
    }
}

reactiveclass Hub {
    knownrebecs {
        Client c1;
        Client c2;
        Client c3;
        Client c4;
        Client c5;
    }

    statevars {
        // no explicit list needed; clients are known rebecs
    }

    msgsrv Register(Client ref) {
        // In Rebeca, rebecs are statically known; dynamic registration is not modeled here.
        // This message is kept for structural similarity but does nothing.
    }

    msgsrv Ping() {
        sender.Pong();
    }

    msgsrv initial() {
        // no-op
    }
}

main {
    Hub hub(c1, c2, c3, c4, c5);
    Client c1(hub);
    Client c2(hub);
    Client c3(hub);
    Client c4(hub);
    Client c5(hub);

    c1.start();
    c2.start();
    c3.start();
    c4.start();
    c5.start();
}