reactiveclass Client (Hub hub) {
	knownrebecs { Hub hub; }

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}
}

reactiveclass Hub {
	knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; }

	msgsrv Ping() {
		sender.Pong();
	}
}

main {
	Hub hub(c1, c2, c3, c4, c5);
	Client c1(hub);
	Client c2(hub);
	Client c3(hub);
	Client c4(hub);
	Client c5(hub);

	c1.start();
	c2.start();
	c3.start();
	c4.start();
	c5.start();
}