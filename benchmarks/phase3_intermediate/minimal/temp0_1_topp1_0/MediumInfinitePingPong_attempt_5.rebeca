reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}

	statevars {
	}

	msgsrv initial() {
	}

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor {
	knownrebecs {
		PingActor ping;
	}

	statevars {
	}

	msgsrv initial() {
	}

	msgsrv Ping() {
		ping.Pong();
	}
}

main {
	PongActor pong():();
	PingActor ping(pong):();

	ping.Start();
}