reactiveclass Client {
	knownrebecs {
		Hub hub;
	}
	statevars {
	}

	Client() {
	}

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}
}

reactiveclass Hub {
	knownrebecs {
		Client c1;
		Client c2;
		Client c3;
		Client c4;
		Client c5;
	}
	statevars {
		Client clients[5];
		int count;
	}

	Hub(Client c1, Client c2, Client c3, Client c4, Client c5) {
		count = 0;
	}

	msgsrv Register(Client ref) {
		if (count < 5) {
			clients[count] = ref;
			count = count + 1;
		}
	}

	msgsrv Ping() {
		sender.Pong();
	}
}

main {
	Client c1();
	Client c2();
	Client c3();
	Client c4();
	Client c5();
	Hub hub(c1, c2, c3, c4, c5);

	knownrebecs {
		c1 : (hub);
		c2 : (hub);
		c3 : (hub);
		c4 : (hub);
		c5 : (hub);
		hub : (c1, c2, c3, c4, c5);
	}

	main {
		hub.Register(c1);
		hub.Register(c2);
		hub.Register(c3);
		hub.Register(c4);
		hub.Register(c5);

		c1.start();
		c2.start();
		c3.start();
		c4.start();
		c5.start();
	}
}