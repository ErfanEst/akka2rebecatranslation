reactiveclass Client(hubID) {
    knownrebecs {
        Hub hub;
    }
    statevars {
    }

    Client(Hub h) {
        hub = h;
    }

    msgsrv start() {
        hub.Ping();
    }

    msgsrv Pong() {
        hub.Ping();
    }
}

reactiveclass Hub {
    knownrebecs {
        Client c1;
        Client c2;
        Client c3;
        Client c4;
        Client c5;
    }
    statevars {
        Client clients[5];
        int count;
    }

    Hub() {
        count = 0;
    }

    msgsrv Register(Client ref) {
        if (count < 5) {
            clients[count] = ref;
            count = count + 1;
        }
    }

    msgsrv Ping() {
        /* In Rebeca, sender is implicit: send Pong back to the sender */
        self.sender.Pong();
    }
}

main {
    Hub hub(c1, c2, c3, c4, c5);
    Client c1(hub);
    Client c2(hub);
    Client c3(hub);
    Client c4(hub);
    Client c5(hub);

    hub.Register(c1);
    hub.Register(c2);
    hub.Register(c3);
    hub.Register(c4);
    hub.Register(c5);

    c1.start();
    c2.start();
    c3.start();
    c4.start();
    c5.start();
}