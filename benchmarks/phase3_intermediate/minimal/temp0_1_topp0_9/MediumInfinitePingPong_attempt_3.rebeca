reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}

	msgsrv initial() {
		// no-op
	}

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor {
	knownrebecs {
		PingActor ping;
	}

	msgsrv initial() {
		// no-op
	}

	msgsrv Ping() {
		ping.Pong();
	}
}

main {
	PingActor ping(pong):();
	PongActor pong(ping):();

	ping.Start();
}