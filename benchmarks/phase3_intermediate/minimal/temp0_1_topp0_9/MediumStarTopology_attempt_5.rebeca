reactiveclass Client {
	knownrebecs { Hub hub; }

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}

	Client(Hub h) {
		hub = h;
	}
}

reactiveclass Hub {
	knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; }

	msgsrv Ping() {
		sender.Pong();
	}

	Hub(Client cc1, Client cc2, Client cc3, Client cc4, Client cc5) {
		c1 = cc1;
		c2 = cc2;
		c3 = cc3;
		c4 = cc4;
		c5 = cc5;
	}
}

main {
	Hub hub():();
	Client c1(hub):();
	Client c2(hub):();
	Client c3(hub):();
	Client c4(hub):();
	Client c5(hub):();

	hub(c1, c2, c3, c4, c5):();

	c1.start();
	c2.start();
	c3.start();
	c4.start();
	c5.start();
}