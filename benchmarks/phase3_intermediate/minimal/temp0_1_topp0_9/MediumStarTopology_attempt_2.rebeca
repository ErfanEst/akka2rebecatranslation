reactiveclass Client {
	knownrebecs { Hub hub; }

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}

	Client(Hub h) {
		hub = h;
	}
}

reactiveclass Hub {
	knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; }

	msgsrv Ping() {
		sender.Pong();
	}

	Hub() {
	}
}

main {
	Hub hub();

	Client c1(hub):();
	Client c2(hub):();
	Client c3(hub):();
	Client c4(hub):();
	Client c5(hub):();

	c1.start():();
	c2.start():();
	c3.start():();
	c4.start():();
	c5.start():();
}