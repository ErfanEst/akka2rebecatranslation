reactiveclass PingActor(pongId: int, id: int) {
    knownrebecs {
        PongActor pong[pongId];
    }

    msgsrv initial() {
        // no-op
    }

    msgsrv start() {
        ping();
    }

    msgsrv ping() {
        pong.pong("ping-", id);
    }
}

reactiveclass PongActor {
    knownrebecs { }

    msgsrv initial() {
        // no-op
    }

    msgsrv pong(char[10] prefix, int id) {
        // In Rebeca, there is no generic "sender" like Akka.
        // Typically, you would have explicit references.
        // Here we define empty body to represent reply behavior.
        // A concrete model would store sender in a state var when needed.
        // This is a structural translation only.
    }
}

main {
    PongActor pong();

    PingActor ping1(pong, 1);
    PingActor ping2(pong, 2);
    PingActor ping3(pong, 3);
    PingActor ping4(pong, 4);
    PingActor ping5(pong, 5);
    PingActor ping6(pong, 6);
    PingActor ping7(pong, 7);
    PingActor ping8(pong, 8);
    PingActor ping9(pong, 9);
    PingActor ping10(pong, 10);

    ping1.start();
    ping2.start();
    ping3.start();
    ping4.start();
    ping5.start();
    ping6.start();
    ping7.start();
    ping8.start();
    ping9.start();
    ping10.start();
}