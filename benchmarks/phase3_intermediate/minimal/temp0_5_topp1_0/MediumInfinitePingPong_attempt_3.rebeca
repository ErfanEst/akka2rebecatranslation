reactiveclass PingActor {
    knownrebecs PingActor ping;
    knownrebecs PongActor pong;

    msgsrv Start() {
        pong.Ping();
    }

    msgsrv Pong() {
        pong.Ping();
    }
}

reactiveclass PongActor {
    knownrebecs PingActor ping;

    msgsrv Ping() {
        ping.Pong();
    }
}

main {
    PingActor ping(ping, pong):();
    PongActor pong(ping):();

    ping.Start();
}