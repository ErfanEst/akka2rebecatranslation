reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}

	statevars {
	}

	msgsrv initial(PongActor p) {
		pong = p;
	}

	msgsrv Start() {
		pong.Ping();
	}

	msgsrv Pong() {
		pong.Ping();
	}
}

reactiveclass PongActor {
	knownrebecs {
	}

	statevars {
	}

	msgsrv initial() {
	}

	msgsrv Ping() {
		sender.Pong();
	}
}

main {
	PongActor pong();
	PingActor ping(pong): (pong);

	ping.Start();
}