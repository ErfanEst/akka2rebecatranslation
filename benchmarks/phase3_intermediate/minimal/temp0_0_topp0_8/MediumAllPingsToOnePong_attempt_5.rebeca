reactiveclass PongActor {
	knownrebecs {
	}
	statevars {
	}

	PongActor() {
	}

	msgsrv initial() {
	}

	msgsrv pingFrom(int pingId) {
		self.pongFor(pingId);
	}

	msgsrv pongFor(int pingId) {
		// response to ping-pingId
	}
}

reactiveclass PingActor {
	knownrebecs {
		PongActor pong;
	}
	statevars {
		int id;
	}

	PingActor(PongActor pong) {
		this.pong = pong;
	}

	msgsrv initial(int _id) {
		id = _id;
	}

	msgsrv start() {
		ping();
	}

	msgsrv ping() {
		pong.pingFrom(id);
	}
}

main {
	PongActor pong():();
	PingActor ping1(pong):();
	PingActor ping2(pong):();
	PingActor ping3(pong):();
	PingActor ping4(pong):();
	PingActor ping5(pong):();
	PingActor ping6(pong):();
	PingActor ping7(pong):();
	PingActor ping8(pong):();
	PingActor ping9(pong):();
	PingActor ping10(pong):();

	ping1.initial(1);
	ping2.initial(2);
	ping3.initial(3);
	ping4.initial(4);
	ping5.initial(5);
	ping6.initial(6);
	ping7.initial(7);
	ping8.initial(8);
	ping9.initial(9);
	ping10.initial(10);

	ping1.start():();
	ping2.start():();
	ping3.start():();
	ping4.start():();
	ping5.start():();
	ping6.start():();
	ping7.start():();
	ping8.start():();
	ping9.start():();
	ping10.start():();
}