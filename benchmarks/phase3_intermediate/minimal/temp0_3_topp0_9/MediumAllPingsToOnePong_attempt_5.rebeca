reactiveclass PongActor() {
	knownrebecs { }

	statevars { }

	msgsrv ping(byte id) {
		self.pongForPing(id);
	}

	msgsrv pongForPing(byte id) {
		// placeholder for pong behavior
	}
}

reactiveclass PingActor(PongActor p, byte i) {
	knownrebecs { PongActor pong; }

	statevars {
		byte id;
	}

	constructor(PongActor p, byte i) {
		pong = p;
		id = i;
		self.start();
	}

	msgsrv start() {
		self.ping();
	}

	msgsrv ping() {
		pong.ping(id);
	}

	msgsrv externalMsg() {
		pong.ping(id);
	}
}

main {
	PongActor pong():();
	PingActor ping1(pong, 1):(pong, 1);
	PingActor ping2(pong, 2):(pong, 2);
	PingActor ping3(pong, 3):(pong, 3);
	PingActor ping4(pong, 4):(pong, 4);
	PingActor ping5(pong, 5):(pong, 5);
	PingActor ping6(pong, 6):(pong, 6);
	PingActor ping7(pong, 7):(pong, 7);
	PingActor ping8(pong, 8):(pong, 8);
	PingActor ping9(pong, 9):(pong, 9);
	PingActor ping10(pong, 10):(pong, 10);
}