reactiveclass Client {
	knownrebecs { Hub hub; }

	msgsrv start() {
		hub.Ping();
	}

	msgsrv Pong() {
		hub.Ping();
	}

	Client(Hub h) {
		hub = h;
	}
}

reactiveclass Hub {
	knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; }

	msgsrv Register(Client ref) {
		// registration is implicit via known rebecs in Rebeca
	}

	msgsrv Ping() {
		sender.Pong();
	}

	Hub(Client rc1, Client rc2, Client rc3, Client rc4, Client rc5) {
		c1 = rc1;
		c2 = rc2;
		c3 = rc3;
		c4 = rc4;
		c5 = rc5;
	}
}

main {
	Hub hub(c1, c2, c3, c4, c5);
	Client c1(hub);
	Client c2(hub);
	Client c3(hub);
	Client c4(hub);
	Client c5(hub);
}