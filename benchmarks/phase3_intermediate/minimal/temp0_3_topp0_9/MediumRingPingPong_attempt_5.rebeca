reactiveclass RingActor {
	knownrebecs {
		RingActor next;
	}

	statevars {
		// no state variables
	}

	ctor(RingActor nextParam) {
		next = nextParam;
	}

	msgsrv initial() {
		// no initialization message
	}

	msgsrv ping() {
		next.ping();
	}
}

main {
	RingActor a1(a2):();
	RingActor a2(a3):();
	RingActor a3(a4):();
	RingActor a4(a5):();
	RingActor a5(a1):();

	a1.ping();
}