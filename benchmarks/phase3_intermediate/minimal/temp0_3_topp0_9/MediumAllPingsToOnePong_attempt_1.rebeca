reactiveclass PingActor(pong: PongActor, id: int) {
    knownrebecs { PongActor pong; }

    statevars {
        int id;
    }

    PingActor(PongActor p, int i) {
        pong = p;
        id = i;
        start();
    }

    msgsrv start() {
        ping();
    }

    msgsrv ping() {
        pong.ping(id);
    }

    msgsrv externalMsg() {
        pong.ping(id);
    }
}

reactiveclass PongActor {
    knownrebecs { }

    statevars { }

    PongActor() { }

    msgsrv ping(int id) {
        pongForPing(id);
    }

    msgsrv pongForPing(int id) {
        // In Rebeca, there is no direct 'sender' reference.
        // This is a placeholder to show the pong response.
        // In a concrete model, you would pass the PingActor reference as a parameter.
    }
}

main {
    PongActor pong();
    PingActor ping1(pong, 1);
    PingActor ping2(pong, 2);
    PingActor ping3(pong, 3);
    PingActor ping4(pong, 4);
    PingActor ping5(pong, 5);
    PingActor ping6(pong, 6);
    PingActor ping7(pong, 7);
    PingActor ping8(pong, 8);
    PingActor ping9(pong, 9);
    PingActor ping10(pong, 10);
}