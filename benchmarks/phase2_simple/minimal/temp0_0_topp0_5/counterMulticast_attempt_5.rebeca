reactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs { }

	Counter() {
		count = 0;
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
	}

	knownrebecs { Counter counterRef; }

	Client(int id, Counter c) {
		clientId = id;
		counterRef = c;
	}

	msgsrv ValueResponse(int value) {
		// print: Client clientId received value: value
	}
}

main {
	Counter counter();
	Client client1(counter): (1, counter);
	Client client2(counter): (2, counter);

	client1.counterRef.Increment(client1);
	client2.counterRef.Increment(client2);
	client1.counterRef.GetValue(client1);
}