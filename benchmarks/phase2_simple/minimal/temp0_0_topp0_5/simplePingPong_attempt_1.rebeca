reactiveclass Ping {
    knownrebecs {
        Pong pong;
    }
    statevars {
        int count;
    }

    Ping(Pong pong) {
        self.count = 0;
        self.pong = pong;
    }

    msgsrv StartMessage() {
        // println("Ping started the game!");
        pong.PingMessage();
    }

    msgsrv PongMessage() {
        count = count + 1;
        // println("Ping received pong #" + count);
        if (count >= 10) {
            pong.StopMessage();
            // println("Ping stopped");
            self.terminate();
        } else {
            pong.PingMessage();
        }
    }
}

reactiveclass Pong {
    knownrebecs {
    }
    statevars {
    }

    Pong() {
    }

    msgsrv PingMessage() {
        // println("Pong received ping");
        sender.PongMessage();
    }

    msgsrv StopMessage() {
        // println("Pong stopped");
        self.terminate();
    }
}

main {
    Pong pong();
    Ping ping(pong): StartMessage();
}