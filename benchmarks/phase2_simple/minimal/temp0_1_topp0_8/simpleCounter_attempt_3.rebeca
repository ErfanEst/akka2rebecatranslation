reactiveclass Counter(counterClient1, counterClient2) {
	knownrebecs { 
		Client counterClient1; 
		Client counterClient2; 
	}

	statevars {
		int count;
	}

	Counter(Client c1, Client c2) {
		counterClient1 = c1;
		counterClient2 = c2;
		count = 0;
	}

	msgsrv initial() {
		// nothing
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client(counter, id) {
	knownrebecs { 
		Counter counter; 
	}

	statevars {
		int lastValue;
		byte clientId;
	}

	Client(Counter c, byte i) {
		counter = c;
		clientId = i;
		lastValue = 0;
	}

	msgsrv initial() {
		// nothing
	}

	msgsrv ValueResponse(int value) {
		lastValue = value;
		// side effects or environment interaction can be modeled here
	}
}

main {
	Counter counter(counterClient1, counterClient2);
	Client counterClient1(counter, 1);
	Client counterClient2(counter, 2);

	counter.Increment(counterClient1);
	counter.Increment(counterClient2);
	counter.GetValue(counterClient1);
}