reactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs { }

	Counter() {
		count = 0;
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		// println: Counter incremented to count
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		// println: Counter decremented to count
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
		Counter counter;
	}

	knownrebecs {
		Counter counterRef;
		int id;
	}

	Client(Counter c, int cid) {
		counter = c;
		clientId = cid;
	}

	msgsrv ValueResponse(int value) {
		// println: Client clientId received value: value
	}
}

main {
	Counter counter();
	Client client1(counter, 1);
	Client client2(counter, 2);

	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}