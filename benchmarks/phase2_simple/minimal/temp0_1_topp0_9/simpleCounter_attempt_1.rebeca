reactiveclass Counter(1) {
    knownrebecs { }

    statevars {
        int count;
    }

    Counter() {
        count = 0;
    }

    msgsrv initial() {
        // no-op
    }

    msgsrv Increment(Client sender) {
        count = count + 1;
        sender.ValueResponse(count);
    }

    msgsrv Decrement(Client sender) {
        count = count - 1;
        sender.ValueResponse(count);
    }

    msgsrv GetValue(Client sender) {
        sender.ValueResponse(count);
    }
}

reactiveclass Client(1) {
    knownrebecs {
        Counter counter;
    }

    statevars {
        int clientId;
    }

    Client(Counter c, int id) {
        counter = c;
        clientId = id;
    }

    msgsrv initial() {
        // no-op
    }

    msgsrv ValueResponse(int value) {
        // In Rebeca, no direct printing; placeholder for side-effect
        // e.g., modeling the reception of the value
        // Client with id clientId received value
    }
}

main {
    Counter counter();
    Client client1(counter, 1);
    Client client2(counter, 2);

    counter.Increment(client1);
    counter.Increment(client2);
    counter.GetValue(client1);
}