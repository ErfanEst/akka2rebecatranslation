reactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs { }

	Counter() {
		count = 0;
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
		Counter counter;
	}

	knownrebecs {
		Counter counter;
	}

	Client(int id) {
		clientId = id;
		counter = counter;
	}

	msgsrv ValueResponse(int value) {
		// print statement can be modeled as a comment or ignored in Rebeca core
		// Client clientId received value: value
	}
}

main {
	Counter counter();
	Client client1(counter, 1);
	Client client2(counter, 2);

	// Simulating the tell with explicit sender
	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}