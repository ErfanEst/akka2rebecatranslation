reactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs { }

	construct() {
		count = 0;
	}

	msgsrv initial() {
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
	}

	knownrebecs {
		Counter counterRef;
	}

	construct(int id, Counter c) {
		clientId = id;
		counterRef = c;
	}

	msgsrv initial() {
	}

	msgsrv ValueResponse(int value) {
		// println("Client " + clientId + " received value: " + value);
	}
}

main {
	Counter counterRef():();
	Client client1(counterRef):(1, counterRef);
	Client client2(counterRef):(2, counterRef);

	counterRef.Increment(client1);
	counterRef.Increment(client2);
	counterRef.GetValue(client1);
}