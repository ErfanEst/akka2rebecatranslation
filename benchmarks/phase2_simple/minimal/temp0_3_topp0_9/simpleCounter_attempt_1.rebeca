reactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs { }

	Counter() {
		count = 0;
	}

	msgsrv initial() {
		// no initialization messages
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
		Counter counter;
	}

	knownrebecs {
		Counter counterRef;
	}

	Client(int id, Counter c) {
		clientId = id;
		counter = c;
	}

	msgsrv initial() {
		// no automatic initial messages
	}

	msgsrv ValueResponse(int value) {
		// print is environment-specific; represented as a comment
		// println("Client " + clientId + " received value: " + value);
	}
}

main {
	Counter counterRef:();
	Client client1:(1, counterRef);
	Client client2:(2, counterRef);

	{
		counterRef.Increment(client1);
		counterRef.Increment(client2);
		counterRef.GetValue(client1);
	}
}