reactiveclass Producer {
	knownrebecs { 
		Consumer consumer;
	}
	statevars {
	}

	Producer(Consumer c) {
		consumer = c;
	}

	msgsrv Produce(int item) {
		consumer.Consume(item);
	}
}

reactiveclass Consumer {
	statevars {
	}

	Consumer() {
	}

	msgsrv Consume(int item) {
	}
}

main {
	Consumer consumer();
	Producer producer(consumer);

	producer.Produce(1);
	producer.Produce(2);
}