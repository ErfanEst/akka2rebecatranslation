reactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs { }

	Counter() {
		count = 0;
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
	}

	knownrebecs { }

	Client(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// In Rebeca, printing is usually done via an environment or logging,
		// here we just model the reception of the value.
		// println("Client " + clientId + " received value: " + value);
	}
}

main {
	Counter counter();
	Client client1(1);
	Client client2(2);

	// simulate sender by passing the client rebec reference as parameter
	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}