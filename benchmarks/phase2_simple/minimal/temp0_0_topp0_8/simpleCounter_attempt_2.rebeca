reactiveclass Counter {
	statevars {
		int count;
		Client client1;
		Client client2;
	}

	knownrebecs {
		Client client1;
		Client client2;
	}

	Counter(Client c1, Client c2) {
		count = 0;
		client1 = c1;
		client2 = c2;
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
	}

	knownrebecs { }

	Client(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// model reception of the value
	}
}

main {
	Client client1(1):();
	Client client2(2):();
	Counter counter(client1, client2):(client1, client2);

	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}