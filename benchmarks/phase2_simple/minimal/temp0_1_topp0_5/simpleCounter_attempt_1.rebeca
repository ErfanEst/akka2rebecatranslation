reactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs {
		Client client1;
		Client client2;
	}

	Counter() {
		count = 0;
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
	}

	knownrebecs {
		Counter counter;
	}

	Client(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// In Rebeca, printing is usually done via environment or logging;
		// here we just model the reception of the value.
		// println("Client " + clientId + " received value: " + value);
	}
}

main {
	Counter counter(client1, client2):();
	Client client1(counter):(1);
	Client client2(counter):(2);

	// Simulating the sequence of messages in CounterApp
	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}