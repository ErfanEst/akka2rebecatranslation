reactiveclass Ping {
	knownrebecs { 
		Pong pong; 
	}

	statevars {
		int count;
	}

	Ping() {
		count = 0;
	}

	msgsrv initial(Pong pong) {
		self.pong = pong;
	}

	msgsrv StartMessage() {
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		if (count >= 10) {
			pong.StopMessage();
			self.terminate();
		} else {
			pong.PingMessage();
		}
	}
}

reactiveclass Pong {
	msgsrv PingMessage() {
		sender.PongMessage();
	}

	msgsrv StopMessage() {
		self.terminate();
	}
}

main {
	Pong pong():();
	Ping ping():();

	ping.initial(pong);
	ping.StartMessage();
}