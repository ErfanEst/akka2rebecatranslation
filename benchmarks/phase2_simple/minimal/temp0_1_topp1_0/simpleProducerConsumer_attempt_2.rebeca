reactiveclass Producer(1) {
    knownrebecs {
        Consumer consumer;
    }
    statevars {
        int item;
    }
    msgsrv initial() {
        // initialization if needed
    }
    msgsrv Produce(int item) {
        this.item = item;
        consumer.Consume(item);
    }
}

reactiveclass Consumer() {
    knownrebecs { }
    statevars {
        int item;
    }
    msgsrv initial() {
        // initialization if needed
    }
    msgsrv Consume(int item) {
        this.item = item;
    }
}

main {
    Consumer consumer();
    Producer producer(consumer):();

    producer.Produce(1);
    producer.Produce(2);
}