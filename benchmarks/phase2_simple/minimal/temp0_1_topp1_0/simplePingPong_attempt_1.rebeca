reactiveclass Ping {
    knownrebecs {
        Pong pong;
    }
    statevars {
        int count;
    }

    Ping(Pong pong) {
        self.pong = pong;
        count = 0;
    }

    msgsrv StartMessage() {
        println("Ping started the game!");
        pong.PingMessage();
    }

    msgsrv PongMessage() {
        count = count + 1;
        println("Ping received pong #" + count);
        if (count >= 10) {
            pong.StopMessage();
            println("Ping stopped");
        } else {
            pong.PingMessage();
        }
    }
}

reactiveclass Pong {
    statevars {
    }

    Pong() {
    }

    msgsrv PingMessage() {
        println("Pong received ping");
        sender.PongMessage();
    }

    msgsrv StopMessage() {
        println("Pong stopped");
    }
}

main {
    Ping ping(pong):();
    Pong pong():();
    ping.StartMessage();
}