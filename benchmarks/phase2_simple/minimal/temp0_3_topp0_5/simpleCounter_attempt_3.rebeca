reactiveclass Counter {
	statevars {
		int count;
		Client client1;
		Client client2;
	}

	knownrebecs {
		Client c1;
		Client c2;
	}

	Counter() {
		count = 0;
		client1 = c1;
		client2 = c2;
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
		Counter counter;
	}

	knownrebecs {
		Counter c;
	}

	Client(int id) {
		counter = c;
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// side effect placeholder
	}
}

main {
	Counter counter(c1, c2);
	Client c1(counter, 1);
	Client c2(counter, 2);

	counter.Increment(c1);
	counter.Increment(c2);
	counter.GetValue(c1);
}