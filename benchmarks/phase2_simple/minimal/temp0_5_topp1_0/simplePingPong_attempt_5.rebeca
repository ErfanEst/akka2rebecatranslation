reactiveclass Ping {
	statevars {
		int count;
		Pong pong;
	}

	knownrebecs { 
		Pong pongKnown;
	}

	Ping(Pong pongKnown) {
		this.pongKnown = pongKnown;
		count = 0;
	}

	msgsrv StartMessage() {
		pongKnown.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		if (count >= 10) {
			pongKnown.StopMessage();
		} else {
			pongKnown.PingMessage();
		}
	}
}

reactiveclass Pong {
	statevars {
		Ping ping;
	}

	knownrebecs {
		Ping pingKnown;
	}

	Pong(Ping pingKnown) {
		this.pingKnown = pingKnown;
	}

	msgsrv PingMessage() {
		pingKnown.PongMessage();
	}

	msgsrv StopMessage() {
	}
}

main {
	Pong pong(ping):();
	Ping ping(pong):();

	ping.StartMessage();
}