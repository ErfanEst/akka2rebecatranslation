reactiveclass Ping {
	statevars {
		int count;
	}

	knownrebecs { 
		Pong pong;
	}

	Ping(Pong pong) {
		this.pong = pong;
		count = 0;
	}

	msgsrv StartMessage() {
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		if (count >= 10) {
			pong.StopMessage();
		} else {
			pong.PingMessage();
		}
	}
}

reactiveclass Pong {
	knownrebecs {
		Ping ping;
	}

	Pong(Ping ping) {
		this.ping = ping;
	}

	msgsrv PingMessage() {
		ping.PongMessage();
	}

	msgsrv StopMessage() {
	}
}

main {
	Pong pong();
	Ping ping(pong);

	ping.StartMessage();
}