reactiveclass Producer (Consumer consumer) {
	knownrebecs {
		Consumer consumer;
	}

	statevars {
	}

	Producer(Consumer consumer) {
		self.consumer = consumer;
	}

	msgsrv Produce(string item) {
		print("Producer: sending " + item);
		consumer.Consume(item);
	}
}

reactiveclass Consumer {
	knownrebecs {
	}

	statevars {
	}

	Consumer() {
	}

	msgsrv Consume(string item) {
		print("Consumer: received " + item);
	}
}

main {
	Consumer consumer();
	Producer producer(consumer): (consumer);

	producer.Produce("item1");
	producer.Produce("item2");
}