reactiveclass Ping {
	statevars {
		int count;
	}

	knownrebecs {
		Pong pong;
	}

	Ping() {
		count = 0;
	}

	msgsrv StartMessage() {
		print("Ping started the game!");
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		print("Ping received pong #" + count);
		if (count >= 10) {
			pong.StopMessage();
			print("Ping stopped");
		} else {
			pong.PingMessage();
		}
	}
}

reactiveclass Pong {
	msgsrv PingMessage() {
		print("Pong received ping");
		sender.PongMessage();
	}

	msgsrv StopMessage() {
		print("Pong stopped");
	}
}

main {
	Pong pong();
	Ping ping(pong);

	ping.StartMessage();
}