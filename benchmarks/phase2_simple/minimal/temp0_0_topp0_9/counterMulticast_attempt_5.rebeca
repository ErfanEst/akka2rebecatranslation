reactiveclass Counter() {
	knownrebecs { }

	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv initial() { }

	msgsrv Increment(Client senderRef) {
		count = count + 1;
		senderRef.ValueResponse(count);
	}

	msgsrv Decrement(Client senderRef) {
		count = count - 1;
		senderRef.ValueResponse(count);
	}

	msgsrv GetValue(Client senderRef) {
		senderRef.ValueResponse(count);
	}
}

reactiveclass Client(Counter counter) {
	knownrebecs { Counter counter; }

	statevars {
		int clientId;
	}

	Client(int id) {
		clientId = id;
	}

	msgsrv initial() { }

	msgsrv ValueResponse(int value) {
	}
}

main {
	Counter counter():();
	Client client1(counter):(1);
	Client client2(counter):(2);

	client1.Increment(client1);
	client2.Increment(client2);
	client1.GetValue(client1);
}