reactiveclass Counter {
	knownrebecs {
		Client client1;
		Client client2;
	}
	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv initial() {
		self.Increment(client1);
		self.Increment(client2);
		self.GetValue(client1);
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs {
		Counter counter;
	}
	statevars {
		int clientId;
	}

	Client(int id) {
		clientId = id;
	}

	msgsrv initial() {
		// no initial behavior
	}

	msgsrv ValueResponse(int value) {
		env.out("Client " + clientId + " received value: " + value);
	}
}

main {
	Client client1(counter):(1);
	Client client2(counter):(2);
	Counter counter(client1, client2):();
}