reactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs {
		Client client1;
		Client client2;
	}

	Counter() {
		count = 0;
	}

	msgsrv initial() {
		// simulate the main behavior:
		// counter.tell(Increment, client1)
		self.Increment(client1);
		// counter.tell(Increment, client2)
		self.Increment(client2);
		// counter.tell(GetValue, client1)
		self.GetValue(client1);
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
	}

	knownrebecs {
		Counter counter;
	}

	Client(int id) {
		clientId = id;
	}

	msgsrv initial() {
		// no initial behavior here; all messages are initiated from Counter.initial
	}

	msgsrv ValueResponse(int value) {
		// print simulation
		// In Rebeca, printing is usually done via env.out
		env.out("Client " + clientId + " received value: " + value);
	}
}

main {
	Counter counter(client1, client2):();
	Client client1(counter):(1);
	Client client2(counter):(2);
}