reactiveclass Ping(pong: Pong) {
	statevars {
		int count;
	}

	Ping() {
		count = 0;
	}

	msgsrv StartMessage() {
		self.print("Ping started the game!");
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		self.print("Ping received pong #");
		self.print(count);
		if (count >= 10) {
			pong.StopMessage();
			self.print("Ping stopped");
		} else {
			pong.PingMessage();
		}
	}
}

reactiveclass Pong {
	msgsrv PingMessage() {
		self.print("Pong received ping");
		sender.PongMessage();
	}

	msgsrv StopMessage() {
		self.print("Pong stopped");
	}
}

main {
	Pong pong();
	Ping ping(pong): (StartMessage);
}