reactiveclass Counter {
    knownrebecs {
    }

    statevars {
        int count;
    }

    Counter() {
        count = 0;
    }

    msgsrv initial() {
    }

    msgsrv Increment(Client sender) {
        count = count + 1;
        sender.ValueResponse(count);
    }

    msgsrv Decrement(Client sender) {
        count = count - 1;
        sender.ValueResponse(count);
    }

    msgsrv GetValue(Client sender) {
        sender.ValueResponse(count);
    }
}

reactiveclass Client {
    knownrebecs {
        Counter counter;
        Environment env;
    }

    statevars {
        int clientId;
    }

    Client(int id) {
        clientId = id;
    }

    msgsrv initial() {
    }

    msgsrv ValueResponse(int value) {
        env.printClientValue(clientId, value);
    }
}

reactiveclass Environment {
    knownrebecs {
        Counter counter;
        Client client1;
        Client client2;
    }

    Environment() {
    }

    msgsrv initial() {
        counter.Increment(client1);
        counter.Increment(client2);
        counter.GetValue(client1);
    }

    msgsrv printClientValue(int clientId, int value) {
        // In plain Rebeca there is no I/O; this is a placeholder
        // for printing: "Client clientId received value: value"
    }
}

main {
    Counter counter();
    Environment env(counter, client1, client2);
    Client client1(counter, env): (1);
    Client client2(counter, env): (2);
}