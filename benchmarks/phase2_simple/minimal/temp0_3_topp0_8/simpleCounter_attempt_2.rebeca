reactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs { }

	Counter() {
		count = 0;
	}

	msgsrv Increment(rebeca.Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(rebeca.Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(rebeca.Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
	}

	knownrebecs { Counter counter; }

	Client(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// print: Client <clientId> received value: <value>
	}
}

main {
	Counter counter();
	Client client1(counter): (1);
	Client client2(counter): (2);

	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}