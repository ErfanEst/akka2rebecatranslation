reactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs { }

	Counter() {
		count = 0;
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
		Counter counter;
	}

	knownrebecs {
		Counter counterRef;
	}

	Client(int id, Counter cRef) {
		clientId = id;
		counter = cRef;
	}

	msgsrv initial() {
		// No initial behavior; messages are sent from the main block
	}

	msgsrv ValueResponse(int value) {
		// env.out("Client " + clientId + " received value: " + value);
	}
}

main {
	Counter counter();

	Client client1(counter): (1, counter);
	Client client2(counter): (2, counter);

	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}