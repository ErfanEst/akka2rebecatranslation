reactiveclass Ping(5) {
  knownrebecs { Pong pong; }
  statevars { int count; }

  Ping() {
    count = 0;
  }

  msgsrv initial() {
    // corresponds to StartMessage
    pong.PingMessage();
  }

  msgsrv PongMessage() {
    count = count + 1;
    if (count >= 10) {
      pong.StopMessage();
      // context.stop(self) has no direct equivalent; omitted
    } else {
      pong.PingMessage();
    }
  }
}

reactiveclass Pong(5) {
  knownrebecs { Ping ping; }

  Pong() {
  }

  msgsrv PingMessage() {
    ping.PongMessage();
  }

  msgsrv StopMessage() {
    // context.stop(self) has no direct equivalent; omitted
  }
}

main {
  Ping ping(pong):();
  Pong pong(ping):();

  ping.initial();
}