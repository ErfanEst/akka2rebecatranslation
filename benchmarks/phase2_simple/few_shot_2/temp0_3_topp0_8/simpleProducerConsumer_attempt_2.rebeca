reactiveclass Producer(5) {
	knownrebecs {
		Consumer consumer;
	}
	statevars {
	}

	msgsrv initial() {
		self.ProduceMsgSrv(1);
		self.ProduceMsgSrv(2);
	}

	msgsrv ProduceMsgSrv(int item) {
		consumer.ConsumeMsgSrv(item);
	}
}

reactiveclass Consumer(5) {
	knownrebecs {
	}
	statevars {
	}

	msgsrv initial() {
	}

	msgsrv ConsumeMsgSrv(int item) {
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();
}