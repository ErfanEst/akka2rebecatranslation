reactiveclass Producer(5) {
	knownrebecs { 
		Consumer consumer;
	}
	statevars { 
	}
	msgsrv initial() {
		self.ProduceMsg(1);
		self.ProduceMsg(2);
	}
	msgsrv ProduceMsg(int item) {
		consumer.ConsumeMsg(item);
	}
}

reactiveclass Consumer(5) {
	knownrebecs {
	}
	statevars {
	}
	msgsrv initial() {
	}
	msgsrv ConsumeMsg(int item) {
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();
}