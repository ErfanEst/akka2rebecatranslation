reactiveclass Counter(10) {
	knownrebecs {
		Client client1;
		Client client2;
	}
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment(Client snd) {
		count = count + 1;
		snd.ValueResponse(count);
	}

	msgsrv Decrement(Client snd) {
		count = count - 1;
		snd.ValueResponse(count);
	}

	msgsrv GetValue(Client snd) {
		snd.ValueResponse(count);
	}
}

reactiveclass Client(10) {
	knownrebecs {
		Counter counter;
	}
	statevars {
		int clientId;
	}

	Client(int id) {
		clientId = id;
	}

	msgsrv initial() {
		// no-op
	}

	msgsrv ValueResponse(int value) {
		// no-op
	}
}

main {
	Counter counter(client1, client2):();
	Client client1(counter):(1);
	Client client2(counter):(2);

	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}