reactiveclass Producer(3) {
	knownrebecs { Consumer consumer; }
	statevars { }

	msgsrv initial() {
		self.Produce(1);
		self.Produce(2);
	}

	msgsrv Produce(int item) {
		consumer.Consume(item);
	}
}

reactiveclass Consumer(3) {
	knownrebecs { }
	statevars { }

	msgsrv initial() { }

	msgsrv Consume(int item) {
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();
}