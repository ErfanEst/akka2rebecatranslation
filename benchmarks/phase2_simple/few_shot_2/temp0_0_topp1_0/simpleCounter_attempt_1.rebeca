reactiveclass Counter(10) {
  knownrebecs { Client client1; Client client2; }
  statevars { int count; }

  Counter() {
    count = 0;
  }

  msgsrv initial() {
    client1.requestIncrement();
    client2.requestIncrement();
    client1.requestGetValue();
  }

  msgsrv increment(Client senderRef) {
    count = count + 1;
    senderRef.valueResponse(count);
  }

  msgsrv decrement(Client senderRef) {
    count = count - 1;
    senderRef.valueResponse(count);
  }

  msgsrv getValue(Client senderRef) {
    senderRef.valueResponse(count);
  }
}

reactiveclass Client(10) {
  knownrebecs { Counter counter; }
  statevars { int clientId; }

  Client(int id) {
    clientId = id;
  }

  msgsrv initial() {
  }

  msgsrv requestIncrement() {
    counter.increment(self);
  }

  msgsrv requestGetValue() {
    counter.getValue(self);
  }

  msgsrv valueResponse(int value) {
  }
}

main {
  Counter counter(client1, client2):();
  Client client1(counter):(1);
  Client client2(counter):(2);
}