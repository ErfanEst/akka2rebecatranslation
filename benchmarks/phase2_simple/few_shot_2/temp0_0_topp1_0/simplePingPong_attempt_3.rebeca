reactiveclass Ping(5) {
	knownrebecs { Pong pong; }
	statevars { int count; }

	Ping(Pong pongRef) {
		pong = pongRef;
		count = 0;
	}

	msgsrv initial() {
	}

	msgsrv StartMessage() {
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		if (count >= 10) {
			pong.StopMessage();
		} else {
			pong.PingMessage();
		}
	}
}

reactiveclass Pong(5) {
	knownrebecs { Ping ping; }

	Pong(Ping pingRef) {
		ping = pingRef;
	}

	msgsrv initial() {
	}

	msgsrv PingMessage() {
		ping.PongMessage();
	}

	msgsrv StopMessage() {
	}
}

main {
	Ping ping(Pong):(pong);
	Pong pong(Ping):(ping);

	ping.StartMessage();
}