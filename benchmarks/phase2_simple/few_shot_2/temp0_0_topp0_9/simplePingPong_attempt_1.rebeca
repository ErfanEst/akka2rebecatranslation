reactiveclass Ping(5) {
	knownrebecs { Pong pong; }
	statevars { int count; }

	Ping() {
		count = 0;
	}

	msgsrv initial() {
		self.StartMessage();
	}

	msgsrv StartMessage() {
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		if (count >= 10) {
			pong.StopMessage();
		} else {
			pong.PingMessage();
		}
	}
}

reactiveclass Pong(5) {
	knownrebecs { Ping ping; }

	msgsrv PingMessage() {
		ping.PongMessage();
	}

	msgsrv StopMessage() {
		// no further action; actor stopped in Akka version
	}
}

main {
	Ping ping(pong):();
	Pong pong(ping):();
}