reactiveclass Counter(2) {
	knownrebecs {
		Client client1;
		Client client2;
	}
	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv initial() {
		self.Increment(client1);
		self.Increment(client2);
		self.GetValue(client1);
	}

	msgsrv Increment(Client snd) {
		count = count + 1;
		snd.ValueResponse(count);
	}

	msgsrv Decrement(Client snd) {
		count = count - 1;
		snd.ValueResponse(count);
	}

	msgsrv GetValue(Client snd) {
		snd.ValueResponse(count);
	}
}

reactiveclass Client(1) {
	knownrebecs {
		Counter counter;
	}
	statevars {
		int clientId;
	}

	Client(int id) {
		clientId = id;
	}

	msgsrv initial() {
		// no initialization behavior
	}

	msgsrv ValueResponse(int value) {
		// client processes received value
	}
}

main {
	Counter counter(client1, client2):();
	Client client1(counter):(1);
	Client client2(counter):(2);
}