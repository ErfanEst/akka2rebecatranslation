reactiveclass Counter(3) {
    knownrebecs { Client client1; Client client2; }
    statevars { int count; }

    Counter() {
        count = 0;
    }

    msgsrv initial() {
        self.increment(client1);
        self.increment(client2);
        self.getValue(client1);
    }

    msgsrv increment(Client sender) {
        count = count + 1;
        sender.valueResponse(count);
    }

    msgsrv decrement(Client sender) {
        count = count - 1;
        sender.valueResponse(count);
    }

    msgsrv getValue(Client sender) {
        sender.valueResponse(count);
    }
}

reactiveclass Client(3) {
    knownrebecs { Counter counter; }
    statevars { int clientId; }

    Client(int id) {
        clientId = id;
    }

    msgsrv initial() {
        // no-op
    }

    msgsrv valueResponse(int value) {
        // original Akka code printed the value; I/O removed
    }
}

main {
    Counter counter(client1, client2):();
    Client client1(counter):(1);
    Client client2(counter):(2);
}