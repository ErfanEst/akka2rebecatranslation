reactiveclass Producer(5) {
  knownrebecs { 
    Consumer consumer;
  }
  statevars { 
    int dummy;
  }

  msgsrv initial() {
    self.Produce(1);
    self.Produce(2);
  }

  msgsrv Produce(int item) {
    consumer.Consume(item);
  }
}

reactiveclass Consumer(5) {
  statevars { 
    int dummy;
  }

  msgsrv initial() {
    // no-op
  }

  msgsrv Consume(int item) {
    // no-op
  }
}

main {
  Consumer consumer():();
  Producer producer(consumer):();
}