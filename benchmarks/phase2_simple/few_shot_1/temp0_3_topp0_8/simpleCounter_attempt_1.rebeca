reactiveclass Counter(5) {
	knownrebecs {
		Client client1;
		Client client2;
	}
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv incrementFromClient1() {
		count = count + 1;
		client1.valueResponse(count);
	}

	msgsrv incrementFromClient2() {
		count = count + 1;
		client2.valueResponse(count);
	}

	msgsrv getValueFromClient1() {
		client1.valueResponse(count);
	}

	msgsrv getValueFromClient2() {
		client2.valueResponse(count);
	}
}

reactiveclass Client(5) {
	knownrebecs {
		Counter counter;
	}
	statevars {
		int clientId;
	}

	msgsrv initial(int id) {
		clientId = id;
	}

	msgsrv valueResponse(int value) {
		// In Rebeca, printing is typically modeled via environment or ignored.
		// This is a placeholder for: println(s"Client $clientId received value: $value")
	}

	msgsrv startClient1() {
		// corresponds to: counter.tell(Increment, client1)
		counter.incrementFromClient1();
	}

	msgsrv startClient2() {
		// corresponds to: counter.tell(Increment, client2)
		counter.incrementFromClient2();
	}

	msgsrv requestValueClient1() {
		// corresponds to: counter.tell(GetValue, client1)
		counter.getValueFromClient1();
	}
}

main {
	Counter counter(client1, client2):();
	Client client1(counter):(1);
	Client client2(counter):(2);

	// Start the scenario as in CounterApp
	client1.startClient1();
	client2.startClient2();
	client1.requestValueClient1();
}