reactiveclass Ping(1) {
	knownrebecs { Pong pong; }
	statevars { int count; }

	msgsrv initial() {
		count = 0;
	}

	msgsrv StartMessage() {
		pong.PingMessage(self);
	}

	msgsrv PongMessage(Pong sender) {
		count = count + 1;
		if (count >= 10) {
			sender.StopMessage();
		} else {
			sender.PingMessage(self);
		}
	}
}

reactiveclass Pong(1) {
	knownrebecs { Ping ping; }
	statevars { }

	msgsrv initial() {
	}

	msgsrv PingMessage(Ping sender) {
		sender.PongMessage(self);
	}

	msgsrv StopMessage() {
	}
}

main {
	Ping ping(pong):();
	Pong pong(ping):();

	ping.StartMessage();
}