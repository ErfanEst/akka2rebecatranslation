reactiveclass Ping(5) {
	knownrebecs {
		Pong pong;
	}
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv StartMessage() {
		// println("Ping started the game!")
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		// count += 1;
		count = count + 1;
		// println("Ping received pong #" + count)
		if (count >= 10) {
			// sender() ! StopMessage  --> pong is the only sender here
			pong.StopMessage();
			// println("Ping stopped")
			// context.stop(self)  --> no direct equivalent; actor becomes quiescent
		} else {
			// sender() ! PingMessage --> pong
			pong.PingMessage();
		}
	}
}

reactiveclass Pong(5) {
	knownrebecs {
		Ping ping;
	}
	statevars {
	}

	msgsrv initial() {
	}

	msgsrv PingMessage() {
		// println("Pong received ping")
		ping.PongMessage();
	}

	msgsrv StopMessage() {
		// println("Pong stopped")
		// context.stop(self) --> no direct equivalent; actor becomes quiescent
	}
}

main {
	Ping ping(pong):();
	Pong pong(ping):();

	ping.StartMessage();
}