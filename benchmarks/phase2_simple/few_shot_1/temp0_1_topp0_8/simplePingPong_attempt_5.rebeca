reactiveclass Ping(5) {
	knownrebecs {
		Pong pong;
	}
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv StartMessage() {
		// Ping started the game!
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		// Ping received pong
		if (count >= 10) {
			pong.StopMessage();
			// Ping stopped
			// context.stop(self) is not modeled explicitly
		} else {
			pong.PingMessage();
		}
	}
}

reactiveclass Pong(5) {
	knownrebecs {
		Ping ping;
	}
	statevars {
	}

	msgsrv initial() {
	}

	msgsrv PingMessage() {
		// Pong received ping
		ping.PongMessage();
	}

	msgsrv StopMessage() {
		// Pong stopped
		// context.stop(self) is not modeled explicitly
	}
}

main {
	Ping ping(pong):();
	Pong pong(ping):();

	ping.StartMessage();
}