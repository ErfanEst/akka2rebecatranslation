reactiveclass Counter {
	knownrebecs {
		Client client1;
		Client client2;
	}
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv IncrementFromClient1() {
		count = count + 1;
		client1.ValueResponseMsg(count);
	}

	msgsrv IncrementFromClient2() {
		count = count + 1;
		client2.ValueResponseMsg(count);
	}

	msgsrv GetValueFromClient1() {
		client1.ValueResponseMsg(count);
	}

	msgsrv GetValueFromClient2() {
		client2.ValueResponseMsg(count);
	}
}

reactiveclass Client {
	knownrebecs {
		Counter counter;
	}
	statevars {
		int clientId;
		int lastValue;
	}

	msgsrv initial() {
		clientId = -1;
		lastValue = -1;
	}

	msgsrv initWithId(int id) {
		clientId = id;
	}

	msgsrv ValueResponseMsg(int value) {
		lastValue = value;
	}
}

main {
	Counter counter(client1, client2):();
	Client client1(counter):();
	Client client2(counter):();

	client1.initWithId(1);
	client2.initWithId(2);

	counter.IncrementFromClient1();
	counter.IncrementFromClient2();
	counter.GetValueFromClient1();
}