reactiveclass Producer(5) {
	knownrebecs {
		Consumer consumer;
	}
	statevars {
	}
	msgsrv initial() {
		self.produce("item1");
		self.produce("item2");
	}
	msgsrv produce(string item) {
		consumer.consume(item);
	}
}

reactiveclass Consumer(5) {
	knownrebecs {
	}
	statevars {
	}
	msgsrv initial() {
	}
	msgsrv consume(string item) {
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();
}