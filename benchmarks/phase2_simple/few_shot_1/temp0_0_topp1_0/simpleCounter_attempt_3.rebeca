reactiveclass Counter(5) {
	knownrebecs {
		Client client1;
		Client client2;
	}
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv increment(Client sender) {
		count = count + 1;
		sender.valueResponse(count);
	}

	msgsrv decrement(Client sender) {
		count = count - 1;
		sender.valueResponse(count);
	}

	msgsrv getValue(Client sender) {
		sender.valueResponse(count);
	}
}

reactiveclass Client(5) {
	knownrebecs {
		Counter counter;
	}

	statevars {
		int clientId;
	}

	msgsrv initial(byte id) {
		clientId = id;
	}

	msgsrv valueResponse(int value) {
		println("Client " + clientId + " received value: " + value);
	}

	msgsrv start() {
		counter.increment(self);
		counter.increment(self);
		counter.getValue(self);
	}
}

main {
	Client client1(counter):(1);
	Client client2(counter):(2);
	Counter counter(client1, client2):();
	
	client1.start();
	client2.start();
}