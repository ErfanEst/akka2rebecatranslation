reactiveclass Counter(5) {
	knownrebecs {
		Client client1;
		Client client2;
	}
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv increment(Client sender) {
		count = count + 1;
		sender.valueResponse(count);
	}

	msgsrv decrement(Client sender) {
		count = count - 1;
		sender.valueResponse(count);
	}

	msgsrv getValue(Client sender) {
		sender.valueResponse(count);
	}
}

reactiveclass Client(5) {
	knownrebecs {
		Counter counter;
	}

	statevars {
		int clientId;
	}

	msgsrv initial() {
		clientId = 0;
	}

	msgsrv setId(int id) {
		clientId = id;
	}

	msgsrv valueResponse(int value) {
		// logging can be added here if supported by the tool
	}

	msgsrv start() {
		counter.increment(self);
		counter.increment(self);
		counter.getValue(self);
	}
}

main {
	Counter counter(client1, client2):();
	Client client1(counter):();
	Client client2(counter):();

	client1.setId(1):();
	client2.setId(2):();

	client1.start():();
	client2.start():();
}