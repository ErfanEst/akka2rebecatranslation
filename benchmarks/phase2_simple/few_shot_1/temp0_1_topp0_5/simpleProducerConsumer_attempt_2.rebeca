reactiveclass Producer(5) {
	knownrebecs {
		Consumer consumer;
	}
	statevars {
		int itemId;
	}
	msgsrv initial() {
		itemId = 0;
	}
	msgsrv Produce(int id) {
		consumer.Consume(id);
	}
}

reactiveclass Consumer(5) {
	knownrebecs {
	}
	statevars {
	}
	msgsrv initial() {
		// no-op
	}
	msgsrv Consume(int id) {
		// no-op
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();

	producer.Produce(1);
	producer.Produce(2);
}