reactiveclass Ping(5) {
	knownrebecs { Pong pong; }
	statevars { int count; }

	msgsrv initial() {
		count = 0;
		self.StartMessage();
	}

	msgsrv StartMessage() {
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		if (count >= 10) {
			pong.StopMessage();
		} else {
			pong.PingMessage();
		}
	}
}

reactiveclass Pong(5) {
	knownrebecs { Ping ping; }
	statevars { }

	msgsrv initial() {
	}

	msgsrv PingMessage() {
		ping.PongMessage();
	}

	msgsrv StopMessage() {
	}
}

main {
	Pong pong(ping):();
	Ping ping(pong):();
}