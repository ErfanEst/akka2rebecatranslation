reactiveclass Producer(5) {
	knownrebecs {
		Consumer consumer;
	}

	statevars {
	}

	msgsrv initial() {
		// no initialization needed
	}

	msgsrv start() {
		self.produce(1);
		self.produce(2);
	}

	msgsrv produce(int item) {
		consumer.consume(item);
	}
}

reactiveclass Consumer(5) {
	knownrebecs {
	}

	statevars {
	}

	msgsrv initial() {
		// no initialization needed
	}

	msgsrv consume(int item) {
		// Consumer: received item
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();

	producer.start();
}