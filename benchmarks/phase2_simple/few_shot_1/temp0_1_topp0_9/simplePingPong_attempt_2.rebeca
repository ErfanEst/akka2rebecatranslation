reactiveclass Ping(5) {
	knownrebecs { Pong pong; }
	statevars { int count; }

	msgsrv initial() {
		count = 0;
	}

	msgsrv StartMessage() {
		// println("Ping started the game!")
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		// println("Ping received pong #" + count)
		if (count >= 10) {
			pong.StopMessage();
			// println("Ping stopped")
		} else {
			pong.PingMessage();
		}
	}
}

reactiveclass Pong(5) {
	knownrebecs { Ping ping; }
	statevars { }

	msgsrv initial() {
	}

	msgsrv PingMessage() {
		// println("Pong received ping")
		ping.PongMessage();
	}

	msgsrv StopMessage() {
		// println("Pong stopped")
	}
}

main {
	Pong pong(ping):();
	Ping ping(pong):();

	ping.StartMessage();
}