reactiveclass Counter(5) {
	knownrebecs {
		Client client1;
		Client client2;
	}
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv incrementFromClient1() {
		count = count + 1;
		client1.valueResponse(count);
	}

	msgsrv incrementFromClient2() {
		count = count + 1;
		client2.valueResponse(count);
	}

	msgsrv getValueFromClient1() {
		client1.valueResponse(count);
	}

	msgsrv getValueFromClient2() {
		client2.valueResponse(count);
	}
}

reactiveclass Client(5) {
	knownrebecs {
		Counter counter;
	}
	statevars {
		byte clientId;
		int lastValue;
	}

	msgsrv initial() {
		lastValue = 0;
	}

	msgsrv setId(byte id) {
		clientId = id;
	}

	msgsrv valueResponse(int value) {
		lastValue = value;
	}
}

main {
	Client client1(counter):();
	Client client2(counter):();
	Counter counter(client1, client2):();

	client1.setId(1);
	client2.setId(2);

	counter.incrementFromClient1();
	counter.incrementFromClient2();
	counter.getValueFromClient1();
}