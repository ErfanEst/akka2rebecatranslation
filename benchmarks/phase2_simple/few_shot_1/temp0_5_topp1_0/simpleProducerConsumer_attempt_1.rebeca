reactiveclass Producer(5) {
	knownrebecs { 
		Consumer consumer;
	} 

	statevars { 
		// no internal state
	} 

	msgsrv initial() {
		// no initialization logic
	}

	msgsrv Produce(string item) {
		// Producer: sending item
		consumer.Consume(item);
	}
}

reactiveclass Consumer(5) {
	knownrebecs {
		// no known rebecs
	}

	statevars {
		// no internal state
	}

	msgsrv initial() {
		// no initialization logic
	}

	msgsrv Consume(string item) {
		// Consumer: received item
	}
}

main {
	Consumer consumer() : ();
	Producer producer(consumer) : (Produce("item1"), Produce("item2"));
}