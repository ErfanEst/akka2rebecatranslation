reactiveclass Counter(3) {
	knownrebecs {
		Client client1;
		Client client2;
	}
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv incrementFromClient1() {
		count = count + 1;
		client1.valueResponse(count);
	}

	msgsrv incrementFromClient2() {
		count = count + 1;
		client2.valueResponse(count);
	}

	msgsrv decrementFromClient1() {
		count = count - 1;
		client1.valueResponse(count);
	}

	msgsrv decrementFromClient2() {
		count = count - 1;
		client2.valueResponse(count);
	}

	msgsrv getValueForClient1() {
		client1.valueResponse(count);
	}

	msgsrv getValueForClient2() {
		client2.valueResponse(count);
	}
}

reactiveclass Client(3) {
	knownrebecs {
		Counter counter;
	}
	statevars {
		int id;
	}

	msgsrv initial(int clientId) {
		id = clientId;
	}

	msgsrv valueResponse(int value) {
		// Modeling println: Client <id> received value: <value>
	}

	msgsrv startClient1() {
		// this is only used for client1 to initiate the sequence
		counter.incrementFromClient1();
		counter.incrementFromClient2();
		counter.getValueForClient1();
	}
}

main {
	Client client1(counter):(1);
	Client client2(counter):(2);
	Counter counter(client1, client2):();

	client1.startClient1();
}