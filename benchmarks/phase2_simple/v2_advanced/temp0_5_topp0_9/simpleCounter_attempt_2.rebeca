reactiveclass Counter(client1, client2) {
	statevars {
		int count;
	}

	knownrebecs {
		Client client1;
		Client client2;
	}

	msgsrv initial() {
		count = 0;
		self.increment(1, client1);
		self.increment(2, client2);
		self.getValue(client1);
	}

	msgsrv increment(int dummy, Client sender) {
		count = count + 1;
		sender.valueResponse(count);
	}

	msgsrv decrement(int dummy, Client sender) {
		count = count - 1;
		sender.valueResponse(count);
	}

	msgsrv getValue(Client sender) {
		sender.valueResponse(count);
	}
}

reactiveclass Client(counter) {
	statevars {
		int clientId;
	}

	knownrebecs {
		Counter counter;
	}

	msgsrv initial(int id) {
		clientId = id;
	}

	msgsrv valueResponse(int value) {
		skip;
	}
}

main {
	Client client1(counter):(1);
	Client client2(counter):(2);
	Counter counter(client1, client2):();
}