reactiveclass Counter {
	knownrebecs { }

	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs {
		Counter counter;
	}

	statevars {
		int clientId;
	}

	Client(int id, Counter c) {
		clientId = id;
		counter = c;
	}

	msgsrv ValueResponse(int value) {
		// handle value
	}

	msgsrv start() {
		// initial behavior if needed
	}
}

main {
	Counter counter1():();
	Client client1(counter1):(1, counter1);
	Client client2(counter1):(2, counter1);

	counter1.Increment(client1);
	counter1.Increment(client2);
	counter1.GetValue(client1);
}