reactiveclass Counter(1) {
	statevars {
		int count;
		Client senderRef;
	}

	knownrebecs { }

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment(Client s) {
		senderRef = s;
		count = count + 1;
		senderRef.ValueResponse(count);
	}

	msgsrv Decrement(Client s) {
		senderRef = s;
		count = count - 1;
		senderRef.ValueResponse(count);
	}

	msgsrv GetValue(Client s) {
		senderRef = s;
		senderRef.ValueResponse(count);
	}
}

reactiveclass Client(1) {
	statevars {
		int clientId;
		Counter counter;
	}

	knownrebecs {
		Counter counterRef;
		int id;
	}

	msgsrv initial() {
		counter = counterRef;
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// no-op
	}
}

main {
	Counter counter1();
	Client client1(counter1, 1);
	Client client2(counter1, 2);

	counter1.Increment(client1);
	counter1.Increment(client2);
	counter1.GetValue(client1);
}