timed reactiveclass Counter(1) {
	statevars {
		int count;
		Client senderRef;
	}

	knownrebecs { }

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment(Client s) {
		senderRef = s;
		count = count + 1;
		// println("Counter incremented to " + count);
		senderRef.ValueResponse(count);
	}

	msgsrv Decrement(Client s) {
		senderRef = s;
		count = count - 1;
		// println("Counter decremented to " + count);
		senderRef.ValueResponse(count);
	}

	msgsrv GetValue(Client s) {
		senderRef = s;
		senderRef.ValueResponse(count);
	}
}

timed reactiveclass Client(1) {
	statevars {
		int clientId;
		Counter counter;
	}

	knownrebecs {
		Counter counterRef;
		int id;
	}

	msgsrv initial() {
		counter = counterRef;
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// println("Client " + clientId + " received value: " + value);
	}
}

main {
	Counter counter();
	Client client1(counter, 1);
	Client client2(counter, 2);

	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}