reactiveclass Counter(counterClient1, counterClient2) {
	knownrebecs {
		Client counterClient1;
		Client counterClient2;
	}

	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;

		Increment(counterClient1);
		Increment(counterClient2);
		GetValue(counterClient1);
	}

	msgsrv Increment(Client sender) {
		ValueResponse(sender, count + 1);
		count = count + 1;
	}

	msgsrv Decrement(Client sender) {
		ValueResponse(sender, count - 1);
		count = count - 1;
	}

	msgsrv GetValue(Client sender) {
		ValueResponse(sender, count);
	}

	msgsrv ValueResponse(Client sender, int value) {
		// do nothing (Counter does not need to process this)
	}
}

reactiveclass Client() {
	statevars {
		byte clientId;
	}

	msgsrv initial(byte id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// do nothing
	}
}

main {
	Client counterClient1(): (1);
	Client counterClient2(): (2);
	Counter counter(counterClient1, counterClient2): ();
}