reactiveclass Producer(Consumer consumer) {
	statevars {
	}

	Producer() {
	}

	msgsrv initial() {
		self.produce(1);
		self.produce(2);
	}

	msgsrv produce(int item) {
		consumer.consume(item);
	}
}

reactiveclass Consumer() {
	statevars {
	}

	Consumer() {
	}

	msgsrv initial() {
	}

	msgsrv consume(int item) {
	}
}

main {
	Consumer consumer():();
	Producer p(consumer):(consumer);

	p.initial();
	consumer.initial();
}