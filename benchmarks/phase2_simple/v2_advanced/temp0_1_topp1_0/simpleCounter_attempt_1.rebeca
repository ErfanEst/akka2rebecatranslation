reactiveclass Counter {
	statevars {
		int count;
		ClientRef client1;
		ClientRef client2;
	}

	msgsrv initial(ClientRef c1, ClientRef c2) {
		count = 0;
		client1 = c1;
		client2 = c2;

		// counter.tell(Increment, client1)
		Increment(client1);
		// counter.tell(Increment, client2)
		Increment(client2);
		// counter.tell(GetValue, client1)
		GetValue(client1);
	}

	msgsrv Increment(ClientRef sender) {
		count = count + 1;
		ValueResponse(sender, count);
	}

	msgsrv Decrement(ClientRef sender) {
		count = count - 1;
		ValueResponse(sender, count);
	}

	msgsrv GetValue(ClientRef sender) {
		ValueResponse(sender, count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
	}

	msgsrv initial(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// println(s"Client $clientId received value: $value")
	}
}

main {
	Counter counter(counterClient1, counterClient2):();
	Client counterClient1:(1);
	Client counterClient2:(2);
}