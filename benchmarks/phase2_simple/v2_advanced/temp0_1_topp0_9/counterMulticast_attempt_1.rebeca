timedreactiveclass Counter {
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		// println("Counter incremented to " + count);
		ValueResponse(sender, count);
	}

	msgsrv Decrement() {
		count = count - 1;
		// println("Counter decremented to " + count);
		ValueResponse(sender, count);
	}

	msgsrv GetValue() {
		ValueResponse(sender, count);
	}
}

timedreactiveclass Client {
	statevars {
		Counter counter;
		int clientId;
	}

	msgsrv initial(Counter c, int id) {
		counter = c;
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// println("Client " + clientId + " received value: " + value);
	}
}

main {
	Counter counter();
	Client client1(counter, 1);
	Client client2(counter, 2);

	counter.Increment() after(0) sender client1;
	counter.Increment() after(0) sender client2;
	counter.GetValue() after(0) sender client1;
}