import Environment;

	reactiveclass Producer(1) {
		knownrebecs {
			Consumer consumer;
			Environment env;
		}
		statevars {
			// no state variables
		}

		msgsrv initial() {
			// no initialization needed
		}

		msgsrv Produce(string item) {
			env.print("Producer: sending " + item);
			consumer.Consume(item);
		}
	}

	reactiveclass Consumer(1) {
		knownrebecs {
			Environment env;
		}
		statevars {
			// no state variables
		}

		msgsrv initial() {
			// no initialization needed
		}

		msgsrv Consume(string item) {
			env.print("Consumer: received " + item);
		}
	}

	main {
		Environment env();
		Consumer consumer(env):();
		Producer producer(consumer, env):();

		producer.Produce("item1");
		producer.Produce("item2");
	}
}