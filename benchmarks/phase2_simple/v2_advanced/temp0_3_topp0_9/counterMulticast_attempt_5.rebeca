reactiveclass Counter(client1, client2) {
	statevars {
		int count;
	}

	knownrebecs {
		Client client1;
		Client client2;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client(counter) {
	statevars {
		int clientId;
	}

	knownrebecs {
		Counter counter;
	}

	msgsrv initial(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
	}
}

main {
	Client client1(counter):(1);
	Client client2(counter):(2);
	Counter counter(client1, client2):();

	counter.Increment() after(0);
	counter.Increment() after(0);
	counter.GetValue() after(0);
}