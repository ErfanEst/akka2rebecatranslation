timedreactiveclass Counter {
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		// println("Counter incremented to " + count);
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		// println("Counter decremented to " + count);
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

timedreactiveclass Client {
	knownrebecs {
		Counter counter;
	}

	statevars {
		int clientId;
	}

	msgsrv initial(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// println("Client " + clientId + " received value: " + value);
	}
}

main {
	Counter counter();
	Client client1(counter):(1);
	Client client2(counter):(2);

	// counter.tell(Increment, client1)
	counter.Increment() after(0) deadline(0) sender(client1);

	// counter.tell(Increment, client2)
	counter.Increment() after(0) deadline(0) sender(client2);

	// counter.tell(GetValue, client1)
	counter.GetValue() after(0) deadline(0) sender(client1);
}