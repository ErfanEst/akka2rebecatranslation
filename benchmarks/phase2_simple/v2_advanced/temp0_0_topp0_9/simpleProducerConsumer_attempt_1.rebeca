reactiveclass Producer(knownrebecs { Consumer consumer }) {
	statevars {
		int dummy;
	}

	Producer() {
		// constructor
	}

	msghandler Produce(string item) {
		// println("Producer: sending " + item);
		consumer.Consume(item);
	}
}

reactiveclass Consumer {
	statevars {
		int dummy;
	}

	Consumer() {
		// constructor
	}

	msghandler Consume(string item) {
		// println("Consumer: received " + item);
	}
}

main {
	Consumer consumer();
	Producer producer(consumer);

	producer.Produce("item1");
	producer.Produce("item2");
}