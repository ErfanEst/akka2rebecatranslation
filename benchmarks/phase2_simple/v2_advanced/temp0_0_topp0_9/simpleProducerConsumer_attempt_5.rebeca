reactiveclass Producer(Consumer consumer) {
	statevars {
		int dummy;
	}

	Producer() {
		// constructor
	}

	msghandler Produce(int item) {
		consumer.Consume(item);
	}
}

reactiveclass Consumer() {
	statevars {
		int dummy;
	}

	Consumer() {
		// constructor
	}

	msghandler Consume(int item) {
		// message received
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();

	producer.Produce(1);
	producer.Produce(2);
}