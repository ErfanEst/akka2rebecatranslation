reactiveclass Counter {
	statevars {
		int count;
		Client clientRef;
	}

	knownrebecs {
		Client client1;
		Client client2;
	}

	msgsrv initial() {
		count = 0;
		// Simulate the CounterSystem initialization behavior
		// counter.tell(Increment, client1)
		clientRef = client1;
		self.increment();

		// counter.tell(Increment, client2)
		clientRef = client2;
		self.increment();

		// counter.tell(GetValue, client1)
		clientRef = client1;
		self.getValue();
	}

	msgsrv increment() {
		count = count + 1;
		// println simulated as comment
		// "Counter incremented to " + count
		clientRef.valueResponse(count);
	}

	msgsrv decrement() {
		count = count - 1;
		// println simulated as comment
		// "Counter decremented to " + count
		clientRef.valueResponse(count);
	}

	msgsrv getValue() {
		clientRef.valueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
	}

	knownrebecs {
	}

	msgsrv initial(int id) {
		clientId = id;
	}

	msgsrv valueResponse(int value) {
		// println simulated as comment
		// "Client " + clientId + " received value: " + value
	}
}

main {
	Counter counter(counterClient1, counterClient2);
	Client counterClient1();
	Client counterClient2();

	counterClient1.initial(1);
	counterClient2.initial(2);
}	
}