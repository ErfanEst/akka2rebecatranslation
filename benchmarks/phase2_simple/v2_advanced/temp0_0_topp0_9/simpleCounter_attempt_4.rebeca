reactiveclass Counter {
	knownrebecs {
	}

	statevars {
		int count;
		Client senderClient;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment(Client senderRef) {
		senderClient = senderRef;
		count = count + 1;
		senderClient.ValueResponse(count);
	}

	msgsrv Decrement(Client senderRef) {
		senderClient = senderRef;
		count = count - 1;
		senderClient.ValueResponse(count);
	}

	msgsrv GetValue(Client senderRef) {
		senderClient = senderRef;
		senderClient.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs {
		Counter counter;
	}

	statevars {
		int clientId;
		int lastValue;
	}

	msgsrv initial(int id) {
		clientId = id;
		lastValue = 0;
		// no automatic behavior on start
	}

	msgsrv ValueResponse(int value) {
		lastValue = value;
		// printing is not modeled explicitly
	}
}

main {
	Counter counter():();
	Client client1(counter):();
	Client client2(counter):();

	client1.initial(1);
	client2.initial(2);

	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}