reactiveclass Counter (Client dummy) {
	knownrebecs {
	}

	statevars {
		int count;
		Client senderClient;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment(Client senderRef) {
		senderClient = senderRef;
		count = count + 1;
		senderClient.ValueResponse(count);
	}

	msgsrv Decrement(Client senderRef) {
		senderClient = senderRef;
		count = count - 1;
		senderClient.ValueResponse(count);
	}

	msgsrv GetValue(Client senderRef) {
		senderClient = senderRef;
		senderClient.ValueResponse(count);
	}
}

reactiveclass Client (Counter counter) {
	knownrebecs {
		Counter counter;
	}

	statevars {
		int clientId;
		int lastValue;
	}

	msgsrv initial(int id) {
		clientId = id;
		lastValue = 0;
	}

	msgsrv ValueResponse(int value) {
		lastValue = value;
	}
}

main {
	Counter counter(client1):();
	Client client1(counter):(1);
	Client client2(counter):(2);

	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}