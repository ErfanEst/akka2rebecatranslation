reactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs {
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment(rebec Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(rebec Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(rebec Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
		rebec Counter myCounter;
	}

	knownrebecs {
		rebec Counter counter;
	}

	msgsrv initial(int cid) {
		clientId = cid;
		myCounter = counter;
	}

	msgsrv ValueResponse(int value) {
		// println("Client " + clientId + " received value: " + value);
	}
}

main {
	Counter counter() : ();
	Client client1(counter) : (1);
	Client client2(counter) : (2);

	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}