reactiveclass Ping(pong: Pong) {
	knownrebecs {
		Pong pong;
	}
	statevars {
		int count;
	}

	Ping() {
		count = 0;
	}

	msgsrv initial() {
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;

		if (count >= 10) {
			pong.StopMessage();
		} else {
			pong.PingMessage();
		}
	}
}

reactiveclass Pong {
	knownrebecs {
	}
	statevars {
	}

	Pong() {
	}

	msgsrv initial() {
	}

	msgsrv PingMessage() {
		self.PongMessage();
	}

	msgsrv StopMessage() {
	}
}

main {
	Pong pong();
	Ping ping(pong):();
}