reactiveclass Producer {
	knownrebecs {
		Consumer consumer;
	}
	statevars {
		int dummy;
	}

	msgsrv initial() {
		self.produce("item1");
		self.produce("item2");
	}

	msgsrv produce(string item) {
		consumer.consume(item);
	}
}

reactiveclass Consumer {
	knownrebecs {
	}
	statevars {
		int dummy;
	}

	msgsrv initial() {
		// No initialization needed.
	}

	msgsrv consume(string item) {
		// println("Consumer: received " + item);
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();
}