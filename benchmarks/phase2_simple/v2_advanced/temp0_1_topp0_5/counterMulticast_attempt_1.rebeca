timedreactiveclass Counter {
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment(clientRef sender) {
		count = count + 1;
		// println: Counter incremented to count
		sender.ValueResponse(count);
	}

	msgsrv Decrement(clientRef sender) {
		count = count - 1;
		// println: Counter decremented to count
		sender.ValueResponse(count);
	}

	msgsrv GetValue(clientRef sender) {
		sender.ValueResponse(count);
	}
}

timedreactiveclass Client {
	statevars {
		Counter counter;
		int clientId;
	}

	msgsrv initial(Counter c, int id) {
		counter = c;
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// println: Client clientId received value: value
	}
}

main {
	Counter counter();
	Client client1(counter, 1);
	Client client2(counter, 2);

	// Simulate CounterSystem main behavior
	counter.Increment(client1) after(0);
	counter.Increment(client2) after(0);
	counter.GetValue(client1) after(0);
}