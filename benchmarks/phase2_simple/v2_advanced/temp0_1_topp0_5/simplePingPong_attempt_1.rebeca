reactiveclass Ping {
	statevars {
		int count;
		Pong pong;
	}

	Ping(Pong pongRef) {
		count = 0;
		pong = pongRef;
		self.start();
	}

	msgsrv start() {
		// Ping started the game!
		pong.pingMessage();
	}

	msgsrv pongMessage() {
		count = count + 1;
		// Ping received pong #count from sender
		if (count >= 10) {
			// Ping stopped
			sender.stopMessage();
		} else {
			sender.pingMessage();
		}
	}
}

reactiveclass Pong {
	msgsrv pingMessage() {
		// Pong received ping from sender
		sender.pongMessage();
	}

	msgsrv stopMessage() {
		// Pong stopped
	}
}

main {
	Pong pong();
	Ping ping(pong):();
}