timedreactiveclass Counter {
    knownrebecs {
    }

    statevars {
        int count;
        Client client1;
        Client client2;
    }

    Counter() {
        count = 0;
    }

    msgsrv setClients(Client c1, Client c2) {
        client1 = c1;
        client2 = c2;
    }

    msgsrv Increment(Client senderRef) {
        count = count + 1;
        // println("Counter incremented to " + count);
        senderRef.ValueResponse(count);
    }

    msgsrv Decrement(Client senderRef) {
        count = count - 1;
        // println("Counter decremented to " + count);
        senderRef.ValueResponse(count);
    }

    msgsrv GetValue(Client senderRef) {
        senderRef.ValueResponse(count);
    }
}

timedreactiveclass Client {
    knownrebecs {
    }

    statevars {
        int clientId;
    }

    Client(int id) {
        clientId = id;
    }

    msgsrv ValueResponse(int value) {
        // println("Client " + clientId + " received value: " + value);
    }
}

main {
    Counter counter;
    Client client1(clientId: 1);
    Client client2(clientId: 2);

    counter.setClients(client1, client2);
    counter.Increment(client1);
    counter.Increment(client2);
    counter.GetValue(client1);
}