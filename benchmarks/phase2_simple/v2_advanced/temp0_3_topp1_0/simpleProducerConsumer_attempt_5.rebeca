reactiveclass Producer(1) {
	statevars {
		int id;
	}

	knownrebecs {
		Consumer consumer;
	}

	msgsrv initial(int myId) {
		id = myId;
		self.Produce(1);
		self.Produce(2);
	}

	msgsrv Produce(int item) {
		consumer.Consume(item);
	}
}

reactiveclass Consumer(1) {
	statevars {
		int id;
	}

	knownrebecs {
	}

	msgsrv initial(int myId) {
		id = myId;
	}

	msgsrv Consume(int item) {
		// message received
	}
}

main {
	Consumer consumer() : ();
	Producer producer(consumer) : ();

	main {
		consumer.initial(1);
		producer.initial(1);
	}
}