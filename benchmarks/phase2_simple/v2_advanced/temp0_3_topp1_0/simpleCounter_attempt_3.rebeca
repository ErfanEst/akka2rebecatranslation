reactiveclass Counter {
	knownrebecs {
		Client client1;
		Client client2;
	}
	statevars {
		int count;
		Client senderRef;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment(Client s) {
		senderRef = s;
		count = count + 1;
		ValueResponse(count);
	}

	msgsrv Decrement(Client s) {
		senderRef = s;
		count = count - 1;
		ValueResponse(count);
	}

	msgsrv GetValue(Client s) {
		senderRef = s;
		ValueResponse(count);
	}

	msgsrv ValueResponse(int v) {
		senderRef.receiveValue(v);
	}
}

reactiveclass Client {
	knownrebecs {
	}
	statevars {
		int clientId;
	}

	msgsrv initial() {
		// no parameters allowed in initial in plain Rebeca
	}

	msgsrv setId(int id) {
		clientId = id;
	}

	msgsrv receiveValue(int value) {
		// models reception of the value
	}
}

main {
	Client client1();
	Client client2();
	Counter counter(client1, client2);

	client1.setId(1);
	client2.setId(2);

	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}