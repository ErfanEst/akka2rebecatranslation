reactiveclass Counter() {
	knownrebecs {
		Client client1;
		Client client2;
	}

	statevars {
		int count;
	}

	// no-arg constructor: empty parameter list, body omitted (default)
	// Counter() { count = 0; }  // not allowed here; initialize in a msgsrv instead

	msgsrv init() {
		count = 0;
	}

	msgsrv setClients(Client c1, Client c2) {
		client1 = c1;
		client2 = c2;
	}

	msgsrv Increment(Client senderRef) {
		count = count + 1;
		senderRef.ValueResponse(count);
	}

	msgsrv Decrement(Client senderRef) {
		count = count - 1;
		senderRef.ValueResponse(count);
	}

	msgsrv GetValue(Client senderRef) {
		senderRef.ValueResponse(count);
	}
}

reactiveclass Client(int id) {
	knownrebecs {
	}

	statevars {
		int clientId;
	}

	// constructor: parameters are declared in the header and
	// assignments (if any) must be in a msgsrv, not here

	msgsrv init() {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// handle received value
	}
}

main {
	Counter counter();
	Client client1(1);
	Client client2(2);

	counter.init();
	client1.init();
	client2.init();

	counter.setClients(client1, client2);
	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}