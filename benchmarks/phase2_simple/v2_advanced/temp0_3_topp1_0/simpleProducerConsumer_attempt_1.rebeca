reactiveclass Producer(1) {
	statevars {
		int id;
	}

	knownrebecs {
		Consumer consumer;
	}

	msgsrv initial(int myId) {
		id = myId;
	}

	msgsrv Produce(string item) {
		// println("Producer: sending " + item);
		consumer.Consume(item);
	}
}

reactiveclass Consumer(1) {
	statevars {
		int id;
	}

	knownrebecs {
	}

	msgsrv initial(int myId) {
		id = myId;
	}

	msgsrv Consume(string item) {
		// println("Consumer: received " + item);
	}
}

main {
	Consumer consumer();
	Producer producer(consumer);

	producer.initial(1);
	consumer.initial(1);

	producer.Produce("item1");
	producer.Produce("item2");
}

}