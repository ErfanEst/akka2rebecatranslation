reactiveclass Counter {
	knownrebecs {
		Client client1;
		Client client2;
	}

	statevars {
		int count;
	}

	msgsrv init() {
		count = 0;
	}

	msgsrv setClients(Client c1, Client c2) {
		client1 = c1;
		client2 = c2;
	}

	msgsrv Increment(Client senderRef) {
		count = count + 1;
		senderRef.ValueResponse(count);
	}

	msgsrv Decrement(Client senderRef) {
		count = count - 1;
		senderRef.ValueResponse(count);
	}

	msgsrv GetValue(Client senderRef) {
		senderRef.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs {
	}

	statevars {
		int clientId;
	}

	msgsrv init(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// handle received value
	}
}

main {
	Counter counter(counterKnown:Client client1, Client client2);
	Client client1();
	Client client2();

	client1.init(1);
	client2.init(2);
	counter.init();

	counter.setClients(client1, client2);
	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}