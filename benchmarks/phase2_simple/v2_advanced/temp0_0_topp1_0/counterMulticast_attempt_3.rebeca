reactiveclass Counter (Client client1, Client client2) {
	knownrebecs {
		Client client1;
		Client client2;
	}
	statevars {
		int count;
		Client senderTmp;
	}

	Counter(Client c1, Client c2) {
		count = 0;
	}

	msgsrv initial() {
		// no automatic behavior
	}

	msgsrv Increment(Client senderRef) {
		count = count + 1;
		senderTmp = senderRef;
		senderTmp.ValueResponse(count);
	}

	msgsrv Decrement(Client senderRef) {
		count = count - 1;
		senderTmp = senderRef;
		senderTmp.ValueResponse(count);
	}

	msgsrv GetValue(Client senderRef) {
		senderTmp = senderRef;
		senderTmp.ValueResponse(count);
	}
}

reactiveclass Client (Counter counter, int id) {
	knownrebecs {
		Counter counter;
	}
	statevars {
		int clientId;
		int lastValue;
	}

	Client(int id) {
		clientId = id;
		lastValue = 0;
	}

	msgsrv initial() {
		// no automatic behavior
	}

	msgsrv ValueResponse(int value) {
		lastValue = value;
		// print is omitted in Rebeca model
	}
}

main {
	Client client1(counter, 1):();
	Client client2(counter, 2):();
	Counter counter(client1, client2):(client1, client2);

	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}