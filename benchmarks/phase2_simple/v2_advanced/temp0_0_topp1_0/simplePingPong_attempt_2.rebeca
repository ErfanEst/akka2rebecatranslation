reactiveclass Ping(pong: Pong) {
	knownrebecs {
		Pong pong;
	}
	statevars {
		int count;
	}

	Ping() {
		count = 0;
	}

	msgsrv StartMessage() {
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		if (count >= 10) {
			self.StopPong();
		} else {
			self.SendPing();
		}
	}

	msgsrv SendPing() {
		pong.PingMessage();
	}

	msgsrv StopPong() {
		pong.StopMessage();
	}
}

reactiveclass Pong {
	knownrebecs { }

	Pong() {
	}

	msgsrv PingMessage() {
		sender.PongMessage();
	}

	msgsrv StopMessage() {
	}
}

main {
	Pong pong();
	Ping ping(pong):();
	ping.StartMessage();
}