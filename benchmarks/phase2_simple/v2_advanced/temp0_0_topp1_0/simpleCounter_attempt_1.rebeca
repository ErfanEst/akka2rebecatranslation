timedreactiveclass Counter {
	statevars {
		int count;
		clientRef lastSender;
	}

	knownrebecs {
		clientRef client1;
		clientRef client2;
	}

	reactiveclass clientRef {
	}

 msgsrv Increment(clientRef sender) {
		count = count + 1;
		lastSender = sender;
		sender.ValueResponse(count) after(0);
	}

	msgsrv Decrement(clientRef sender) {
		count = count - 1;
		lastSender = sender;
		sender.ValueResponse(count) after(0);
	}

	msgsrv GetValue(clientRef sender) {
		lastSender = sender;
		sender.ValueResponse(count) after(0);
	}

	msgsrv initial() {
		count = 0;
	}
}

timedreactiveclass Client {
	statevars {
		int clientId;
		Counter counter;
	}

	knownrebecs {
		Counter counter;
	}

	msgsrv initial(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// println("Client " + clientId + " received value: " + value);
	}
}

main {
	Counter counter(counterClient1, counterClient2):();
	Client counterClient1(counter):(1);
	Client counterClient2(counter):(2);

	counter.Increment(counterClient1) after(0);
	counter.Increment(counterClient2) after(0);
	counter.GetValue(counterClient1) after(0);
}