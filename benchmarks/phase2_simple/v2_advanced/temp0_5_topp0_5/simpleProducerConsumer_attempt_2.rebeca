reactiveclass Producer(1) {
	statevars {
		int dummy;
	}

	knownrebecs {
		Consumer consumer;
	}

	msgsrv initial() {
		// simulate sending two items at start
		Produce(1);
		Produce(2);
	}

	msgsrv Produce(int item) {
		// Producer: sending item
		consumer.Consume(item);
	}
}

reactiveclass Consumer(1) {
	statevars {
		int dummy;
	}

	knownrebecs {
	}

	msgsrv initial() {
		// no initialization needed
	}

	msgsrv Consume(int item) {
		// Consumer: received item
	}
}

main {
	Consumer consumer();
	Producer producer(consumer);
}