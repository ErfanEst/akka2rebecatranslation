reactiveclass Counter {
	statevars {
		int count;
		Client client1;
		Client client2;
	}

	knownrebecs { }

	msgsrv initial(Client c1, Client c2) {
		count = 0;
		client1 = c1;
		client2 = c2;

		// Simulate:
		// counter.tell(Increment, client1)
		// counter.tell(Increment, client2)
		// counter.tell(GetValue, client1)
		self.Increment(client1);
		self.Increment(client2);
		self.GetValue(client1);
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
	}

	knownrebecs { }

	msgsrv initial(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// println(s"Client $clientId received value: $value")
		// In Rebeca, we use print:
		print("Client ");
		print(clientId);
		print(" received value: ");
		print(value);
		println("");
	}
}

main {
	Counter counter(counterClient1, counterClient2);
	Client counterClient1(1);
	Client counterClient2(2);
}