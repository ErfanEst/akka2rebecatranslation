reactiveclass Counter (Client client1, Client client2) {
	knownrebecs {
		Client client1;
		Client client2;
	}

	statevars {
		int count;
		Client clientRef;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment(Client senderRef) {
		count = count + 1;
		clientRef = senderRef;
		clientRef.ValueResponse(count);
	}

	msgsrv Decrement(Client senderRef) {
		count = count - 1;
		clientRef = senderRef;
		clientRef.ValueResponse(count);
	}

	msgsrv GetValue(Client senderRef) {
		clientRef = senderRef;
		clientRef.ValueResponse(count);
	}
}

reactiveclass Client (Counter counter) {
	knownrebecs {
		Counter counter;
	}

	statevars {
		int clientId;
	}

	msgsrv initial(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// print: Client clientId received value: value
	}
}

main {
	Client client1(counter): (1);
	Client client2(counter): (2);
	Counter counter(client1, client2): ();
	
	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}