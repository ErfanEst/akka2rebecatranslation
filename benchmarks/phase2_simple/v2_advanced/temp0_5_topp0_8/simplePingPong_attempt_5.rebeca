reactiveclass Ping {
	knownrebecs {
		Pong pong;
	}

	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
		startMessage();
	}

	msgsrv startMessage() {
		pong.pingMessage();
	}

	msgsrv pongMessage() {
		count = count + 1;
		if (count >= 10) {
			sender.stopMessage();
		} else {
			sender.pingMessage();
		}
	}
}

reactiveclass Pong {
	msgsrv initial() {
	}

	msgsrv pingMessage() {
		sender.pongMessage();
	}

	msgsrv stopMessage() {
	}
}

main {
	Pong pong():();
	Ping ping(pong):();
}