reactiveclass Producer {
	knownrebecs {
		Consumer consumer;
	}
	statevars {
		int dummy;
	}

	msgsrv initial() {
		self.Produce(1);
		self.Produce(2);
	}

	msgsrv Produce(int item) {
		consumer.Consume(item);
	}
}

reactiveclass Consumer {
	statevars {
		int dummy;
	}

	msgsrv initial() {
		// no initialization needed
	}

	msgsrv Consume(int item) {
		// Consumer: received item
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();
}