reactiveclass Counter {
	statevars {
		int count;
		Client clientSender;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment(Client s) {
		clientSender = s;
		count = count + 1;
		clientSender.ValueResponse(count);
	}

	msgsrv Decrement(Client s) {
		clientSender = s;
		count = count - 1;
		clientSender.ValueResponse(count);
	}

	msgsrv GetValue(Client s) {
		clientSender = s;
		clientSender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
	}

	msgsrv initial(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// println is not part of Rebeca; use comments to represent output
		// Client clientId received value: value
	}
}

main {
	Counter counter();
	Client client1(1);
	Client client2(2);

	counter.Increment(client1) after(0);
	counter.Increment(client2) after(0);
	counter.GetValue(client1) after(0);
}

}