reactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs {
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		// ValueResponse(count, sender); // 'sender' is not directly available in basic Rebeca
	}

	msgsrv Decrement() {
		count = count - 1;
		// ValueResponse(count, sender);
	}

	msgsrv GetValue() {
		// ValueResponse(count, sender);
	}

	msgsrv ValueResponse(int value, Client client) {
		// This message server is not used in Counter; defined for type completeness
	}
}

reactiveclass Client {
	statevars {
		int clientId;
	}

	knownrebecs {
		Counter counter;
	}

	msgsrv initial(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value, Client client) {
		// println("Client " + clientId + " received value: " + value);
	}
}

main {
	Counter counter();
	Client client1(counter): (1);
	Client client2(counter): (2);

	counter.Increment();
	counter.Increment();
	counter.GetValue();
}