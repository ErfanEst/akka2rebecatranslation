reactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs {
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
	}

	msgsrv Decrement() {
		count = count - 1;
	}

	msgsrv GetValue() {
	}

	msgsrv ValueResponse(int value, Client client) {
	}
}

reactiveclass Client {
	statevars {
		int clientId;
		Counter counter;
	}

	knownrebecs {
	}

	msgsrv initial(int id, Counter c) {
		clientId = id;
		counter = c;
	}

	msgsrv ValueResponse(int value, Client client) {
	}
}

main {
	Counter counter():();
	Client client1():(1, counter);
	Client client2():(2, counter);

	counter.Increment():();
	counter.Increment():();
	counter.GetValue():();
}