reactiveclass Counter() {
	statevars {
		int count;
	}

	knownrebecs {
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
	}

	msgsrv Decrement() {
		count = count - 1;
	}

	msgsrv GetValue() {
	}

	msgsrv ValueResponse(int value, Client client) {
	}
}

reactiveclass Client(Counter counter) {
	statevars {
		int clientId;
	}

	knownrebecs {
		Counter counter;
	}

	msgsrv initial(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value, Client client) {
	}
}

main {
	Counter counter():();
	Client client1(counter):(1);
	Client client2(counter):(2);

	counter.Increment():();
	counter.Increment():();
	counter.GetValue():();
}