reactiveclass Producer(1) {
	knownrebecs {
		Consumer consumer;
	}
	statevars {
		int item;
	}

	msgsrv initial() {
		// no-op
	}

	msgsrv Produce(int _item) {
		item = _item;
		consumer.Consume(item);
	}
}

reactiveclass Consumer(1) {
	knownrebecs {
	}
	statevars {
		int item;
	}

	msgsrv initial() {
		// no-op
	}

	msgsrv Consume(int _item) {
		item = _item;
	}
}

main {
	Consumer consumer();
	Producer producer(consumer);

	producer.Produce(1);
	producer.Produce(2);
}