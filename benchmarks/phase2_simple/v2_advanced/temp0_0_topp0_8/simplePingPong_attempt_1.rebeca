reactiveclass Ping(1) {
    knownrebecs {
        Pong pong;
    }
    statevars {
        int count;
    }

    Ping() {
        count = 0;
    }

    msgsrv StartMessage() {
        // println("Ping started the game!");
        pong.PingMessage();
    }

    msgsrv PongMessage() {
        count = count + 1;
        // println("Ping received pong #" + count);
        if (count >= 10) {
            sender.StopMessage();
            // println("Ping stopped");
            // no explicit stop; rebec becomes quiescent
        } else {
            sender.PingMessage();
        }
    }
}

reactiveclass Pong(1) {
    knownrebecs {
    }
    statevars {
    }

    Pong() {
    }

    msgsrv PingMessage() {
        // println("Pong received ping");
        sender.PongMessage();
    }

    msgsrv StopMessage() {
        // println("Pong stopped");
        // no explicit stop; rebec becomes quiescent
    }
}

main {
    Pong pong();
    Ping ping(pong): (StartMessage);
}