reactiveclass Counter() {
	knownrebecs { }

	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		self.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		self.ValueResponse(count);
	}

	msgsrv GetValue() {
		self.ValueResponse(count);
	}

	msgsrv ValueResponse(int v) {
		// no-op, used only for sender semantics
	}
}

reactiveclass Client(Counter counter) {
	knownrebecs { 
		Counter counter;
	}

	statevars {
		int clientId;
	}

	msgsrv initial(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// no-op, placeholder for client-side handling
	}
}

main {
	Counter counter():();
	Client client1(counter):(1);
	Client client2(counter):(2);

	counter.Increment();
	counter.Increment();
	counter.GetValue();
}