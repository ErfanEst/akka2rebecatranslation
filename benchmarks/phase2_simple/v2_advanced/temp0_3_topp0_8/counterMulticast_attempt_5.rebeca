reactiveclass Counter(1) {
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client(Counter counter) {
	statevars {
		int clientId;
	}

	msgsrv initial(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// println: Client clientId received value: value
	}
}

main {
	Counter counter(counter):();
	Client client1(counter):(1);
	Client client2(counter):(2);

	client1.Increment() after(0);
	client2.Increment() after(0);
	client1.GetValue() after(0);
}