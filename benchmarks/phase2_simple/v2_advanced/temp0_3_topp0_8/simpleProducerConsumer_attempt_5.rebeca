reactiveclass Producer(Consumer consumer) {
	statevars {
	}

	msgsrv initial() {
		Produce(1);
		Produce(2);
	}

	msgsrv Produce(int item) {
		_consume(item);
	}

	private msgsrv _consume(int item) {
		consumer.Consume(item);
	}
}

reactiveclass Consumer() {
	statevars {
	}

	msgsrv initial() {
	}

	msgsrv Consume(int item) {
		// println("Consumer: received " + item);
	}
}

main {
	Consumer consumer();
	Producer producer(consumer);
}