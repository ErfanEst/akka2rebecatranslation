reactiveclass Producer {
	knownrebecs { 
		Consumer consumer;
	}
	statevars {
	}

	msgsrv initial() {
		Produce("item1");
		Produce("item2");
	}

	msgsrv Produce(string item) {
		_consume(item);
	}

	private msgsrv _consume(string item) {
		consumer.Consume(item);
	}
}

reactiveclass Consumer {
	knownrebecs {
	}
	statevars {
	}

	msgsrv initial() {
	}

	msgsrv Consume(string item) {
		// println("Consumer: received " + item);
	}
}

main {
	Consumer consumer();
	Producer producer(consumer);
}