reactiveclass Counter {
    knownrebecs {
    }
    statevars {
        int count;
    }

    msgsrv initial() {
        count = 0;
    }

    msgsrv Increment(Client sender) {
        count = count + 1;
        sender.ValueResponse(count);
    }

    msgsrv Decrement(Client sender) {
        count = count - 1;
        sender.ValueResponse(count);
    }

    msgsrv GetValue(Client sender) {
        sender.ValueResponse(count);
    }
}

reactiveclass Client {
    knownrebecs {
    }
    statevars {
        int clientId;
    }

    msgsrv initial(int id) {
        clientId = id;
    }

    msgsrv ValueResponse(int value) {
        // println("Client " + clientId + " received value: " + value);
    }
}

main {
    Counter counter();
    Client client1(1);
    Client client2(2);

    counter.Increment(client1) after(0);
    counter.Increment(client2) after(0);
    counter.GetValue(client1) after(0);
}

}