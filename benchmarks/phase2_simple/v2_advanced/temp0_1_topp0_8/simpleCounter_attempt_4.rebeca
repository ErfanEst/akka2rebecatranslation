reactiveclass Counter {
	knownrebecs {
		Client client1;
		Client client2;
	}
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs {
	}
	statevars {
		int clientId;
	}

	msgsrv initial(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// println("Client " + clientId + " received value: " + value);
	}
}

main {
	Client client1(1):();
	Client client2(2):();
	Counter counter(client1, client2):();

	client1.Increment(counter);
	client2.Increment(counter);
	client1.GetValue(counter);
}