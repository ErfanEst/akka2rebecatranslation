reactiveclass Ping {
	knownrebecs {
		Pong pong;
	}
	statevars {
		int count;
	}

	Ping() {
		count = 0;
		self.start();
	}

	msgsrv start() {
		pong.pingMessage();
	}

	msgsrv pongMessage() {
		count = count + 1;
		if (count >= 10) {
			pong.stopMessage();
		} else {
			pong.pingMessage();
		}
	}
}

reactiveclass Pong {
	knownrebecs {
		Ping ping;
	}

	msgsrv pingMessage() {
		ping.pongMessage();
	}

	msgsrv stopMessage() {
	}
}

main {
	Ping ping(pong):();
	Pong pong(ping):();
}