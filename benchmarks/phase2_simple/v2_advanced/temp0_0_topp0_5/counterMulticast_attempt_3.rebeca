reactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs {
		Client client1;
		Client client2;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment(byte senderId) {
		count = count + 1;
		self.GetValue(senderId);
	}

	msgsrv Decrement(byte senderId) {
		count = count - 1;
		self.GetValue(senderId);
	}

	msgsrv GetValue(byte senderId) {
		if (senderId == 1) {
			client1.ValueResponse(count);
		} else {
			client2.ValueResponse(count);
		}
	}
}

reactiveclass Client {
	statevars {
		byte clientId;
	}

	knownrebecs {
		Counter counter;
	}

	msgsrv initial(byte _clientId, Counter _counter) {
		clientId = _clientId;
		counter = _counter;
	}

	msgsrv ValueResponse(int value) {
		value = value;
	}
}

main {
	Counter counter(client1, client2);
	Client client1(counter): (1, counter);
	Client client2(counter): (2, counter);

	counter.Increment(1);
	counter.Increment(2);
	counter.GetValue(1);
}