reactiveclass Counter(5) {
	knownrebecs { Client client1; Client client2; }
	statevars { int count; }

	Counter() {
		count = 0;
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client(5) {
	knownrebecs { Counter counter; }
	statevars { int clientId; }

	Client(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// no I/O in Rebeca model
	}
}

main {
	Counter counter(client1, client2):();
	Client client1(counter):(1);
	Client client2(counter):(2);

	// Initial messages must be sent from within an msgsrv or constructor in Rebeca.
	// To model the same behavior, let client1 trigger them in its constructor:

	// So we remove these top-level calls:
	// counter.Increment(client1);
	// counter.Increment(client2);
	// counter.GetValue(client1);
}