reactiveclass Ping(5) {
  knownrebecs { Pong pong; }
  statevars { int count; int active; }

  Ping() {
    count = 0;
    active = 1;
  }

  msgsrv StartMessage() {
    if (active == 1) {
      pong.PingMessage();
    }
  }

  msgsrv PongMessage() {
    if (active == 1) {
      count = count + 1;
      if (count >= 10) {
        pong.StopMessage();
        active = 0;
      } else {
        pong.PingMessage();
      }
    }
  }
}

reactiveclass Pong(5) {
  knownrebecs { Ping ping; }
  statevars { int active; }

  Pong() {
    active = 1;
  }

  msgsrv PingMessage() {
    if (active == 1) {
      ping.PongMessage();
    }
  }

  msgsrv StopMessage() {
    active = 0;
  }
}

main {
  Ping ping(pong):();
  Pong pong(ping):();
  
  ping.StartMessage();
}