reactiveclass Counter(5) {
	knownrebecs { Client client1; Client client2; }
	statevars { int count; }

	Counter() {
		count = 0;
	}

	msgsrv Increment(int clientId) {
		count = count + 1;
		if (clientId == 1) {
			client1.ValueResponse(count);
		} else {
			client2.ValueResponse(count);
		}
	}

	msgsrv Decrement(int clientId) {
		count = count - 1;
		if (clientId == 1) {
			client1.ValueResponse(count);
		} else {
			client2.ValueResponse(count);
		}
	}

	msgsrv GetValue(int clientId) {
		if (clientId == 1) {
			client1.ValueResponse(count);
		} else {
			client2.ValueResponse(count);
		}
	}
}

reactiveclass Client(5) {
	knownrebecs { Counter counter; }
	statevars { int clientId; }

	Client(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
	}
}

main {
	Client client1(counter):(1);
	Client client2(counter):(2);
	Counter counter(client1, client2):();

	counter.Increment(1);
	counter.Increment(2);
	counter.GetValue(1);
}