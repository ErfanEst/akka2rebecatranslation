reactiveclass Producer(5) {
	knownrebecs { Consumer consumer; }

	statevars { }

	Producer() { }

	msgsrv initial() { }

	msgsrv ProduceMsg(int item) {
		consumer.ConsumeMsg(item);
	}
}

reactiveclass Consumer(5) {
	knownrebecs { }

	statevars { }

	Consumer() { }

	msgsrv initial() { }

	msgsrv ConsumeMsg(int item) {
		// no I/O
	}
}

main {
	Consumer c():();
	Producer p(c):();

	p.ProduceMsg(1);
	p.ProduceMsg(2);
}