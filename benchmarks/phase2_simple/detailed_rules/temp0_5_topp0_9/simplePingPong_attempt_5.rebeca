reactiveclass Ping(pongType) {
	knownrebecs {
		pongType pong;
	}

	statevars {
		int count;
	}

	Ping() {
		count = 0;
	}

	msgsrv StartMessage() {
		println("Ping started the game!");
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		println("Ping received pong #" + count);
		if (count >= 10) {
			pong.StopMessage();
			println("Ping stopped");
		} else {
			pong.PingMessage();
		}
	}
}

reactiveclass Pong(pingType) {
	knownrebecs {
		pingType ping;
	}

	statevars {
	}

	Pong() {
	}

	msgsrv PingMessage() {
		println("Pong received ping");
		ping.PongMessage();
	}

	msgsrv StopMessage() {
		println("Pong stopped");
	}
}

main {
	Ping(pongType): ping();
	Pong(pingType): pong();
	ping.StartMessage();
}