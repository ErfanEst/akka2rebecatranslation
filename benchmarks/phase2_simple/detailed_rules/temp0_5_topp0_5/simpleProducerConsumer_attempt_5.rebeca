reactiveclass Producer(Consumer consumer) {
	knownrebecs {
		Consumer consumer;
	}

	statevars {
	}

	constructor(Consumer c) {
		consumer = c;
	}

	msgsrv initial() {
	}

	msgsrv Produce(int item) {
		consumer.Consume(item);
	}
}

reactiveclass Consumer() {
	knownrebecs {
	}

	statevars {
	}

	constructor() {
	}

	msgsrv initial() {
	}

	msgsrv Consume(int item) {
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):(consumer);

	producer.Produce(1);
	producer.Produce(2);
}