reactiveclass Ping {
	knownrebecs { 
		Pong pong;
	}
	statevars {
		int count;
	}

	Ping(Pong pong) {
		self.pong = pong;
		count = 0;
	}

	msgsrv StartMessage() {
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		if (count >= 10) {
			pong.StopMessage();
			self.stop();
		} else {
			pong.PingMessage();
		}
	}
}

reactiveclass Pong {
	knownrebecs { 
		Ping ping;
	}

	statevars {
	}

	Pong(Ping ping) {
		self.ping = ping;
	}

	msgsrv PingMessage() {
		ping.PongMessage();
	}

	msgsrv StopMessage() {
		self.stop();
	}
}

main {
	Ping ping(pong): (StartMessage);
	Pong pong(ping): ();
}