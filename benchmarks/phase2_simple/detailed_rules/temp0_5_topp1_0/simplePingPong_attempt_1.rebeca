reactiveclass Ping {
	knownrebecs {
		Pong pong;
	}

	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv StartMessage() {
		// println("Ping started the game!");
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		// println("Ping received pong #" + count);
		if (count >= 10) {
			// sender() ! StopMessage
			pong.StopMessage();
			// println("Ping stopped");
			self.destroy();
		} else {
			// sender() ! PingMessage
			pong.PingMessage();
		}
	}
}

reactiveclass Pong {
	knownrebecs {
		Ping ping;
	}

	statevars {
	}

	msgsrv initial() {
	}

	msgsrv PingMessage() {
		// println("Pong received ping");
		ping.PongMessage();
	}

	msgsrv StopMessage() {
		// println("Pong stopped");
		self.destroy();
	}
}

main {
	Ping ping(pong):();
	Pong pong(ping):();
	ping.StartMessage();
}