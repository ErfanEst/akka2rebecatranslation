reactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs {
		// In Akka, sender is dynamic; in Rebeca we pass the sender explicitly
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment(Client senderClient) {
		count = count + 1;
		// println equivalent is omitted in core Rebeca
		senderClient.ValueResponse(count);
	}

	msgsrv Decrement(Client senderClient) {
		count = count - 1;
		senderClient.ValueResponse(count);
	}

	msgsrv GetValue(Client senderClient) {
		senderClient.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
	}

	knownrebecs {
		Counter counter;
	}

	msgsrv initial(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// println equivalent is omitted in core Rebeca
		// This is where: "Client clientId received value: value" would be printed
	}
}

main {
	Counter counter();
	Client client1(counter): (1);
	Client client2(counter): (2);

	// Equivalent of:
	// counter.tell(Increment, client1)
	// counter.tell(Increment, client2)
	// counter.tell(GetValue, client1)
	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}