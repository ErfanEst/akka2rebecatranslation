reactiveclass Pong {
	knownrebecs { }

	statevars { }

	Pong() { }

	msgsrv PingMessage() {
		sender.PongMessage();
	}

	msgsrv StopMessage() {
	}
}

reactiveclass Ping {
	knownrebecs { 
		Pong pong;
	}

	statevars {
		int count;
	}

	Ping() {
		count = 0;
	}

	msgsrv StartMessage() {
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		if (count >= 10) {
			pong.StopMessage();
		} else {
			pong.PingMessage();
		}
	}
}

main {
	Pong pong() : ();
	Ping ping(pong) : (StartMessage());
}