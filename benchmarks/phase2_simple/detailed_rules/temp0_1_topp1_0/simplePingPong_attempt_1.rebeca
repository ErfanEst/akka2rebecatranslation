reactiveclass Ping {
	knownrebecs { 
		Pong pong;
	}

	statevars {
		int count;
	}

	 Ping(Pong pong) {
		self.pong = pong;
		count = 0;
	}

	msgsrv StartMessage() {
		// Ping started the game!
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		// Ping received pong #count from pong
		if (count >= 10) {
			pong.StopMessage();
			// Ping stopped
		} else {
			pong.PingMessage();
		}
	}
}

reactiveclass Pong {
	knownrebecs { }

	statevars { }

	Pong() { }

	msgsrv PingMessage() {
		// Pong received ping from ping
		sender.PongMessage();
	}

	msgsrv StopMessage() {
		// Pong stopped
	}
}

main {
	Pong pong();
	Ping ping(pong): (StartMessage());
}