reactiveclass Counter {
	knownrebecs {
	}
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		// sender.ValueResponse(count); // 'sender' is not directly available in basic Rebeca
	}

	msgsrv Decrement() {
		count = count - 1;
		// sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		// sender.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs {
		Counter counter;
	}
	statevars {
		int clientId;
	}

	msgsrv initial(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// print("Client " + clientId + " received value: " + value);
	}
}

main {
	Counter counter():();
	Client client1(counter):(1);
	Client client2(counter):(2);

	// Rebeca does not allow arbitrary statements in main; calls must be in initial msgsrv
}