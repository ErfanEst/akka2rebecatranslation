reactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs {
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment(Client senderClient) {
		count = count + 1;
		senderClient.ValueResponse(count);
	}

	msgsrv Decrement(Client senderClient) {
		count = count - 1;
		senderClient.ValueResponse(count);
	}

	msgsrv GetValue(Client senderClient) {
		senderClient.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
	}

	knownrebecs {
		Counter counter;
	}

	msgsrv initial(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
	}
}

main {
	Counter counter():();
	Client client1(counter):(1);
	Client client2(counter):(2);

	client1.counter.Increment(client1);
	client2.counter.Increment(client2);
	client1.counter.GetValue(client1);
}