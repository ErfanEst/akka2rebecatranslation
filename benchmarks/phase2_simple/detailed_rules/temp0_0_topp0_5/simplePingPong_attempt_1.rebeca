reactiveclass Ping {
	knownrebecs { 
		Pong pong;
	}
	statevars {
		int count;
	}

	Ping() {
		count = 0;
	}

	msgsrv StartMessage() {
		// println("Ping started the game!");
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		// println("Ping received pong #" + count);
		if (count >= 10) {
			pong.StopMessage();
			// println("Ping stopped");
			// no explicit stop in Rebeca; actor becomes idle
		} else {
			pong.PingMessage();
		}
	}
}

reactiveclass Pong {
	knownrebecs {
		Ping ping;
	}
	statevars {
	}

	Pong() {
	}

	msgsrv PingMessage() {
		// println("Pong received ping");
		ping.PongMessage();
	}

	msgsrv StopMessage() {
		// println("Pong stopped");
		// no explicit stop in Rebeca; actor becomes idle
	}
}

main {
	Ping ping(pong):();
	Pong pong(ping):();

	ping.StartMessage();
}