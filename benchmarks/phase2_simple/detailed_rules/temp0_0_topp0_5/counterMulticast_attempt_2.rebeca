reactiveclass Counter {
	knownrebecs { }
	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		self.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		self.ValueResponse(count);
	}

	msgsrv GetValue() {
		self.ValueResponse(count);
	}

	msgsrv ValueResponse(int value) {
		// no-op
	}
}

reactiveclass Client {
	knownrebecs {
		Counter counter;
	}
	statevars {
		int clientId;
	}

	Client(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// no-op
	}
}

main {
	Counter counter : ();
	Client client1 : (counter, 1);
	Client client2 : (counter, 2);

	counter.Increment();
	counter.Increment();
	counter.GetValue();
}