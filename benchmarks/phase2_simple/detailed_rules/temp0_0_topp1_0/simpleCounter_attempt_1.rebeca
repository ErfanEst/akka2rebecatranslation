reactiveclass Counter {
    knownrebecs { }
    statevars {
        int count;
    }

    Counter() {
        count = 0;
    }

    msgsrv Increment(Client sender) {
        count = count + 1;
        sender.ValueResponse(count);
    }

    msgsrv Decrement(Client sender) {
        count = count - 1;
        sender.ValueResponse(count);
    }

    msgsrv GetValue(Client sender) {
        sender.ValueResponse(count);
    }
}

reactiveclass Client {
    knownrebecs {
        Counter counter;
    }
    statevars {
        int clientId;
    }

    Client(int id) {
        clientId = id;
    }

    msgsrv ValueResponse(int value) {
        // println("Client " + clientId + " received value: " + value);
    }
}

main {
    Counter counter(cntr):();
    Client client1(c1):(cntr, 1);
    Client client2(c2):(cntr, 2);

    cntr.Increment(c1);
    cntr.Increment(c2);
    cntr.GetValue(c1);
}