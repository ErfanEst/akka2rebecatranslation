reactiveclass Counter {
	knownrebecs {
		Client client1;
		Client client2;
	}
	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv Increment(int sender) {
		count = count + 1;
		if (sender == 1) {
			client1.ValueResponse(count);
		} else if (sender == 2) {
			client2.ValueResponse(count);
		}
	}

	msgsrv Decrement(int sender) {
		count = count - 1;
		if (sender == 1) {
			client1.ValueResponse(count);
		} else if (sender == 2) {
			client2.ValueResponse(count);
		}
	}

	msgsrv GetValue(int sender) {
		if (sender == 1) {
			client1.ValueResponse(count);
		} else if (sender == 2) {
			client2.ValueResponse(count);
		}
	}
}

reactiveclass Client {
	knownrebecs {
		Counter counter;
	}
	statevars {
		int clientId;
	}

	Client(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// placeholder for handling the value
	}
}

main {
	Client counterClient1(counter);
	Client counterClient2(counter);
	Counter counter(counterClient1, counterClient2);

	counter.Increment(1);
	counter.Increment(2);
	counter.GetValue(1);
}