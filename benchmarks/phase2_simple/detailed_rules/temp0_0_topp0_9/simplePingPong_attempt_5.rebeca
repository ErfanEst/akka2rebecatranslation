reactiveclass Ping(pongType pong) {
	knownrebecs { 
		pongType pong;
	}
	statevars {
		int count;
	}

	Ping() {
		count = 0;
	}

	msgsrv StartMessage() {
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		if (count >= 10) {
			pong.StopMessage();
		} else {
			pong.PingMessage();
		}
	}
}

reactiveclass Pong(pingType ping) {
	knownrebecs { 
		pingType ping;
	}
	statevars {
	}

	Pong() {
	}

	msgsrv PingMessage() {
		ping.PongMessage();
	}

	msgsrv StopMessage() {
	}
}

main {
	Ping ping(pong);
	Pong pong(ping);

	ping.StartMessage();
}