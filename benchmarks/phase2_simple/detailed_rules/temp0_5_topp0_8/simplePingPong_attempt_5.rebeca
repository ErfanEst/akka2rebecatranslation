reactiveclass Ping(pong: Pong) {
	statevars {
		int count;
	}

	Ping() {
		count = 0;
	}

	msgsrv StartMessage() {
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		if (count >= 10) {
			pong.StopMessage();
			self.terminate();
		} else {
			pong.PingMessage();
		}
	}
}

reactiveclass Pong(ping: Ping) {
	statevars {
	}

	Pong() {
	}

	msgsrv PingMessage() {
		ping.PongMessage();
	}

	msgsrv StopMessage() {
		self.terminate();
	}
}

main {
	Ping ping(pong):();
	Pong pong(ping):();

	ping.StartMessage();
}