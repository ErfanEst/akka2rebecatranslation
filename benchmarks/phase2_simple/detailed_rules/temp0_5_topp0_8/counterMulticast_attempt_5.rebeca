reactiveclass Counter() {
	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
	}

	msgsrv Decrement() {
		count = count - 1;
	}

	msgsrv GetValue() {
	}
}

reactiveclass Client(Counter counter) {
	statevars {
		int clientId;
		Counter counterRef;
	}

	Client(int id) {
		clientId = id;
		counterRef = counter;
	}

	msgsrv ValueResponse(int value) {
	}

	msgsrv Start() {
		counterRef.Increment();
		counterRef.Increment();
		counterRef.GetValue();
	}
}

main {
	Counter counter():();
	Client client1(counter):(1);
	Client client2(counter):(2);

	client1.Start();
	client2.Start();
}