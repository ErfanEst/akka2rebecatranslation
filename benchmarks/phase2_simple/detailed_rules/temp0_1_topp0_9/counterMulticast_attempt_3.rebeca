reactiveclass Counter {
	knownrebecs { }

	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
	}

	msgsrv Decrement() {
		count = count - 1;
	}

	msgsrv GetValue() {
		// In Rebeca core, we cannot send back to sender directly.
	}
}

reactiveclass Client {
	knownrebecs { Counter counter; }

	statevars {
		int clientId;
	}

	Client(Counter c, int id) {
		counter = c;
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// println: "Client " + clientId + " received value: " + value
	}
}

main {
	Counter counter() : ();
	Client client1(counter) : (1);
	Client client2(counter) : (2);

	counter.Increment();
	counter.Increment();
	counter.GetValue();
}