reactiveclass Counter {
	knownrebecs {
		Client client1;
		Client client2;
	}

	statevars {
		int count;
	}

	Constructor(Client c1, Client c2) {
		client1 = c1;
		client2 = c2;
		count = 0;
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs {
		Counter counter;
	}

	statevars {
		int clientId;
	}

	Constructor(Counter c, int id) {
		counter = c;
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// println is not available in core Rebeca; this is a placeholder
		// for side-effect observation.
	}
}

main {
	Counter counter(client1, client2);
	Client client1(counter, 1);
	Client client2(counter, 2);

	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}