reactiveclass Counter {
	knownrebecs {
		Client client1;
		Client client2;
	}

	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv initial(Client c1, Client c2) {
		client1 = c1;
		client2 = c2;
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs {
		Counter counter;
	}

	statevars {
		byte clientId;
	}

	Client() {
		clientId = 0;
	}

	msgsrv initial(Counter c, byte id) {
		counter = c;
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// side-effect placeholder
	}
}

main {
	Counter counter();
	Client client1();
	Client client2();

	counter.initial(client1, client2);
	client1.initial(counter, 1);
	client2.initial(counter, 2);
}