reactiveclass Counter {
	knownrebecs { 
		Client client1;
		Client client2;
	}
	statevars {
		int count;
	}

	Counter(Client c1, Client c2) {
		count = 0;
		client1 = c1;
		client2 = c2;
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs {
		Counter counter;
	}
	statevars {
		int clientId;
	}

	Client(byte id, Counter c) {
		clientId = id;
		counter = c;
	}

	msgsrv ValueResponse(int value) {
		// empty
	}
}

main {
	Client client1(counter):(1, counter);
	Client client2(counter):(2, counter);
	Counter counter(client1, client2):();

	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}