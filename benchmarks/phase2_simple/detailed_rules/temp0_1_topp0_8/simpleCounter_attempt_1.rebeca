reactiveclass Counter {
	knownrebecs { }

	statevars {
		int count;
	}

	ctor() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs {
		Counter counter;
	}

	statevars {
		int clientId;
	}

	ctor(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// println is not available in core Rebeca; this is a placeholder
		// to represent: println("Client " + clientId + " received value: " + value);
	}
}

main {
	Counter counter();
	Client client1(counter): (1);
	Client client2(counter): (2);

	// Simulate:
	// counter.tell(Increment, client1)
	// counter.tell(Increment, client2)
	// counter.tell(GetValue, client1)
	client1.Increment() to counter;
	client2.Increment() to counter;
	client1.GetValue() to counter;
}