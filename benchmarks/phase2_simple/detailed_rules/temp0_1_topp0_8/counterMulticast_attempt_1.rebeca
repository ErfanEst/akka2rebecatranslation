reactiveclass Counter {
	knownrebecs { }
	statevars {
		int count;
	}

	construct() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		// println("Counter incremented to " + count);
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		// println("Counter decremented to " + count);
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs { Counter counter; }
	statevars {
		int clientId;
	}

	construct(Counter c, int id) {
		counter = c;
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// println("Client " + clientId + " received value: " + value);
	}
}

main {
	Counter counter();
	Client client1(counter, 1);
	Client client2(counter, 2);

	counter.Increment() with (client1);
	counter.Increment() with (client2);
	counter.GetValue() with (client1);
}