reactiveclass Counter {
	knownrebecs { }

	statevars {
		int count;
	}

	constructor() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs { Counter counter; }

	statevars {
		byte clientId;
	}

	constructor(Counter c, byte id) {
		counter = c;
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// println("Client " + clientId + " received value: " + value);
	}
}

main {
	// known rebecs bindings (empty for Counter, one Counter for each Client)
	Counter counter():();
	Client client1(counter):();
	Client client2(counter):();

	// main block
	counter.Increment();
	counter.Increment();
	counter.GetValue();
}