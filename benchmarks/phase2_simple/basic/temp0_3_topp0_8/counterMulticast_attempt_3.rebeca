reactiveclass Counter(client1, client2) {
	knownrebecs {
		Client client1;
		Client client2;
	}

	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		client1.ValueResponse(count);
		client2.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		client1.ValueResponse(count);
		client2.ValueResponse(count);
	}

	msgsrv GetValue() {
		client1.ValueResponse(count);
		client2.ValueResponse(count);
	}
}

reactiveclass Client(counter) {
	knownrebecs {
		Counter counter;
	}

	statevars {
		int clientId;
	}

	Client(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// empty
	}
}

main {
	Counter counter(client1, client2):();
	Client client1(counter):(1);
	Client client2(counter):(2);

	counter.Increment(): (0, 0);
	counter.Increment(): (0, 0);
	counter.GetValue(): (0, 0);
}