reactiveclass Counter {
	knownrebecs {
		Client client1;
		Client client2;
	}

	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		client1.ValueResponse(count);
		client2.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		client1.ValueResponse(count);
		client2.ValueResponse(count);
	}

	msgsrv GetValue() {
		client1.ValueResponse(count);
		client2.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs {
		Counter counter;
	}

	statevars {
		int clientId;
	}

	Client(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// empty
	}
}

main {
	Client client1(counter): (1);
	Client client2(counter): (2);
	Counter counter(client1, client2): ();

	counter.Increment();
	counter.Increment();
	counter.GetValue();
}