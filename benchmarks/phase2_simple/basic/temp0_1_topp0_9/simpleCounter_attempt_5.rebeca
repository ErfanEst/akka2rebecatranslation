reactiveclass Counter {
	knownrebecs {
	}

	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment(Client c) {
		count = count + 1;
		c.ValueResponse(count);
	}

	msgsrv Decrement(Client c) {
		count = count - 1;
		c.ValueResponse(count);
	}

	msgsrv GetValue(Client c) {
		c.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs {
		Counter counter;
	}

	statevars {
		int clientId;
	}

	msgsrv initial(byte id, Counter c) {
		clientId = id;
		counter = c;
	}

	msgsrv ValueResponse(int value) {
		// placeholder for printing
	}
}

main {
	Counter counter():();
	Client client1(counter):(1, counter);
	Client client2(counter):(2, counter);

	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}