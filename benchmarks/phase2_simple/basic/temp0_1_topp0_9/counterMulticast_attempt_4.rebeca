reactiveclass Counter {
	knownrebecs {
	}

	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs {
		Counter counter;
	}

	statevars {
		int clientId;
	}

	msgsrv initial(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// do nothing
	}
}

main {
	Counter counter() : ();
	Client client1(counter) : (1);
	Client client2(counter) : (2);

	client1.counter.Increment(client1);
	client2.counter.Increment(client2);
	client1.counter.GetValue(client1);
}