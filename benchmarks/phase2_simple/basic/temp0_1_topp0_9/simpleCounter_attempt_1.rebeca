reactiveclass Counter {
    knownrebecs { }

    statevars {
        int count;
    }

    msgsrv initial() {
        count = 0;
    }

    msgsrv Increment(client c) {
        count = count + 1;
        c.ValueResponse(count);
    }

    msgsrv Decrement(client c) {
        count = count - 1;
        c.ValueResponse(count);
    }

    msgsrv GetValue(client c) {
        c.ValueResponse(count);
    }
}

reactiveclass Client {
    knownrebecs { Counter counter; }
    
    statevars {
        int clientId;
    }

    msgsrv initial(int id) {
        clientId = id;
    }

    msgsrv ValueResponse(int value) {
        // In standard Rebeca there is no printing; this is a placeholder.
        // println: Client <clientId> received value: <value>
    }
}

main {
    Counter counter();
    Client client1(counter, 1);
    Client client2(counter, 2);

    counter.Increment(client1);
    counter.Increment(client2);
    counter.GetValue(client1);
}