reactiveclass Producer {
	knownrebecs {
		Consumer consumer;
	}

	msgsrv initial() {
		self.Produce(1);
		self.Produce(2);
	}

	msgsrv Produce(int item) {
		print("Producer: sending " + item);
		consumer.Consume(item);
	}
}

reactiveclass Consumer {
	knownrebecs {
	}

	msgsrv initial() {
	}

	msgsrv Consume(int item) {
		print("Consumer: received " + item);
	}
}

main {
	Consumer consumer();
	Producer producer(consumer);
}