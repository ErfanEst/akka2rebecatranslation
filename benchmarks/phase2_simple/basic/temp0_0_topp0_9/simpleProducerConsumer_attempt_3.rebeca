reactiveclass Producer {
	knownrebecs {
		Consumer consumer;
	}

	msgsrv initial() {
		self.Produce("item1");
		self.Produce("item2");
	}

	msgsrv Produce(string item) {
		print("Producer: sending " + item);
		consumer.Consume(item);
	}
}

reactiveclass Consumer {
	knownrebecs {
	}

	msgsrv initial() {
	}

	msgsrv Consume(string item) {
		print("Consumer: received " + item);
	}
}

main {
	Consumer consumer();
	Producer producer(consumer);
}