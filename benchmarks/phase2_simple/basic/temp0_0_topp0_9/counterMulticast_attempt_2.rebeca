reactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs { }

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		ValueResponse(count, sender);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		ValueResponse(count, sender);
	}

	msgsrv GetValue(Client sender) {
		ValueResponse(count, sender);
	}

	msgsrv ValueResponse(int value, Client client) {
		// not used in Counter
	}
}

reactiveclass Client {
	statevars {
		int clientId;
		Counter counter;
	}

	knownrebecs {
		Counter counterRef;
	}

	msgsrv initial(int id, Counter c) {
		clientId = id;
		counter = c;
	}

	msgsrv ValueResponse(int value) {
		// placeholder for logging
	}

	msgsrv sendIncrement() {
		counter.Increment(this);
	}

	msgsrv sendDecrement() {
		counter.Decrement(this);
	}

	msgsrv sendGetValue() {
		counter.GetValue(this);
	}
}

main {
	Counter counter:();
	Client client1(counter):(1, counter);
	Client client2(counter):(2, counter);

	client1.sendIncrement();
	client2.sendIncrement();
	client1.sendGetValue();
}