reactiveclass Counter {
	knownrebecs { }

	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment(rebecaId sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(rebecaId sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(rebecaId sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs { Counter counter; }

	statevars {
		int clientId;
	}

	msgsrv initial(int id, Counter c) {
		clientId = id;
		counter = c;
	}

	msgsrv ValueResponse(int value) {
		println("Client " + clientId + " received value: " + value);
	}
}

main {
	Counter counter():();
	Client client1():(1, counter);
	Client client2():(2, counter);

	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}