reactiveclass Counter {
	knownrebecs { 
		Client client1; 
		Client client2; 
	}

	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		if (sender == client1) {
			client1.ValueResponse(count);
		} else {
			client2.ValueResponse(count);
		}
	}

	msgsrv Decrement() {
		count = count - 1;
		if (sender == client1) {
			client1.ValueResponse(count);
		} else {
			client2.ValueResponse(count);
		}
	}

	msgsrv GetValue() {
		if (sender == client1) {
			client1.ValueResponse(count);
		} else {
			client2.ValueResponse(count);
		}
	}
}

reactiveclass Client {
	knownrebecs { 
		Counter counter; 
	}
	statevars {
		int clientId;
	}

	Client(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// env.out.println("Client " + clientId + " received value: " + value);
	}
}

main {
	Counter counter(counterClient1, counterClient2);
	Client counterClient1(counter): (1);
	Client counterClient2(counter): (2);

	counterClient1.counter.Increment();
	counterClient2.counter.Increment();
	counterClient1.counter.GetValue();
}