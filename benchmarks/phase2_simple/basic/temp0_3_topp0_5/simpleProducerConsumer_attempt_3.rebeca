reactiveclass Producer(Consumer consumer) {
	knownrebecs {
		Consumer consumer;
	}

	msgsrv initial() {
		// No initialization needed
	}

	msgsrv Produce(string item) {
		println("Producer: sending " + item);
		consumer.Consume(item);
	}
}

reactiveclass Consumer() {
	msgsrv initial() {
		// No initialization needed
	}

	msgsrv Consume(string item) {
		println("Consumer: received " + item);
	}
}

main {
	Consumer consumer();
	Producer producer(consumer);

	producer.Produce("item1");
	producer.Produce("item2");
}