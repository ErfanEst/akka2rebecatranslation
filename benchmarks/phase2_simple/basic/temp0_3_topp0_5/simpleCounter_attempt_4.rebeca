reactiveclass Counter {
	knownrebecs { 
		Client client1; 
		Client client2; 
	}

	statevars {
		int count;
	}

	Counter(Client c1, Client c2) {
		client1 = c1;
		client2 = c2;
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		if (sender == client1) {
			client1.ValueResponse(count);
		} else {
			client2.ValueResponse(count);
		}
	}

	msgsrv Decrement() {
		count = count - 1;
		if (sender == client1) {
			client1.ValueResponse(count);
		} else {
			client2.ValueResponse(count);
		}
	}

	msgsrv GetValue() {
		if (sender == client1) {
			client1.ValueResponse(count);
		} else {
			client2.ValueResponse(count);
		}
	}
}

reactiveclass Client {
	knownrebecs { 
		Counter counter; 
	}
	statevars {
		int clientId;
	}

	Client(Counter c, int id) {
		counter = c;
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// env.out.println("Client " + clientId + " received value: " + value);
	}
}

main {
	Counter counter(counterClient1, counterClient2):();
	Client counterClient1(counter, 1):();
	Client counterClient2(counter, 2):();

	counter.Increment();
	counter.Increment();
	counter.GetValue();
}