reactiveclass Counter {
	knownrebecs { }

	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv initial() {
		// no-op
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs { Counter counter; }

	statevars {
		int clientId;
	}

	Client(int id, Counter c) {
		clientId = id;
		counter = c;
	}

	msgsrv initial() {
		// no-op
	}

	msgsrv ValueResponse(int value) {
		println("Client " + clientId + " received value: " + value);
	}
}

main {
	Counter counter():();
	Client client1(counter):(1, counter);
	Client client2(counter):(2, counter);

	counter.Increment() after(1, 1);
	counter.Increment() after(2, 2);
	counter.GetValue() after(3, 3);
}