reactiveclass Counter {
    knownrebecs { }

    statevars {
        int count;
    }

    Counter() {
        count = 0;
    }

    msgsrv initial() {
        // no-op
    }

    msgsrv Increment() {
        count = count + 1;
        sender.ValueResponse(count);
    }

    msgsrv Decrement() {
        count = count - 1;
        sender.ValueResponse(count);
    }

    msgsrv GetValue() {
        sender.ValueResponse(count);
    }
}

reactiveclass Client {
    knownrebecs { Counter counter; }

    statevars {
        int clientId;
    }

    Client(int id) {
        clientId = id;
    }

    msgsrv initial() {
        // no-op
    }

    msgsrv ValueResponse(int value) {
        // In Rebeca we cannot print with string interpolation like Scala;
        // we use println with concatenation.
        println("Client " + clientId + " received value: " + value);
    }
}

main {
    Counter counter();
    Client client1(counter, 1);
    Client client2(counter, 2);

    // Simulating:
    // counter.tell(Increment, client1)
    // counter.tell(Increment, client2)
    // counter.tell(GetValue, client1)

    counter.Increment() after(1, 1) sender(client1);
    counter.Increment() after(2, 2) sender(client2);
    counter.GetValue() after(3, 3) sender(client1);
}