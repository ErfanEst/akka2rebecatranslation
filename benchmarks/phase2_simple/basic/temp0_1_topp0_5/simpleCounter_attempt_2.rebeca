reactiveclass Counter {
	knownrebecs { }

	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv initial() {
		// no-op
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs { Counter counter; }

	statevars {
		int clientId;
	}

	Client(int id) {
		clientId = id;
	}

	msgsrv initial() {
		// no-op
	}

	msgsrv ValueResponse(int value) {
		println("Client " + clientId + " received value: " + value);
	}
}

main {
	Counter counter();
	Client client1(counter): (1);
	Client client2(counter): (2);

	client1.Increment() to counter after(1, 1);
	client2.Increment() to counter after(2, 2);
	client1.GetValue() to counter after(3, 3);
}