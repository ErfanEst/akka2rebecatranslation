reactiveclass Counter (client c1, client c2) {
	knownrebecs { 
		client c1;
		client c2;
	}

	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv Increment(client c) {
		count = count + 1;
		c.ValueResponse(count);
	}

	msgsrv Decrement(client c) {
		count = count - 1;
		c.ValueResponse(count);
	}

	msgsrv GetValue(client c) {
		c.ValueResponse(count);
	}
}

reactiveclass client {
	knownrebecs { }

	statevars {
		int clientId;
	}

	client(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// empty
	}
}

reactiveclass Env (Counter counter, client client1, client client2) {
	knownrebecs {
		Counter counter;
		client client1;
		client client2;
	}

	statevars { }

	Env() {
		// send initial messages if needed
		// e.g., counter.Increment(client1);
		//       counter.GetValue(client2);
	}
}

main {
	client client1(1):();
	client client2(2):();
	Counter counter(client1, client2):();
	Env env(counter, client1, client2):();
}