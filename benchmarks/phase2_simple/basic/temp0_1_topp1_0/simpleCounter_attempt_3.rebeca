reactiveclass Counter {
	knownrebecs(Counter) {
		Client client1;
		Client client2;
	}

	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		if (sender == client1) {
			client1.ValueResponse(count);
		} else {
			client2.ValueResponse(count);
		}
	}

	msgsrv Decrement() {
		count = count - 1;
		if (sender == client1) {
			client1.ValueResponse(count);
		} else {
			client2.ValueResponse(count);
		}
	}

	msgsrv GetValue() {
		if (sender == client1) {
			client1.ValueResponse(count);
		} else {
			client2.ValueResponse(count);
		}
	}
}

reactiveclass Client {
	knownrebecs(Client) {
		Counter counterRef;
	}

	statevars {
		int clientId;
		boolean isFirstClient;
	}

	msgsrv initial(int id, boolean isFirst) {
		clientId = id;
		isFirstClient = isFirst;

		if (isFirstClient) {
			counterRef.Increment();
			counterRef.GetValue();
		} else {
			counterRef.Increment();
		}
	}

	msgsrv ValueResponse(int value) {
		// placeholder for printing functionality
	}
}

main {
	Counter counter(counter_client1, counter_client2):();
	Client counter_client1(counter):(1, true);
	Client counter_client2(counter):(2, false);
}