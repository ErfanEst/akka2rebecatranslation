reactiveclass Counter (Client client1, Client client2) {
	knownrebecs {
		Client client1;
		Client client2;
	}

	statevars {
		int count;
	}

	Counter(Client c1, Client c2) {
		client1 = c1;
		client2 = c2;
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client (Counter counter, int cId) {
	knownrebecs {
		Counter counter;
	}

	statevars {
		int clientId;
	}

	Client(Counter c, int cId) {
		counter = c;
		clientId = cId;
	}

	msgsrv ValueResponse(int value) {
		// empty
	}

	msgsrv initial() {
		counter.Increment();
		counter.Increment();
		counter.GetValue();
	}
}

main {
	Client client1(counter, 1);
	Client client2(counter, 2);
	Counter counter(client1, client2);
}