reactiveclass Counter {
	knownrebecs {
	}

	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs {
		Counter counter;
	}

	statevars {
		int clientId;
	}

	Client(Counter c, int cId) {
		counter = c;
		clientId = cId;
	}

	msgsrv ValueResponse(int value) {
		// empty
	}
}

main {
	Counter counter:();
	Client client1:(counter, 1);
	Client client2:(counter, 2);

	counter.Increment();
	counter.Increment();
	counter.GetValue();
}