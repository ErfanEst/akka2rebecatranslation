reactiveclass Counter {
    knownrebecs {
    }

    statevars {
        int count;
    }

    Counter() {
        count = 0;
    }

    msgsrv Increment() {
        count = count + 1;
        sender.ValueResponse(count);
    }

    msgsrv Decrement() {
        count = count - 1;
        sender.ValueResponse(count);
    }

    msgsrv GetValue() {
        sender.ValueResponse(count);
    }
}

reactiveclass Client {
    knownrebecs {
        Counter counter;
        Environment env;
    }

    statevars {
        int clientId;
    }

    Client(int id) {
        clientId = id;
    }

    msgsrv ValueResponse(int value) {
        env.printClientValue(clientId, value);
    }
}

reactiveclass Environment {
    knownrebecs {
        Counter counter;
        Client client1;
        Client client2;
    }

    Environment() {
        counter.Increment() with (client1);
        counter.Increment() with (client2);
        counter.GetValue() with (client1);
    }

    msgsrv printClientValue(int clientId, int value) {
        // In standard Rebeca there is no direct println, but this msgsrv
        // represents the printing side-effect: "Client clientId received value: value"
    }
}

main {
    Counter counter();
    Environment env(counter, client1, client2);
    Client client1(counter, env): (1);
    Client client2(counter, env): (2);
}