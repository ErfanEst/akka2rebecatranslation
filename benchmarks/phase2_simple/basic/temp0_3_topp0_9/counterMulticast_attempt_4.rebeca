reactiveclass Counter {
	knownrebecs { }

	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		client.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		client.ValueResponse(count);
	}

	msgsrv GetValue() {
		client.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs {
		Counter counter;
	}

	statevars {
		byte clientId;
	}

	Client(Counter c, byte id) {
		counter = c;
		clientId = id;
		counter.Increment();
		counter.Increment();
		counter.GetValue();
	}

	msgsrv ValueResponse(int value) {
		// handle value
	}
}

main {
	Counter counter():();
	Client client1(counter,1):();
	Client client2(counter,2):();
}