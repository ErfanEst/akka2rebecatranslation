reactiveclass Counter {
	knownrebecs {
	}

	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment(Client sender) {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement(Client sender) {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue(Client sender) {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs {
		Counter counter;
	}

	statevars {
		int clientId;
	}

	msgsrv initial(int id, Counter c) {
		clientId = id;
		counter = c;
	}

	msgsrv ValueResponse(int value) {
		// printing is tool-dependent
	}
}

main {
	Counter counter():();
	Client client1():(1, counter);
	Client client2():(2, counter);

	client1.ValueResponse(0);

	counter.Increment(client1);
	counter.Increment(client2);
	counter.GetValue(client1);
}