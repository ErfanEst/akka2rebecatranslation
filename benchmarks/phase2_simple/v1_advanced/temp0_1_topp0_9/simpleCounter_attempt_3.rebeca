reactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs { }

	construct() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
	}

	knownrebecs {
		Counter counter;
	}

	construct(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// no-op
	}
}

main {
	Counter counter();
	Client client1(counter): (1);
	Client client2(counter): (2);

	initial {
		counter.Increment() sender client1;
		counter.Increment() sender client2;
		counter.GetValue() sender client1;
	}
}