reactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs {
	}

	Counter() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int lastValue;
		int clientId;
	}

	knownrebecs {
		Counter counter;
	}

	Client(Counter c, int id) {
		counter = c;
		lastValue = 0;
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		lastValue = value;
	}
}

main {
	Counter counter();
	Client client1(counter, 1);
	Client client2(counter, 2);

	counter.Increment() sender client1;
	counter.Increment() sender client2;
	counter.GetValue() sender client1;
}