timedreactiveclass Counter {
	statevars {
		int count;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}

	knownrebecs { }

	construct() {
		count = 0;
	}
}

timedreactiveclass Client {
	statevars {
		int clientId;
		Counter counter;
	}

	msgsrv ValueResponse(int value) {
		// no-op, original code only printed
	}

	knownrebecs {
		Counter counter;
	}

	construct(int id) {
		clientId = id;
	}
}

main {
	Counter counter:();
	Client client1:(1);
	Client client2:(2);

	knownrebecs {
		counter:();
		client1:(counter);
		client2:(counter);
	}

	initial {
		counter.Increment() sender client1;
		counter.Increment() sender client2;
		counter.GetValue() sender client1;
	}
}