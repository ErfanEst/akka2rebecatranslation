timedreactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs { }

	construct() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

timedreactiveclass Client {
	statevars {
		int clientId;
		Counter counter;
	}

	knownrebecs {
		Counter counter;
	}

	construct(byte id, Counter c) {
		clientId = id;
		counter = c;
	}

	msgsrv ValueResponse(int value) {
		// no-op
	}
}

main {
	Counter counter1();
	Client client1(counter1): (1, counter1);
	Client client2(counter1): (2, counter1);

	initial {
		counter1.Increment() after(0);
		counter1.Increment() after(0);
		counter1.GetValue() after(0);
	}
}