reactiveclass Counter() {
	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client(Counter counter, int clientId) {
	statevars {
		int lastValue;
	}

	Client() {
		lastValue = 0;
	}

	msgsrv ValueResponse(int value) {
		lastValue = value;
	}
}

main {
	Counter counter();
	Client client1(counter, 1);
	Client client2(counter, 2);

	counter.Increment() sender client1;
	counter.Increment() sender client2;
	counter.GetValue() sender client1;
}