env int now;

timedreactiveclass Counter {
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

timedreactiveclass Client {
	statevars {
		int clientId;
	}

	knownrebecs {
		Counter c;
	}

	msgsrv initial(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// no-op
	}
}

main {
	Counter counter1() : ();
	Client client1(counter1) : (1);
	Client client2(counter1) : (2);

	client1.c.Increment() after(1);
	client2.c.Increment() after(2);
	client1.c.GetValue() after(3);
}