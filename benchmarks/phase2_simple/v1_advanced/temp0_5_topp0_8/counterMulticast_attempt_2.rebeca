timedreactiveclass Counter {
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

timedreactiveclass Client {
	statevars {
		Counter counter;
		int clientId;
	}

	msgsrv initial(Counter c, int id) {
		counter = c;
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// no-op
	}
}

main {
	Counter counter1() : ();
	Client client1(counter1, 1) : ();
	Client client2(counter1, 2) : ();

	counter1.Increment() after(1) sender(client1);
	counter1.Increment() after(2) sender(client2);
	counter1.GetValue() after(3) sender(client1);
}