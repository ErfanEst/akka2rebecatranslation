timedreactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs {
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

timedreactiveclass Client {
	statevars {
		int clientId;
	}

	knownrebecs {
		Counter counter;
	}

	msgsrv initial() {
		clientId = 0;
	}

	msgsrv ValueResponse(int value) {
		// no I/O
	}
}

main {
	Counter counter(counter):();
	Client client1(counter):(counter);
	Client client2(counter):(counter);

	counter.Increment();
	counter.Increment();
	counter.GetValue();
}