reactiveclass Counter {
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		client_ValueResponse(sender, count);
	}

	msgsrv Decrement() {
		count = count - 1;
		client_ValueResponse(sender, count);
	}

	msgsrv GetValue() {
		client_ValueResponse(sender, count);
	}

	msgsrv client_ValueResponse(Client c, int value) {
		c.ValueResponse(value);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
		Counter counter;
	}

	msgsrv initial(int id, Counter c) {
		clientId = id;
		counter = c;
	}

	msgsrv ValueResponse(int value) {
		// no I/O in Rebeca model
	}
}

main {
	Counter counter():();
	Client client1(counter):(1, counter);
	Client client2(counter):(2, counter);

	counter.Increment() sender client1;
	counter.Increment() sender client2;
	counter.GetValue() sender client1;
}

}