reactiveclass Counter() {
	knownrebecs { }

	int count;

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client(Counter counter) {
	knownrebecs { Counter counter; }

	int clientId;
	int lastValue;

	msgsrv initial(int id) {
		clientId = id;
		lastValue = 0;
	}

	msgsrv ValueResponse(int value) {
		lastValue = value;
	}
}

main {
	Counter counter():();
	Client client1(counter):(1);
	Client client2(counter):(2);

	counter.Increment() after(0, 0, 0) sender client1;
	counter.Increment() after(0, 0, 0) sender client2;
	counter.GetValue() after(0, 0, 0) sender client1;
}