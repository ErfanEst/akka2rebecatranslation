timedreactiveclass Counter {
    knownrebecs { }

    int count;

    msgsrv initial() {
        count = 0;
    }

    msgsrv Increment() {
        count = count + 1;
        sender.ValueResponse(count);
    }

    msgsrv Decrement() {
        count = count - 1;
        sender.ValueResponse(count);
    }

    msgsrv GetValue() {
        sender.ValueResponse(count);
    }
}

timedreactiveclass Client {
    knownrebecs { Counter counter; }
    int clientId;
    int lastValue;

    msgsrv initial(int id) {
        clientId = id;
        lastValue = 0;
    }

    msgsrv ValueResponse(int value) {
        lastValue = value;
    }
}

main {
    Counter counter:();
    Client client1:(counter, 1);
    Client client2:(counter, 2);

    counter.Increment() sender client1;
    counter.Increment() sender client2;
    counter.GetValue() sender client1;
}