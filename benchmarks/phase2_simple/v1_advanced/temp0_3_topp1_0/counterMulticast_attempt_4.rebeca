reactiveclass Counter() {
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}

	msgsrv ValueResponse(int value) {
		// no-op for this rebec
	}
}

reactiveclass Client(Counter counter) {
	statevars {
		byte clientId;
	}

	msgsrv initial(byte id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// no-op
	}
}

main {
	Counter counter() : ();
	Client client1(counter) : (1);
	Client client2(counter) : (2);

	counter.Increment();
	counter.Increment();
	counter.GetValue();
}