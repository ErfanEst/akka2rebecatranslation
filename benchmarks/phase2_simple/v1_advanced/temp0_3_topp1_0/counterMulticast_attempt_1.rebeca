reactiveclass Counter {
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender!ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender!ValueResponse(count);
	}

	msgsrv GetValue() {
		sender!ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		Counter counter;
		int clientId;
	}

	msgsrv initial(int id, Counter c) {
		clientId = id;
		counter = c;
	}

	msgsrv ValueResponse(int value) {
		// no-op
	}
}

main {
	Counter counter();
	Client client1(1, counter);
	Client client2(2, counter);

	counter.Increment() after(0) deadline(0) with(client1);
	counter.Increment() after(0) deadline(0) with(client2);
	counter.GetValue() after(0) deadline(0) with(client1);
}

}