reactiveclass Ping {
	knownrebecs {
		Pong pong;
	}

	statevars {
		int count;
	}

	Ping() {
		count = 0;
	}

	msgsrv StartMessage() {
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		if (count >= 10) {
			sender.StopMessage();
			selfDone();
		} else {
			sender.PingMessage();
		}
	}

	msgsrv selfDone() {
		// no further behavior; modeled as quiescent
	}
}

reactiveclass Pong {
	Pong() {
	}

	msgsrv PingMessage() {
		sender.PongMessage();
	}

	msgsrv StopMessage() {
		selfDone();
	}

	msgsrv selfDone() {
		// no further behavior; modeled as quiescent
	}
}

main {
	Pong pong():();
	Ping ping(pong):();

	ping.StartMessage();
}