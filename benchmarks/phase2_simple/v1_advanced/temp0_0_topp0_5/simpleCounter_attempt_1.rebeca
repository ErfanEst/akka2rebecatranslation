timedreactiveclass Counter {
	statevars {
		int count;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}

	knownrebecs { }

	Counter() {
		count = 0;
	}
}

timedreactiveclass Client {
	statevars {
		int clientId;
	}

	knownrebecs {
		Counter counter;
	}

	msgsrv ValueResponse(int value) {
		// no I/O in Rebeca model
	}

	Client(int id) {
		clientId = id;
	}
}

main {
	Counter counter();
	Client client1(counter, 1);
	Client client2(counter, 2);

	// simulate the initial tells with explicit sender
	counter.Increment() after (0) sender client1;
	counter.Increment() after (0) sender client2;
	counter.GetValue() after (0) sender client1;
}