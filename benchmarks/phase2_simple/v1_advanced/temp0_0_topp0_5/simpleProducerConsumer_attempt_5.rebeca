reactiveclass Producer {
	knownrebecs {
		Consumer consumer;
	}
	statevars {
		int dummy;
	}

	msgsrv initial(Consumer c) {
		consumer = c;
	}

	msgsrv Produce(int item) {
		consumer.Consume(item);
	}
}

reactiveclass Consumer {
	knownrebecs {
	}
	statevars {
		int dummy;
	}

	msgsrv initial() {
		// no automatic behavior
	}

	msgsrv Consume(int item) {
		// no behavior (I/O removed)
	}
}

main {
	Consumer consumer() : ();
	Producer producer(consumer) : (consumer);

	producer.Produce(1);
	producer.Produce(2);
}