reactiveclass Counter {
	knownrebecs { }
	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
	}

	msgsrv Decrement() {
		count = count - 1;
	}

	msgsrv GetValue() {
		// No direct client response; clients handle their own logic
	}
}

reactiveclass Client {
	knownrebecs { Counter counter; }
	statevars {
		int clientId;
	}

	Client() {
		clientId = 0;
	}

	msgsrv initial(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		int tmp;
		tmp = value + clientId;
	}
}

main {
	Counter counter:();
	Client client1:(counter);
	Client client2:(counter);

	client1.initial(1);
	client2.initial(2);

	counter.Increment();
	counter.Increment();
	counter.GetValue();
}