reactiveclass Counter {
	statevars {
		int count;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}

	knownrebecs { }

	Counter() {
		count = 0;
	}
}

reactiveclass Client {
	statevars {
		int clientId;
		Counter counter;
	}

	knownrebecs {
		Counter counter;
	}

	msgsrv ValueResponse(int value) {
		// no I/O in Rebeca model
	}

	Client(int id, Counter c) {
		clientId = id;
		counter = c;
	}
}

main {
	Counter counter();
	Client client1(counter, 1, counter);
	Client client2(counter, 2, counter);

	counter.Increment() sender client1;
	counter.Increment() sender client2;
	counter.GetValue() sender client1;
}