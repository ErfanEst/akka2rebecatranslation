reactiveclass Counter {
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		Counter counter;
		int clientId;
	}

	msgsrv initial(Counter c, int id) {
		counter = c;
		clientId = id;
		counter.Increment();
		counter.Increment();
		counter.GetValue();
	}

	msgsrv ValueResponse(int value) {
		// no-op
	}
}

main {
	Counter counter(1):();
	Client client1(1):(counter, 1);
	Client client2(1):(counter, 2);
}