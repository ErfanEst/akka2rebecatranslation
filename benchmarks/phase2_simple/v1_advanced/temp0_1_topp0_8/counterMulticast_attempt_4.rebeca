timedreactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs {
	}

	Counter() {
		count = 0;
	}

	msgsrv initial() {
		// no initial behavior
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

timedreactiveclass Client {
	statevars {
		int clientId;
	}

	knownrebecs {
		Counter counter;
	}

	Client(Counter c, int id) {
		counter = c;
		clientId = id;
	}

	msgsrv initial() {
		// no initial behavior
	}

	msgsrv ValueResponse(int value) {
		// no output
	}
}

main {
	Counter counter():();
	Client client1(counter):(counter, 1);
	Client client2(counter):(counter, 2);

	client1.Increment() after(0) deadline(0);
	client2.Increment() after(0) deadline(0);
	client1.GetValue() after(0) deadline(0);
}