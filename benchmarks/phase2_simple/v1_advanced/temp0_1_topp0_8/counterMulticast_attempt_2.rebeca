reactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs {
	}

	Counter() {
		count = 0;
	}

	msgsrv initial() {
		// no initial behavior
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
	}

	knownrebecs {
		Counter counter;
	}

	Client(int id) {
		clientId = id;
	}

	msgsrv initial() {
		// no initial behavior
	}

	msgsrv ValueResponse(int value) {
		// no output
	}
}

main {
	Counter counter();
	Client client1(counter): (1);
	Client client2(counter): (2);

	client1.Increment() to counter;
	client2.Increment() to counter;
	client1.GetValue() to counter;
}