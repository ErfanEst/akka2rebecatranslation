reactiveclass Counter {
	knownrebecs {
		Client client1;
		Client client2;
	}
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
		client1.Increment();
		client2.Increment();
		client1.GetValue();
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs {
		Counter counter;
	}
	statevars {
		int clientId;
	}

	msgsrv initial(int id) {
		clientId = id;
	}

	msgsrv Increment() {
		counter.Increment();
	}

	msgsrv GetValue() {
		counter.GetValue();
	}

	msgsrv ValueResponse(int value) {
		// no I/O
	}
}

main {
	Client client1(counter):(1);
	Client client2(counter):(2);
	Counter counter(client1, client2):();
}