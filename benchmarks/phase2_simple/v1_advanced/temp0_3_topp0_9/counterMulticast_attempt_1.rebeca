timedreactiveclass Counter() {
	statevars {
		int count;
	}

	knownrebecs { }

	Counter() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

timedreactiveclass Client(Counter counter, int clientId) {
	statevars {
	}

	knownrebecs { Counter counter; }

	Client(Counter c, int id) {
		counter = c;
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// no I/O
	}
}

timedreactiveclass Starter() {
	knownrebecs {
		Counter counter;
		Client client1;
		Client client2;
	}

	Starter() {
		counter.Increment() after(0);
		counter.Increment() after(0);
		counter.GetValue() after(0);
	}

	msgsrv initial() {
		// not used
	}
}

main {
	Counter counter();
	Client client1(counter, 1);
	Client client2(counter, 2);
	Starter starter(counter, client1, client2);
}