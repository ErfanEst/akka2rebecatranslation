import java.lang.String;

	reactiveclass Producer {
		knownrebecs { Consumer consumer; }
		statevars {
			String item;
		}

		msgsrv initial() {
			// no automatic behavior on start
		}

		msgsrv Produce(String it) {
			item = it;
			consumer.Consume(item);
		}
	}

	reactiveclass Consumer {
		knownrebecs { }
		statevars {
			String item;
		}

		msgsrv initial() {
			// no automatic behavior on start
		}

		msgsrv Consume(String it) {
			item = it;
			// no I/O in Rebeca model
		}
	}

	main {
		Consumer consumer();
		Producer producer(consumer);

		producer.Produce("item1");
		producer.Produce("item2");
	}
}