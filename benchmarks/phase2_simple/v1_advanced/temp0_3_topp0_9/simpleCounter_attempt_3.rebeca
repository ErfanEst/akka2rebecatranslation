timedreactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs {
	}

	Counter() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

timedreactiveclass Client {
	statevars {
		int clientId;
	}

	knownrebecs {
		Counter counter;
	}

	Client(Counter c, int id) {
		counter = c;
		clientId = id;
		counter.Increment() after(0);
		counter.Increment() after(0);
		counter.GetValue() after(0);
	}

	msgsrv ValueResponse(int value) {
		skip;
	}
}

main {
	Counter counter():();
	Client client1(counter):(counter, 1);
	Client client2(counter):(counter, 2);
}