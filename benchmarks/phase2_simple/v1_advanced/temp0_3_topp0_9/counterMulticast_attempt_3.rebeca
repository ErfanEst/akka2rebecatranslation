reactiveclass Counter() {
	statevars {
		int count;
	}

	knownrebecs { }

	Counter() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
	}

	knownrebecs { 
		Counter counter; 
	}

	Client() {
		clientId = 0;
	}

	msgsrv ValueResponse(int value) {
		// no I/O
	}
}

reactiveclass Starter {
	knownrebecs {
		Counter counter;
		Client client1;
		Client client2;
	}

	Starter() {
		self.initial();
	}

	msgsrv initial() {
		counter.Increment();
		counter.Increment();
		counter.GetValue();
	}
}

main {
	Counter counter();
	Client client1(counter);
	Client client2(counter);
	Starter starter(counter, client1, client2);
}