reactiveclass Counter {
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		Counter counter;
		int clientId;
	}

	msgsrv initial(Counter c, int id) {
		counter = c;
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// no-op (originally printed the value)
	}
}

main {
	Counter counter():();
	Client client1(counter, 1):(counter);
	Client client2(counter, 2):(counter);

	counter.Increment() after(0);
	counter.Increment() after(0);
	counter.GetValue() after(0);
}

}