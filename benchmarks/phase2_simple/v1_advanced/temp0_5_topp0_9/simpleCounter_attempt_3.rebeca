reactiveclass Counter {
	knownrebecs { }

	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs { 
		Counter counter;
	}

	statevars {
		int clientId;
	}

	Client(Counter c, int id) {
		counter = c;
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// no I/O in Rebeca model
	}
}

main {
	Counter counter():();
	Client client1(counter):(1);
	Client client2(counter):(2);

	counter.Increment() after(0) sender(client1);
	counter.Increment() after(0) sender(client2);
	counter.GetValue() after(0) sender(client1);
}