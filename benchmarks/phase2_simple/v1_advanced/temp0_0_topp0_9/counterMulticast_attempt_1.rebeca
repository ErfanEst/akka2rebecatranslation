timedreactiveclass Counter() {
	statevars {
		int count;
	}

	knownrebecs {
	}

	Counter() {
		count = 0;
	}

	msgsrv initial() {
	}

	msgsrv Increment() {
		count = count + 1;
		// sender() ! ValueResponse(count);
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		// sender() ! ValueResponse(count);
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		// sender() ! ValueResponse(count);
		sender.ValueResponse(count);
	}
}

timedreactiveclass Client(Counter counter, int clientId) {
	statevars {
	}

	knownrebecs {
		Counter counter;
	}

	Client(Counter c, int id) {
		counter = c;
		clientId = id;
	}

	msgsrv initial() {
	}

	msgsrv ValueResponse(int value) {
		// println removed
	}
}

main {
	Counter counter();
	Client client1(counter, 1);
	Client client2(counter, 2);

	// Simulate the initial message sends in Akka's main
	counter.Increment() sender client1;
	counter.Increment() sender client2;
	counter.GetValue() sender client1;
}