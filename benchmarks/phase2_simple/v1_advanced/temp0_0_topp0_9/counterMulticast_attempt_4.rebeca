reactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs {
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
	}

	knownrebecs {
		Counter counter;
	}

	msgsrv initial(Counter c, int id) {
		counter = c;
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
	}
}

main {
	Counter counter():();
	Client client1(counter):(counter.Increment());
	Client client2(counter):(counter.Increment(), counter.GetValue());
}