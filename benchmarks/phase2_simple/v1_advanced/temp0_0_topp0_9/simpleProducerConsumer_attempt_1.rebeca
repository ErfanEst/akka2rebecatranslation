reactiveclass Producer {
		knownrebecs {
			Consumer consumer;
		}

		statevars {
			int tmpItem;
		}

		Producer() {
			// no initial behavior
		}

		msgsrv Produce(int item) {
			tmpItem = item;
			consumer.Consume(tmpItem);
		}
	}

	reactiveclass Consumer {
		knownrebecs {
		}

		statevars {
			int lastItem;
		}

		Consumer() {
			// no initial behavior
		}

		msgsrv Consume(int item) {
			lastItem = item;
		}
	}

	main {
		Consumer consumer();
		Producer producer(consumer);

		producer.Produce(1);
		producer.Produce(2);
	}
}