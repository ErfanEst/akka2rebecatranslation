reactiveclass Ping {
		knownrebecs {
			Pong pong;
		}
		statevars {
			int count;
		}

		Ping() {
			count = 0;
		}

		msgsrv initial() {
			self.startMessage();
		}

		msgsrv startMessage() {
			pong.pingMessage();
		}

		msgsrv pongMessage() {
			count = count + 1;
			if (count >= 10) {
				sender.stopMessage();
			} else {
				sender.pingMessage();
			}
		}
	}

	reactiveclass Pong {
		knownrebecs {
		}
		statevars {
		}

		Pong() {
		}

		msgsrv initial() {
		}

		msgsrv pingMessage() {
			sender.pongMessage();
		}

		msgsrv stopMessage() {
		}
	}

	main {
		Pong pong(1):();
		Ping ping(1):(pong);
	}
}