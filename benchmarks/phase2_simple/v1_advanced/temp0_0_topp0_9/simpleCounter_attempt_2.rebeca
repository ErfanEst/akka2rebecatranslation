timedreactiveclass Counter {
	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

timedreactiveclass Client {
	statevars {
		int clientId;
		Counter counter;
	}

	msgsrv initial(int id, Counter c) {
		clientId = id;
		counter = c;
	}

	msgsrv ValueResponse(int value) {
		// No I/O in Rebeca
	}
}

main {
	Counter counter():();
	Client client1(counter):(1, counter);
	Client client2(counter):(2, counter);

	counter.Increment() after(0);
	counter.Increment() after(0);
	counter.GetValue() after(0);
}