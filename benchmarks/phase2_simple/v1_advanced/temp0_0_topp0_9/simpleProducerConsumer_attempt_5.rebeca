reactiveclass Producer(Consumer c) {
	knownrebecs {
		Consumer consumer;
	}

	statevars {
		int tmpItem;
	}

	Producer() {
		consumer = c;
	}

	msgsrv Produce(int item) {
		tmpItem = item;
		consumer.Consume(tmpItem);
	}
}

reactiveclass Consumer() {
	knownrebecs {
	}

	statevars {
		int lastItem;
	}

	Consumer() {
		lastItem = 0;
	}

	msgsrv Consume(int item) {
		lastItem = item;
	}
}

main {
	Consumer consumer() : ();
	Producer producer(consumer) : (consumer);

	producer.Produce(1);
	producer.Produce(2);
}