timedreactiveclass Counter {
	statevars {
		int count;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}

	knownrebecs { }

	Counter() {
		count = 0;
	}
}

timedreactiveclass Client {
	statevars {
		int clientId;
		Counter counter;
	}

	msgsrv ValueResponse(int value) {
		// no I/O in Rebeca model
	}

	knownrebecs {
		Counter counter;
	}

	Client(int id) {
		clientId = id;
	}
}

main {
	Counter counter();
	Client client1(counter): (1);
	Client client2(counter): (2);

	// simulate explicit senders by direct calls
	client1.Increment() to counter;
	client2.Increment() to counter;
	client1.GetValue() to counter;
}