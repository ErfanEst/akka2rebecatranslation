reactiveclass Counter(client1, client2) {
	knownrebecs {
		Client client1;
		Client client2;
	}

	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		client1.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		client1.ValueResponse(count);
	}

	msgsrv GetValue() {
		client1.ValueResponse(count);
	}
}

reactiveclass Client(counter) {
	knownrebecs {
		Counter counter;
	}

	statevars {
		int clientId;
	}

	Client() {
		clientId = 0;
	}

	msgsrv ValueResponse(int value) {
		// no I/O in Rebeca model
	}

	msgsrv Init(int id) {
		clientId = id;
	}
}

main {
	Client client1(counter):();
	Client client2(counter):();
	Counter counter(client1, client2):();

	client1.Init(1):();
	client2.Init(2):();

	counter.Increment():();
	counter.Increment():();
	counter.GetValue():();
}