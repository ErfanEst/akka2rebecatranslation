reactiveclass Counter {
	statevars {
		int count;
		Client client1;
		Client client2;
	}

	msgsrv Increment() {
		count = count + 1;
		client1.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		client1.ValueResponse(count);
	}

	msgsrv GetValue() {
		client1.ValueResponse(count);
	}

	knownrebecs {
		Client client1;
		Client client2;
	}

	Counter() {
		count = 0;
	}
}

reactiveclass Client {
	statevars {
		int clientId;
		Counter counter;
	}

	msgsrv ValueResponse(int value) {
		// no I/O in Rebeca model
	}

	knownrebecs {
		Counter counter;
	}

	Client(int id) {
		clientId = id;
	}
}

main {
	Counter counter(client1, client2);
	Client client1(counter): (1);
	Client client2(counter): (2);

	client1.Increment();
	client2.Increment();
	client1.GetValue();
}