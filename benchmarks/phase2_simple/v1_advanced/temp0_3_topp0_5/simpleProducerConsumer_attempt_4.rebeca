reactiveclass Producer(Consumer consumer) {
	statevars {
		int dummy;
	}

	msgsrv initial() {
		self.produce();
		self.produce();
	}

	msgsrv produce() {
		consumer.consume();
	}
}

reactiveclass Consumer() {
	statevars {
		int dummy;
	}

	msgsrv initial() {
	}

	msgsrv consume() {
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();
}