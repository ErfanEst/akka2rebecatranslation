reactiveclass Counter {
		statevars {
			int count;
		}

		msgsrv initial() {
			count = 0;
		}

		msgsrv Increment() {
			count = count + 1;
			sender.ValueResponse(count);
		}

		msgsrv Decrement() {
			count = count - 1;
			sender.ValueResponse(count);
		}

		msgsrv GetValue() {
			sender.ValueResponse(count);
		}
	}

	reactiveclass Client {
		statevars {
			int clientId;
			Counter counter;
		}

		msgsrv initial(int id, Counter c) {
			clientId = id;
			counter = c;
		}

		msgsrv ValueResponse(int value) {
			// no I/O in Rebeca model
		}
	}

	main {
		Counter counter();
		Client client1(1, counter);
		Client client2(2, counter);

		counter.Increment() after(0) sender(client1);
		counter.Increment() after(0) sender(client2);
		counter.GetValue() after(0) sender(client1);
	}
}