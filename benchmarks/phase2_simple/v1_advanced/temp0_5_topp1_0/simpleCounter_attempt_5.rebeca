reactiveclass Counter(c1, c2) {
	knownrebecs {
		Client c1;
		Client c2;
	}

	statevars {
		int count;
		Client client1;
		Client client2;
	}

	Counter() {
		count = 0;
		client1 = c1;
		client2 = c2;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client(c) {
	knownrebecs {
		Counter c;
	}

	statevars {
		int clientId;
		Counter counter;
	}

	Client() {
		clientId = 0;
		counter = c;
	}

	msgsrv setId(int id) {
		clientId = id;
	}

	msgsrv IncrementCall() {
		counter.Increment();
	}

	msgsrv GetValueCall() {
		counter.GetValue();
	}

	msgsrv ValueResponse(int value) {
	}
}

main {
	Client client1(counter);
	Client client2(counter);
	Counter counter(client1, client2);

	client1.setId(1);
	client2.setId(2);

	client1.IncrementCall();
	client2.IncrementCall();
	client1.GetValueCall();
}