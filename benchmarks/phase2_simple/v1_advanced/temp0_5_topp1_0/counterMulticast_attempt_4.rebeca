reactiveclass Counter {
		knownrebecs {
		}

		statevars {
			int count;
		}

		msgsrv initial() {
			count = 0;
		}

		msgsrv Increment() {
			count = count + 1;
			self.ValueResponse(count);
		}

		msgsrv Decrement() {
			count = count - 1;
			self.ValueResponse(count);
		}

		msgsrv GetValue() {
			self.ValueResponse(count);
		}

		msgsrv ValueResponse(int value) {
			// no-op in counter
		}
	}

	reactiveclass Client {
		knownrebecs {
			Counter counter;
		}

		statevars {
			int clientId;
		}

		msgsrv initial(int id) {
			clientId = id;
		}

		msgsrv ValueResponse(int value) {
			// no-op
		}

		msgsrv Increment() {
			counter.Increment();
		}

		msgsrv Decrement() {
			counter.Decrement();
		}

		msgsrv GetValue() {
			counter.GetValue();
		}
	}

	main {
		Counter counter() : ();
		Client client1(counter) : (1);
		Client client2(counter) : (2);

		client1.Increment();
		client2.Increment();
		client1.GetValue();
	}
}