reactiveclass Counter {
    knownrebecs {
    }

    statevars {
        int count;
    }

    msgsrv initial() {
        count = 0;
    }

    msgsrv Increment() {
        count = count + 1;
        ValueResponse(count);
    }

    msgsrv Decrement() {
        count = count - 1;
        ValueResponse(count);
    }

    msgsrv GetValue() {
        ValueResponse(count);
    }

    msgsrv ValueResponse(int value) {
        // no-op in counter
    }
}

reactiveclass Client {
    knownrebecs {
        Counter counter;
    }

    statevars {
        int clientId;
    }

    msgsrv initial(int id) {
        clientId = id;
    }

    msgsrv ValueResponse(int value) {
        // no-op: was println in Akka
    }

    msgsrv Increment() {
        counter.Increment();
    }

    msgsrv Decrement() {
        counter.Decrement();
    }

    msgsrv GetValue() {
        counter.GetValue();
    }
}

main {
    Counter counter():();
    Client client1(counter):(1);
    Client client2(counter):(2);

    // Simulate:
    // counter.tell(Increment, client1)
    // counter.tell(Increment, client2)
    // counter.tell(GetValue, client1)

    client1.Increment();
    client2.Increment();
    client1.GetValue();
}

}