reactiveclass Counter {
	statevars {
		int count;
		Client client1;
		Client client2;
	}

	knownrebecs {
		Client c1;
		Client c2;
	}

	Counter(Client c1, Client c2) {
		count = 0;
		client1 = c1;
		client2 = c2;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
		Counter counter;
	}

	knownrebecs {
		Counter c;
	}

	Client(int id, Counter c) {
		clientId = id;
		counter = c;
	}

	msgsrv IncrementCall() {
		counter.Increment();
	}

	msgsrv GetValueCall() {
		counter.GetValue();
	}

	msgsrv ValueResponse(int value) {
	}
}

main {
	Counter counter(client1, client2);
	Client client1(1, counter);
	Client client2(2, counter);

	client1.IncrementCall();
	client2.IncrementCall();
	client1.GetValueCall();
}