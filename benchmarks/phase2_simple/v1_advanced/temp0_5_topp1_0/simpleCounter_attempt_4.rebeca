reactiveclass Counter {
	statevars {
		int count;
		Client client1;
		Client client2;
	}

	knownrebecs {
		Client c1;
		Client c2;
	}

	Counter() {
		count = 0;
		client1 = c1;
		client2 = c2;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
		Counter counter;
	}

	knownrebecs {
		Counter c;
	}

	Client() {
		clientId = 0;
		counter = c;
	}

	msgsrv setId(int id) {
		clientId = id;
	}

	msgsrv IncrementCall() {
		counter.Increment();
	}

	msgsrv GetValueCall() {
		counter.GetValue();
	}

	msgsrv ValueResponse(int value) {
	}
}

main {
	Counter counter(c1, c2);
	Client client1(counter);
	Client client2(counter);

	client1.setId(1):0;
	client2.setId(2):0;

	client1.IncrementCall():0;
	client2.IncrementCall():0;
	client1.GetValueCall():0;
}