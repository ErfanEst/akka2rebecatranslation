reactiveclass Counter {
		statevars {
			int count;
		}

		knownrebecs {
		}

		Counter() {
			count = 0;
		}

		msgsrv Increment() {
			count = count + 1;
			sender.ValueResponse(count);
		}

		msgsrv Decrement() {
			count = count - 1;
			sender.ValueResponse(count);
		}

		msgsrv GetValue() {
			sender.ValueResponse(count);
		}
	}

	reactiveclass Client {
		statevars {
			int clientId;
		}

		knownrebecs {
		}

		Client(int id) {
			clientId = id;
		}

		msgsrv ValueResponse(int value) {
			// No I/O in Rebeca; this models reception of the value
		}
	}

	main {
		Counter counter();
		Client client1(1);
		Client client2(2);

		// Simulate:
		// counter.tell(Increment, client1)
		// counter.tell(Increment, client2)
		// counter.tell(GetValue, client1)

		counter.Increment() with client1;
		counter.Increment() with client2;
		counter.GetValue() with client1;
	}
}