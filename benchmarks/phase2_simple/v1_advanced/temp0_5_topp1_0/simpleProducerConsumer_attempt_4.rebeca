reactiveclass Producer {
	knownrebecs {
		Consumer consumer;
	}
	statevars {
		int dummy;
	}

	msgsrv initial() {
		skip;
	}

	msgsrv Produce(int itemId) {
		consumer.Consume(itemId);
	}
}

reactiveclass Consumer {
	knownrebecs {
	}
	statevars {
		int dummy;
	}

	msgsrv initial() {
		skip;
	}

	msgsrv Consume(int itemId) {
		skip;
	}
}

main {
	Consumer consumer() : ();
	Producer producer(consumer) : ();

	producer.Produce(1);
	producer.Produce(2);
}