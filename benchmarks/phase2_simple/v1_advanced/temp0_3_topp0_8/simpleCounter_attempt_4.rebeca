reactiveclass Counter {
	knownrebecs { }

	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	knownrebecs {
		Counter counter;
	}

	statevars {
		int clientId;
	}

	Client(int id, Counter c) {
		clientId = id;
		counter = c;
	}

	msgsrv ValueResponse(int value) {
		// no I/O in Rebeca
	}

	msgsrv start() {
		// no-op
	}
}

main {
	Counter counter1():();
	Client client1(counter1):(1, counter1);
	Client client2(counter1):(2, counter1);

	counter1.Increment();
	counter1.Increment();
	counter1.GetValue();
}