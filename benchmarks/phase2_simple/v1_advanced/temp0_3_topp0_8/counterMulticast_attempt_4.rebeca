reactiveclass Counter() {
	knownrebecs { }
	statevars {
		int count;
	}

	Counter() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client(Counter counter, Environment env) {
	knownrebecs { Counter counter; Environment env; }
	statevars {
		int clientId;
	}

	Client(int id) {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// no I/O
	}
}

reactiveclass Environment(Counter counter, Client client1, Client client2) {
	knownrebecs { Counter counter; Client client1; Client client2; }
	statevars { }

	Environment() {
		counter.Increment() after(0);
		counter.Increment() after(0);
		counter.GetValue() after(0);
	}

	msgsrv dummy() {
	}
}

main {
	Counter counter():();
	Client client1(counter, env):(1);
	Client client2(counter, env):(2);
	Environment env(counter, client1, client2):();
}