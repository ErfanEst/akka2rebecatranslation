reactiveclass Ping {
	statevars {
		int count;
		Pong pong;
	}

	knownrebecs {
		Pong pongRef;
	}

	Ping(Pong pongRef) {
		count = 0;
		pong = pongRef;
	}

	msgsrv StartMessage() {
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		if (count >= 10) {
			sender.StopMessage();
		} else {
			sender.PingMessage();
		}
	}
}

reactiveclass Pong {
	statevars {
	}

	knownrebecs {
	}

	Pong() {
	}

	msgsrv PingMessage() {
		sender.PongMessage();
	}

	msgsrv StopMessage() {
	}
}

main {
	Pong pong();
	Ping ping(pong): (pong);

	ping.StartMessage();
}