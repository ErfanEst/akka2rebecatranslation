reactiveclass Counter {
	statevars {
		int count;
	}

	knownrebecs { }

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client {
	statevars {
		int clientId;
		int id;
	}

	knownrebecs {
		Counter counter;
	}

	msgsrv initial(int idParam, Counter counterParam) {
		id = idParam;
		clientId = id;
		counter = counterParam;
	}

	msgsrv ValueResponse(int value) {
		// no output
	}
}

reactiveclass Env {
	knownrebecs {
		Counter counter;
		Client client1;
		Client client2;
	}

	msgsrv initial(Counter counterParam, Client c1, Client c2) {
		counter = counterParam;
		client1 = c1;
		client2 = c2;
		counter.Increment() sender client1;
		counter.Increment() sender client2;
		counter.GetValue() sender client1;
	}
}

main {
	Counter counter(counter):();
	Client client1(client1):(1, counter);
	Client client2(client2):(2, counter);
	Env env(env):(counter, client1, client2);
}