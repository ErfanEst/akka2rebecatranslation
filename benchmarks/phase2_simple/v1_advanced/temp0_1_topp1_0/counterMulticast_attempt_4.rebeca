reactiveclass Counter() {
	statevars {
		int count;
	}

	knownrebecs { }

	msgsrv initial() {
		count = 0;
	}

	msgsrv Increment() {
		count = count + 1;
		sender.ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		sender.ValueResponse(count);
	}

	msgsrv GetValue() {
		sender.ValueResponse(count);
	}
}

reactiveclass Client(Counter counter, int id) {
	statevars {
		int clientId;
	}

	knownrebecs {
		Counter counter;
	}

	msgsrv initial() {
		clientId = id;
	}

	msgsrv ValueResponse(int value) {
		// no output
	}
}

reactiveclass Env(Counter counter, Client client1, Client client2) {
	knownrebecs {
		Counter counter;
		Client client1;
		Client client2;
	}

	msgsrv initial() {
		counter.Increment() sender client1;
		counter.Increment() sender client2;
		counter.GetValue() sender client1;
	}
}

main {
	Counter counter():();
	Client client1(counter, 1):(counter);
	Client client2(counter, 2):(counter);
	Env env(counter, client1, client2):(counter, client1, client2);
}