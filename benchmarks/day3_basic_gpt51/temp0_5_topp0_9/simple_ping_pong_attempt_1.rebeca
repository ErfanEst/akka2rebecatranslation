reactiveclass Ping {
    knownrebecs {
        Pong pong;
    }
    statevars {
        int count;
    }

    Ping(Pong pong) {
        this.pong = pong;
        count = 0;
    }

    msgsrv startMessage() {
        // println("Ping started the game!");
        pong.pingMessage();
    }

    msgsrv pongMessage() {
        count = count + 1;
        // println("Ping received pong #" + count);
        if (count >= 10) {
            pong.stopMessage();
            // println("Ping stopped");
            self.stop();
        } else {
            pong.pingMessage();
        }
    }

    msgsrv stop() {
        // dummy to allow self.stop() modeling if needed
    }
}

reactiveclass Pong {
    knownrebecs {
    }
    statevars {
    }

    Pong() {
    }

    msgsrv pingMessage() {
        // println("Pong received ping");
        sender.pongMessage();
    }

    msgsrv stopMessage() {
        // println("Pong stopped");
        self.stop();
    }

    msgsrv stop() {
        // dummy to allow self.stop() modeling if needed
    }
}

main {
    Pong pong();
    Ping ping(pong):startMessage();
}