reactiveclass Ping {
	knownrebecs {
		Pong pong;
	}
	statevars {
		int count;
	}

	Ping(Pong pong) {
		this.pong = pong;
		count = 0;
	}

	msgsrv startMessage() {
		pong.pingMessage();
	}

	msgsrv pongMessage() {
		count = count + 1;
		if (count >= 10) {
			pong.stopMessage();
			self.stop();
		} else {
			pong.pingMessage();
		}
	}

	msgsrv stop() {
		// dummy to allow self.stop() modeling if needed
	}
}

reactiveclass Pong {
	knownrebecs {
	}
	statevars {
	}

	Pong() {
	}

	msgsrv pingMessage() {
		sender.pongMessage();
	}

	msgsrv stopMessage() {
		self.stop();
	}

	msgsrv stop() {
		// dummy to allow self.stop() modeling if needed
	}
}

main {
	Pong pong();
	Ping ping(pong);
	ping.startMessage();
}