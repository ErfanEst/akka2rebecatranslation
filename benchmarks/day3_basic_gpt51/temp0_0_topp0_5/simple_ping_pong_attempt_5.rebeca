reactiveclass Ping {
	knownrebecs {
		Pong pong;
	}
	statevars {
		int count;
	}

	Ping(Pong pong) {
		count = 0;
	}

	msgsrv startMessage() {
		pong.pingMessage();
	}

	msgsrv pongMessage() {
		count = count + 1;
		if (count >= 10) {
			pong.stopMessage();
			self.terminate();
		} else {
			pong.pingMessage();
		}
	}
}

reactiveclass Pong {
	knownrebecs {
		Ping ping;
	}

	Pong(Ping ping) {
	}

	msgsrv pingMessage() {
		sender.pongMessage();
	}

	msgsrv stopMessage() {
		self.terminate();
	}
}

main {
	Ping ping(pong):();
	Pong pong(ping):();
	ping.startMessage();
}