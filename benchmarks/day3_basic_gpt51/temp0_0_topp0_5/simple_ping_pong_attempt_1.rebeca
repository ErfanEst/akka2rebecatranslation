reactiveclass Ping {
    knownrebecs {
        Pong pong;
    }
    statevars {
        int count;
    }

    Ping(Pong pong) {
        self.count = 0;
    }

    msgsrv startMessage() {
        // println("Ping started the game!");
        pong.pingMessage();
    }

    msgsrv pongMessage() {
        count = count + 1;
        // println("Ping received pong #" + count);
        if (count >= 10) {
            pong.stopMessage();
            // println("Ping stopped");
            self.terminate();
        } else {
            pong.pingMessage();
        }
    }
}

reactiveclass Pong {
    msgsrv pingMessage() {
        // println("Pong received ping");
        sender.pongMessage();
    }

    msgsrv stopMessage() {
        // println("Pong stopped");
        self.terminate();
    }
}

main {
    Pong pong();
    Ping ping(pong);

    ping.startMessage();
}