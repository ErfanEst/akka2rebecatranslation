reactiveclass Ping(pong: Pong) {
	knownrebecs {
		Pong pong;
	}
	statevars {
		int count;
	}

	Ping() {
		count = 0;
	}

	msgsrv startMessage() {
		pong.pingMessage();
	}

	msgsrv pongMessage() {
		count = count + 1;
		if (count >= 10) {
			pong.stopMessage();
			self.terminate();
		} else {
			pong.pingMessage();
		}
	}
}

reactiveclass Pong {
	msgsrv pingMessage() {
		sender.pongMessage();
	}

	msgsrv stopMessage() {
		self.terminate();
	}
}

main {
	Pong pong();
	Ping ping(pong):();
	ping.startMessage();
}