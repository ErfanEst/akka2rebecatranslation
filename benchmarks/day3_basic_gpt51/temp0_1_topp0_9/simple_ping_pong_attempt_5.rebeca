reactiveclass Ping {
	knownrebecs {
		Pong pong;
	}
	statevars {
		int count;
	}

	Ping() {
		count = 0;
	}

	msgsrv startMessage() {
		println("Ping started the game!");
		pong.pingMessage();
	}

	msgsrv pongMessage() {
		count = count + 1;
		println("Ping received pong #" + count + " from pong");
		if (count >= 10) {
			pong.stopMessage();
			println("Ping stopped");
		} else {
			pong.pingMessage();
		}
	}
}

reactiveclass Pong {
	knownrebecs {
		Ping ping;
	}
	statevars {
		// no state variables
	}

	Pong() {
		// no initialization needed
	}

	msgsrv pingMessage() {
		println("Pong received ping from ping");
		ping.pongMessage();
	}

	msgsrv stopMessage() {
		println("Pong stopped");
	}
}

main {
	Ping ping(pong):();
	Pong pong(ping):();

	ping.startMessage();
}