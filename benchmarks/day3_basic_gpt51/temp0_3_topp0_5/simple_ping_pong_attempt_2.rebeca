reactiveclass Ping(pong):Pong {
	statevars { 
		int count; 
	}

	Ping() {
		count = 0;
	}

	msgsrv StartMessage() {
		// Ping started the game!
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		// Ping received pong #count from pong
		if (count >= 10) {
			pong.StopMessage();
			// Ping stopped
			self.stop();
		} else {
			pong.PingMessage();
		}
	}
}

reactiveclass Pong {
	Pong() {
	}

	msgsrv PingMessage() {
		// Pong received ping from ping
		sender.PongMessage();
	}

	msgsrv StopMessage() {
		// Pong stopped
		self.stop();
	}
}

main {
	Pong pong():();
	Ping ping(pong):();

	ping.StartMessage();
}