reactiveclass Ping {
    knownrebecs { Pong pong; }

    statevars {
        int count;
    }

    Ping(Pong pong_) {
        pong = pong_;
        count = 0;
    }

    msgsrv StartMessage() {
        println("Ping started the game!");
        pong.PingMessage();
    }

    msgsrv PongMessage() {
        count = count + 1;
        println("Ping received pong #" + count + " from pong");
        if (count >= 10) {
            pong.StopMessage();
            println("Ping stopped");
            self.stop();
        } else {
            pong.PingMessage();
        }
    }
}

reactiveclass Pong {
    knownrebecs { }

    Pong() {
    }

    msgsrv PingMessage() {
        println("Pong received ping from ping");
        sender.PongMessage();
    }

    msgsrv StopMessage() {
        println("Pong stopped");
        self.stop();
    }
}

main {
    Ping ping(pong);
    Pong pong();
    ping.StartMessage();
}