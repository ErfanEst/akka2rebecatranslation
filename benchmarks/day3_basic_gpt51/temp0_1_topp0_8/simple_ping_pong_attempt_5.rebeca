reactiveclass Ping(pongKnown: Pong) {
	knownrebecs {
		Pong pongKnown;
	}
	statevars {
		int count;
	}

	Ping() {
		count = 0;
	}

	msgsrv startMessage() {
		pongKnown.pingMessage();
	}

	msgsrv pongMessage() {
		count = count + 1;
		if (count >= 10) {
			pongKnown.stopMessage();
			self.terminate();
		} else {
			pongKnown.pingMessage();
		}
	}
}

reactiveclass Pong(pingKnown: Ping) {
	knownrebecs {
		Ping pingKnown;
	}

	Pong() {
	}

	msgsrv pingMessage() {
		pingKnown.pongMessage();
	}

	msgsrv stopMessage() {
		self.terminate();
	}
}

main {
	Ping ping(pong): ();
	Pong pong(ping): ();

	ping.startMessage();
}