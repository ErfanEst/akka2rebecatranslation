reactiveclass Ping {
	knownrebecs {
		Pong pong;
	}

	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv StartMessage() {
		// Ping started the game!
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		// Ping received pong #count
		if (count >= 10) {
			// Ping stopped
			pong.StopMessage();
		} else {
			pong.PingMessage();
		}
	}
}

reactiveclass Pong {
	knownrebecs {
	}

	statevars {
	}

	msgsrv initial() {
	}

	msgsrv PingMessage() {
		// Pong received ping
		sender.PongMessage();
	}

	msgsrv StopMessage() {
		// Pong stopped
	}
}

main {
	Pong pong();
	Ping ping(pong): StartMessage();
}