reactiveclass Ping(pongKnown): {
	knownrebecs { 
		Pong pongKnown;
	}
	statevars {
		int count;
	}

	Ping() {
		count = 0;
	}

	msgsrv StartMessage() {
		pongKnown.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		if (count >= 10) {
			pongKnown.StopMessage();
		} else {
			pongKnown.PingMessage();
		}
	}
}

reactiveclass Pong(pingKnown): {
	knownrebecs {
		Ping pingKnown;
	}

	statevars {
	}

	Pong() {
	}

	msgsrv PingMessage() {
		pingKnown.PongMessage();
	}

	msgsrv StopMessage() {
	}
}

main {
	Pong pong(ping): ();
	Ping ping(pong): (StartMessage);
}