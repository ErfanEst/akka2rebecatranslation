reactiveclass Ping {
	knownrebecs {
		Pong pong;
	}

	statevars {
		int count;
	}

	Ping(Pong pong) {
		this.pong = pong;
		count = 0;
	}

	msgsrv startMessage() {
		// println("Ping started the game!");
		pong.pingMessage();
	}

	msgsrv pongMessage() {
		count = count + 1;
		// println("Ping received pong #" + count + " from pong");
		if (count >= 10) {
			pong.stopMessage();
			// println("Ping stopped");
		} else {
			pong.pingMessage();
		}
	}
}

reactiveclass Pong {
	knownrebecs {
	}

	statevars {
	}

	Pong() {
	}

	msgsrv pingMessage() {
		// println("Pong received ping from ping");
		sender.pongMessage();
	}

	msgsrv stopMessage() {
		// println("Pong stopped");
	}
}

main {
	Pong pong();
	Ping ping(pong): (startMessage);
}