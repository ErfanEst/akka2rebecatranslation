reactiveclass Ping (Pong pong) {
	knownrebecs {
		Pong pong;
	}

	statevars {
		int count;
	}

	Ping() {
		count = 0;
	}

	msgsrv startMessage() {
		pong.pingMessage();
	}

	msgsrv pongMessage() {
		count = count + 1;
		if (count >= 10) {
			pong.stopMessage();
		} else {
			pong.pingMessage();
		}
	}
}

reactiveclass Pong {
	knownrebecs {
	}

	statevars {
	}

	Pong() {
	}

	msgsrv pingMessage() {
		sender.pongMessage();
	}

	msgsrv stopMessage() {
	}
}

main {
	Pong pong();
	Ping ping(pong): startMessage();
}