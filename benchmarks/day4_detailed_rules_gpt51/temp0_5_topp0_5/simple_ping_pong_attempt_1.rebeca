reactiveclass Ping {
    knownrebecs {
        Pong pong;
    }
    statevars {
        int count;
    }
    msgsrv initial() {
        count = 0;
    }
    msgsrv StartMessage() {
        // Ping started the game!
        pong.PingMessage();
    }
    msgsrv PongMessage() {
        count = count + 1;
        // Ping received pong
        if (count >= 10) {
            pong.StopMessage();
            // Ping stopped
        } else {
            pong.PingMessage();
        }
    }
}

reactiveclass Pong {
    knownrebecs {
        Ping ping;
    }
    statevars {
    }
    msgsrv initial() {
    }
    msgsrv PingMessage() {
        // Pong received ping
        ping.PongMessage();
    }
    msgsrv StopMessage() {
        // Pong stopped
    }
}

main {
    Ping ping(pong):();
    Pong pong(ping):();
    ping.StartMessage();
}