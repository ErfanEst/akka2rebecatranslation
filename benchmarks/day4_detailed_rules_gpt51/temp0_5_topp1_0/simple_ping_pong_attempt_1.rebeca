reactiveclass Ping {
	knownrebecs {
		Pong pong;
	}

	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv StartMessage() {
		// println("Ping started the game!");
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		// println("Ping received pong #" + count);
		if (count >= 10) {
			// println("Ping stopped");
			sender.StopMessage();
			self.stop();
		} else {
			sender.PingMessage();
		}
	}
}

reactiveclass Pong {
	statevars {
	}

	msgsrv initial() {
	}

	msgsrv PingMessage() {
		// println("Pong received ping");
		sender.PongMessage();
	}

	msgsrv StopMessage() {
		// println("Pong stopped");
		self.stop();
	}
}

main {
	Pong pong();
	Ping ping(pong): (StartMessage);
}