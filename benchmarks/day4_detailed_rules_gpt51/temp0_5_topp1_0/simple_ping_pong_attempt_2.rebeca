reactiveclass Ping(pong: Pong) {
	knownrebecs {
		Pong pong;
	}

	statevars {
		int count;
	}

	msgsrv initial() {
		count = 0;
	}

	msgsrv StartMessage() {
		pong.PingMessage();
	}

	msgsrv PongMessage() {
		count = count + 1;
		if (count >= 10) {
			pong.StopMessage();
			self.stop();
		} else {
			pong.PingMessage();
		}
	}
}

reactiveclass Pong() {
	knownrebecs {
	}

	statevars {
	}

	msgsrv initial() {
	}

	msgsrv PingMessage() {
		sender.PongMessage();
	}

	msgsrv StopMessage() {
		self.stop();
	}
}

main {
	Pong pong():();
	Ping ping(pong):(StartMessage);
}