reactiveclass Ping(1) {
    knownrebecs { Pong pong; }
    statevars { int count = 0; }

    Ping(Pong myPong) {
        pong = myPong;
        StartMessage();
    }

    msgsrv StartMessage() {
        pong.PingMessage();
    }
    
    msgsrv PongMessage() {
        count = count + 1;
        if (count >= 10) {
            pong.StopMessage();
            terminate();
        } else {
            pong.PingMessage();
        }
    }
}

reactiveclass Pong(1) {
    knownrebecs { Ping ping; }

    Pong(Ping myPing) {
        ping = myPing;
    }

    msgsrv PingMessage() {
        ping.PongMessage();
    }

    msgsrv StopMessage() {
        terminate();
    }
}

main {

	Ping p(p: Pong());
	Pong q(p: Ping());
	p.StartMessage();

}