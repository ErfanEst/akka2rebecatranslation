reactiveclass Ping(1) {
    knownrebecs { Pong pong; }
    statevars { int count = 0; }

    Ping(Pong myPong) {
        pong = myPong;
        StartMessage();
    }

    msgsrv StartMessage() {
        println("Ping started the game!");
        pong.PingMessage();
    }
    
    msgsrv PongMessage() {
        count = count + 1;
        println("Ping received pong #" + count);
        if (count >= 10) {
            pong.StopMessage();
            println("Ping stopped");
            terminate();
        } else {
            pong.PingMessage();
        }
    }
}

reactiveclass Pong(1) {
    knownrebecs { Ping ping; }

    Pong(Ping myPing) {
        ping = myPing;
    }

    msgsrv PingMessage() {
        println("Pong received ping");
        ping.PongMessage();
    }

    msgsrv StopMessage() {
        println("Pong stopped");
        terminate();
    }
}

main {

	Ping p(<initial known rebecs>) : (<initial constructor parameters>);
	Pong q(p): (<initial constructor parameters>);
	p.StartMessage();

}