reactiveclass Ping(10) {
    knownrebecs { Pong pong; }
    statevars { int count = 0; }

    msgsrv StartMessage {
        pong.PingMessage();
    }

    msgsrv PongMessage {
        count = count + 1;
        if (count >= 10) {
            pong.StopMessage();
            selfdestruct;
        } else {
            pong.PingMessage();
        }
    }
}

reactiveclass Pong(10) {
    knownrebecs { Ping ping; }

    msgsrv PingMessage {
        ping.PongMessage();
    }

    msgsrv StopMessage {
        selfdestruct;
    }
}

main {
	Ping ping();
	Pong pong();
	ping.known(ping);
	pong.known(ping);
	ping.StartMessage();
}