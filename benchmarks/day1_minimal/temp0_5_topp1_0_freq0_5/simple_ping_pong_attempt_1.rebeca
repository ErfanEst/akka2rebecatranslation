reactiveclass Ping(10) {
    knownrebecs { Pong pong; }
    statevars { int count = 0; }
    
    msgsrv StartMessage() {
        println("Ping started the game!");
        pong.PingMessage();
    }
    
    msgsrv PongMessage() {
        count++;
        println("Ping received pong #" + count);
        if (count >= 10) {
            pong.StopMessage();
            println("Ping stopped");
            selfdestruct();
        } else {
            pong.PingMessage();
        }
    }
}

reactiveclass Pong(10) {
    knownrebecs { Ping ping; }

    msgsrv PingMessage() {
        println("Pong received ping");
        ping.PongMessage();
    }

    msgsrv StopMessage() {
        println("Pong stopped");
        selfdestruct();
    }
}

main {
	Ping ping(<initial arguments>);
	Pong pong(<initial arguments>);
	ping.StartMessage();
}