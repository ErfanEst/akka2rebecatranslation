reactiveclass Ping(1) {
    knownrebecs { Pong pong; }
    statevars { int count; }

    Ping() {
        count = 0;
    }

    msgsrv StartMessage {
        println("Ping started the game!");
        pong.PingMessage();
    }

    msgsrv PongMessage {
        count = count + 1;
        println("Ping received pong #" + (count));
        if (count >= 10) {
            pong.StopMessage();
            println("Ping stopped");
            self.kill();
        } else {
            pong.PingMessage();
        }
    }
}

reactiveclass Pong(1) {
    knownrebecs { Ping ping; }

    msgsrv PingMessage {
        println("Pong received ping");
        ping.PongMessage();
    }

    msgsrv StopMessage {
        println("Pong stopped");
        self.kill();
    }
}

main {
	Ping ping(): (pong);
	Pong pong(): (ping);
	ping.StartMessage();
}