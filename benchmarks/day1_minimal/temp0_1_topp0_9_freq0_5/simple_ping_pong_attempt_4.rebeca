reactiveclass Ping(1) {
    knownrebecs { Pong pong; }
    statevars { int count; }

    Ping(Pong myPong) {
        pong = myPong;
        count = 0;
        self.StartMessage();
    }

    msgsrv StartMessage {
        println("Ping started the game!");
        pong.PingMessage();
    }

    msgsrv PongMessage {
        count = count + 1;
        println("Ping received pong #" + toString(count));
        if (count >= 10) {
            pong.StopMessage();
            println("Ping stopped");
            self.die();
        } else {
            pong.PingMessage();
        }
    }
}

reactiveclass Pong(1) {
    knownrebecs { Ping ping; }

    Pong(Ping myPing) {
        ping = myPing;
    }

    msgsrv PingMessage {
        println("Pong received ping");
        ping.PongMessage();
    }

    msgsrv StopMessage {
        println("Pong stopped");
        self.die();
    }
}

main {
	Ping ping(): (pong);
	Pong pong(): (ping);
}