reactiveclass Ping(1) {
    knownrebecs { Pong pong; }

    statevars {
        int count = 0;
    }

    msgsrv StartMessage() {
        print("Ping started the game!");
        pong.PingMessage();
    }

    msgsrv PongMessage() {
        count = count + 1;
        print("Ping received pong #"+count+" from Pong");
        if (count >= 10) {
            pong.StopMessage();
            print("Ping stopped");
            selfdestruct();
        } else {
            pong.PingMessage();
        }
    }
}

reactiveclass Pong(1) {
    knownrebecs { Ping ping; }

    msgsrv PingMessage() {
        print("Pong received ping from Ping");
        ping.PongMessage();
    }

    msgsrv StopMessage() {
        print("Pong stopped");
        selfdestruct();
    }
}

main {

	Ping ping(pong): ( );
	Pong pong(ping): ( );

	ping.StartMessage();

}