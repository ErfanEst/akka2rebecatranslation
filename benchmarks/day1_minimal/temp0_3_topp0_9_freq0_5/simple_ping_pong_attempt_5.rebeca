reactiveclass Ping(1) {
    knownrebecs { Pong pong; }
    statevars { int count; }

    Ping(Pong myPong) {
        pong = myPong;
        count = 0;
        StartMessage();
    }

    msgsrv StartMessage {
        self.println("Ping started the game!");
        pong.PingMessage();
    }

    msgsrv PongMessage {
        count = count + 1;
        self.println("Ping received pong #" + (count));
        if (count >= 10) {
            pong.StopMessage();
            self.println("Ping stopped");
            // termination is not supported in Rebeca
        } else {
            delay(0);
            pong.PingMessage();
        }
    }
}

reactiveclass Pong(1) {
    knownrebecs { Ping ping; }

    Pong(Ping myPing) {
      ping = myPing;
    }

    msgsrv PingMessage {
      self.println("Pong received ping");
      delay(0);
      ping.PongMessage();
    }

    msgsrv StopMessage {
      self.println("Pong stopped");
      // termination is not supported in Rebeca
   }
}

main {
	Ping p: (new Pong(p));
}