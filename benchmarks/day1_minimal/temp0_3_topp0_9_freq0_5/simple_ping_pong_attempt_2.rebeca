reactiveclass Ping(1) {
    knownrebecs { Pong pong; }
    statevars { int count = 0; }

    Ping(Pong pong) {
        self.StartMessage();
    }

    msgsrv StartMessage {
        println("Ping started the game!");
        pong.PingMessage();
    }

    msgsrv PongMessage {
        count = count + 1;
        println("Ping received pong #" + count);
        if (count >= 10) {
            pong.StopMessage();
            println("Ping stopped");
            // termination is not supported in Rebeca
        } else {
            pong.PingMessage();
        }
    }
}

reactiveclass Pong(1) {
    knownrebecs { Ping ping; }

    Pong(Ping ping) {}

    msgsrv PingMessage {
        println("Pong received ping");
        ping.PongMessage();
    }

    msgsrv StopMessage {
        println("Pong stopped");
        // termination is not supported in Rebeca
    }
}

main {
	Ping ping(p : ());
	Pong pong(ping);
}