reactiveclass Ping(1) {
    knownrebecs { Pong pong; }
    statevars { int count; }

    Ping() {
        count = 0;
    }

    msgsrv StartMessage() {
        pong.PingMessage();
    }

    msgsrv PongMessage() {
        count = count + 1;
        if (count >= 10) {
            pong.StopMessage();
            self = null;
        } else {
            pong.PingMessage();
        }
    }
}

reactiveclass Pong(1) {
    knownrebecs { Ping ping; }

    msgsrv PingMessage() {
        ping.PongMessage();
    }

    msgsrv StopMessage() {
        self = null;
    }
}

main {
	Ping ping(pong): (StartMessage());
	Pong pong(ping);
}