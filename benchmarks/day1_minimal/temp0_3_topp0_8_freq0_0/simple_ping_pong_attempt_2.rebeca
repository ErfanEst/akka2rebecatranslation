reactiveclass Ping(1) {
    knownrebecs { Pong pong; }
    statevars { int count; }

    Ping(Pong myPong) {
        pong = myPong;
        count = 0;
    }

    msgsrv startMessage {
        println("Ping started the game!");
        pong.pingMessage();
    }

    msgsrv pongMessage {
        count = count + 1;
        println("Ping received pong #" + count + " from Pong");
        if (count >= 10) {
            pong.stopMessage();
            println("Ping stopped");
            // self.shutdown(); // There is no equivalent in Rebeca for self.shutdown()
        } else {
            pong.pingMessage();
        }
    }
}

reactiveclass Pong(1) {
    knownrebecs { Ping ping; }

    Pong(Ping myPing) {
        ping = myPing;
    }

    msgsrv pingMessage {
        println("Pong received ping from Ping");
        ping.pongMessage();
    }

    msgsrv stopMessage {
        println("Pong stopped");
        // self.shutdown(); // There is no equivalent in Rebeca for self.shutdown()
    }
}

main {
    Pong pong(ping):();
    Ping ping(pong):();

    // Start the exchange from inside an actor (ping)
    ping.startMessage();
}