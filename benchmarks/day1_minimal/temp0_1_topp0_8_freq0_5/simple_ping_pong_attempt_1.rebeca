reactiveclass Ping(1) {
    knownrebecs { Pong pong; }
    statevars { int count = 0; }

    msgsrv StartMessage {
        println("Ping started the game!");
        pong.PingMessage();
    }

    msgsrv PongMessage {
        count = count + 1;
        println("Ping received pong #" + count);
        if (count >= 10) {
            pong.StopMessage();
            println("Ping stopped");
            selfdestruct();
        } else {
            pong.PingMessage();
        }
    }
}

reactiveclass Pong(1) {
    knownrebecs { Ping ping; }

    msgsrv PingMessage(Ping sender) {
        println("Pong received ping from " + sender);
        sender.PongMessage();
    }

    msgsrv StopMessage(Ping sender) {
        println("Pong stopped");
        selfdestruct();
    }
}

main {
	Ping ping(<initial arguments>);
	Pong pong(<initial arguments>);
	ping.StartMessage();
}