reactiveclass Ping(1) {
    knownrebecs { Pong pong; }
    statevars { int count; }

    Ping() {
        count = 0;
    }

    msgsrv StartMessage {
        pong.PingMessage();
    }

    msgsrv PongMessage {
        count = count + 1;
        if (count >= 10) {
            terminate();
        } else {
            delay(0);
            pong.PingMessage();
        }
    }
}

reactiveclass Pong(1) {
    knownrebecs { Ping ping; }

    msgsrv PingMessage() {
        delay(0);
        ping.PongMessage();
    }
}

main {
	Ping ping : ( )(pong);
	Pong pong : (ping)();
	ping.StartMessage();
}