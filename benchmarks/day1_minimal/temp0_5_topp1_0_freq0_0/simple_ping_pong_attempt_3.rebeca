reactiveclass Ping(1) {
  knownrebecs { Pong pong; }
  statevars { int count = 0; }
  
  Ping(Pong myPong) {
    pong = myPong;
  }
  
  msgsrv StartMessage {
    println("Ping started the game!");
    pong.PingMessage();
  }
  
  msgsrv PongMessage {
    count = count + 1;
    println("Ping received pong #" + count);
    if (count >= 10) {
      pong.StopMessage();
      println("Ping stopped");
      terminate();
    } else {
      pong.PingMessage();
    }
  }
}

reactiveclass Pong(1) {
  knownrebecs { Ping ping; }
  
  Pong(Ping myPing) {
    ping = myPing;
  }
  
  msgsrv PingMessage {
    println("Pong received ping");
    ping.PongMessage();
  }
  
  msgsrv StopMessage {
    println("Pong stopped");
    terminate();
  }
}

main {
  Pong pong : ( );
  Ping ping : (pong);
  
  // Start the exchange from inside an actor (ping)
  ping.StartMessage();
}