reactiveclass Ping(1) {
  knownrebecs { Pong pong; }
  statevars { int count = 0; }
  
  Ping(Pong myPong) {
    pong = myPong;
  }
  
  msgsrv StartMessage {
    pong.PingMessage();
  }
  
  msgsrv PongMessage {
    count = count + 1;
    if (count >= 10) {
      pong.StopMessage();
    } else {
      pong.PingMessage();
    }
  }
}

reactiveclass Pong(1) {
  knownrebecs { Ping ping; }
  
  Pong(Ping myPing) {
    ping = myPing;
  }
  
  msgsrv PingMessage {
    ping.PongMessage();
  }
  
  msgsrv StopMessage {
  }
}

main {
  Pong pong : ();
  Ping ping : (pong);
  
  ping.StartMessage();
}