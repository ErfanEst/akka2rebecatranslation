reactiveclass Ping(1) {
  knownrebecs { Pong pong; }
  statevars { int count; }

  Ping() {
    count = 0;
  }

  msgsrv StartMessage() {
    pong.PingMessage();
  }

  msgsrv PongMessage() {
    count = count + 1;
    if (count >= 10) {
      pong.StopMessage();
    } else {
      delay(1);
      self.StartMessage();
    }
  }
}

reactiveclass Pong(1) {
  knownrebecs { Ping ping; }

  msgsrv PingMessage() {
    delay(1);
    ping.PongMessage();
  }

  msgsrv StopMessage() {}
}

main {
	Ping ping(): ();
	Pong pong(ping): ();
	ping.StartMessage();
}