reactiveclass Ping(1) {
    knownrebecs {Pong pong;}
    statevars {int count;}

    Ping(Pong myPong) {
        pong = myPong;
        count = 0;
    }

    msgsrv startMessage {
        pong.pingMessage();
    }
    msgsrv pongMessage {
        count = count + 1;
        if (count >= 10) {
            pong.stopMessage();
        } else {
            self.startMessage();
        }
    }
}

reactiveclass Pong(1) {
    knownrebecs {Ping ping;}

    Pong(Ping myPing) {
        ping = myPing;
    }

    msgsrv pingMessage {
        ping.pongMessage();
    }
    msgsrv stopMessage {
    }
}

main {
    Ping ping(): (pong);
    Pong pong(): (ping);
    ping.startMessage();
}