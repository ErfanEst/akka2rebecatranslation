reactiveclass Ping(1) {
    knownrebecs {Pong pong;}
    statevars {int count;}
    
    Ping(Pong myPong) {
        pong = myPong;
        count = 0;
    }

    msgsrv StartMessage {
        pong.PingMessage();
    }
    msgsrv PongMessage {
        count = count + 1;
        if (count >= 10) {
            pong.StopMessage();
        } else {
            pong.PingMessage();
        }
    }
}

reactiveclass Pong(1) {
    knownrebecs {Ping ping;}
    
    Pong(Ping myPing) {
        ping = myPing;
    }

    msgsrv PingMessage {
        ping.PongMessage();
    }
    msgsrv StopMessage {
    }
}

main {
    Ping ping(): (pongInstance);
    Pong pongInstance(): (ping);
    ping.StartMessage();
}