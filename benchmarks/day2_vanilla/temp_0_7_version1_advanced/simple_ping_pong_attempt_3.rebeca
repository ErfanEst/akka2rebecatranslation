reactiveclass Ping(2) {
  knownrebecs {
    Pong pong;
  }
  statevars {
    int count;
  }

  Ping(Pong pongInstance) {
    self.startMessage();
    pong = pongInstance;
    count = 0;
  }

  msgsrv startMessage() {
    self.pingMessage() after(1);
  }

  msgsrv pingMessage() {
    pong.pongMessage();
  }

  msgsrv processPong() {
    count = count + 1;
    if (count >= 10) {
      pong.stopMessage();
    } else {
      self.pingMessage() after(1);
    }
  }
}

reactiveclass Pong(1) {
  knownrebecs {
    Ping ping;
  }

  Pong(Ping pingInstance) {
    ping = pingInstance;
  }

  msgsrv pongMessage() {
    ping.processPong();
  }

  msgsrv stopMessage() {
    // nothing to do here
  }
}

main {
  Pong pong():();
  Ping ping(pong):();
}