reactiveclass Ping(1) {
	knownrebecs {
		Pong pong;
	}
	statevars {
		int count;
	}
	
	Ping(Pong myPong) {
		count = 0;
		pong = myPong;
	}
	
	msgsrv startMessage {
		println("Ping started the game");
		pong.pingMessage();
	}
	
	msgsrv pongMessage {
		count = count + 1;
		println("Ping received pong " + count);
		if (count >= 10) {
			pong.stopMessage();
			println("Ping stopped");
			terminate();
		} else {
			delay(10);
			pong.pingMessage();
		}
	}
}

reactiveclass Pong(1) {
	knownrebecs {
		Ping ping;
	}
	
	msgsrv pingMessage {
		println("Pong received ping");
		ping.pongMessage();
	}
	
	msgsrv stopMessage {
		println("Pong stopped");
		terminate();
	}
}

main {
	Pong pongInstance(): ();
	Ping pingInstance(pongInstance): ();
	
	pingInstance.startMessage();
}