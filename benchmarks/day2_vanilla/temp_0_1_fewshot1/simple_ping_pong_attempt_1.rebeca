reactiveclass Ping(5) {
  knownrebecs {
    Pong pong;
  }
  statevars {
    int count;
  }
  msgsrv initial() {
    count = 0;
    pong.PingMessage();
  }
  msgsrv PongMessage() {
    count = count + 1;
    if (count >= 10) {
      pong.StopMessage();
    } else {
      pong.PingMessage();
    }
  }
}

reactiveclass Pong(5) {
  knownrebecs {
    Ping ping;
  }
  msgsrv PingMessage() {
    ping.PongMessage();
  }
  msgsrv StopMessage() {
  }
}

main {
  Pong pong():();
  Ping ping(pong):();
}