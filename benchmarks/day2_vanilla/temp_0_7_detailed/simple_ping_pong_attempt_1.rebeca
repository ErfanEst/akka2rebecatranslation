reactiveclass Ping(1) {
    statevars {
        int count = 0;
    }
    knownrebecs {
        Pong pong;
    }
    msgsrv StartMessage {
        println("Ping started the game!");
        pong.PingMessage();
    }
    msgsrv PongMessage {
        count = count + 1;
        println("Ping received pong #" + count + " from " + pong.self.name);
        if (count >= 10) {
            pong.StopMessage();
            println("Ping stopped");
            self.terminate();
        } else {
            pong.PingMessage();
        }
    }
}

reactiveclass Pong(1) {
    msgsrv PingMessage {
        println("Pong received ping from " + self.sender.name);
        self.sender.PongMessage();
    }
    msgsrv StopMessage {
        println("Pong stopped");
        self.terminate();
    }
}

main {
    Pong pong(<initialArguments>);
    Ping ping(pong);
    ping.StartMessage();
}