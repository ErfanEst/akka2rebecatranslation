reactiveclass Ping(1) {
    knownrebecs {
        Pong pong;
    }
    statevars {
        int count;
    }
    Ping(Pong myPong) {
        pong = myPong;
        count = 0;
    }
    msgsrv StartMessage {
        pong.PingMessage();
    }
    msgsrv PongMessage {
        count = count + 1;
        if (count >= 10) {
            pong.StopMessage();
        } else {
            delay(0);
            self.PongMessage();
        }
    }
}

reactiveclass Pong(1) {
    knownrebecs {
        Ping ping;
    }
    Pong() {
    }
    msgsrv PingMessage {
        delay(0);
        ping.PongMessage();
    }
    msgsrv StopMessage {
    }
}

main {
    Pong pong();
    Ping ping(pong);
    initial { 
        ping.StartMessage();
    }
}