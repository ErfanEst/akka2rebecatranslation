reactiveclass Ping(2) {
    knownrebecs {
        Pong pong;
    }
    
    statevars {
        int count;
    }

    msgsrv startMessage {
        self.println("Ping started the game!");
        pong.pingMessage();
    }
    
    msgsrv pongMessage {
        count = count + 1;
        self.println("Ping received pong #" + (count) + " from pong");
        if (count >= 10) {
            pong.stopMessage();
            self.println("Ping stopped");
            self.selfdestruct();
        } else {
            pong.pingMessage();
        }
    }
}

reactiveclass Pong(1) {
    knownrebecs {
        Ping ping;
    }
    
    msgsrv pingMessage {
        self.println("Pong received ping from ping");
        ping.pongMessage();
    }
    
    msgsrv stopMessage {
        self.println("Pong stopped");
        self.selfdestruct();
    }
}

main {
    Pong pong("pong");
    Ping ping("ping", pong);
    ping.startMessage();
}