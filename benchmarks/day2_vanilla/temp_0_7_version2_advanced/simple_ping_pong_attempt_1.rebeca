reactiveclass Ping(2) {
    knownrebecs {
        Pong pong;
    }
    
    statevars {
        int count;
    }

    msgsrv StartMessage {
        println("Ping started the game!");
        pong.PingMessage();
    }
    
    msgsrv PongMessage {
        count = count + 1;
        println("Ping received pong #" + (count) + " from pong");
        if (count >= 10) {
            pong.StopMessage();
            println("Ping stopped");
            selfdestruct();
        } else {
            pong.PingMessage();
        }
    }
}

reactiveclass Pong(1) {
    msgsrv PingMessage(Ping ping) {
        println("Pong received ping from ping");
        ping.PongMessage();
    }
    
    msgsrv StopMessage {
        println("Pong stopped");
        selfdestruct();
    }
}

main {
    Pong pong("pong");
    Ping ping("ping", pong);
    ping.StartMessage();
}