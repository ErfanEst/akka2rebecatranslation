reactiveclass Ping(2) {
    knownrebecs {
        Pong pong;
    }
    statevars {
        int count;
    }
    Ping(Pong myPong) {
        pong = myPong;
    }
    msgsrv start {
        pong.ping();
    }
    msgsrv pong {
        count = count + 1;
        if (count >= 10) {
            pong.stop();
        } else {
            delay(10);
            pong.ping();
        }
    }
}

reactiveclass Pong(1) {
    knownrebecs {
        Ping ping;
    }
    Pong() {}
    msgsrv ping {
        ping.pong();
    }
    msgsrv stop {
    }
}

main {
    Pong pong();
    Ping ping(pong);
    pong.setPing(ping);
    ping.start();
}