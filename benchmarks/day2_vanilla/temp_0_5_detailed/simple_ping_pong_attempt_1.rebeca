reactiveclass Ping(2) {
    knownrebecs {
        Pong pong;
    }
    statevars {
        int count;
    }
    Ping(Pong pong) {
        self.start();
    }
    msgsrv start {
        println("Ping started the game!");
        pong.ping();
    }
    msgsrv pong {
        count = count + 1;
        println("Ping received pong #" + count + " from Pong");
        if (count >= 10) {
            pong.stop();
            println("Ping stopped");
            self.terminate();
        } else {
            pong.ping();
        }
    }
}

reactiveclass Pong(1) {
    knownrebecs {
        Ping ping;
    }
    msgsrv ping {
        println("Pong received ping from Ping");
        ping.pong();
    }
    msgsrv stop {
        println("Pong stopped");
        self.terminate();
    }
}

main {
    Pong pong(<initial arguments>);
    Ping ping(pong);
}