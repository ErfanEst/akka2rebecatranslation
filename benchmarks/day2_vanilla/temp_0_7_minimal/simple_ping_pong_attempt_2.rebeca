reactiveclass Ping(1) {
    knownrebecs {Pong pong;}
    statevars {int count;}

    Ping(Pong pongInstance) {
        pong = pongInstance;
        count = 0;
    }

    msgsrv StartMessage {
        pong.PingMessage();
    }

    msgsrv PongMessage {
        count = count + 1;
        if (count < 10) {
            pong.PingMessage();
        } else {
            pong.StopMessage();
        }
    }
}

reactiveclass Pong(1) {
    knownrebecs {Ping ping;}

    Pong() { }

    msgsrv PingMessage {
        ping.PongMessage();
    }

    msgsrv StopMessage {
    }
}

main {
    Pong pong():();
    Ping ping(pong): ();
    ping.StartMessage();
}