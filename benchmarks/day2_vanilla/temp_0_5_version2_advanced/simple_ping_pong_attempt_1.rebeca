reactiveclass Ping(1) {
  knownrebecs {
    Pong pong;
  }
  statevars {
    int count;
  }
  msgsrv StartMessage {
    count = 0;
    println("Ping started the game!");
    pong.PingMessage();
  }
  msgsrv PongMessage {
    count = count + 1;
    println("Ping received pong #" + count);
    if (count >= 10) {
      pong.StopMessage();
      println("Ping stopped");
      selfdestruct();
    } else {
      pong.PingMessage();
    }
  }
}

reactiveclass Pong(1) {
  knownrebecs {
    Ping ping;
  }
  msgsrv PingMessage {
    println("Pong received ping");
    ping.PongMessage();
  }
  msgsrv StopMessage {
    println("Pong stopped");
    selfdestruct();
  }
}

main {
  Pong pong(<initial known rebecs>);
  Ping ping(pong);
  ping.StartMessage();
}