reactiveclass Ping(3) {
    knownrebecs { Pong pong; }
    statevars { int count; }
    Ping() { count = 0; }
    msgsrv StartMessage() {
        pong.PingMessage();
    }
    msgsrv PongMessage() {
        count = count + 1;
        if (count >= 10) {
            pong.StopMessage();
            self.Shutdown();
        } else {
            pong.PingMessage();
        }
    }
    msgsrv Shutdown() { }
}

reactiveclass Pong(3) {
    knownrebecs { Ping ping; }
    msgsrv PingMessage() {
        ping.PongMessage();
    }
    msgsrv StopMessage() {
        self.Shutdown();
    }
    msgsrv Shutdown() { }
}

main {
    Ping ping(pong):();
    Pong pong(ping):();
    ping.StartMessage() after(0);
}