reactiveclass Ping(3) {
    knownrebecs { Pong pong; }
    statevars { int count; }
    Ping() { count = 0; }
    msgsrv StartMessage() {
        println("Ping started the game!");
        pong.PingMessage();
    }
    msgsrv PongMessage() {
        count = count + 1;
        println("Ping received pong #" + count);
        if (count >= 10) {
            pong.StopMessage();
            println("Ping stopped");
            self.Shutdown();
        } else {
            pong.PingMessage();
        }
    }
    msgsrv Shutdown() { }
}

reactiveclass Pong(3) {
    knownrebecs { Ping ping; }
    msgsrv PingMessage() {
        println("Pong received ping");
        ping.PongMessage();
    }
    msgsrv StopMessage() {
        println("Pong stopped");
        self.Shutdown();
    }
    msgsrv Shutdown() { }
}

main {
    Ping ping(pong):();
    Pong pong(ping):();
    ping.StartMessage();
}