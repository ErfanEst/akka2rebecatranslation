reactiveclass Ping(2) {
    knownrebecs { Pong pong; }
    statevars { int count; }
    Ping() { count = 0; }
    msgsrv start() {
        pong.ping();
    }
    msgsrv pong() {
        count = count + 1;
        if (count >= 10) {
            pong.stop();
        } else {
            pong.ping();
        }
    }
}

reactiveclass Pong(2) {
    knownrebecs { Ping ping; }
    msgsrv ping() {
        ping.pong();
    }
    msgsrv stop() { }
}

main {
    Pong pong():(ping);
    Ping ping():(pong);
    ping.start();
}