env {
    msg StartMessage;
    msg PingMessage;
    msg PongMessage;
    msg StopMessage;
}

reactiveclass Ping(2) {
    knownrebecs { Pong pong; }
    statevars { int count; }
    Ping() { count = 0; }
    msgsrv StartMessage() {
        println("Ping started the game!");
        pong.PingMessage();
    }
    msgsrv PongMessage() {
        count = count + 1;
        println("Ping received pong #" + count);
        if (count >= 10) {
            pong.StopMessage();
            println("Ping stopped");
            self = null;
        } else {
            pong.PingMessage();
        }
    }
}

reactiveclass Pong(2) {
    knownrebecs { Ping ping; }
    msgsrv PingMessage() {
        println("Pong received ping");
        ping.PongMessage();
    }
    msgsrv StopMessage() {
        println("Pong stopped");
        self = null;
    }
}

main {
    Pong pong():();
    Ping ping(pong):();
    ping.StartMessage();
}