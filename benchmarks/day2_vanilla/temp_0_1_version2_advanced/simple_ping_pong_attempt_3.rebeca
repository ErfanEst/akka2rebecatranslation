reactiveclass Ping(1) {
  knownrebecs {
    Pong pong;
  }
  statevars {
    int count;
  }

  Ping(Pong pong) {
    self.pong = pong;
    count = 0;
  }

  msgsrv startMessage() {
    pong.pingMessage();
  }

  msgsrv pongMessage() {
    count = count + 1;
    if (count >= 10) {
      pong.stopMessage();
    } else {
      pong.pingMessage();
    }
  }
}

reactiveclass Pong(1) {
  knownrebecs {
    Ping ping;
  }

  Pong(Ping ping) {
    self.ping = ping;
  }

  msgsrv pingMessage() {
    ping.pongMessage();
  }

  msgsrv stopMessage() {
  }
}

main {
  Pong pong(): (ping);
  Ping ping(): (pong);
  ping.startMessage();
}