reactiveclass Ping(1) {
  knownrebecs {
    Pong pong;
  }
  statevars {
    int count = 0;
  }

  msgsrv startMessage {
    pong.pingMessage();
  }

  msgsrv pongMessage {
    count = count + 1;
    if (count >= 10) {
      pong.stopMessage();
      selfDestruct();
    } else {
      pong.pingMessage();
    }
  }
}

reactiveclass Pong(1) {
  knownrebecs {
    Ping ping;
  }

  msgsrv pingMessage {
    ping.pongMessage();
  }

  msgsrv stopMessage {
    selfDestruct();
  }
}

main {
  Pong pong("pong") : ();
  Ping ping("ping") : (pong);
  ping.startMessage();
}