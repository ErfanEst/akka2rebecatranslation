reactiveclass Ping(2) {
	knownrebecs { Pong pong; }
	statevars { int count; }

	Ping(Pong pongInstance) {
		pong = pongInstance;
		self.start();
	}

	msgsrv start {
		pong.ping();
	}

	msgsrv pong {
		count = count + 1;
		if (count >= 10) {
			pong.stop();
		} else {
			delay(1);
			self.start();
		}
	}
}

reactiveclass Pong(2) {
	knownrebecs { Ping ping; }

	Pong(Ping pingInstance) {
		ping = pingInstance;
	}

	msgsrv ping {
		ping.pong();
	}

	msgsrv stop {
		// Terminate logic here
	}
}

main {
	Ping ping():();
	Pong pong(ping):();
}