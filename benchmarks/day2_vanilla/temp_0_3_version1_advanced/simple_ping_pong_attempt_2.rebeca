reactiveclass Ping(2) {
	knownrebecs { Pong pong; }
	statevars { int count; }

	Ping(Pong pongInstance) {
		pong = pongInstance;
		self.start();
	}

	msgsrv start {
		pong.ping();
	}

	msgsrv pong {
		count = count + 1;
		if (count >= 10) {
			pong.stop();
		} else {
			pong.ping();
		}
	}
}

reactiveclass Pong(2) {
	msgsrv ping {
		((Ping)sender).pong();
	}

	msgsrv stop {
		// Terminate logic here
	}
}

main {
	Pong pong():();
	Ping ping(pong):();
}