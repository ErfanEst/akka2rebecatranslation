reactiveclass Ping(2) {
	knownrebecs {
		Pong pong;
	}
	statevars {
		int count;
	}
	
	Ping(Pong pong) {
		self.initial();
	}
	
	msgsrv initial {
		pong.pingMsg();
	}
	
	msgsrv pongMsg {
		count = count + 1;
		if (count >= 10) {
			((Pong)sender).stopMsg();
		} else {
			((Pong)sender).pingMsg();
		}
	}
}

reactiveclass Pong(2) {
	msgsrv pingMsg {
		((Ping)sender).pongMsg();
	}
	
	msgsrv stopMsg {
		terminate();
	}
}

main {
	Pong pong():();
	Ping ping(pong):();
}