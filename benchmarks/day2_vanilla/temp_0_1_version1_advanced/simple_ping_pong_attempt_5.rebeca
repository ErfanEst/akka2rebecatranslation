reactiveclass Ping(2) {
	knownrebecs {
		Pong pong;
	}
	statevars {
		int count;
	}
	
	Ping(Pong pongInstance) {
		pong = pongInstance;
		self.initial();
	}
	
	msgsrv initial {
		pong.pingMsg();
	}
	
	msgsrv pongMsg {
		count = count + 1;
		if (count >= 10) {
			pong.stopMsg();
		} else {
			delay(1);
			pong.pingMsg();
		}
	}
}

reactiveclass Pong(2) {
	knownrebecs {
		Ping ping;
	}
	
	Pong(Ping pingInstance) {
		ping = pingInstance;
	}
	
	msgsrv pingMsg {
		delay(1);
		((Ping)sender).pongMsg();
	}
	
	msgsrv stopMsg {
		// terminate() is not a valid Rebeca method
		// replace with appropriate behavior
	}
}

main {
	Ping ping():();
	Pong pong(ping):();
}