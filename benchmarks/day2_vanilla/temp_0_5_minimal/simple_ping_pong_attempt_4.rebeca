reactiveclass Ping(1) {
  knownrebecs { Pong pong; }
  statevars { int count; }

  Ping(Pong pongInstance) {
    count = 0;
    pong = pongInstance;
  }

  msgsrv StartMessage {
    pong.PingMessage();
  }

  msgsrv PongMessage {
    count = count + 1;
    if (count >= 10) {
      pong.StopMessage();
    } else {
      pong.PingMessage();
    }
  }
}

reactiveclass Pong(1) {
  knownrebecs { Ping ping; }

  Pong(Ping pingInstance) {
    ping = pingInstance;
  }

  msgsrv PingMessage {
    ping.PongMessage();
  }

  msgsrv StopMessage {
  }
}

main {
  Pong pongInstance : (new Pong(pingInstance));
  Ping pingInstance : (new Ping(pongInstance));
  pingInstance.StartMessage();
}