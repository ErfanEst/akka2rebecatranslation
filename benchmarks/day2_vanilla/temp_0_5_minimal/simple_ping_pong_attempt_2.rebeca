reactiveclass Ping(1) {
  knownrebecs { Pong pong; }
  statevars { int count; }

  Ping(Pong pong) {
    self.count = 0;
    self.pong = pong;
  }

  msgsrv StartMessage {
    pong.PingMessage();
  }

  msgsrv PongMessage {
    count = count + 1;
    if (count >= 10) {
      pong.StopMessage();
    } else {
      pong.PingMessage();
    }
  }
}

reactiveclass Pong(1) {
  knownrebecs { Ping ping; }

  Pong(Ping ping) {
    self.ping = ping;
  }

  msgsrv PingMessage {
    ping.PongMessage();
  }

  msgsrv StopMessage {
  }
}

main {
  Pong pong(ping);
  Ping ping(pong);
  ping.StartMessage();
}