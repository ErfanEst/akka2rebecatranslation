reactiveclass Ping(1) {
  knownrebecs { Pong pong; }
  statevars { int count; }

  msgsrv start() {
    count = 0;
    pong.ping();
  }

  msgsrv pong() {
    count = count + 1;
    if (count >= 10) {
      pong.stop();
      self.terminate();
    } else {
      delay(1);
      pong.ping();
    }
  }

  msgsrv terminate() { }
}

reactiveclass Pong(1) {
  knownrebecs { Ping ping; }

  msgsrv ping() {
    delay(1);
    ping.pong();
  }

  msgsrv stop() {
    self.terminate();
  }

  msgsrv terminate() { }
}

main {
  Ping ping(pong): ();
  Pong pong(ping): ();
  ping.start();
}