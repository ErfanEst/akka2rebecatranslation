reactiveclass Ping(5) {
  knownrebecs {
    Pong pong;
  }
  statevars {
    int count;
  }
  msgsrv initial() {
    count = 0;
    pong.pingMessage();
  }
  msgsrv pongMessage() {
    count = count + 1;
    if (count >= 10) {
      pong.stopMessage();
    } else {
      pong.pingMessage();
    }
  }
}

reactiveclass Pong(5) {
  knownrebecs {
    Ping ping;
  }
  msgsrv initial() {
  }
  msgsrv pingMessage() {
    ping.pongMessage();
  }
  msgsrv stopMessage() {
  }
}

main {
  Pong pong():();
  Ping ping(pong):();
}