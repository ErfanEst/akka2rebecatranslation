reactiveclass Ping(3) {
	statevars {
		int count;
	}
	knownrebecs {
		Pong pong;
	}
	Ping(Pong myPong) {
		pong = myPong;
		self.start();
	}
	msgsrv start() {
		pong.ping();
	}
	msgsrv pong() {
		count = count + 1;
		if (count >= 10) {
			pong.stop();
			self = null;
		} else {
			delay(1);
			pong.ping();
		}
	}
}

reactiveclass Pong(3) {
	knownrebecs {
		Ping ping;
	}
	Pong() {}
	msgsrv ping() {
		delay(1);
		ping.pong();
	}
	msgsrv stop() {
		self = null;
	}
}

main {
	Pong pong({});
	Ping ping({pong});
}