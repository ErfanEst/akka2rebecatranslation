reactiveclass Ping(1) {
  knownrebecs { Pong pong; }
  statevars { int count; }

  msgsrv startMessage() {
    pong.pingMessage();
  }

  msgsrv pongMessage() {
    count = count + 1;
    if (count >= 10) {
      pong.stopMessage();
      self();
    } else {
      pong.pingMessage();
    }
  }
}

reactiveclass Pong(1) {
  knownrebecs { Ping ping; }

  msgsrv pingMessage() {
    ping.pongMessage();
  }

  msgsrv stopMessage() {
    self();
  }
}

main {
  Pong pong : ( );
  Ping ping : (pong);
  ping.startMessage();
}