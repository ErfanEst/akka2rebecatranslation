reactiveclass Ping(1) {
  knownrebecs { Pong pong; }
  statevars { int count; }

  msgsrv startMessage() {
    println("Ping started the game!");
    pong.pingMessage();
  }

  msgsrv pongMessage() {
    count = count + 1;
    println("Ping received pong #" + count);
    if (count >= 10) {
      pong.stopMessage();
      println("Ping stopped");
      self.stop();
    } else {
      pong.pingMessage();
    }
  }
}

reactiveclass Pong(1) {
  knownrebecs { Ping ping; }

  msgsrv pingMessage() {
    println("Pong received ping");
    ping.pongMessage();
  }

  msgsrv stopMessage() {
    println("Pong stopped");
    self.stop();
  }
}

main {
  Pong pong("pong");
  Ping ping("ping", pong);
  ping.startMessage();
}