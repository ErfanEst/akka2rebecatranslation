reactiveclass Ping(10) {
  knownrebecs { Pong pong; }
  statevars { int count; }

  Ping() {
    count = 0;
  }

  msgsrv startMessage() {
    pong.pingMessage();
  }

  msgsrv pongMessage() {
    count = count + 1;
    if (count >= 10) {
      pong.stopMessage();
    } else {
      pong.pingMessage();
    }
  }
}

reactiveclass Pong(10) {
  knownrebecs { Ping ping; }

  msgsrv pingMessage() {
    ping.pongMessage();
  }

  msgsrv stopMessage() {
    terminate();
  }
}

main {
  Ping ping(): ();
  Pong pong(ping): ();
  ping.startMessage();
}