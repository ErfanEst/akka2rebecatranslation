reactiveclass Ping(10) {
  knownrebecs { Pong pong; }
  statevars { int count; }
  Ping() { count = 0; }

  msgsrv StartMessage() {
    println("Ping started the game!");
    pong.PingMessage();
  }

  msgsrv PongMessage() {
    count = count + 1;
    println("Ping received pong from Pong");
    if (count >= 10) {
      pong.StopMessage();
      println("Ping stopped");
      self.StopMessage();
    } else {
      pong.PingMessage();
    }
  }

  msgsrv StopMessage() { }
}

reactiveclass Pong(10) {
  knownrebecs { Ping ping; }

  msgsrv PingMessage() {
    println("Pong received ping from Ping");
    ping.PongMessage();
  }

  msgsrv StopMessage() {
    println("Pong stopped");
    self.StopMessage();
  }
}

main {
  Ping ping(pong):();
  Pong pong(ping):();
  ping.StartMessage();
}