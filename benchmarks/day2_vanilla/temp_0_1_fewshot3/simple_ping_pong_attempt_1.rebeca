env {
    int MAX_COUNT = 10;
}

reactiveclass Ping(2) {
    knownrebecs { Pong pong; }
    statevars { int count; }
    Ping() { count = 0; }
    msgsrv StartMessage() {
        println("Ping started the game!");
        pong.PingMessage();
    }
    msgsrv PongMessage() {
        count = count + 1;
        println("Ping received pong #" + count);
        if (count >= MAX_COUNT) {
            pong.StopMessage();
            println("Ping stopped");
            self.terminate();
        } else {
            pong.PingMessage();
        }
    }
}

reactiveclass Pong(2) {
    knownrebecs { Ping ping; }
    msgsrv PingMessage() {
        println("Pong received ping");
        ping.PongMessage();
    }
    msgsrv StopMessage() {
        println("Pong stopped");
        self.terminate();
    }
}

main {
    Ping ping(pong):();
    Pong pong():();
    ping.StartMessage();
}