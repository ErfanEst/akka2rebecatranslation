reactiveclass Ping(3) {
  knownrebecs { Pong pong; }
  statevars { int count; }
  Ping(Pong myPong) {
    pong = myPong;
    count = 0;
  }
  msgsrv start() {
    count = 0;
    pong.ping();
  }
  msgsrv pong() {
    count = count + 1;
    if (count >= 10) {
      pong.stop();
    } else {
      pong.ping();
    }
  }
}

reactiveclass Pong(3) {
  knownrebecs { Ping ping; }
  Pong(Ping myPing) {
    ping = myPing;
  }
  msgsrv ping() {
    ping.pong();
  }
  msgsrv stop() {
  }
}

main {
  Pong pong(ping):();
  Ping ping(pong):();
  ping.start();
}