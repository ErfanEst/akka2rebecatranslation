reactiveclass Ping(3) {
  knownrebecs { Pong pong; }
  statevars { int count; }
  msgsrv initial() {
    count = 0;
    pong.ping();
  }
  msgsrv pong() {
    count = count + 1;
    if (count >= 10) {
      pong.stop();
    } else {
      pong.ping();
    }
  }
}

reactiveclass Pong(3) {
  knownrebecs { Ping ping; }
  msgsrv ping() {
    ping.pong();
  }
  msgsrv stop() {
  }
}

main {
  Pong pong(Ping ping):();
  Ping ping(pong):();
  ping.initial();
}