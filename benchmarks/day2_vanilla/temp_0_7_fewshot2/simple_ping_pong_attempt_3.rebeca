reactiveclass Ping(3) {
  knownrebecs { Pong pong; }
  statevars { int count; }
  Ping() { count = 0; self.start(); }
  msgsrv start() {
    pong.ping();
  }
  msgsrv pongMsg() {
    count += 1;
    if (count >= 10) {
      pong.stop();
    } else {
      pong.ping();
    }
  }
}

reactiveclass Pong(3) {
  knownrebecs { Ping ping; }
  msgsrv ping() {
    ping.pongMsg();
  }
  msgsrv stop() { }
}

main {
  Pong pong(ping):();
  Ping ping(pong):();
}