reactiveclass Ping {
	statevars {
		int count = 0;
	}
	knownrebecs {
		Pong pong;
	}
	Ping(Pong pong) {
		self.start();
	}
	msgsrv start {
		println("Ping started the game!");
		pong.ping();
	}
	msgsrv pong {
		count = count + 1;
		println("Ping received pong #" + count);
		if (count >= 10) {
			pong.stop();
			println("Ping stopped");
			self.terminate();
		} else {
			pong.ping();
		}
	}
}

reactiveclass Pong {
	msgsrv ping {
		println("Pong received ping");
		sender().pong();
	}
	msgsrv stop {
		println("Pong stopped");
		self.terminate();
	}
}

main {
	Pong pong();
	Ping ping(pong);
}