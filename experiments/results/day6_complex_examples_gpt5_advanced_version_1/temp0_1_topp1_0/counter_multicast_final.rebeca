reactiveclass CounterMulticast_Counter(5) {
	statevars {
		int count;
	}

	msgsrv initial() {
		// no initialization behavior specified
	}

	msgsrv Increment() {
		count = count + 1;
		((CounterMulticast_Client)sender).ValueResponse(count);
	}

	msgsrv Decrement() {
		count = count - 1;
		((CounterMulticast_Client)sender).ValueResponse(count);
	}

	msgsrv GetValue() {
		((CounterMulticast_Client)sender).ValueResponse(count);
	}
}

reactiveclass CounterMulticast_Client(5) {
	knownrebecs {
		CounterMulticast_Counter counter;
	}

	statevars {
		int clientId;
	}

	msgsrv initial() {
		if (clientId == 1) {
			counter.Increment();
			counter.GetValue();
		} else {
			counter.Increment();
		}
	}

	msgsrv ValueResponse(int value) {
		// no-op
	}
}

main {
	CounterMulticast_Counter counter() :();
	CounterMulticast_Client client1(counter) :();
	CounterMulticast_Client client2(counter) :();
}