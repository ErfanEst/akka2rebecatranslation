reactiveclass Counter(2) {
  knownrebecs {
    Client client1;
    Client client2;
  }
  statevars {
    int count;
  }

  Counter() {
    count = 0;
  }

  msgsrv initial() {
  }

  msgsrv Increment(Client snd) {
    count = count + 1;
    snd.ValueResponse(count);
  }

  msgsrv Decrement(Client snd) {
    count = count - 1;
    snd.ValueResponse(count);
  }

  msgsrv GetValue(Client snd) {
    snd.ValueResponse(count);
  }
}

reactiveclass Client(1) {
  knownrebecs {
    Counter counter;
  }
  statevars {
    int clientId;
  }

  Client(int id) {
    clientId = id;
  }

  msgsrv initial() {
    counter.Increment(self);
    counter.Increment(self);
    counter.GetValue(self);
  }

  msgsrv ValueResponse(int value) {
  }
}

main {
  Counter counter(client1, client2):();
  Client client1(counter):(1);
  Client client2(counter):(2);
}