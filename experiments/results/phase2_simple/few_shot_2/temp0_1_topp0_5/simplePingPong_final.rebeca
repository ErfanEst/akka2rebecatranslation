reactiveclass Ping(5) {
  knownrebecs { Pong pong; }
  statevars { int count; }

  Ping() {
    count = 0;
  }

  msgsrv StartMessage() {
    pong.PingMessage();
  }

  msgsrv PongMessage() {
    count = count + 1;
    if (count >= 10) {
      pong.StopMessage();
    } else {
      pong.PingMessage();
    }
  }
}

reactiveclass Pong(5) {
  knownrebecs { Ping ping; }

  msgsrv initial() {
    ping.StartMessage();
  }

  msgsrv PingMessage() {
    ping.PongMessage();
  }

  msgsrv StopMessage() {
    // no action needed, actor stops in Akka version
  }
}

main {
  Ping ping(pong):();
  Pong pong(ping):();
}