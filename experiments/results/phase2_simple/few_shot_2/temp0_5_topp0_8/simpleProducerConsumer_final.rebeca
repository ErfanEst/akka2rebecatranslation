reactiveclass Producer(5) {
	knownrebecs { Consumer consumer; }
	statevars { }

	msgsrv initial() { }

	msgsrv Produce(int item) {
		consumer.Consume(item);
	}
}

reactiveclass Consumer(5) {
	knownrebecs { }
	statevars { }

	msgsrv initial() { }

	msgsrv Consume(int item) {
	}
}

reactiveclass Starter(5) {
	knownrebecs { Producer producer; }
	statevars { }

	msgsrv initial() {
		producer.Produce(1);
		producer.Produce(2);
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();
	Starter starter(producer):();
}