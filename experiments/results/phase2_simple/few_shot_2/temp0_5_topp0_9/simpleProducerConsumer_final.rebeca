reactiveclass Producer(3) {
	knownrebecs { Consumer consumer; }
	statevars { }

	msgsrv initial() { }

	msgsrv ProduceMsg(int item) {
		consumer.ConsumeMsg(item);
	}
}

reactiveclass Consumer(3) {
	knownrebecs { }
	statevars { }

	msgsrv initial() { }

	msgsrv ConsumeMsg(int item) { }
}

reactiveclass MainRebeca(3) {
	knownrebecs { Consumer consumer; Producer producer; }
	statevars { }

	msgsrv initial() {
		producer.ProduceMsg(1);
		producer.ProduceMsg(2);
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();
	MainRebeca starter(consumer, producer):();
}