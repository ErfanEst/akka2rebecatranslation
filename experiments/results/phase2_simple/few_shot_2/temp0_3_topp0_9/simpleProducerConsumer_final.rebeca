reactiveclass MainRebeca(5) {
	knownrebecs {
		Consumer consumer;
		Producer producer;
	}
	statevars {
	}
	msgsrv initial() {
		producer.ProduceMsg(1);
		producer.ProduceMsg(2);
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();
	MainRebeca starter(consumer, producer):();
}