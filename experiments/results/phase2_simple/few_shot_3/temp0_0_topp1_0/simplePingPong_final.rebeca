reactiveclass Ping(5) {
	knownrebecs { Pong pong; } 
	statevars { int count; int state; } 

	Ping() { 
		count = 0; 
		state = 0; 
	} 

	msgsrv initial() { 
		// corresponds to StartMessage
		pong.PingMessage(); 
	} 

	msgsrv PongMessage() { 
		count = count + 1; 
		if (count >= 10) { 
			pong.StopMessage(); 
			state = 1; 
		} else { 
			pong.PingMessage(); 
		} 
	} 
} 

reactiveclass Pong(5) { 
	knownrebecs { Ping ping; } 
	statevars { int state; } 

	Pong() { 
		state = 0; 
	} 

	msgsrv PingMessage() { 
		ping.PongMessage(); 
	} 

	msgsrv StopMessage() { 
		state = 1; 
	} 
} 

main { 
	Ping ping(pong):(); 
	Pong pong(ping):(); 
}