reactiveclass Ping(5) {
	knownrebecs { Pong pong; }
	statevars { int count; boolean active; }

	Ping() {
		count = 0;
		active = true;
	}

	msgsrv initial() {
		self.StartMessage();
	}

	msgsrv StartMessage() {
		if (active) {
			pong.PingMessage();
		}
	}

	msgsrv PongMessage() {
		if (active) {
			count = count + 1;
			if (count >= 10) {
				pong.StopMessage();
				active = false;
			} else {
				pong.PingMessage();
			}
		}
	}
}

reactiveclass Pong(5) {
	knownrebecs { Ping ping; }
	statevars { boolean active; }

	Pong() {
		active = true;
	}

	msgsrv PingMessage() {
		if (active) {
			ping.PongMessage();
		}
	}

	msgsrv StopMessage() {
		active = false;
	}
}

main {
	Ping ping(pong):();
	Pong pong(ping):();
}