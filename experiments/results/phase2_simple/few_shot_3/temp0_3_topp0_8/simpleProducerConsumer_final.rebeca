reactiveclass Producer(5) {
  knownrebecs { Consumer consumer; }
  statevars { }

  Producer() { }

  msgsrv initial() {
    char[10] item1;
    char[10] item2;
    item1[0] = 'i'; item1[1] = 't'; item1[2] = 'e'; item1[3] = 'm'; item1[4] = '1';
    item2[0] = 'i'; item2[1] = 't'; item2[2] = 'e'; item2[3] = 'm'; item2[4] = '2';
    self.Produce(item1);
    self.Produce(item2);
  }

  msgsrv Produce(char[10] item) {
    consumer.Consume(item);
  }
}

reactiveclass Consumer(5) {
  knownrebecs { }
  statevars { }

  Consumer() { }

  msgsrv Consume(char[10] item) {
  }
}

main {
  Consumer c():();
  Producer p(c):();
}