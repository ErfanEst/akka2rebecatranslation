reactiveclass Producer(5) {
	knownrebecs {
		Consumer consumer;
	}

	statevars {
		int item;
	}

	msgsrv initial() {
		// no initialization logic
	}

	msgsrv Produce(int item) {
		consumer.Consume(item);
	}
}

reactiveclass Consumer(5) {
	knownrebecs {
	}

	statevars {
	}

	msgsrv initial() {
		self.start();
	}

	msgsrv Consume(int item) {
		// handle received item
	}

	msgsrv start() {
		// entry point to start the scenario if needed
	}
}

reactiveclass System(5) {
	knownrebecs {
		Producer producer;
	}

	statevars {
	}

	msgsrv initial() {
		producer.Produce(1);
		producer.Produce(2);
	}
}

main {
	Consumer consumer():();
	Producer producer(consumer):();
	System system(producer):();
}