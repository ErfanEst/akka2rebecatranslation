reactiveclass Ping(1) {
  knownrebecs { Pong pong; } 
  statevars { int count; } 

  msgsrv initial() {
    count = 0;
    self.startMessage();
  }

  msgsrv startMessage() {
    pong.pingMessage();
  }

  msgsrv pongMessage() {
    count = count + 1;
    if (count >= 10) {
      pong.stopMessage();
    } else {
      pong.pingMessage();
    }
  }
}

reactiveclass Pong(1) {
  knownrebecs { Ping ping; }

  msgsrv initial() {
  }

  msgsrv pingMessage() {
    ping.pongMessage();
  }

  msgsrv stopMessage() {
  }
}

main {
  Ping ping(pong):();
  Pong pong(ping):();
}