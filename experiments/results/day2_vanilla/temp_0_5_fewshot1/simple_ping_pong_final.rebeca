reactiveclass Ping(5) { 
  knownrebecs { 
    Pong pong; 
  } 
  statevars { 
    int count; 
  } 
  msgsrv initial() { 
    count = 0; 
    pong.pongMsg(); 
  } 
  msgsrv pongMsg() { 
    count = count + 1; 
    if(count >= 10) { 
      pong.stopMsg(); 
    } else { 
      pong.pongMsg(); 
    } 
  } 
  msgsrv stopMsg() { 
  } 
} 

reactiveclass Pong(5) { 
  knownrebecs { 
    Ping ping; 
  } 
  msgsrv initial() { 
  } 
  msgsrv pongMsg() { 
    ping.pongMsg(); 
  } 
  msgsrv stopMsg() { 
  } 
} 

main { 
  Ping ping(pong):(); 
  Pong pong(ping):(); 
}