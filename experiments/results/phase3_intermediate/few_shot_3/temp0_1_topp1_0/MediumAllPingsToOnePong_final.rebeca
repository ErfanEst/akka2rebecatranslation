reactiveclass PingActor(5) {
	knownrebecs { PongActor pong; }
	statevars { int id; }

	PingActor(int myId) {
		id = myId;
	}

	msgsrv initial() {
		// optional: could auto-start here if desired
	}

	msgsrv start() {
		pong.ping(id);
	}

	msgsrv msg(String m) {
		pong.ping(id);
	}

	msgsrv pong(int pid) {
		// no-op, just modeling that a pong is received
	}
}

reactiveclass PongActor(5) {
	knownrebecs { 
		PingActor p1; PingActor p2; PingActor p3; PingActor p4; PingActor p5;
	    PingActor p6; PingActor p7; PingActor p8; PingActor p9; PingActor p10; 
	}

	statevars { }

	PongActor() {
	}

	msgsrv ping(int pid) {
		if (pid == 1) {
			p1.pong(pid);
		} else if (pid == 2) {
			p2.pong(pid);
		} else if (pid == 3) {
			p3.pong(pid);
		} else if (pid == 4) {
			p4.pong(pid);
		} else if (pid == 5) {
			p5.pong(pid);
		} else if (pid == 6) {
			p6.pong(pid);
		} else if (pid == 7) {
			p7.pong(pid);
		} else if (pid == 8) {
			p8.pong(pid);
		} else if (pid == 9) {
			p9.pong(pid);
		} else if (pid == 10) {
			p10.pong(pid);
		}
	}
}

main {
	PingActor p1(pong):(1);
	PingActor p2(pong):(2);
	PingActor p3(pong):(3);
	PingActor p4(pong):(4);
	PingActor p5(pong):(5);
	PingActor p6(pong):(6);
	PingActor p7(pong):(7);
	PingActor p8(pong):(8);
	PingActor p9(pong):(9);
	PingActor p10(pong):(10);

	PongActor pong(p1, p2, p3, p4, p5, p6, p7, p8, p9, p10):();

	// initial message sending should be modeled via environment or initial() if needed
}