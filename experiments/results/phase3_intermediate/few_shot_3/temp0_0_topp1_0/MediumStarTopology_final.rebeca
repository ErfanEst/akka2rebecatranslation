reactiveclass Client(3) {
  knownrebecs { Hub hub; }
  statevars { }

  Client() { }

  msgsrv initial() {
    // no-op
  }

  msgsrv start() {
    hub.Ping(self);
  }

  msgsrv Pong() {
    hub.Ping(self);
  }
}

reactiveclass Hub(5) {
  knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; }
  statevars { int registeredCount; }

  Hub() {
    registeredCount = 0;
  }

  msgsrv initial() {
    self.RegisterDone();
    c1.start();
    c2.start();
    c3.start();
    c4.start();
    c5.start();
  }

  msgsrv RegisterDone() {
    registeredCount = registeredCount + 1;
  }

  msgsrv Ping(Client senderRef) {
    senderRef.Pong();
  }
}

main {
  Client c1(hub):();
  Client c2(hub):();
  Client c3(hub):();
  Client c4(hub):();
  Client c5(hub):();
  Hub hub(c1, c2, c3, c4, c5):();
}