reactiveclass Client(5) {
  knownrebecs { Hub hub; } 
  statevars { }

  msgsrv initial() { 
    hub.Register();
    hub.Ping(); 
  }

  msgsrv Register() {
    // registration acknowledgment or logic can be added here
  }

  msgsrv Pong() { 
    hub.Ping(); 
  }
}

reactiveclass Hub(10) {
  knownrebecs { Client c1; Client c2; Client c3; Client c4; Client c5; } 
  statevars { }

  msgsrv initial() { 
    c1.Register(); 
    c2.Register(); 
    c3.Register(); 
    c4.Register(); 
    c5.Register(); 
  }

  msgsrv Register() { 
    // registration logic implicit via knownrebecs
  }

  msgsrv Ping() { 
    // Since Rebeca has no sender(), we nondeterministically choose a client to Pong
    int choice;
    choice = ?(1,2,3,4,5);
    if (choice == 1) {
      c1.Pong();
    } else if (choice == 2) {
      c2.Pong();
    } else if (choice == 3) {
      c3.Pong();
    } else if (choice == 4) {
      c4.Pong();
    } else {
      c5.Pong();
    }
  }
}

main {
  Hub hub(c1, c2, c3, c4, c5):();
  Client c1(hub):();
  Client c2(hub):();
  Client c3(hub):();
  Client c4(hub):();
  Client c5(hub):();
}