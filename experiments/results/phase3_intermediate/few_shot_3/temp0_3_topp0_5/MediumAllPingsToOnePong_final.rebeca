reactiveclass PingActor(5) {
	knownrebecs { PongActor pong; }
	statevars { int id; }

	PingActor(int _id) {
		id = _id;
		self.start();
	}

	msgsrv initial() {
		// optional: self.start();
	}

	msgsrv start() {
		pong.ping(id);
	}

	msgsrv msg(int _msg) {
		pong.ping(id);
	}
}

reactiveclass PongActor(5) {
	knownrebecs { }

	statevars { }

	PongActor() { }

	msgsrv initial() {
	}

	msgsrv ping(int pid) {
		// In Rebeca there is no sender() meta-data; need explicit knownrebec
		// so we cannot call sender.pong(pid) here.
	}

	msgsrv pong(int pid) { }
}

main {
	PongActor pong():();
	PingActor p1(pong):(1);
	PingActor p2(pong):(2);
	PingActor p3(pong):(3);
	PingActor p4(pong):(4);
	PingActor p5(pong):(5);
	PingActor p6(pong):(6);
	PingActor p7(pong):(7);
	PingActor p8(pong):(8);
	PingActor p9(pong):(9);
	PingActor p10(pong):(10);
}