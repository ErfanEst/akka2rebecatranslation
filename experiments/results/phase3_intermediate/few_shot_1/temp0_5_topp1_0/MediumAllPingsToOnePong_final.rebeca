reactiveclass PingActor(5) {
	knownrebecs {
		PongActor pong;
	}
	statevars {
		int id;
	}

	msgsrv initial() {
		id = 0;
	}

	msgsrv setId(int _id) {
		id = _id;
		pong.pingFromPing(id);
	}

	msgsrv anyString() {
		pong.pingFromPing(id);
	}
}

