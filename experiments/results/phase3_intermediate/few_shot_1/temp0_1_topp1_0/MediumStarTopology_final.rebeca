reactiveclass Client(5) {
	knownrebecs {
		Hub hub;
	}
	statevars {
	}

	msgsrv initial() {
		self.start();
	}

	msgsrv start() {
		hub.pingFrom(self);
	}

	msgsrv pong() {
		hub.pingFrom(self);
	}
}

reactiveclass Hub(5) {
	knownrebecs {
		Client c1;
		Client c2;
		Client c3;
		Client c4;
		Client c5;
	}
	statevars {
		Client lastSender;
		int clientsCount;
		Client client0;
		Client client1;
		Client client2;
		Client client3;
		Client client4;
	}

	msgsrv initial() {
		clientsCount = 0;
		self.register(c1);
		self.register(c2);
		self.register(c3);
		self.register(c4);
		self.register(c5);
	}

	msgsrv register(Client ref) {
		if (clientsCount < 5) {
			if (clientsCount == 0) {
				client0 = ref;
			} else {
				if (clientsCount == 1) {
					client1 = ref;
				} else {
					if (clientsCount == 2) {
						client2 = ref;
					} else {
						if (clientsCount == 3) {
							client3 = ref;
						} else {
							if (clientsCount == 4) {
								client4 = ref;
							}
						}
					}
				}
			}
			clientsCount = clientsCount + 1;
		}
	}

	msgsrv ping() {
		lastSender.pong();
	}

	msgsrv pingFrom(Client ref) {
		lastSender = ref;
		self.ping();
	}
}

main {
	Hub hub(c1, c2, c3, c4, c5):();
	Client c1(hub):();
	Client c2(hub):();
	Client c3(hub):();
	Client c4(hub):();
	Client c5(hub):();
}