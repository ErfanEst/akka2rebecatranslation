reactiveclass PingActor(5) {
	knownrebecs { PongActor pong; } 
	statevars { int id; } 

	PingActor(int _id) { 
		id = _id; 
		self.start(); 
	} 

	msgsrv start() { 
		pong.ping(id); 
	} 

	msgsrv pongResponse(int dummy) { 
		pong.ping(id); 
	} 
} 

