reactiveclass PingActor(3) {
  knownrebecs { 
    PongActor pong; 
  } 
  statevars { 
    int id; 
  } 
  PingActor(int _id) { 
    id = _id; 
  } 
  msgsrv initial() { 
  } 
  msgsrv start() { 
    pong.ping(id); 
  } 
  msgsrv pongFor(int msgId) { 
    pong.ping(id); 
  } 
}

reactiveclass PongActor(3) {
  knownrebecs { 
  } 
  statevars { 
  } 
  PongActor() { 
  } 
  msgsrv initial() { 
  } 
  msgsrv ping(int id) { 
    self.pongFor(id); 
  } 
  msgsrv pongFor(int msgId) { 
  } 
}

